{
  "$schema": "node_modules/lerna/schemas/lerna-schema.json",
  "version": "1.0.0",
  "npmClient": "yarn",
  "useWorkspaces": true,
  "packages": [
    "packages/shared",
    "packages/shared/*",
    "packages/api-client",
    "packages/i18n",
    "packages/socket-client",
    "packages/video-sdk",
    "apps/web-app",
    "apps/mobile-app",
    "backend",
    "backend/services/*",
    "backend/shared",
    "backend/services/shared"
  ],
  "command": {
    "bootstrap": {
      "hoist": true,
      "npmClientArgs": ["--frozen-lockfile"]
    },
    "publish": {
      "conventionalCommits": true,
      "message": "chore(release): publish"
    },
    "version": {
      "allowBranch": "main",
      "message": "chore(release): version"
    },
    "run": {
      "stream": true,
      "parallel": false
    },
    "exec": {
      "stream": true
    }
  },
  "ignoreChanges": [
    "**/__tests__/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/*.md"
  ]
}
