# Test Environment Variables
NODE_ENV=test
PORT=3000
LOG_LEVEL=error

# Database - PostgreSQL (Test - Docker Compose port 5433)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flamoral_test
DB_USER=postgres
DB_PASSWORD=test_password
DATABASE_URL=postgresql://postgres:test_password@localhost:5433/flamoral_test

# Test Database Aliases
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=flamoral_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=test_password

# Redis (Test - Docker Compose port 6380)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=1
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6380/1

# Test Redis Aliases
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380
TEST_REDIS_DB=1

# MongoDB (Test - Docker Compose port 27018)
MONGODB_URI=mongodb://localhost:27018/flamoral_test
MONGODB_DB=flamoral_test

# RabbitMQ (Test - Docker Compose port 5673)
RABBITMQ_URL=amqp://test:test@localhost:5673
QUEUE_MATCHING=matching_queue_test
QUEUE_NOTIFICATIONS=notification_queue_test
QUEUE_ANALYTICS=analytics_queue_test
QUEUE_MODERATION=moderation_queue_test

# JWT Secrets (Test)
JWT_SECRET=test_jwt_secret_key_for_testing_only_do_not_use_in_production
JWT_ACCESS_SECRET=test-jwt-access-secret-key-for-testing-min-32-chars
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-for-testing-min-32-chars
JWT_EXPIRES_IN=15m
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Service URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3003
MESSAGING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3006

# Stripe (Test Mode)
STRIPE_SECRET_KEY=sk_test_fake_key_for_testing
STRIPE_PUBLISHABLE_KEY=pk_test_fake_key
STRIPE_WEBHOOK_SECRET=whsec_test_fake_webhook_secret

# Email (Mock - MailHog on port 1025)
EMAIL_FROM=noreply@test.flamoral.com
SENDGRID_API_KEY=SG.test_api_key
SENDGRID_FROM_EMAIL=test@flamoral.com
SENDGRID_FROM_NAME=Flamoral Test
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASSWORD=test

# Azure Storage (Mock - MinIO on port 9000)
AZURE_STORAGE_ACCOUNT_NAME=teststorage
AZURE_STORAGE_ACCOUNT_KEY=minioadmin
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=minioadmin;BlobEndpoint=http://localhost:9000/devstoreaccount1;
AZURE_STORAGE_CONTAINER_NAME=test-media
AZURE_STORAGE_CONTAINER_PHOTOS=photos-test
AZURE_STORAGE_CONTAINER_VIDEOS=videos-test
AZURE_CONTAINER_NAME=test-container
AZURE_CDN_URL=http://localhost:9000

# Azure Cognitive Services (Mock)
AZURE_CV_ENDPOINT=https://test.api.cognitive.microsoft.com/
AZURE_CV_API_KEY=test-cv-key
AZURE_FACE_API_KEY=test-face-api-key
AZURE_FACE_API_ENDPOINT=https://test.api.cognitive.microsoft.com

# WebSocket
WEBSOCKET_PORT=8080
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# CORS
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Session
SESSION_SECRET=test-session-secret-min-32-chars-here
SESSION_MAX_AGE=86400000

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_PHOTOS_PER_USER=9
MAX_VIDEO_SIZE=52428800

# External Services (Mock)
TWILIO_ACCOUNT_SID=ACtest
TWILIO_AUTH_TOKEN=test-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAtest

AGORA_APP_ID=test-app-id
AGORA_APP_CERTIFICATE=test-certificate

OPENAI_API_KEY=test-openai-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Testing
TEST_USER_EMAIL=testuser@test.com
TEST_USER_PASSWORD=TestPassword123!
TEST_USER_PHONE=+1234567890
SKIP_AUTH=false
USE_DOCKER_COMPOSE=true
USE_TESTCONTAINERS=false
