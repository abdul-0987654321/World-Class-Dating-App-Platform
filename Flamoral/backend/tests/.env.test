# Integration Test Environment Variables
NODE_ENV=test
LOG_LEVEL=error

# Test Database (PostgreSQL) - Docker Compose Service (port 5433)
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=flamoral_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=test_password

# Database Aliases (for compatibility with different test setups)
DB_HOST=localhost
DB_PORT=5433
DB_NAME=flamoral_test
DB_USER=postgres
DB_PASSWORD=test_password
DATABASE_URL=postgresql://postgres:test_password@localhost:5433/flamoral_test

# Test Redis - Docker Compose Service (port 6380)
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380
TEST_REDIS_DB=1

# Redis Aliases (for compatibility)
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=1
REDIS_URL=redis://localhost:6380/1

# Test MongoDB - Docker Compose Service (port 27018)
TEST_MONGODB_URI=mongodb://localhost:27018/flamoral_test
MONGODB_URI=mongodb://localhost:27018/flamoral_test
MONGODB_DB=flamoral_test

# Test RabbitMQ - Docker Compose Service (port 5673)
TEST_RABBITMQ_URL=amqp://test:test@localhost:5673
RABBITMQ_URL=amqp://test:test@localhost:5673

# JWT Secrets
JWT_ACCESS_SECRET=test-jwt-access-secret-key-for-testing-min-32-chars
JWT_REFRESH_SECRET=test-jwt-refresh-secret-key-for-testing-min-32-chars
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Test Service URLs
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3003
MESSAGING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3006

# Email (use test mode - MailHog on port 1025)
EMAIL_PROVIDER=test
SENDGRID_API_KEY=test_key
SMTP_HOST=localhost
SMTP_PORT=1025

# SMS (use test mode)
TWILIO_ACCOUNT_SID=test_sid
TWILIO_AUTH_TOKEN=test_token
TWILIO_PHONE_NUMBER=+15555555555

# Stripe (use test keys)
STRIPE_SECRET_KEY=sk_test_fake_key_for_testing
STRIPE_PUBLISHABLE_KEY=pk_test_fake_key
STRIPE_WEBHOOK_SECRET=whsec_test_fake_webhook_secret

# Storage (MinIO on port 9000)
STORAGE_PROVIDER=local
STORAGE_PATH=/tmp/flamoral-test-uploads
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=minioadmin;BlobEndpoint=http://localhost:9000/devstoreaccount1;

# Feature Flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PHONE_VERIFICATION=false
ENABLE_RATE_LIMITING=false

# Docker Compose
USE_DOCKER_COMPOSE=true
USE_TESTCONTAINERS=false
