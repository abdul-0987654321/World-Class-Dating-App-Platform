{
  "name": "@flamoral/services-shared",
  "version": "1.0.0",
  "description": "Shared utilities, middleware, and clients for Flamoral services",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "clients",
    "middleware",
    "cache",
    "messaging",
    "telemetry",
    "config",
    "utils"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rimraf dist *.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@flamoral/types": "workspace:*",
    "@flamoral/constants": "workspace:*",
    "@flamoral/utils": "workspace:*",
    "@flamoral/backend-shared": "workspace:*",
    "axios": "^1.7.9",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "winston": "^3.11.0",
    "ioredis": "^5.3.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
