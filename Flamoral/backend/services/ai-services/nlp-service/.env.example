# Service Configuration
SERVICE_NAME=nlp-service
VERSION=2.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8085
WORKERS=4

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/flamoral
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=flamoral

# Redis
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
GPT_MODEL=gpt-4-turbo-preview
GPT_MAX_TOKENS=2000
GPT_TEMPERATURE=0.7

# Translation APIs (choose one)
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATE_API_KEY=your_google_key_here
DEEPL_API_KEY=your_deepl_key_here
AZURE_TRANSLATOR_KEY=your_azure_key_here

# ML Models
SENTIMENT_MODEL=cardiffnlp/twitter-roberta-base-sentiment-latest
TOXICITY_MODEL=unitary/toxic-bert
INTENT_MODEL=facebook/bart-large-mnli
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
LANGUAGE_MODEL=papluca/xlm-roberta-base-language-detection
EMOTION_MODEL=j-hartmann/emotion-english-distilroberta-base

# NLP Settings
MAX_TEXT_LENGTH=5000
MIN_TEXT_LENGTH=1
TOXICITY_THRESHOLD=0.7
SPAM_THRESHOLD=0.8
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,nl,ru,ja,ko,zh,ar,hi,tr,pl

# Feature Flags
ENABLE_BIO_GENERATION=true
ENABLE_PROFILE_OPTIMIZATION=true
ENABLE_COMPATIBILITY_ANALYSIS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_TRANSLATION=true

# Rate Limiting
RATE_LIMIT_BIO_GENERATION=10
RATE_LIMIT_TRANSLATION=100
RATE_LIMIT_ANALYSIS=50

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
