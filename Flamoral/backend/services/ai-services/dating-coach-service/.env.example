# Service Configuration
SERVICE_NAME=dating-coach-service
VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8004

# AI Provider Configuration
AI_PROVIDER=openai  # openai or anthropic
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Model Configuration
OPENAI_MODEL=gpt-4-turbo-preview
ANTHROPIC_MODEL=claude-3-opus-20240229
MAX_TOKENS=1000
TEMPERATURE=0.7

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=2
REDIS_PASSWORD=

# Rate Limiting (requests per day)
RATE_LIMIT_FREE=3
RATE_LIMIT_BASIC=3
RATE_LIMIT_PREMIUM=10
RATE_LIMIT_PREMIUM_PLUS=-1  # -1 = unlimited

# MongoDB Configuration (optional - for analytics)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dating_coach

# Logging
LOG_LEVEL=INFO

# CORS
CORS_ORIGINS=*

# Monitoring (optional)
SENTRY_DSN=
