# Matching Service Test Environment
NODE_ENV=test
PORT=3003
LOG_LEVEL=error

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=matching_service_test
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# JWT
JWT_ACCESS_SECRET=test-access-secret-key

# Services
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3007

# Matching Algorithm
MAX_DISTANCE_KM=100
DEFAULT_AGE_RANGE_MIN=18
DEFAULT_AGE_RANGE_MAX=99
ELO_K_FACTOR=32
