# =============================================================================
# MATCHING SERVICE - Production Environment Configuration
# =============================================================================
# SECURITY: All secrets must be injected from Azure Key Vault
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=matching-service
NODE_ENV=production
PORT=3009
HOST=0.0.0.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Database Configuration (Azure PostgreSQL)
# =============================================================================
DB_HOST=flamoral-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral_matching
DB_USER=flamoral_admin@flamoral-prod-postgres
DB_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20
DATABASE_URL=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
REDIS_DB=1
REDIS_TLS=true

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_ACCESS_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Internal Service URLs (Kubernetes Service Discovery)
# =============================================================================
USER_SERVICE_URL=http://user-service.flamoral-prod.svc.cluster.local:3002
AUTH_SERVICE_URL=http://auth-service.flamoral-prod.svc.cluster.local:3001
NOTIFICATION_SERVICE_URL=http://notification-service.flamoral-prod.svc.cluster.local:3012
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-prod.svc.cluster.local:3007

# =============================================================================
# AI/ML Services
# =============================================================================
AI_SERVICE_URL=http://ai-service.flamoral-prod.svc.cluster.local:8000
RECOMMENDATION_SERVICE_URL=http://recommendation-service.flamoral-prod.svc.cluster.local:5000

# =============================================================================
# ML Model Configuration
# =============================================================================
ML_MODEL_PATH=/app/models
ML_MODEL_VERSION=1.0.0
ML_INFERENCE_BATCH_SIZE=100
ML_MODEL_CACHE_DIR=/tmp/ml-cache

# =============================================================================
# Matching Algorithm Settings
# =============================================================================
MATCH_QUEUE_SIZE=50
MATCH_REFRESH_INTERVAL_HOURS=24
COMPATIBILITY_THRESHOLD=0.6
MIN_COMPATIBILITY_SCORE=30
DEFAULT_RECOMMENDATION_LIMIT=20
MAX_DISTANCE_KM=100

# Advanced Matching
ENABLE_AI_MATCHING=true
ENABLE_BEHAVIORAL_ANALYSIS=true
ENABLE_PERSONALITY_MATCHING=true

# =============================================================================
# Azure Service Bus (Message Queue)
# =============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Performance
# =============================================================================
WORKER_CONCURRENCY=10
JOB_TIMEOUT=300000
ENABLE_BACKGROUND_JOBS=true

# Scheduled Jobs
CRON_MATCH_GENERATION=0 */6 * * *
CRON_CLEANUP_EXPIRED_MATCHES=0 2 * * *

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=*** # INJECT FROM AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
ENABLE_METRICS=true

# Application Insights
APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live
