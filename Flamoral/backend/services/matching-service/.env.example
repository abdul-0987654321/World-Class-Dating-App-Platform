# ============================================================================
# MATCHING SERVICE - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=matching-service
NODE_ENV=development
PORT=3009

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_matching
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Alternative: Full connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_matching

# ============================================================================
# Redis Configuration (for match queue caching)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1
REDIS_URL=redis://localhost:6379/1

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================
JWT_ACCESS_SECRET=your-jwt-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================================
# Internal Service Authentication (REQUIRED)
# ============================================================================
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# ============================================================================
# Service URLs (REQUIRED - Correct port assignments)
# ============================================================================
USER_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3012
ANALYTICS_SERVICE_URL=http://localhost:3007

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000,https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com

# ============================================================================
# ML Model Configuration
# ============================================================================
ML_MODEL_PATH=./src/ml/models
ML_MODEL_VERSION=1.0.0
ML_INFERENCE_BATCH_SIZE=100

# ============================================================================
# Matching Algorithm Settings
# ============================================================================
MATCH_QUEUE_SIZE=50
MATCH_REFRESH_INTERVAL_HOURS=24
COMPATIBILITY_THRESHOLD=0.6
MIN_COMPATIBILITY_SCORE=30
DEFAULT_RECOMMENDATION_LIMIT=20
MAX_DISTANCE_KM=100

# ============================================================================
# Performance
# ============================================================================
WORKER_CONCURRENCY=5
REQUEST_TIMEOUT_MS=30000

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
