# ============================================================================
# USER SERVICE - Environment Variables
# ============================================================================
# Service Configuration
SERVICE_NAME=user-service
NODE_ENV=development
PORT=3002

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_users
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Alternative: Full connection string (if preferred over individual vars)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_users

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================================
# Internal Service Authentication (REQUIRED)
# ============================================================================
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# ============================================================================
# Service URLs (REQUIRED - Correct port assignments)
# ============================================================================
AUTH_SERVICE_URL=http://localhost:3001
MODERATION_SERVICE_URL=http://localhost:3008
NOTIFICATION_SERVICE_URL=http://localhost:3012
ANALYTICS_SERVICE_URL=http://localhost:3007

# ============================================================================
# Frontend URLs
# ============================================================================
APP_URL=http://localhost:3000
API_URL=http://localhost:3002
WEB_URL=https://flamoral.com

# ============================================================================
# Azure Blob Storage (for profile photos)
# ============================================================================
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_BLOB_CONTAINER_NAME=profile-photos
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos

# ============================================================================
# Email Service (SendGrid)
# ============================================================================
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@flamoral.com
FROM_NAME=Flamoral

# ============================================================================
# SMS Service (Twilio - for phone verification)
# ============================================================================
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid

# ============================================================================
# Azure Cognitive Services (for photo verification)
# ============================================================================
AZURE_FACE_API_KEY=your_azure_face_api_key
AZURE_FACE_API_ENDPOINT=https://your-region.api.cognitive.microsoft.com
AZURE_CV_KEY=your_azure_computer_vision_key
AZURE_CV_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# ============================================================================
# KYC/Identity Verification
# ============================================================================
# Choose provider: stripe, persona, onfido, jumio, or leave empty for manual verification
KYC_PROVIDER=stripe

# Stripe Identity (optional - only if using Stripe as KYC provider)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# Persona (optional - only if using Persona as KYC provider)
PERSONA_API_KEY=your_persona_api_key
PERSONA_TEMPLATE_ID=your_persona_template_id

# Onfido (optional - only if using Onfido as KYC provider)
ONFIDO_API_KEY=your_onfido_api_key

# Jumio (optional - only if using Jumio as KYC provider)
JUMIO_API_TOKEN=your_jumio_api_token
JUMIO_API_SECRET=your_jumio_api_secret

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000,https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com

# ============================================================================
# Security Configuration
# ============================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# TOTP/2FA Encryption (REQUIRED for production)
# Generate master key: openssl rand -base64 48
TOTP_ENCRYPTION_MASTER_KEY=your-totp-encryption-master-key-min-32-chars-use-openssl-rand-base64-48
# Generate salt: openssl rand -base64 48
TOTP_ENCRYPTION_KEY_SALT=your-totp-encryption-salt-min-32-chars-use-openssl-rand-base64-48
# Key version for rotation support
TOTP_ENCRYPTION_KEY_VERSION=1

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ============================================================================
# Video Calling (Agora)
# ============================================================================
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# Timeouts
# ============================================================================
REQUEST_TIMEOUT_MS=30000
