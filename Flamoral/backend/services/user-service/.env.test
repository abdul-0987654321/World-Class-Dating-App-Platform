# User Service Test Environment
NODE_ENV=test
PORT=3002
LOG_LEVEL=error

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=user_service_test
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/user_service_test

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# JWT
JWT_ACCESS_SECRET=test-access-secret-key
JWT_REFRESH_SECRET=test-refresh-secret-key
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Email
SENDGRID_API_KEY=SG.test_api_key_for_testing
FROM_EMAIL=test@flamoral.com

# Services
AUTH_SERVICE_URL=http://localhost:3001
MEDIA_SERVICE_URL=http://localhost:3005
PAYMENT_SERVICE_URL=http://localhost:3006

# Stripe
STRIPE_SECRET_KEY=sk_test_mock_key
STRIPE_WEBHOOK_SECRET=whsec_test_mock_secret

# Subscription Defaults
FREE_TIER_DAILY_SWIPES=10
MID_TIER_DAILY_SWIPES=100
TOP_TIER_DAILY_SWIPES=-1
