# Development Dockerfile - Quick deployment
FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./
COPY tsconfig.json ./

# Install ALL dependencies (including dev dependencies for ts-node)
RUN npm install

# Copy source code
COPY . .

# Expose port
EXPOSE 3001

# Run with ts-node (development mode)
CMD ["npx", "ts-node", "src/index.ts"]
