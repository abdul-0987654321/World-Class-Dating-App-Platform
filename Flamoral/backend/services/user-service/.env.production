# =============================================================================
# USER SERVICE - Production Environment Configuration
# =============================================================================
# SECURITY: All secrets must be injected from Azure Key Vault
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=user-service
NODE_ENV=production
PORT=3002
HOST=0.0.0.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Database Configuration (Azure PostgreSQL)
# =============================================================================
DB_HOST=flamoral-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral_users
DB_USER=flamoral_admin@flamoral-prod-postgres
DB_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20
DATABASE_URL=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
REDIS_DB=0
REDIS_TLS=true

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_ACCESS_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Internal Service URLs (Kubernetes Service Discovery)
# =============================================================================
AUTH_SERVICE_URL=http://auth-service.flamoral-prod.svc.cluster.local:3001
MODERATION_SERVICE_URL=http://moderation-service.flamoral-prod.svc.cluster.local:3008
NOTIFICATION_SERVICE_URL=http://notification-service.flamoral-prod.svc.cluster.local:3012
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-prod.svc.cluster.local:3007
MEDIA_SERVICE_URL=http://media-service.flamoral-prod.svc.cluster.local:3006

# =============================================================================
# Azure Storage (Profile Photos & Media)
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoralprodst
AZURE_STORAGE_KEY=*** # INJECT FROM AZURE KEY VAULT
AZURE_STORAGE_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
AZURE_BLOB_CONTAINER_NAME=profile-photos
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_AVATARS=avatars

# CDN Configuration
CDN_ENABLED=true
CDN_URL=https://cdn.flamoral.com
AZURE_STORAGE_CDN_ENABLED=true
AZURE_STORAGE_CDN_ENDPOINT=https://cdn.flamoral.com

# =============================================================================
# Email Configuration (SendGrid)
# =============================================================================
SENDGRID_API_KEY=*** # INJECT FROM AZURE KEY VAULT
FROM_EMAIL=noreply@flamoral.com
FROM_NAME=Flamoral

# =============================================================================
# Azure Cognitive Services (Photo Verification)
# =============================================================================
AZURE_FACE_API_KEY=*** # INJECT FROM AZURE KEY VAULT
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com
FACE_VERIFICATION_THRESHOLD=0.7

# =============================================================================
# Password Security
# =============================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# =============================================================================
# TOTP/2FA Encryption
# =============================================================================
TOTP_ENCRYPTION_MASTER_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 48 chars
TOTP_ENCRYPTION_KEY_SALT=*** # INJECT FROM AZURE KEY VAULT - Min 48 chars
TOTP_ENCRYPTION_KEY_VERSION=1

# =============================================================================
# CORS Configuration - CRITICAL for WebSocket connections
# =============================================================================
# Must include all frontend domains for Socket.IO to work properly
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com,https://flamoral.vercel.app,https://*.flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=*** # INJECT FROM AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
ENABLE_METRICS=true

# Application Insights
APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

# =============================================================================
# Business Rules
# =============================================================================
MIN_AGE=18
MAX_AGE=100
MAX_PHOTOS=10
MAX_BIO_LENGTH=500
MAX_INTERESTS=20
