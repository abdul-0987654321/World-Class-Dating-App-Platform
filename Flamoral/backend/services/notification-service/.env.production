# =============================================================================
# NOTIFICATION SERVICE - Production Environment Configuration
# =============================================================================
# SECURITY: All secrets must be injected from Azure Key Vault
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=notification-service
NODE_ENV=production
PORT=3012
HOST=0.0.0.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Database Configuration (Azure PostgreSQL)
# =============================================================================
DB_HOST=flamoral-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral_notifications
DB_USER=flamoral_admin@flamoral-prod-postgres
DB_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20
DATABASE_URL=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
REDIS_DB=5
REDIS_TLS=true

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_ACCESS_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Internal Service URLs (Kubernetes Service Discovery)
# =============================================================================
USER_SERVICE_URL=http://user-service.flamoral-prod.svc.cluster.local:3002
AUTH_SERVICE_URL=http://auth-service.flamoral-prod.svc.cluster.local:3001
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-prod.svc.cluster.local:3007

# =============================================================================
# Email Service - SendGrid
# =============================================================================
SENDGRID_API_KEY=*** # INJECT FROM AZURE KEY VAULT
SENDGRID_FROM_EMAIL=noreply@flamoral.com
SENDGRID_FROM_NAME=Flamoral
SENDGRID_REPLY_TO=support@flamoral.com

# Email Templates
SENDGRID_TEMPLATE_WELCOME=d-xxx
SENDGRID_TEMPLATE_MATCH_NOTIFICATION=d-xxx
SENDGRID_TEMPLATE_MESSAGE_NOTIFICATION=d-xxx
SENDGRID_TEMPLATE_DIGEST=d-xxx

# Email Settings
EMAIL_RATE_LIMIT=100
EMAIL_RETRY_ATTEMPTS=3

# =============================================================================
# SMS Service - Twilio
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=*** # INJECT FROM AZURE KEY VAULT
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_RETRY_ATTEMPTS=3
TWILIO_TIMEOUT=30000

# =============================================================================
# Push Notifications - Firebase Cloud Messaging
# =============================================================================
FIREBASE_PROJECT_ID=flamoral-production
FIREBASE_PRIVATE_KEY=*** # INJECT FROM AZURE KEY VAULT (JSON format)
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@flamoral-production.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://flamoral-production.firebaseio.com
FIREBASE_SERVICE_ACCOUNT_PATH=/etc/secrets/firebase-service-account.json
FCM_SERVER_KEY=*** # INJECT FROM AZURE KEY VAULT
FCM_SENDER_ID=your-fcm-sender-id
FCM_TIMEOUT=30000

# =============================================================================
# Azure Service Bus (Message Queue)
# =============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_EMAIL=email_queue
QUEUE_SMS=sms_queue
QUEUE_PUSH_NOTIFICATIONS=push_notification_queue

# =============================================================================
# Notification Settings
# =============================================================================
# Notification Preferences
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=true
ENABLE_PUSH_NOTIFICATIONS=true

# Rate Limiting (per user)
MAX_EMAILS_PER_DAY=10
MAX_SMS_PER_DAY=5
MAX_PUSH_PER_HOUR=20

# Notification Batching
BATCH_EMAIL_ENABLED=true
BATCH_EMAIL_DELAY=300000
DIGEST_EMAIL_ENABLED=true
DIGEST_EMAIL_SCHEDULE=0 9 * * *

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=*** # INJECT FROM AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
ENABLE_METRICS=true

APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live
