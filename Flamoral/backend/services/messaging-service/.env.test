# Messaging Service Test Environment
NODE_ENV=test
PORT=3004
LOG_LEVEL=error

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=messaging_service_test
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# JWT
JWT_ACCESS_SECRET=test-access-secret-key

# WebSocket
WEBSOCKET_PORT=8080

# Services
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3007
MODERATION_SERVICE_URL=http://localhost:3009

# Agora Video Chat
AGORA_APP_ID=test_agora_app_id
AGORA_APP_CERTIFICATE=test_agora_certificate

# Message Limits
MAX_MESSAGE_LENGTH=2000
MAX_MEDIA_SIZE_MB=10
