# =============================================================================
# MESSAGING SERVICE - Production Environment Configuration
# =============================================================================
# SECURITY: All secrets must be injected from Azure Key Vault
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=messaging-service
NODE_ENV=production
PORT=3003
HOST=0.0.0.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Database Configuration (Azure Cosmos DB with MongoDB API)
# =============================================================================
MONGODB_URI=*** # INJECT FROM AZURE KEY VAULT
MONGODB_DB=flamoral_messaging
MONGODB_SSL=true
COSMOS_DB_ENDPOINT=*** # INJECT FROM AZURE KEY VAULT
COSMOS_DB_KEY=*** # INJECT FROM AZURE KEY VAULT
COSMOS_DB_DATABASE=flamoral-messaging

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
REDIS_DB=2
REDIS_TLS=true

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_ACCESS_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Internal Service URLs (Kubernetes Service Discovery)
# =============================================================================
USER_SERVICE_URL=http://user-service.flamoral-prod.svc.cluster.local:3002
AUTH_SERVICE_URL=http://auth-service.flamoral-prod.svc.cluster.local:3001
NOTIFICATION_SERVICE_URL=http://notification-service.flamoral-prod.svc.cluster.local:3012
MODERATION_SERVICE_URL=http://moderation-service.flamoral-prod.svc.cluster.local:3008
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-prod.svc.cluster.local:3007

# =============================================================================
# Azure Storage (Media Attachments)
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoralprodst
AZURE_STORAGE_KEY=*** # INJECT FROM AZURE KEY VAULT
AZURE_STORAGE_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
AZURE_STORAGE_CONTAINER_MESSAGES=messages

# =============================================================================
# Azure Service Bus (Message Queue)
# =============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
QUEUE_WEBSOCKET_EVENTS=websocket_events_queue
TOPIC_MESSAGE_EVENTS=message_events_topic

# =============================================================================
# Message Configuration
# =============================================================================
MAX_MESSAGE_LENGTH=2000
MAX_MESSAGES_PER_CONVERSATION=10000
MESSAGE_RETENTION_DAYS=365
MAX_ATTACHMENT_SIZE=10485760
ALLOWED_ATTACHMENT_TYPES=image/jpeg,image/png,image/gif,image/webp

# Encryption
MESSAGE_ENCRYPTION_ENABLED=true
MESSAGE_ENCRYPTION_KEY=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=*** # INJECT FROM AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
ENABLE_METRICS=true

APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live
