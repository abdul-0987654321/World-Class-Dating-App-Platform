# ============================================================================
# JWT CONFIGURATION - SECURE TEMPLATE
# ============================================================================
# This template provides secure JWT configuration for Flamoral services
# CRITICAL: Never commit actual secrets to version control
# ============================================================================

# ============================================================================
# JWT SECRETS (REQUIRED - MUST BE CHANGED IN PRODUCTION)
# ============================================================================
# Generate secure secrets using:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# IMPORTANT:
# - Each secret MUST be at least 32 characters (64 recommended)
# - Access and Refresh secrets MUST be different
# - Change these immediately after deployment
# - Rotate secrets periodically (quarterly recommended)
# ============================================================================

# JWT Access Token Secret (64+ hex characters recommended)
# This secret is used to sign short-lived access tokens
JWT_ACCESS_SECRET=CHANGE_ME_TO_SECURE_64_CHARACTER_HEX_STRING_MINIMUM_32_CHARS_0123456789abcdef

# JWT Refresh Token Secret (64+ hex characters recommended)
# This secret MUST be different from JWT_ACCESS_SECRET
# Used to sign long-lived refresh tokens
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_CHARACTER_HEX_STRING_MINIMUM_32_CHARS_fedcba9876543210

# ============================================================================
# JWT CONFIGURATION - SECURE DEFAULTS
# ============================================================================

# Access Token Expiration
# Short-lived for security (15 minutes recommended)
# Supported formats: 60, "2 days", "10h", "7d", "1y"
JWT_ACCESS_EXPIRES_IN=15m

# Refresh Token Expiration
# Long-lived for user convenience (7 days recommended)
# Maximum: 30 days for security
JWT_REFRESH_EXPIRES_IN=7d

# JWT Issuer
# Identifies who issued the token
# Should be consistent across all services
JWT_ISSUER=flamoral-auth-service

# JWT Audience
# Identifies who the token is intended for
# Should be consistent across all services
JWT_AUDIENCE=flamoral-platform

# JWT Algorithm
# MUST be HS256 for HMAC-SHA256
# DO NOT change unless you know what you're doing
JWT_ALGORITHM=HS256

# ============================================================================
# JWT VALIDATION (OPTIONAL - RECOMMENDED FOR DEVELOPMENT)
# ============================================================================

# Enable JWT secret validation on startup
# Validates that secrets meet minimum security requirements
# Set to false only if you know secrets are secure
VALIDATE_JWT_SECRETS=true

# Minimum secret length enforcement
# Default: 32 characters
JWT_MIN_SECRET_LENGTH=32

# ============================================================================
# TOKEN REFRESH CONFIGURATION
# ============================================================================

# Enable refresh token rotation
# When true, a new refresh token is issued on each refresh
# Improves security by detecting token theft
ENABLE_REFRESH_TOKEN_ROTATION=true

# Refresh token reuse window (in seconds)
# Allows a small window for race conditions in distributed systems
# Default: 3 seconds
REFRESH_TOKEN_REUSE_WINDOW=3

# ============================================================================
# SECURITY CONFIGURATION
# ============================================================================

# Token Blacklist/Revocation
# Enable token revocation list (requires Redis)
ENABLE_TOKEN_REVOCATION=true

# Token revocation storage (redis, memory, database)
TOKEN_REVOCATION_STORE=redis

# Maximum active sessions per user
# Set to 0 for unlimited
# Recommended: 3-5 for security
MAX_ACTIVE_SESSIONS=5

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================

# Before deploying to production:
# [ ] Generate new JWT_ACCESS_SECRET (64+ characters)
# [ ] Generate new JWT_REFRESH_SECRET (64+ characters, different from access)
# [ ] Verify JWT_ISSUER matches auth service name
# [ ] Verify JWT_AUDIENCE matches platform name
# [ ] Set JWT_ACCESS_EXPIRES_IN to 15m or less
# [ ] Set JWT_REFRESH_EXPIRES_IN to 7d or less
# [ ] Enable VALIDATE_JWT_SECRETS=true
# [ ] Enable ENABLE_REFRESH_TOKEN_ROTATION=true
# [ ] Configure TOKEN_REVOCATION_STORE (Redis recommended)
# [ ] Set MAX_ACTIVE_SESSIONS to reasonable limit
# [ ] Test token generation and validation
# [ ] Test token refresh flow
# [ ] Test token revocation
# [ ] Document secret rotation procedure

# ============================================================================
# ENVIRONMENT-SPECIFIC OVERRIDES
# ============================================================================

# Development
# - Can use longer token expiration for convenience
# - JWT_ACCESS_EXPIRES_IN=1h
# - JWT_REFRESH_EXPIRES_IN=30d

# Staging
# - Should match production configuration
# - Use separate secrets from production

# Production
# - Use shortest practical token expiration
# - JWT_ACCESS_EXPIRES_IN=15m
# - JWT_REFRESH_EXPIRES_IN=7d
# - Enable all security features

