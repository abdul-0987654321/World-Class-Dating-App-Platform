# Moderation Service Test Environment
NODE_ENV=test
PORT=3009
LOG_LEVEL=error

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moderation_service_test
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# JWT
JWT_ACCESS_SECRET=test-access-secret-key

# OpenAI
OPENAI_API_KEY=sk-test-openai-key-for-testing

# Azure Computer Vision
AZURE_CV_ENDPOINT=https://test.api.cognitive.microsoft.com/
AZURE_CV_API_KEY=test-cv-key

# Moderation Thresholds
TOXICITY_THRESHOLD=0.7
NSFW_THRESHOLD=0.8
AUTO_BAN_THRESHOLD=0.95

# Services
USER_SERVICE_URL=http://localhost:3002
