# ============================================================================
# CSAM DETECTION CONFIGURATION
# ============================================================================
# CRITICAL: These settings are required for legal compliance
# DO NOT disable CSAM detection in production
# ============================================================================

# Enable/Disable CSAM Detection
# WARNING: Should ALWAYS be true in production
# Only set to false for local development testing (with extreme caution)
CSAM_DETECTION_ENABLED=true

# ============================================================================
# MICROSOFT PHOTODNA CONFIGURATION
# ============================================================================
# PhotoDNA is the industry standard for CSAM detection
# Sign up at: https://www.microsoft.com/en-us/photodna
#
# Required for production deployment
PHOTODNA_ENDPOINT=https://api.microsoftphotodna.com
PHOTODNA_API_KEY=your_photodna_api_key_here

# ============================================================================
# NCMEC CYBERTIPLINE CONFIGURATION
# ============================================================================
# National Center for Missing & Exploited Children
# Mandatory reporting under 18 U.S.C. § 2258A
#
# Register as an ESP at: https://www.missingkids.org/gethelpnow/cybertipline
# Required for production deployment
NCMEC_ENDPOINT=https://report.cybertip.org/api
NCMEC_API_KEY=your_ncmec_api_key_here
NCMEC_ESP_ID=your_electronic_service_provider_id
NCMEC_ESP_NAME=Flamoral Dating Platform
NCMEC_CONTACT_EMAIL=legal@flamoral.com
NCMEC_CONTACT_PHONE=+1-555-123-4567

# Enable/disable actual submission to NCMEC
# Set to false only in development/staging
# MUST be true in production
NCMEC_REPORTING_ENABLED=true

# ============================================================================
# CONTENT QUARANTINE CONFIGURATION
# ============================================================================
# Secure storage for quarantined CSAM evidence
# Must be encrypted and access-controlled
CSAM_QUARANTINE_STORAGE_PATH=/secure/csam-quarantine

# 256-bit encryption key for quarantined content
# CRITICAL: Generate a secure random key and store in secrets manager
# Generate with: openssl rand -hex 32
CSAM_ENCRYPTION_KEY=generate_secure_256_bit_key_here

# Audit log signing key (for tamper detection)
# Generate with: openssl rand -hex 32
AUDIT_SIGNING_KEY=generate_secure_256_bit_key_here

# ============================================================================
# STAFF NOTIFICATION CONFIGURATION
# ============================================================================
# Emergency contacts for CSAM detection alerts
# Multiple emails separated by commas

# Email Notifications (always enabled for critical alerts)
CSAM_EMAIL_NOTIFICATIONS_ENABLED=true
CSAM_EMERGENCY_EMAILS=safety@flamoral.com,legal@flamoral.com,ceo@flamoral.com

# SMS Notifications (for critical severity only)
CSAM_SMS_NOTIFICATIONS_ENABLED=true
CSAM_EMERGENCY_PHONES=+1-555-123-4567,+1-555-987-6543

# Slack Integration
CSAM_SLACK_NOTIFICATIONS_ENABLED=true
CSAM_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# PagerDuty Integration (for on-call escalation)
CSAM_PAGERDUTY_ENABLED=true
CSAM_PAGERDUTY_KEY=your_pagerduty_integration_key_here

# ============================================================================
# DETECTION THRESHOLDS
# ============================================================================
# Fine-tune detection sensitivity (values: 0.0 - 1.0)

# Confidence threshold for automatic quarantine
# Default: 0.70 (70% confidence)
# Lower = more sensitive (more false positives)
# Higher = less sensitive (possible false negatives)
CSAM_AUTO_QUARANTINE_THRESHOLD=0.70

# Confidence threshold for NCMEC reporting
# Default: 0.85 (85% confidence)
# Should be higher than quarantine threshold
CSAM_NCMEC_REPORTING_THRESHOLD=0.85

# Perceptual hash similarity threshold (Hamming distance)
# Default: 10 (out of 64 bits)
# Lower = more strict matching
# Higher = more lenient matching
CSAM_PHASH_SIMILARITY_THRESHOLD=10

# ============================================================================
# LAW ENFORCEMENT PORTAL
# ============================================================================
# Secure portal for law enforcement evidence access
LAW_ENFORCEMENT_PORTAL_URL=https://le-portal.flamoral.com

# ============================================================================
# GENERAL MODERATION SERVICE CONFIGURATION
# ============================================================================
# Main moderation service URL
MODERATION_SERVICE_URL=http://localhost:3005

# Application URL (for notification links)
APP_URL=https://flamoral.com

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_moderation
DB_USER=postgres
DB_PASSWORD=your_secure_db_password
DB_SSL=true

# ============================================================================
# LOGGING CONFIGURATION
# ============================================================================
# Log level for CSAM detection
# Options: error, warn, info, debug
# Recommend: warn or info for production
LOG_LEVEL=info

# ============================================================================
# PRODUCTION DEPLOYMENT CHECKLIST
# ============================================================================
# Before deploying to production, ensure:
#
# [√] CSAM_DETECTION_ENABLED=true
# [√] PHOTODNA_API_KEY configured
# [√] NCMEC_API_KEY configured
# [√] NCMEC_ESP_ID configured
# [√] NCMEC_REPORTING_ENABLED=true
# [√] CSAM_ENCRYPTION_KEY is secure (256-bit)
# [√] AUDIT_SIGNING_KEY is secure (256-bit)
# [√] Emergency contacts configured
# [√] Slack webhook configured
# [√] PagerDuty integration configured
# [√] Database is configured and migrated
# [√] Storage path exists and is encrypted
# [√] All notification channels tested
# [√] Legal team briefed on system
# [√] On-call rotation established
# [√] Law enforcement contact established
#
# ============================================================================
# SECURITY NOTES
# ============================================================================
# 1. NEVER commit this file with real credentials
# 2. Use secrets manager (AWS Secrets Manager, HashiCorp Vault, etc.)
# 3. Rotate API keys regularly
# 4. Monitor API key usage
# 5. Restrict access to quarantine storage
# 6. Enable database encryption at rest
# 7. Use TLS 1.3 for all communications
# 8. Regular security audits required
# 9. Keep audit logs for minimum 7 years
# 10. Maintain comprehensive incident response plan
#
# ============================================================================
# COMPLIANCE NOTES
# ============================================================================
# Legal Requirements:
# - Report to NCMEC within 24 hours of detection
# - Preserve evidence for minimum 90 days
# - Do NOT notify user of detection or report
# - Cooperate fully with law enforcement
# - Maintain complete audit trail
# - Annual compliance audit recommended
#
# Penalties for Non-Compliance:
# - Civil penalties: up to $150,000 per violation
# - Criminal prosecution for knowing violations
# - Loss of safe harbor protections
# - Platform shutdown
#
# ============================================================================
# SUPPORT
# ============================================================================
# For technical support: csam-support@flamoral.com
# For legal questions: legal@flamoral.com
# For emergency: PagerDuty escalation
#
# External Resources:
# - NCMEC: https://www.missingkids.org
# - PhotoDNA: https://www.microsoft.com/photodna
# - FBI ICAC: https://www.fbi.gov/investigate/violent-crime/cac
#
# ============================================================================
