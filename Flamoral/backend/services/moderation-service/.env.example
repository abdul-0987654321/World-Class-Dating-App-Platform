# ============================================================================
# MODERATION SERVICE - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=moderation-service
PORT=3008
NODE_ENV=development

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================
JWT_ACCESS_SECRET=your-jwt-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=24h

# ============================================================================
# Internal Service Authentication (REQUIRED)
# ============================================================================
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_moderation
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Alternative: Full connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_moderation

# ============================================================================
# Redis Configuration (for caching and queuing)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=8
REDIS_URL=redis://localhost:6379/8

# ============================================================================
# AWS Rekognition Configuration
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REKOGNITION_MIN_CONFIDENCE=80
AWS_REKOGNITION_MAX_LABELS=10

# ============================================================================
# Azure Content Moderator Configuration
# ============================================================================
AZURE_CONTENT_MODERATOR_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_CONTENT_MODERATOR_KEY=your_azure_content_moderator_key

# ============================================================================
# Moderation Thresholds (0.0 - 1.0)
# ============================================================================
# Image Moderation
THRESHOLD_EXPLICIT_NUDITY=0.85
THRESHOLD_SUGGESTIVE_NUDITY=0.70
THRESHOLD_VIOLENCE=0.80
THRESHOLD_DISTURBING=0.75
THRESHOLD_RUDE=0.70
THRESHOLD_DRUGS=0.80
THRESHOLD_TOBACCO=0.70
THRESHOLD_ALCOHOL=0.70
THRESHOLD_GAMBLING=0.75
THRESHOLD_HATE=0.85

# Text Moderation
THRESHOLD_PROFANITY=0.70
THRESHOLD_SEXUALLY=0.75
THRESHOLD_OFFENSIVE=0.70
THRESHOLD_TEXT_HATE=0.80

# Auto-Action Thresholds
AUTO_REJECT_THRESHOLD=0.90
AUTO_FLAG_THRESHOLD=0.70
AUTO_APPROVE_THRESHOLD=0.50

# ============================================================================
# User Violation Limits
# ============================================================================
SUSPENSION_VIOLATION_COUNT=3
BAN_VIOLATION_COUNT=5

# ============================================================================
# Service URLs (REQUIRED - Correct port assignments)
# ============================================================================
USER_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001
MEDIA_SERVICE_URL=http://localhost:3006
ANALYTICS_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3012

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000,https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# COST OPTIMIZATION SETTINGS
# ============================================================================
# API Caching
ENABLE_MODERATION_CACHING=true
AWS_REKOGNITION_CACHE_TTL=604800
AZURE_MODERATION_CACHE_TTL=604800
MODERATION_RESULT_CACHE_MAX_SIZE=50000

# Circuit Breaker for External Services
AWS_CIRCUIT_BREAKER_ENABLED=true
AWS_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AWS_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
AWS_CIRCUIT_BREAKER_TIMEOUT=20000
AWS_CIRCUIT_BREAKER_RESET_TIMEOUT=120000

AZURE_CIRCUIT_BREAKER_ENABLED=true
AZURE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AZURE_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
AZURE_CIRCUIT_BREAKER_TIMEOUT=20000
AZURE_CIRCUIT_BREAKER_RESET_TIMEOUT=120000

# Request Batching
MODERATION_BATCH_SIZE=10
MODERATION_BATCH_INTERVAL_MS=1000
MODERATION_QUEUE_CONCURRENCY=5

# Rate Limiting (per user)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MODERATION_MAX_REQUESTS=30
RATE_LIMIT_STANDARD_MAX_REQUESTS=60

# Graceful Degradation
ENABLE_GRACEFUL_DEGRADATION=true
AUTO_APPROVE_UNDER_HIGH_LOAD=false
QUEUE_NON_CRITICAL_UNDER_LOAD=true

# Content Hash-based Deduplication
ENABLE_CONTENT_HASH_DEDUPLICATION=true
CONTENT_HASH_CACHE_TTL=2592000

# Request Deduplication
ENABLE_REQUEST_DEDUPLICATION=true
DEDUPLICATION_WINDOW_MS=1000

# ============================================================================
# Timeouts
# ============================================================================
REQUEST_TIMEOUT_MS=30000
