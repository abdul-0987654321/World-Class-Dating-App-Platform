# ============================================================================
# PAYMENT SERVICE - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=payment-service
NODE_ENV=development
PORT=3005

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_payments
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_DEBUG=false

# Alternative: Full connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_payments

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=7
REDIS_URL=redis://localhost:6379/7

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================
JWT_ACCESS_SECRET=your-jwt-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================================
# Internal Service Authentication (REQUIRED)
# ============================================================================
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# ============================================================================
# Stripe Configuration (REQUIRED)
# ============================================================================
# Get these from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_API_VERSION=2024-12-18.acacia

# ============================================================================
# Service URLs (REQUIRED - Correct port assignments)
# ============================================================================
USER_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001
NOTIFICATION_SERVICE_URL=http://localhost:3012
ANALYTICS_SERVICE_URL=http://localhost:3007

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000,https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com

# ============================================================================
# Subscription Tiers
# ============================================================================
FREE_TIER_DAILY_LIKES=10
PREMIUM_TIER_PRICE=19.99
PREMIUM_TIER_DAILY_LIKES=100
ELITE_TIER_PRICE=39.99
ELITE_TIER_DAILY_LIKES=-1

# ============================================================================
# Payment Configuration
# ============================================================================
PAYMENT_CURRENCY=usd
TRIAL_PERIOD_DAYS=7

# ============================================================================
# Webhook Configuration
# ============================================================================
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAYS=60,300,900,3600,7200
PAYMENT_GRACE_PERIOD_DAYS=3
WEBHOOK_EVENT_RETENTION_DAYS=30

# ============================================================================
# Feature Flags
# ============================================================================
ENABLE_COIN_PURCHASES=true
ENABLE_BOOST_PURCHASES=true
ENABLE_SUBSCRIPTIONS=true
ENABLE_REFUNDS=true
ENABLE_PRORATED_REFUNDS=true

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# COST OPTIMIZATION SETTINGS
# ============================================================================
# Stripe API Caching
ENABLE_STRIPE_CACHING=true
STRIPE_CUSTOMER_CACHE_TTL=3600
STRIPE_SUBSCRIPTION_CACHE_TTL=300
STRIPE_PRICE_CACHE_TTL=86400
STRIPE_PRODUCT_CACHE_TTL=86400

# Circuit Breaker for Stripe API
STRIPE_CIRCUIT_BREAKER_ENABLED=true
STRIPE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
STRIPE_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=3
STRIPE_CIRCUIT_BREAKER_TIMEOUT=30000
STRIPE_CIRCUIT_BREAKER_RESET_TIMEOUT=180000

# Request Deduplication
ENABLE_PAYMENT_DEDUPLICATION=true
PAYMENT_DEDUPLICATION_WINDOW_MS=2000

# Rate Limiting (per user)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_PAYMENT_MAX_REQUESTS=10
RATE_LIMIT_STANDARD_MAX_REQUESTS=60

# Webhook Processing Optimization
WEBHOOK_BATCH_PROCESSING=true
WEBHOOK_BATCH_SIZE=50
WEBHOOK_BATCH_INTERVAL_MS=2000

# Graceful Degradation
ENABLE_GRACEFUL_DEGRADATION=true
DISABLE_COIN_PURCHASES_UNDER_LOAD=true
DISABLE_BOOST_PURCHASES_UNDER_LOAD=true

# ============================================================================
# Timeouts
# ============================================================================
REQUEST_TIMEOUT_MS=45000
