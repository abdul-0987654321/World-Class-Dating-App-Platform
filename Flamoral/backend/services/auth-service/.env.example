# ============================================================================
# AUTH SERVICE - Environment Variables
# ============================================================================
# Service Configuration
SERVICE_NAME=auth-service
NODE_ENV=development
PORT=3001

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_auth
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Alternative: Full connection string (if preferred over individual vars)
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flamoral_auth

# ============================================================================
# Redis Configuration
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# ============================================================================
# JWT Configuration (REQUIRED - NEVER USE DEFAULTS IN PRODUCTION)
# ============================================================================
# Generate secure secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: These MUST be set and be at least 32 characters long
JWT_ACCESS_SECRET=CHANGE_ME_TO_SECURE_64_CHARACTER_HEX_STRING_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_CHARACTER_HEX_STRING_MINIMUM_32_CHARS
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=flamoral-auth-service
JWT_AUDIENCE=flamoral-platform

# Enable JWT secret validation in development (recommended)
VALIDATE_JWT_SECRETS=true

# ============================================================================
# Internal Service Authentication (REQUIRED)
# ============================================================================
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars
INTERNAL_SERVICE_KEY=your-internal-service-api-key-min-32-chars

# ============================================================================
# Service URLs (REQUIRED - Correct port assignments)
# ============================================================================
USER_SERVICE_URL=http://localhost:3002
NOTIFICATION_SERVICE_URL=http://localhost:3012
ANALYTICS_SERVICE_URL=http://localhost:3007

# ============================================================================
# Frontend URLs (for redirects and email links)
# ============================================================================
FRONTEND_URL=http://localhost:3000
WEB_URL=https://flamoral.com
ADMIN_URL=https://admin.flamoral.com
API_URL=https://api.flamoral.com

# ============================================================================
# Email Configuration (SendGrid)
# ============================================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@flamoral.com
FROM_EMAIL=noreply@flamoral.com
FROM_NAME=Flamoral

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com

# ============================================================================
# Rate Limiting
# ============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ============================================================================
# Azure Key Vault (Production)
# ============================================================================
AZURE_KEY_VAULT_URL=https://flamoral-prod-kv.vault.azure.net/
KEY_VAULT_NAME=flamoral-prod-kv

# ============================================================================
# OAuth Configuration
# ============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://api.flamoral.com/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=https://api.flamoral.com/auth/facebook/callback

# Apple OAuth
APPLE_CLIENT_ID=com.flamoral.com
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=./config/apple-auth-key.p8
APPLE_CALLBACK_URL=https://api.flamoral.com/auth/apple/callback

# ============================================================================
# Security Configuration
# ============================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=900000

# ============================================================================
# Session Configuration
# ============================================================================
SESSION_SECRET=dev-session-secret-min-32-chars-here
SESSION_MAX_AGE=86400000

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info
