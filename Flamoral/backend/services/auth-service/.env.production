# =============================================================================
# AUTH SERVICE - Production Environment Configuration
# =============================================================================
# SECURITY: All secrets must be injected from Azure Key Vault
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=auth-service
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Database Configuration (Azure PostgreSQL)
# =============================================================================
DB_HOST=flamoral-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral_prod
DB_USER=flamoral_admin@flamoral-prod-postgres
DB_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20
DATABASE_URL=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
REDIS_DB=0
REDIS_TLS=true
REDIS_URL=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# JWT Configuration (CRITICAL - Must be 64+ characters)
# =============================================================================
JWT_ACCESS_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=flamoral-auth-service
JWT_AUDIENCE=flamoral-platform
JWT_ALGORITHM=HS256

# JWT Validation (Production - Strict)
VALIDATE_JWT_SECRETS=true

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=*** # INJECT FROM AZURE KEY VAULT
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# =============================================================================
# Password Security
# =============================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000
MFA_ENABLED=true
MFA_ISSUER=Flamoral

# =============================================================================
# Email Configuration (SendGrid)
# =============================================================================
SENDGRID_API_KEY=*** # INJECT FROM AZURE KEY VAULT
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=*** # INJECT FROM AZURE KEY VAULT (same as SENDGRID_API_KEY)
EMAIL_FROM=noreply@flamoral.com
SENDGRID_FROM_EMAIL=noreply@flamoral.com
SENDGRID_FROM_NAME=Flamoral

# Email Templates
SENDGRID_TEMPLATE_WELCOME=d-xxx
SENDGRID_TEMPLATE_VERIFICATION=d-xxx
SENDGRID_TEMPLATE_PASSWORD_RESET=d-xxx

# =============================================================================
# Frontend URLs
# =============================================================================
FRONTEND_URL=https://flamoral.com
WEB_URL=https://flamoral.com
ADMIN_URL=https://admin.flamoral.com
API_URL=https://api.flamoral.com

# =============================================================================
# OAuth Providers (Production)
# =============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=*** # INJECT FROM AZURE KEY VAULT
GOOGLE_CALLBACK_URL=https://api.flamoral.com/auth/google/callback
GOOGLE_OAUTH_ENABLED=true

# Facebook OAuth
FACEBOOK_APP_ID=your-production-facebook-app-id
FACEBOOK_APP_SECRET=*** # INJECT FROM AZURE KEY VAULT
FACEBOOK_CALLBACK_URL=https://api.flamoral.com/auth/facebook/callback
FACEBOOK_OAUTH_ENABLED=true

# Apple OAuth
APPLE_CLIENT_ID=com.flamoral.com
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=*** # INJECT FROM AZURE KEY VAULT
APPLE_PRIVATE_KEY_PATH=/etc/secrets/apple-auth-key.p8
APPLE_CALLBACK_URL=https://api.flamoral.com/auth/apple/callback
APPLE_OAUTH_ENABLED=true

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=10

# =============================================================================
# Azure Key Vault
# =============================================================================
KEY_VAULT_ENABLED=true
KEY_VAULT_NAME=flamoral-prod-kv
AZURE_KEY_VAULT_URL=https://flamoral-prod-kv.vault.azure.net/
KEY_VAULT_TENANT_ID=*** # INJECT FROM AZURE KEY VAULT
KEY_VAULT_CLIENT_ID=*** # INJECT FROM AZURE KEY VAULT
KEY_VAULT_CLIENT_SECRET=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=*** # INJECT FROM AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
ENABLE_METRICS=true

# Application Insights
APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# SMS Service - Twilio
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=*** # INJECT FROM AZURE KEY VAULT
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Security Headers
# =============================================================================
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
CSP_ENABLED=true

# =============================================================================
# Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live
