# =============================================================================
# API GATEWAY - Production Environment Configuration
# =============================================================================
# SECURITY: All secrets must be injected from Azure Key Vault
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=api-gateway
NODE_ENV=production
PORT=4000
HOST=0.0.0.0
# Note: GraphQL and WebSocket are served on the same port as REST API
GRAPHQL_PORT=4000
WS_PORT=4000

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
REDIS_DB=0
REDIS_TLS=true

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_ACCESS_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=flamoral-production
JWT_AUDIENCE=flamoral-app

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Internal Service URLs (Kubernetes Service Discovery)
# =============================================================================
AUTH_SERVICE_URL=http://auth-service.flamoral-prod.svc.cluster.local:3001
USER_SERVICE_URL=http://user-service.flamoral-prod.svc.cluster.local:3002
MATCHING_SERVICE_URL=http://matching-service.flamoral-prod.svc.cluster.local:3009
MESSAGING_SERVICE_URL=http://messaging-service.flamoral-prod.svc.cluster.local:3003
MODERATION_SERVICE_URL=http://moderation-service.flamoral-prod.svc.cluster.local:3008
PAYMENT_SERVICE_URL=http://payment-service.flamoral-prod.svc.cluster.local:3005
MEDIA_SERVICE_URL=http://media-service.flamoral-prod.svc.cluster.local:3006
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-prod.svc.cluster.local:3007
NOTIFICATION_SERVICE_URL=http://notification-service.flamoral-prod.svc.cluster.local:3012
ADMIN_SERVICE_URL=http://admin-service.flamoral-prod.svc.cluster.local:3013
ADVERTISING_SERVICE_URL=http://advertising-service.flamoral-prod.svc.cluster.local:3011
REALTIME_SERVICE_URL=http://realtime-service.flamoral-prod.svc.cluster.local:8081
AUTOMATION_SERVICE_URL=http://automation-service.flamoral-prod.svc.cluster.local:3014
WORKFLOW_ENGINE_URL=http://workflow-engine.flamoral-prod.svc.cluster.local:3015

# =============================================================================
# Frontend URLs
# =============================================================================
WEB_URL=https://flamoral.com
ADMIN_URL=https://admin.flamoral.com
API_URL=https://api.flamoral.com

# =============================================================================
# CORS Configuration (Strict Production) - CRITICAL for WebSocket
# =============================================================================
# Must include all frontend domains for Socket.IO to work properly
CORS_ORIGIN=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com,https://flamoral.vercel.app,https://*.flamoral.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400
CORS_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,X-API-Key,X-Request-ID,X-Correlation-ID

# =============================================================================
# Rate Limiting (Strict Production)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false
RATE_LIMIT_SKIP_FAILED_REQUESTS=false
RATE_LIMIT_HEADERS=true

# Endpoint-Specific Rate Limits
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=100
RATE_LIMIT_UPLOAD_MAX=20

# =============================================================================
# API Configuration
# =============================================================================
API_VERSION=v1
API_TIMEOUT=30000
API_MAX_BODY_SIZE=10mb

# GraphQL Configuration
GRAPHQL_PLAYGROUND_ENABLED=false
GRAPHQL_INTROSPECTION=false
GRAPHQL_DEPTH_LIMIT=10
GRAPHQL_COMPLEXITY_LIMIT=1000

# =============================================================================
# WebSocket Configuration - CRITICAL for real-time features
# =============================================================================
WS_PATH=/socket.io
WS_HEARTBEAT_INTERVAL=25000
WS_HEARTBEAT_TIMEOUT=60000
WS_MAX_CONNECTIONS_PER_USER=3
WS_RECONNECT_ATTEMPTS=5
WS_RECONNECT_DELAY=1000
# Must match CORS_ORIGIN for WebSocket connections to work
WS_CORS_ORIGIN=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com,https://flamoral.vercel.app,https://*.flamoral.com

# =============================================================================
# Circuit Breaker
# =============================================================================
ENABLE_CIRCUIT_BREAKER=true
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=30000
CIRCUIT_BREAKER_RESET_TIMEOUT=60000

# =============================================================================
# Security Headers
# =============================================================================
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
CSP_REPORT_URI=https://flamoral.report-uri.com/r/d/csp/enforce
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff
X_XSS_PROTECTION=1; mode=block
REFERRER_POLICY=strict-origin-when-cross-origin

# =============================================================================
# SSL/TLS Configuration
# =============================================================================
SSL_ENABLED=true
SSL_FORCE_HTTPS=true
TLS_MIN_VERSION=1.2

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=*** # INJECT FROM AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
ENABLE_METRICS=true
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
PROMETHEUS_PATH=/metrics

# Application Insights
APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_ROLE_NAME=api-gateway

# Distributed Tracing
ENABLE_TRACING=true
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=jaeger-agent.flamoral-prod.svc.cluster.local
JAEGER_AGENT_PORT=6831
JAEGER_SAMPLER_TYPE=probabilistic
JAEGER_SAMPLER_PARAM=0.1

# =============================================================================
# Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live

# =============================================================================
# Request Logging
# =============================================================================
ENABLE_REQUEST_LOGGING=true
LOG_REQUEST_BODY=false
LOG_RESPONSE_BODY=false
LOG_SENSITIVE_HEADERS=false

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_API_DOCS=false
ENABLE_SWAGGER=false
ENABLE_DEBUG_LOGGING=false
ENABLE_VERBOSE_ERRORS=false
