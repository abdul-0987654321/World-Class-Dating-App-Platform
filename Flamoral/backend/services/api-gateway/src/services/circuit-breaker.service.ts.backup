import { Injectable, Logger } from '@nestjs/common';
import { ConfigService } from '@nestjs/config';

export enum CircuitState {
  CLOSED = 'CLOSED', // Normal operation
  OPEN = 'OPEN', // Circuit is open, requests fail fast
  HALF_OPEN = 'HALF_OPEN', // Testing if service has recovered
}

export interface CircuitBreakerConfig {
  failureThreshold: number; // Number of failures before opening circuit
  failureRateThreshold: number; // Percentage of failures to trigger opening (0-100)
  successThreshold: number; // Number of successes needed to close circuit from half-open
  timeout: number; // Time in ms to wait before attempting half-open
  resetTimeout: number; // Time in ms to wait before resetting failure count
  minimumRequests: number; // Minimum requests in window before evaluating failure rate
  slowCallThreshold: number; // Response time in ms considered "slow"
  slowCallRateThreshold: number; // Percentage of slow calls to trigger opening
  halfOpenMaxCalls: number; // Max concurrent calls allowed in half-open state
  slidingWindowSize: number; // Number of calls in the sliding window
}

export interface CircuitStats {
  state: CircuitState;
  failures: number;
  successes: number;
  slowCalls: number;
  lastFailureTime: number;
  nextAttemptTime: number;
  totalRequests: number;
  totalFailures: number;
  totalSuccesses: number;
  totalSlowCalls: number;
  halfOpenCalls: number;
  consecutiveSuccesses: number;
  lastStateChange: number;
  responseTimesWindow: number[];
}

@Injectable()
export class CircuitBreakerService {
  private readonly logger = new Logger(CircuitBreakerService.name);
  private readonly circuits: Map<string, CircuitStats> = new Map();
  private readonly config: CircuitBreakerConfig;
  private readonly stateChangeCallbacks: Map<string, ((state: CircuitState, circuitKey: string) => void)[]> = new Map();

  constructor(private readonly configService: ConfigService) {
    // Production-grade circuit breaker configuration
    this.config = {
      // Failure thresholds - faster response to issues
      failureThreshold: parseInt(process.env.CIRCUIT_FAILURE_THRESHOLD, 10) || 5, // 5 failures (down from 10)
      failureRateThreshold: parseInt(process.env.CIRCUIT_FAILURE_RATE_THRESHOLD, 10) || 50, // 50% failure rate

      // Recovery settings - faster recovery
      successThreshold: parseInt(process.env.CIRCUIT_SUCCESS_THRESHOLD, 10) || 5,
      timeout: parseInt(process.env.CIRCUIT_TIMEOUT, 10) || 15000, // 15 seconds (down from 30s)
      resetTimeout: parseInt(process.env.CIRCUIT_RESET_TIMEOUT, 10) || 60000, // 60 seconds (down from 5 min)

      // Minimum volume to prevent trips on low traffic - lowered for faster evaluation
      minimumRequests: parseInt(process.env.CIRCUIT_MINIMUM_REQUESTS, 10) || 5,

      // Slow call detection
      slowCallThreshold: parseInt(process.env.CIRCUIT_SLOW_CALL_THRESHOLD, 10) || 5000, // 5 seconds
      slowCallRateThreshold: parseInt(process.env.CIRCUIT_SLOW_CALL_RATE_THRESHOLD, 10) || 80, // 80% slow calls

      // Half-open state - gradual recovery
      halfOpenMaxCalls: parseInt(process.env.CIRCUIT_HALF_OPEN_MAX_CALLS, 10) || 10,

      // Sliding window for failure rate calculation
      slidingWindowSize: parseInt(process.env.CIRCUIT_SLIDING_WINDOW_SIZE, 10) || 100,
    };

    this.logger.log(`Circuit breaker initialized with config: ${JSON.stringify(this.config)}`);
  }

  /**
   * Register callback for state changes (useful for alerting)
   */
  onStateChange(circuitKey: string, callback: (state: CircuitState, circuitKey: string) => void): void {
    if (!this.stateChangeCallbacks.has(circuitKey)) {
      this.stateChangeCallbacks.set(circuitKey, []);
    }
    this.stateChangeCallbacks.get(circuitKey)!.push(callback);
  }

  /**
   * Notify all registered callbacks of state change
   */
  private notifyStateChange(circuitKey: string, newState: CircuitState): void {
    const callbacks = this.stateChangeCallbacks.get(circuitKey) || [];
    callbacks.forEach(cb => {
      try {
        cb(newState, circuitKey);
      } catch (e) {
        this.logger.error(`Error in state change callback for ${circuitKey}:`, e);
      }
    });
  }

  /**
   * Execute a function with circuit breaker protection
   * Now includes response time tracking and gradual half-open recovery
   */
  async execute<T>(
    circuitKey: string,
    fn: () => Promise<T>,
    fallback?: () => Promise<T>,
  ): Promise<T> {
    const circuit = this.getCircuit(circuitKey);
    const now = Date.now();

    // Check if circuit is open
    if (circuit.state === CircuitState.OPEN) {
      // Check if it's time to attempt half-open
      if (now >= circuit.nextAttemptTime) {
        this.transitionTo(circuitKey, CircuitState.HALF_OPEN);
      } else {
        // Circuit is still open, fail fast
        this.logger.debug(`Circuit ${circuitKey} is OPEN, failing fast (retry in ${Math.ceil((circuit.nextAttemptTime - now) / 1000)}s)`);

        if (fallback) {
          return fallback();
        }

        const error = new Error(`Service ${circuitKey} is currently unavailable`);
        (error as any).circuitBreakerOpen = true;
        (error as any).retryAfter = Math.ceil((circuit.nextAttemptTime - now) / 1000);
        throw error;
      }
    }

    // Check half-open concurrency limit
    if (circuit.state === CircuitState.HALF_OPEN) {
      if (circuit.halfOpenCalls >= this.config.halfOpenMaxCalls) {
        this.logger.debug(`Circuit ${circuitKey} HALF_OPEN max calls reached, failing fast`);

        if (fallback) {
          return fallback();
        }

        const error = new Error(`Service ${circuitKey} is recovering, please retry`);
        (error as any).circuitBreakerHalfOpen = true;
        throw error;
      }
      circuit.halfOpenCalls++;
    }

    circuit.totalRequests++;
    const startTime = Date.now();

    try {
      // Execute the function
      const result = await fn();
      const responseTime = Date.now() - startTime;

      // Track response time
      this.trackResponseTime(circuitKey, responseTime);

      // Success
      this.onSuccess(circuitKey, responseTime);

      if (circuit.state === CircuitState.HALF_OPEN) {
        circuit.halfOpenCalls--;
      }

      return result;
    } catch (error) {
      const responseTime = Date.now() - startTime;

      // Track response time even for failures
      this.trackResponseTime(circuitKey, responseTime);

      // Failure
      this.onFailure(circuitKey, error as Error);

      if (circuit.state === CircuitState.HALF_OPEN) {
        circuit.halfOpenCalls--;
      }

      // Only use fallback for circuit-related failures or if error is retryable
      if (fallback && this.shouldUseFallback(error as Error)) {
        this.logger.warn(`Circuit ${circuitKey} executing fallback due to: ${(error as Error).message}`);
        return fallback();
      }

      throw error;
    }
  }

  /**
   * Track response time in sliding window
   */
  private trackResponseTime(circuitKey: string, responseTime: number): void {
    const circuit = this.getCircuit(circuitKey);

    circuit.responseTimesWindow.push(responseTime);

    // Keep only the last N response times
    if (circuit.responseTimesWindow.length > this.config.slidingWindowSize) {
      circuit.responseTimesWindow.shift();
    }

    // Track slow calls
    if (responseTime >= this.config.slowCallThreshold) {
      circuit.slowCalls++;
      circuit.totalSlowCalls++;
    }
  }

  /**
   * Determine if fallback should be used for this error
   */
  private shouldUseFallback(error: Error): boolean {
    // Always use fallback for these cases
    if ((error as any).circuitBreakerOpen || (error as any).circuitBreakerHalfOpen) {
      return true;
    }

    // Use fallback for network/timeout errors
    const retryableErrors = [
      'ECONNREFUSED', 'ETIMEDOUT', 'ENOTFOUND', 'ESOCKETTIMEDOUT',
      'ECONNRESET', 'EAI_AGAIN', 'EPIPE', 'EHOSTUNREACH'
    ];

    if ((error as any).code && retryableErrors.includes((error as any).code)) {
      return true;
    }

    // Use fallback for 5xx errors (server errors)
    if ((error as any).statusCode && (error as any).statusCode >= 500) {
      return true;
    }

    return false;
  }

  /**
   * Transition circuit to new state
   */
  private transitionTo(circuitKey: string, newState: CircuitState): void {
    const circuit = this.getCircuit(circuitKey);
    const oldState = circuit.state;

    if (oldState === newState) return;

    circuit.state = newState;
    circuit.lastStateChange = Date.now();

    if (newState === CircuitState.HALF_OPEN) {
      circuit.halfOpenCalls = 0;
      circuit.consecutiveSuccesses = 0;
      this.logger.log(`Circuit ${circuitKey} entering HALF_OPEN state after ${this.config.timeout}ms - attempting recovery with ${this.config.halfOpenMaxCalls} max concurrent calls`);
    } else if (newState === CircuitState.CLOSED) {
      circuit.failures = 0;
      circuit.slowCalls = 0;
      circuit.consecutiveSuccesses = 0;
      const metrics = this.getCircuitMetrics(circuitKey);
      this.logger.log(`Circuit ${circuitKey} CLOSED - service recovered successfully! Metrics: failureRate=${metrics.failureRate.toFixed(1)}%, uptime=${metrics.uptime.toFixed(1)}%, avgResponseTime=${metrics.avgResponseTime.toFixed(0)}ms`);
    } else if (newState === CircuitState.OPEN) {
      circuit.nextAttemptTime = Date.now() + this.config.timeout;
      const metrics = this.getCircuitMetrics(circuitKey);
      this.logger.warn(`Circuit ${circuitKey} OPENED - failing fast for ${this.config.timeout}ms. Failures: ${circuit.failures}, FailureRate: ${metrics.failureRate.toFixed(1)}%, SlowCallRate: ${metrics.slowCallRate.toFixed(1)}%`);

      // Schedule automatic transition to half-open with recovery logging
      setTimeout(() => {
        const currentCircuit = this.getCircuit(circuitKey);
        if (currentCircuit.state === CircuitState.OPEN && Date.now() >= currentCircuit.nextAttemptTime) {
          this.logger.log(`Circuit ${circuitKey} timeout expired, automatically attempting recovery`);
          this.transitionTo(circuitKey, CircuitState.HALF_OPEN);
        }
      }, this.config.timeout + 100);
    }

    this.notifyStateChange(circuitKey, newState);
  }

  /**
   * Handle successful execution
   */
  private onSuccess(circuitKey: string, responseTime: number): void {
    const circuit = this.getCircuit(circuitKey);
    circuit.totalSuccesses++;
    circuit.successes++;
    circuit.consecutiveSuccesses++;

    if (circuit.state === CircuitState.HALF_OPEN) {
      // Need consecutive successes to close circuit - properly testing recovery
      this.logger.debug(`Circuit ${circuitKey} HALF_OPEN success (${circuit.consecutiveSuccesses}/${this.config.successThreshold}), responseTime: ${responseTime}ms`);

      if (circuit.consecutiveSuccesses >= this.config.successThreshold) {
        this.logger.log(`Circuit ${circuitKey} closing after ${circuit.consecutiveSuccesses} consecutive successes in HALF_OPEN state - recovery confirmed`);
        this.transitionTo(circuitKey, CircuitState.CLOSED);
      }
    } else if (circuit.state === CircuitState.CLOSED) {
      // Gradual reset of failure count (don't reset immediately)
      if (circuit.consecutiveSuccesses > 5) {
        circuit.failures = Math.max(0, circuit.failures - 1);
      }
    }
  }

  /**
   * Handle failed execution
   */
  private onFailure(circuitKey: string, error: Error): void {
    const circuit = this.getCircuit(circuitKey);
    const now = Date.now();

    // Don't count client errors (4xx) as circuit breaker failures
    if ((error as any).statusCode && (error as any).statusCode >= 400 && (error as any).statusCode < 500) {
      // Client error - don't count against circuit breaker
      this.logger.debug(`Circuit ${circuitKey}: Client error (${(error as any).statusCode}) not counted as failure`);
      return;
    }

    circuit.failures++;
    circuit.totalFailures++;
    circuit.lastFailureTime = now;
    circuit.consecutiveSuccesses = 0;

    if (circuit.state === CircuitState.HALF_OPEN) {
      // In half-open, a single failure with tolerance
      // Only reopen if we have had multiple recent failures
      if (circuit.failures >= 2) {
        this.logger.warn(`Circuit ${circuitKey} failed ${circuit.failures} times in HALF_OPEN, reopening circuit`);
        this.transitionTo(circuitKey, CircuitState.OPEN);
      } else {
        this.logger.warn(`Circuit ${circuitKey} had failure in HALF_OPEN (${circuit.failures}/${2}), continuing recovery attempt`);
      }
    } else if (circuit.state === CircuitState.CLOSED) {
      // Check if we should open the circuit
      if (this.shouldOpenCircuit(circuitKey)) {
        const failureRate = this.calculateFailureRate(circuitKey);
        const slowCallRate = this.calculateSlowCallRate(circuitKey);
        this.logger.error(
          `Circuit ${circuitKey} opening: failures=${circuit.failures}, failureRate=${failureRate.toFixed(1)}%, slowCallRate=${slowCallRate.toFixed(1)}%`,
        );
        this.transitionTo(circuitKey, CircuitState.OPEN);
      }
    }
  }

  /**
   * Determine if circuit should open based on failure rate and minimum requests
   */
  private shouldOpenCircuit(circuitKey: string): boolean {
    const circuit = this.getCircuit(circuitKey);

    // Must have minimum requests before evaluating
    if (circuit.totalRequests < this.config.minimumRequests) {
      return false;
    }

    // Check absolute failure threshold
    if (circuit.failures >= this.config.failureThreshold) {
      return true;
    }

    // Check failure rate in sliding window
    const failureRate = this.calculateFailureRate(circuitKey);
    if (failureRate >= this.config.failureRateThreshold) {
      return true;
    }

    // Check slow call rate
    const slowCallRate = this.calculateSlowCallRate(circuitKey);
    if (slowCallRate >= this.config.slowCallRateThreshold) {
      return true;
    }

    return false;
  }

  /**
   * Calculate failure rate in sliding window
   */
  private calculateFailureRate(circuitKey: string): number {
    const circuit = this.getCircuit(circuitKey);

    if (circuit.totalRequests === 0) return 0;

    // Use recent requests for calculation
    const recentTotal = Math.min(circuit.totalRequests, this.config.slidingWindowSize);
    const recentFailures = Math.min(circuit.failures, recentTotal);

    return (recentFailures / recentTotal) * 100;
  }

  /**
   * Calculate slow call rate in sliding window
   */
  private calculateSlowCallRate(circuitKey: string): number {
    const circuit = this.getCircuit(circuitKey);

    if (circuit.responseTimesWindow.length === 0) return 0;

    const slowCalls = circuit.responseTimesWindow.filter(
      t => t >= this.config.slowCallThreshold
    ).length;

    return (slowCalls / circuit.responseTimesWindow.length) * 100;
  }

  /**
   * Get or create a circuit
   */
  private getCircuit(circuitKey: string): CircuitStats {
    if (!this.circuits.has(circuitKey)) {
      this.circuits.set(circuitKey, {
        state: CircuitState.CLOSED,
        failures: 0,
        successes: 0,
        slowCalls: 0,
        lastFailureTime: 0,
        nextAttemptTime: 0,
        totalRequests: 0,
        totalFailures: 0,
        totalSuccesses: 0,
        totalSlowCalls: 0,
        halfOpenCalls: 0,
        consecutiveSuccesses: 0,
        lastStateChange: Date.now(),
        responseTimesWindow: [],
      });
    }

    return this.circuits.get(circuitKey)!;
  }

  /**
   * Get circuit status
   */
  getCircuitStatus(circuitKey: string): CircuitStats {
    return this.getCircuit(circuitKey);
  }

  /**
   * Get all circuits status
   */
  getAllCircuitsStatus(): Record<string, CircuitStats> {
    const status: Record<string, CircuitStats> = {};

    this.circuits.forEach((circuit, key) => {
      status[key] = { ...circuit };
    });

    return status;
  }

  /**
   * Reset a circuit manually (admin function)
   */
  resetCircuit(circuitKey: string): void {
    this.logger.log(`Manually resetting circuit ${circuitKey}`);
    this.circuits.delete(circuitKey);
  }

  /**
   * Reset all circuits (admin function)
   */
  resetAllCircuits(): void {
    this.logger.log('Manually resetting all circuits');
    this.circuits.clear();
  }

  /**
   * Get circuit metrics for monitoring
   */
  getCircuitMetrics(circuitKey: string): {
    state: CircuitState;
    totalRequests: number;
    totalFailures: number;
    totalSuccesses: number;
    totalSlowCalls: number;
    failureRate: number;
    slowCallRate: number;
    uptime: number;
    avgResponseTime: number;
    p95ResponseTime: number;
    lastStateChange: number;
    timeInCurrentState: number;
  } {
    const circuit = this.getCircuit(circuitKey);
    const responseTimes = circuit.responseTimesWindow;

    // Calculate average response time
    const avgResponseTime = responseTimes.length > 0
      ? responseTimes.reduce((a, b) => a + b, 0) / responseTimes.length
      : 0;

    // Calculate p95 response time
    const sortedTimes = [...responseTimes].sort((a, b) => a - b);
    const p95Index = Math.floor(sortedTimes.length * 0.95);
    const p95ResponseTime = sortedTimes.length > 0 ? sortedTimes[p95Index] || sortedTimes[sortedTimes.length - 1] : 0;

    return {
      state: circuit.state,
      totalRequests: circuit.totalRequests,
      totalFailures: circuit.totalFailures,
      totalSuccesses: circuit.totalSuccesses,
      totalSlowCalls: circuit.totalSlowCalls,
      failureRate: this.calculateFailureRate(circuitKey),
      slowCallRate: this.calculateSlowCallRate(circuitKey),
      uptime:
        circuit.totalRequests > 0
          ? (circuit.totalSuccesses / circuit.totalRequests) * 100
          : 100,
      avgResponseTime,
      p95ResponseTime,
      lastStateChange: circuit.lastStateChange,
      timeInCurrentState: Date.now() - circuit.lastStateChange,
    };
  }

  /**
   * Force close a circuit (for emergency recovery)
   */
  forceClose(circuitKey: string): void {
    this.logger.warn(`Force closing circuit ${circuitKey}`);
    this.transitionTo(circuitKey, CircuitState.CLOSED);
  }

  /**
   * Force open a circuit (for maintenance)
   */
  forceOpen(circuitKey: string): void {
    this.logger.warn(`Force opening circuit ${circuitKey}`);
    this.transitionTo(circuitKey, CircuitState.OPEN);
  }

  /**
   * Get circuit breaker configuration
   */
  getConfig(): CircuitBreakerConfig {
    return { ...this.config };
  }

  /**
   * Check if circuit allows requests (for quick checks without executing)
   */
  isAllowed(circuitKey: string): boolean {
    const circuit = this.getCircuit(circuitKey);

    if (circuit.state === CircuitState.CLOSED) {
      return true;
    }

    if (circuit.state === CircuitState.OPEN) {
      return Date.now() >= circuit.nextAttemptTime;
    }

    // HALF_OPEN - check concurrency limit
    return circuit.halfOpenCalls < this.config.halfOpenMaxCalls;
  }

  /**
   * Get health summary for all circuits
   */
  getHealthSummary(): {
    healthy: number;
    degraded: number;
    unhealthy: number;
    circuits: Record<string, { state: CircuitState; failureRate: number }>;
  } {
    let healthy = 0;
    let degraded = 0;
    let unhealthy = 0;
    const circuits: Record<string, { state: CircuitState; failureRate: number }> = {};

    this.circuits.forEach((circuit, key) => {
      const failureRate = this.calculateFailureRate(key);
      circuits[key] = { state: circuit.state, failureRate };

      if (circuit.state === CircuitState.CLOSED && failureRate < 10) {
        healthy++;
      } else if (circuit.state === CircuitState.HALF_OPEN || (circuit.state === CircuitState.CLOSED && failureRate >= 10)) {
        degraded++;
      } else {
        unhealthy++;
      }
    });

    return { healthy, degraded, unhealthy, circuits };
  }
}
