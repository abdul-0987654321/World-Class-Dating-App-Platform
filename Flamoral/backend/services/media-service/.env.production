# =============================================================================
# MEDIA SERVICE - Production Environment Configuration
# =============================================================================
# SECURITY: All secrets must be injected from Azure Key Vault
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Service Configuration
# =============================================================================
SERVICE_NAME=media-service
NODE_ENV=production
PORT=3006
HOST=0.0.0.0

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Database Configuration (Azure PostgreSQL)
# =============================================================================
DB_HOST=flamoral-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral_media
DB_USER=flamoral_admin@flamoral-prod-postgres
DB_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20
DATABASE_URL=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Redis Configuration (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # INJECT FROM AZURE KEY VAULT
REDIS_DB=4
REDIS_TLS=true

# =============================================================================
# JWT Configuration
# =============================================================================
JWT_ACCESS_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # INJECT FROM AZURE KEY VAULT - Min 64 chars

# =============================================================================
# Internal Service URLs (Kubernetes Service Discovery)
# =============================================================================
USER_SERVICE_URL=http://user-service.flamoral-prod.svc.cluster.local:3002
AUTH_SERVICE_URL=http://auth-service.flamoral-prod.svc.cluster.local:3001
MODERATION_SERVICE_URL=http://moderation-service.flamoral-prod.svc.cluster.local:3008
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-prod.svc.cluster.local:3007

# =============================================================================
# Azure Storage (Media Files)
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoralprodst
AZURE_STORAGE_KEY=*** # INJECT FROM AZURE KEY VAULT
AZURE_STORAGE_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT

# Blob Containers
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos
AZURE_STORAGE_CONTAINER_AVATARS=avatars
AZURE_STORAGE_CONTAINER_THUMBNAILS=thumbnails

# CDN Configuration
CDN_ENABLED=true
CDN_URL=https://cdn.flamoral.com
AZURE_STORAGE_CDN_ENABLED=true
AZURE_STORAGE_CDN_ENDPOINT=https://cdn.flamoral.com

# =============================================================================
# Azure Cognitive Services
# =============================================================================
# Computer Vision (Image Analysis)
AZURE_COMPUTER_VISION_KEY=*** # INJECT FROM AZURE KEY VAULT
AZURE_COMPUTER_VISION_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# Face API (Photo Verification)
AZURE_FACE_API_KEY=*** # INJECT FROM AZURE KEY VAULT
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# Content Moderator (Content Safety)
AZURE_CONTENT_MODERATOR_KEY=*** # INJECT FROM AZURE KEY VAULT
AZURE_CONTENT_MODERATOR_ENDPOINT=https://eastus.api.cognitive.microsoft.com
CONTENT_MODERATION_ENABLED=true
AUTO_REJECT_THRESHOLD=0.90
AUTO_FLAG_THRESHOLD=0.70

# =============================================================================
# File Upload Configuration
# =============================================================================
# Upload Limits
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800
MAX_DOCUMENT_SIZE=5242880

# Allowed File Types
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/heic
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime,video/x-msvideo
ALLOWED_DOCUMENT_TYPES=application/pdf

# Upload Security
UPLOAD_VIRUS_SCAN_ENABLED=true
UPLOAD_CONTENT_MODERATION_ENABLED=true
UPLOAD_EXIF_STRIP_ENABLED=true

# =============================================================================
# Image Processing
# =============================================================================
IMAGE_QUALITY=80
THUMBNAIL_WIDTH=200
THUMBNAIL_HEIGHT=200
MEDIUM_WIDTH=800
MEDIUM_HEIGHT=800
LARGE_WIDTH=1920
LARGE_HEIGHT=1920

# =============================================================================
# Azure Service Bus (Message Queue)
# =============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
QUEUE_MEDIA_PROCESSING=media_processing_queue
QUEUE_MODERATION=moderation_queue

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://admin.flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_UPLOAD_MAX=20

# =============================================================================
# Monitoring & Observability
# =============================================================================
SENTRY_DSN=*** # INJECT FROM AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
ENABLE_METRICS=true

APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # INJECT FROM AZURE KEY VAULT
APPLICATION_INSIGHTS_INSTRUMENTATION_KEY=*** # INJECT FROM AZURE KEY VAULT

# =============================================================================
# Health Checks
# =============================================================================
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH=/health
READINESS_CHECK_PATH=/ready
LIVENESS_CHECK_PATH=/live
