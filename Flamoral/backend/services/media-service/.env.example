# ============================================================================
# MEDIA SERVICE - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=media-service
PORT=3006
NODE_ENV=development

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================
JWT_ACCESS_SECRET=your-jwt-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================================
# Internal Service Authentication (REQUIRED)
# ============================================================================
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# ============================================================================
# Database Configuration (PostgreSQL)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_media
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Alternative: Full connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_media

# ============================================================================
# Redis Configuration (for Bull queue and caching)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=3
REDIS_URL=redis://localhost:6379/3

# ============================================================================
# Azure Storage Configuration
# ============================================================================
AZURE_STORAGE_ACCOUNT_NAME=flamoralprodst
AZURE_STORAGE_ACCOUNT_KEY=your-storage-account-key
AZURE_CONTAINER_NAME=media
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos
AZURE_CDN_URL=https://cdn.flamoral.com
AZURE_STORAGE_CDN_ENDPOINT=https://cdn.flamoral.com

# Azure Storage CORS Configuration
AZURE_STORAGE_CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com
AZURE_STORAGE_CORS_MAX_AGE=3600

# ============================================================================
# Azure Computer Vision
# ============================================================================
AZURE_CV_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
AZURE_CV_API_KEY=your-computer-vision-api-key

# ============================================================================
# Azure Face API (Photo Verification)
# ============================================================================
AZURE_FACE_API_KEY=your-face-api-key-here
AZURE_FACE_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# Photo Verification Thresholds (0.0 - 1.0)
FACE_MATCH_THRESHOLD=0.7
LIVENESS_THRESHOLD=0.6
QUALITY_THRESHOLD=0.5

# ============================================================================
# Verification Queue Configuration
# ============================================================================
VERIFICATION_QUEUE_NAME=photo-verification
VERIFICATION_QUEUE_CONCURRENCY=5
VERIFICATION_MAX_RETRIES=3
VERIFICATION_RETRY_DELAY_MS=5000

# ============================================================================
# Upload Configuration
# ============================================================================
MAX_FILE_SIZE=10485760
MAX_PHOTOS_PER_USER=9

# Image Processing Configuration
IMAGE_OUTPUT_FORMAT=webp
ENABLE_WEBP=true

# ============================================================================
# Content Moderation Thresholds (0.0 - 1.0)
# ============================================================================
ADULT_CONTENT_THRESHOLD=0.7
RACY_CONTENT_THRESHOLD=0.6
VIOLENCE_CONTENT_THRESHOLD=0.7

# ============================================================================
# Service URLs (REQUIRED)
# ============================================================================
USER_SERVICE_URL=http://localhost:3002
MODERATION_SERVICE_URL=http://localhost:3008
ANALYTICS_SERVICE_URL=http://localhost:3007

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000,https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# COST OPTIMIZATION SETTINGS
# ============================================================================
# API Caching
ENABLE_API_CACHING=true
AZURE_FACE_CACHE_TTL=86400
AZURE_CV_CACHE_TTL=86400
CONTENT_MODERATION_CACHE_TTL=604800
CACHE_MAX_SIZE=10000

# Circuit Breaker
CIRCUIT_BREAKER_ENABLED=true
AZURE_CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
AZURE_CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
AZURE_CIRCUIT_BREAKER_TIMEOUT=20000
AZURE_CIRCUIT_BREAKER_RESET_TIMEOUT=120000

# Request Batching
IMAGE_PROCESSING_BATCH_SIZE=5
VIDEO_PROCESSING_BATCH_SIZE=2
THUMBNAIL_PROCESSING_BATCH_SIZE=10

# Rate Limiting (per user)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_UPLOAD_MAX_REQUESTS=10
RATE_LIMIT_STANDARD_MAX_REQUESTS=60

# Graceful Degradation
ENABLE_GRACEFUL_DEGRADATION=true
CPU_THRESHOLD_DEGRADATION=80
MEMORY_THRESHOLD_DEGRADATION=85

# Lazy Processing
ENABLE_LAZY_PROCESSING=true
DEFER_IMAGE_OPTIMIZATION=true
DEFER_VARIANT_GENERATION=true
DEFER_THUMBNAILS=false

# Request Deduplication
ENABLE_REQUEST_DEDUPLICATION=true
DEDUPLICATION_WINDOW_MS=1000

# ============================================================================
# Timeouts
# ============================================================================
REQUEST_TIMEOUT_MS=60000
