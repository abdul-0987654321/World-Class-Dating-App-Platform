# Media Service Test Environment
NODE_ENV=test
PORT=3005
LOG_LEVEL=error

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=media_service_test
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=1

# JWT
JWT_ACCESS_SECRET=test-secret-key

# Azure Storage
AZURE_STORAGE_ACCOUNT_NAME=teststorage
AZURE_STORAGE_ACCOUNT_KEY=test-key
AZURE_CONTAINER_NAME=test-container
AZURE_CDN_URL=https://test-cdn.azureedge.net

# Azure Computer Vision
AZURE_CV_ENDPOINT=https://test.api.cognitive.microsoft.com/
AZURE_CV_API_KEY=test-cv-key

# Upload Limits
MAX_FILE_SIZE=10485760
MAX_PHOTOS_PER_USER=9
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# Services
USER_SERVICE_URL=http://localhost:3002
MODERATION_SERVICE_URL=http://localhost:3009
