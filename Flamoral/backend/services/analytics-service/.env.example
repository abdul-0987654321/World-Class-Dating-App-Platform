# ============================================================================
# ANALYTICS SERVICE - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=analytics-service
NODE_ENV=development
PORT=3007

# ============================================================================
# JWT Configuration (REQUIRED)
# ============================================================================
JWT_ACCESS_SECRET=your-jwt-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars

# ============================================================================
# Internal Service Authentication (REQUIRED)
# ============================================================================
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# ============================================================================
# Database Configuration (PostgreSQL - for analytics data storage)
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_analytics
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=5
DB_POOL_MAX=20

# Alternative: Full connection string
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_analytics

# ============================================================================
# TimescaleDB Extension (for time-series data)
# ============================================================================
ENABLE_TIMESCALEDB=true

# ============================================================================
# Redis Configuration (for caching and real-time aggregations)
# ============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=6
REDIS_URL=redis://localhost:6379/6

# ============================================================================
# ClickHouse (Optional - for high-performance analytics)
# ============================================================================
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
ENABLE_CLICKHOUSE=false

# ============================================================================
# Event Queue Configuration
# ============================================================================
EVENT_QUEUE_TYPE=redis
# For Kafka (if enabled):
# KAFKA_BROKERS=localhost:9092
# KAFKA_CLIENT_ID=analytics-service
# KAFKA_GROUP_ID=analytics-consumer-group
# For RabbitMQ (if enabled):
# RABBITMQ_URL=amqp://localhost:5672

# ============================================================================
# Service URLs (REQUIRED - Correct port assignments)
# ============================================================================
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3009
MESSAGING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
AUTH_SERVICE_URL=http://localhost:3001
MODERATION_SERVICE_URL=http://localhost:3008
NOTIFICATION_SERVICE_URL=http://localhost:3012
MEDIA_SERVICE_URL=http://localhost:3006

# ============================================================================
# CORS Configuration
# ============================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com

# ============================================================================
# Analytics Configuration
# ============================================================================
EVENT_BATCH_SIZE=1000
EVENT_FLUSH_INTERVAL_MS=5000
DATA_RETENTION_DAYS=365
AGGREGATION_INTERVAL_MINUTES=5

# ============================================================================
# Metrics Collection
# ============================================================================
COLLECT_USER_EVENTS=true
COLLECT_MATCH_EVENTS=true
COLLECT_MESSAGE_EVENTS=true
COLLECT_PAYMENT_EVENTS=true
COLLECT_PERFORMANCE_METRICS=true

# ============================================================================
# Real-time Analytics
# ============================================================================
ENABLE_REALTIME_DASHBOARD=true
REALTIME_UPDATE_INTERVAL_MS=10000

# ============================================================================
# Data Warehouse Integration (Optional)
# ============================================================================
ENABLE_DATA_WAREHOUSE=false
# WAREHOUSE_TYPE=bigquery
# BIGQUERY_PROJECT_ID=your-project-id
# BIGQUERY_DATASET=analytics
# BIGQUERY_CREDENTIALS_PATH=./config/bigquery-credentials.json

# ============================================================================
# Reporting
# ============================================================================
DAILY_REPORT_ENABLED=true
WEEKLY_REPORT_ENABLED=true
MONTHLY_REPORT_ENABLED=true
REPORT_TIMEZONE=America/New_York

# ============================================================================
# A/B Testing
# ============================================================================
ENABLE_AB_TESTING=true
AB_TEST_SAMPLE_RATE=0.1

# ============================================================================
# Machine Learning Integration
# ============================================================================
ENABLE_ML_PREDICTIONS=false
ML_MODEL_ENDPOINT=http://localhost:5000/predict

# ============================================================================
# ADVERTISING TRACKING INTEGRATIONS
# ============================================================================
# Meta Pixel & Conversions API (Facebook/Instagram)
META_PIXEL_ID=your_meta_pixel_id
META_CAPI_ACCESS_TOKEN=your_meta_capi_access_token
META_TEST_EVENT_CODE=TEST12345

# Google Analytics 4 & Measurement Protocol
GA4_MEASUREMENT_ID=G-XXXXXXXXXX
GA4_API_SECRET=your_ga4_api_secret

# TikTok Pixel & Events API
TIKTOK_PIXEL_ID=your_tiktok_pixel_id
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token
TIKTOK_TEST_EVENT_CODE=TEST67890

# Snapchat Pixel & Conversions API
SNAPCHAT_PIXEL_ID=your_snapchat_pixel_id
SNAPCHAT_API_TOKEN=your_snapchat_api_token
SNAPCHAT_TEST_MODE=false

# Google Ads Conversion Tracking
GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXXXX
GOOGLE_ADS_REGISTRATION_LABEL=AbC-D1eFGHiJk2LMno
GOOGLE_ADS_PURCHASE_LABEL=XyZ-A1bCDefGhIjKl2
GOOGLE_ADS_SIGNUP_LABEL=PqR-S1tUVwXyZ0AbC1

# ============================================================================
# Logging
# ============================================================================
LOG_LEVEL=info

# ============================================================================
# Worker Configuration
# ============================================================================
WORKER_CONCURRENCY=10
PROCESSING_TIMEOUT_MS=30000

# ============================================================================
# Timeouts
# ============================================================================
REQUEST_TIMEOUT_MS=30000
SERVICE_TIMEOUT=30000
