# Server Configuration
# Note: Port 3011 is used by Advertising Service. Using 3013 for Workflow Engine
NODE_ENV=development
PORT=3013

# Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=workflow_engine_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_SYNCHRONIZE=true
DATABASE_LOGGING=true

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_QUEUE_PREFIX=flamoral_

# JWT Configuration (for admin authentication)
JWT_SECRET=your-workflow-jwt-secret
JWT_ACCESS_SECRET=your-workflow-access-secret

# Service URLs (Correct port assignments)
NOTIFICATION_SERVICE_URL=http://localhost:3012
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3009
PAYMENT_SERVICE_URL=http://localhost:3005
AUTH_SERVICE_URL=http://localhost:3001
MESSAGING_SERVICE_URL=http://localhost:3004
MEDIA_SERVICE_URL=http://localhost:3006
ANALYTICS_SERVICE_URL=http://localhost:3007
MODERATION_SERVICE_URL=http://localhost:3008
ADMIN_SERVICE_URL=http://localhost:3010
ADVERTISING_SERVICE_URL=http://localhost:3011

# CORS - Include production domains
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com

# Internal Service Key
INTERNAL_SERVICE_KEY=internal-service-key

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_INITIAL_DELAY=1000
RETRY_MAX_DELAY=30000
RETRY_BACKOFF_FACTOR=2

# Workflow Execution
WORKFLOW_EXECUTION_TIMEOUT=300000
WORKFLOW_PARALLEL_LIMIT=10

# Logging
LOG_LEVEL=info
LOG_FORMAT=json

# Health Check
HEALTH_CHECK_INTERVAL=30000
