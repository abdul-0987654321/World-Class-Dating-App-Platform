# Server Configuration
PORT=8081
ENVIRONMENT=development
LOG_LEVEL=info

# Allowed CORS Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_ISSUER=heartly
JWT_EXPIRATION=15m

# WebSocket Configuration
WS_READ_BUFFER_SIZE=1024
WS_WRITE_BUFFER_SIZE=1024
WS_MAX_MESSAGE_SIZE=524288
WS_PONG_WAIT=60s
WS_PING_PERIOD=54s
WS_WRITE_WAIT=10s
WS_HANDSHAKE_TIMEOUT=10s

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=1m

# Presence Configuration
PRESENCE_TTL=5m
PRESENCE_HEARTBEAT=30s

# Typing Configuration
TYPING_TIMEOUT=5s

# ============================================================================
# COST OPTIMIZATION SETTINGS - WebSocket Connections
# ============================================================================

# Connection Pool Optimization
WS_MAX_CONNECTIONS=10000                # Maximum concurrent connections
WS_IDLE_TIMEOUT=5m                      # Close idle connections after 5 minutes
WS_HEARTBEAT_INTERVAL=30s               # Heartbeat every 30 seconds
WS_HEARTBEAT_TIMEOUT=60s                # Timeout after 60 seconds
WS_CONNECTION_DRAIN_TIME=30s            # Graceful shutdown time

# Message Compression - Reduce bandwidth costs
WS_COMPRESSION_ENABLED=true
WS_COMPRESSION_THRESHOLD=1024           # Compress messages > 1KB
WS_COMPRESSION_LEVEL=6                  # Balanced compression (1-9)

# Message Batching - Reduce message overhead
WS_BATCHING_ENABLED=true
WS_BATCH_SIZE=10                        # Batch up to 10 messages
WS_BATCH_INTERVAL=100ms                 # 100ms batch window
WS_MAX_BATCH_WAIT=500ms                 # Maximum 500ms wait

# Presence Optimization - Reduce update frequency
WS_PRESENCE_THROTTLE=30s                # Update presence every 30s max
WS_PRESENCE_BATCH=true
WS_PRESENCE_BATCH_INTERVAL=5s           # Batch presence updates every 5s

# Rate Limiting per Connection
WS_MESSAGE_RATE_LIMIT=60                # 60 messages per minute
WS_RATE_LIMIT_WINDOW=1m

# Memory Optimization
WS_MESSAGE_BUFFER_SIZE=256
WS_READ_BUFFER_SIZE=4096
WS_WRITE_BUFFER_SIZE=4096
WS_MAX_MESSAGE_QUEUE=100
WS_MESSAGE_POOLING=true                 # Enable message pooling

# Auto-Scaling Triggers
WS_CPU_SCALE_THRESHOLD=75.0             # Scale at 75% CPU
WS_MEMORY_SCALE_THRESHOLD=80.0          # Scale at 80% memory
WS_CONNECTIONS_PER_INSTANCE=5000        # Connections per instance before scaling

# Circuit Breaker for External Services
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_SUCCESS_THRESHOLD=2
CIRCUIT_BREAKER_TIMEOUT=30s
CIRCUIT_BREAKER_RESET_TIMEOUT=60s
