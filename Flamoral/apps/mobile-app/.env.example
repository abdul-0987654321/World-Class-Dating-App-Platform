# Flamoral Mobile App Environment Configuration

# API Configuration
API_BASE_URL=http://localhost:4000
WEBSOCKET_URL=ws://localhost:4000

# AI Services (for development, point to local or staging)
FRAUD_DETECTION_URL=http://localhost:5001/fraud
NLP_SERVICE_URL=http://localhost:5001/nlp
PHOTO_ANALYSIS_URL=http://localhost:5001/photos
RECOMMENDATION_URL=http://localhost:5001/recommendations

# Messaging Service
EXPO_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:3004

# App Configuration
APP_NAME=Flamoral
APP_VERSION=1.0.0
BUNDLE_ID=com.flamoral.app

# External Services
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key

# Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# Feature Flags
ENABLE_VIDEO_CALLS=true
ENABLE_EVENTS=true
ENABLE_AI_FEATURES=true
ENABLE_ENCRYPTION=true

# Sentry (Error Tracking)
SENTRY_DSN=

# Debug Settings
DEBUG_MODE=true
LOG_LEVEL=debug
