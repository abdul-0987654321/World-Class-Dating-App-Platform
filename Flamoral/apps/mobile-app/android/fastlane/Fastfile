# Fastfile for Flamoral Android App
# This file contains the fastlane.tools configuration

default_platform(:android)

platform :android do

  # ========================================
  # LANES
  # ========================================

  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Build a debug APK"
  lane :build_debug do
    gradle(
      task: "assemble",
      build_type: "Debug"
    )
  end

  desc "Build a release APK"
  lane :build_release do
    gradle(
      task: "assemble",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["FLAMORAL_UPLOAD_STORE_FILE"],
        "android.injected.signing.store.password" => ENV["FLAMORAL_UPLOAD_STORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["FLAMORAL_UPLOAD_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["FLAMORAL_UPLOAD_KEY_PASSWORD"],
      }
    )
  end

  desc "Build an Android App Bundle (AAB) for release"
  lane :build_bundle do
    gradle(
      task: "bundle",
      build_type: "Release",
      properties: {
        "android.injected.signing.store.file" => ENV["FLAMORAL_UPLOAD_STORE_FILE"],
        "android.injected.signing.store.password" => ENV["FLAMORAL_UPLOAD_STORE_PASSWORD"],
        "android.injected.signing.key.alias" => ENV["FLAMORAL_UPLOAD_KEY_ALIAS"],
        "android.injected.signing.key.password" => ENV["FLAMORAL_UPLOAD_KEY_PASSWORD"],
      }
    )
  end

  desc "Deploy a new version to the Google Play Store (internal track)"
  lane :deploy_internal do
    build_bundle
    upload_to_play_store(
      track: 'internal',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_screenshots: true,
      skip_upload_images: true,
      skip_upload_metadata: false
    )
  end

  desc "Deploy a new version to the Google Play Store (alpha track)"
  lane :deploy_alpha do
    build_bundle
    upload_to_play_store(
      track: 'alpha',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_screenshots: true,
      skip_upload_images: true,
      skip_upload_metadata: false
    )
  end

  desc "Deploy a new version to the Google Play Store (beta track)"
  lane :deploy_beta do
    build_bundle
    upload_to_play_store(
      track: 'beta',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_screenshots: false,
      skip_upload_images: false,
      skip_upload_metadata: false
    )
  end

  desc "Deploy a new version to the Google Play Store (production)"
  lane :deploy_production do
    build_bundle
    upload_to_play_store(
      track: 'production',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_screenshots: false,
      skip_upload_images: false,
      skip_upload_metadata: false,
      release_status: 'completed'
    )
  end

  desc "Promote internal build to alpha"
  lane :promote_internal_to_alpha do
    upload_to_play_store(
      track: 'internal',
      track_promote_to: 'alpha',
      skip_upload_changelogs: true
    )
  end

  desc "Promote alpha build to beta"
  lane :promote_alpha_to_beta do
    upload_to_play_store(
      track: 'alpha',
      track_promote_to: 'beta',
      skip_upload_changelogs: true
    )
  end

  desc "Promote beta build to production"
  lane :promote_beta_to_production do
    upload_to_play_store(
      track: 'beta',
      track_promote_to: 'production',
      skip_upload_changelogs: true,
      release_status: 'completed'
    )
  end

  desc "Submit a new build and metadata to Google Play Store"
  lane :deploy do
    # Increment version code
    increment_version_code(
      gradle_file_path: "app/build.gradle"
    )

    # Build the release AAB
    build_bundle

    # Upload to Play Store
    upload_to_play_store(
      track: 'internal',
      aab: lane_context[SharedValues::GRADLE_AAB_OUTPUT_PATH],
      skip_upload_apk: true,
      skip_upload_screenshots: false,
      skip_upload_images: false,
      skip_upload_metadata: false
    )

    # Notify team
    slack(
      message: "Successfully deployed Flamoral Android to Play Store Internal Track! 🚀",
      success: true
    ) if ENV["SLACK_URL"]
  end

  desc "Take screenshots for all device types"
  lane :screenshots do
    capture_android_screenshots(
      locales: ["en-US"],
      clear_previous_screenshots: true,
      app_apk_path: "app/build/outputs/apk/debug/app-debug.apk",
      tests_apk_path: "app/build/outputs/apk/androidTest/debug/app-debug-androidTest.apk"
    )
  end

  desc "Upload metadata and screenshots to Play Store"
  lane :upload_metadata do
    upload_to_play_store(
      skip_upload_apk: true,
      skip_upload_aab: true,
      skip_upload_screenshots: false,
      skip_upload_images: false,
      skip_upload_metadata: false
    )
  end

  # ========================================
  # ERROR HANDLING
  # ========================================

  error do |lane, exception|
    slack(
      message: "Flamoral Android lane '#{lane}' failed: #{exception}",
      success: false
    ) if ENV["SLACK_URL"]
  end

end
