{
  "name": "Flamoral",
  "displayName": "Flamoral",
  "version": "1.0.0",
  "build": "1",
  "slug": "flamoral",
  "description": "Where Passion Meets Connection - A modern dating app for meaningful relationships",
  "privacy": "https://flamoral.com/privacy",
  "termsOfService": "https://flamoral.com/terms",
  "support": "https://flamoral.com/support",
  "contact": "support@flamoral.com",
  "orientation": "portrait",
  "platforms": ["ios", "android"],
  "primaryColor": "#FF6B6B",
  "backgroundColor": "#FFFFFF",
  "icon": "./assets/icon.png",
  "splash": {
    "image": "./assets/splash.png",
    "resizeMode": "contain",
    "backgroundColor": "#FF6B6B"
  },
  "updates": {
    "fallbackToCacheTimeout": 0
  },
  "assetBundlePatterns": [
    "assets/**/*"
  ],
  "ios": {
    "bundleIdentifier": "com.flamoral.app",
    "buildNumber": "1",
    "supportsTablet": false,
    "requireFullScreen": true,
    "infoPlist": {
      "NSCameraUsageDescription": "We need access to your camera to take profile photos and verify your identity",
      "NSPhotoLibraryUsageDescription": "We need access to your photo library to upload profile photos",
      "NSPhotoLibraryAddUsageDescription": "We need access to save photos to your library",
      "NSLocationWhenInUseUsageDescription": "We use your location to show you matches nearby",
      "NSLocationAlwaysUsageDescription": "We use your location to show you matches nearby and update your location in the background",
      "NSMicrophoneUsageDescription": "We need access to your microphone for video calls and voice messages",
      "NSUserNotificationsUsageDescription": "Get notified when you have new matches and messages",
      "NSFaceIDUsageDescription": "Use Face ID to securely log in to your account",
      "NSContactsUsageDescription": "Find friends who are already on Flamoral"
    },
    "config": {
      "usesNonExemptEncryption": false
    },
    "associatedDomains": [
      "applinks:flamoral.com",
      "applinks:www.flamoral.com"
    ],
    "entitlements": {
      "com.apple.developer.associated-domains": [
        "applinks:flamoral.com",
        "applinks:www.flamoral.com"
      ]
    }
  },
  "android": {
    "package": "com.flamoral.app",
    "versionCode": 1,
    "googleServicesFile": "./google-services.json",
    "icon": "./assets/icon.png",
    "adaptiveIcon": {
      "foregroundImage": "./assets/adaptive-icon.png",
      "backgroundColor": "#FFFFFF"
    },
    "permissions": [
      "CAMERA",
      "READ_MEDIA_IMAGES",
      "READ_EXTERNAL_STORAGE",
      "WRITE_EXTERNAL_STORAGE",
      "ACCESS_FINE_LOCATION",
      "ACCESS_COARSE_LOCATION",
      "POST_NOTIFICATIONS",
      "INTERNET",
      "ACCESS_NETWORK_STATE",
      "VIBRATE",
      "RECORD_AUDIO",
      "MODIFY_AUDIO_SETTINGS",
      "USE_BIOMETRIC",
      "USE_FINGERPRINT"
    ],
    "intentFilters": [
      {
        "action": "VIEW",
        "autoVerify": true,
        "data": [
          {
            "scheme": "https",
            "host": "flamoral.com",
            "pathPrefix": "/"
          },
          {
            "scheme": "flamoral"
          }
        ],
        "category": [
          "BROWSABLE",
          "DEFAULT"
        ]
      }
    ],
    "compileSdkVersion": 34,
    "targetSdkVersion": 34,
    "minSdkVersion": 23
  },
  "notification": {
    "icon": "./assets/notification-icon.png",
    "color": "#FF6B6B",
    "androidMode": "default",
    "androidCollapsedTitle": "#{unread_notifications} new notifications"
  },
  "ratingRequired": true,
  "contentRating": "MATURE_17_PLUS",
  "ageRating": "17+",
  "category": "SOCIAL",
  "keywords": [
    "dating",
    "relationships",
    "social",
    "matches",
    "chat",
    "connection"
  ]
}
