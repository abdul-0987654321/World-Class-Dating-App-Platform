# ============================================================================
# Flamoral Mobile App - Development Environment Configuration
# ============================================================================

# ============================================================================
# API & Backend Configuration
# ============================================================================

# Main API Gateway (development environment)
API_BASE_URL=http://localhost:4000

# WebSocket URL for real-time features (messaging, notifications, presence)
WEBSOCKET_URL=ws://localhost:4000

# GraphQL endpoint (if using GraphQL)
GRAPHQL_URL=http://localhost:4000/graphql

# ============================================================================
# AI Services Configuration
# ============================================================================

# AI Fraud Detection Service
FRAUD_DETECTION_URL=http://localhost:5001/fraud

# Natural Language Processing Service
NLP_SERVICE_URL=http://localhost:5001/nlp

# Photo Analysis Service (AI-powered photo moderation)
PHOTO_ANALYSIS_URL=http://localhost:5001/photos

# Recommendation Engine
RECOMMENDATION_URL=http://localhost:5001/recommendations

# ============================================================================
# Messaging Service
# ============================================================================
EXPO_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:3004

# ============================================================================
# Application Configuration
# ============================================================================
APP_NAME=Flamoral Dev
APP_VERSION=1.0.0
APP_ENV=development

# Bundle identifiers
BUNDLE_ID=com.flamoral.dev
IOS_BUNDLE_ID=com.flamoral.dev
ANDROID_PACKAGE=com.flamoral.dev

# Deep linking
DEEP_LINK_SCHEME=flamoral-dev
UNIVERSAL_LINK_DOMAIN=dev.flamoral.local

# ============================================================================
# External Services & API Keys (Use TEST/DEV keys)
# ============================================================================

# Stripe Payment Processing (Test Keys)
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key
STRIPE_MERCHANT_ID=merchant.com.flamoral.dev

# Google Maps (for location features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Agora (Video/Voice Calling)
AGORA_APP_ID=your_agora_dev_app_id

# Tenor GIF API
TENOR_API_KEY=your_tenor_api_key

# Giphy API (alternative to Tenor)
GIPHY_API_KEY=your_giphy_api_key

# ============================================================================
# Push Notifications (Firebase Development)
# ============================================================================
FIREBASE_PROJECT_ID=your_firebase_dev_project_id
FIREBASE_API_KEY=your_firebase_dev_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_dev_auth_domain.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_firebase_dev_storage_bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_dev_messaging_sender_id
FIREBASE_APP_ID=your_firebase_dev_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_dev_measurement_id

# iOS Push Certificates
FIREBASE_IOS_CLIENT_ID=your_firebase_dev_ios_client_id
FIREBASE_IOS_REVERSED_CLIENT_ID=your_firebase_dev_ios_reversed_client_id

# Android FCM
FIREBASE_ANDROID_CLIENT_ID=your_firebase_dev_android_client_id

# ============================================================================
# Social Login Configuration (Development Apps)
# ============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_dev_client_id
GOOGLE_IOS_CLIENT_ID=your_google_dev_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_dev_android_client_id

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_dev_app_id
FACEBOOK_CLIENT_TOKEN=your_facebook_dev_client_token
FACEBOOK_DISPLAY_NAME=Flamoral Dev

# Apple Sign In
APPLE_SERVICE_ID=your_apple_dev_service_id

# ============================================================================
# Analytics & Monitoring
# ============================================================================

# Google Analytics for Firebase
GA_MEASUREMENT_ID=G-DEV_ID

# Mixpanel (Product Analytics)
MIXPANEL_TOKEN=your_mixpanel_dev_token

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dev_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Amplitude (User Analytics)
AMPLITUDE_API_KEY=your_amplitude_dev_api_key

# ============================================================================
# SSL Certificate Pinning (Disabled for local development)
# ============================================================================

# SSL Certificates (Leave empty for local development)
SSL_PINS_API_FLAMORAL=
SSL_PINS_BACKUP=

# ============================================================================
# Feature Flags (Enable all for testing)
# ============================================================================

# Core Features
ENABLE_VIDEO_CALLS=true
ENABLE_VOICE_CALLS=true
ENABLE_EVENTS=true
ENABLE_AI_FEATURES=true
ENABLE_STORIES=true
ENABLE_TRAVEL_MODE=true

# Premium Features
ENABLE_PREMIUM_SUBSCRIPTIONS=true
ENABLE_BOOSTS=true
ENABLE_SUPER_LIKES=true
ENABLE_VIRTUAL_GIFTS=true

# Safety Features
ENABLE_PHOTO_VERIFICATION=true
ENABLE_ID_VERIFICATION=true
ENABLE_BACKGROUND_CHECKS=true
ENABLE_ENCRYPTION=true

# Native Features
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true

# Experimental Features
ENABLE_GAMIFICATION=true
ENABLE_AI_COACH=true
ENABLE_AR_FEATURES=true
ENABLE_BLOCKCHAIN_VERIFICATION=false

# ============================================================================
# In-App Purchases (Development Product IDs)
# ============================================================================

# iOS Product IDs
IOS_PRODUCT_ID_PREMIUM_MONTHLY=com.flamoral.dev.premium.monthly
IOS_PRODUCT_ID_PREMIUM_YEARLY=com.flamoral.dev.premium.yearly
IOS_PRODUCT_ID_COINS_SMALL=com.flamoral.dev.coins.small
IOS_PRODUCT_ID_COINS_MEDIUM=com.flamoral.dev.coins.medium
IOS_PRODUCT_ID_COINS_LARGE=com.flamoral.dev.coins.large

# Android Product IDs
ANDROID_PRODUCT_ID_PREMIUM_MONTHLY=com.flamoral.dev.premium.monthly
ANDROID_PRODUCT_ID_PREMIUM_YEARLY=com.flamoral.dev.premium.yearly

# ============================================================================
# Debug & Development Options
# ============================================================================
DEBUG_MODE=true
LOG_LEVEL=debug
ENABLE_DEBUG_MENU=true
ENABLE_FLIPPER=true

# ============================================================================
# Performance Configuration
# ============================================================================

# API timeouts (in milliseconds)
API_TIMEOUT=30000
UPLOAD_TIMEOUT=120000
AI_ANALYSIS_TIMEOUT=60000

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=1000
BACKOFF_MULTIPLIER=2

# Image optimization
IMAGE_QUALITY=80
IMAGE_MAX_SIZE=5242880
ENABLE_IMAGE_COMPRESSION=true

# ============================================================================
# Security Configuration
# ============================================================================

# Encryption keys (stored securely in Keychain/Keystore)
ENCRYPTION_KEY_ALIAS=flamoral_dev_encryption_key

# Secure storage
USE_KEYCHAIN=true
USE_KEYSTORE=true

# Certificate pinning (disabled for local dev)
ENABLE_SSL_PINNING=false
SSL_PINNING_MODE=permissive

# Root detection (disabled for dev)
ENABLE_ROOT_DETECTION=false
ENABLE_JAILBREAK_DETECTION=false

# ============================================================================
# Localization
# ============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh
DATE_FORMAT=MM/DD/YYYY
TIME_FORMAT=12h

# ============================================================================
# CDN Configuration
# ============================================================================
CDN_URL=http://localhost:4000/cdn
MEDIA_CDN_URL=http://localhost:4000/media

# ============================================================================
# API Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=false
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW=60000

# ============================================================================
# Offline Mode
# ============================================================================
ENABLE_OFFLINE_MODE=true
OFFLINE_CACHE_SIZE=52428800
OFFLINE_CACHE_DURATION=86400000

# ============================================================================
# Legal & Compliance
# ============================================================================
TERMS_URL=http://localhost:4000/terms
PRIVACY_URL=http://localhost:4000/privacy
COOKIE_POLICY_URL=http://localhost:4000/cookies
COMMUNITY_GUIDELINES_URL=http://localhost:4000/guidelines

# ============================================================================
# Contact & Support
# ============================================================================
SUPPORT_EMAIL=dev@flamoral.local
SUPPORT_URL=http://localhost:4000/support
HELP_CENTER_URL=http://localhost:4000/help

# ============================================================================
# Code Push (Development Deployment)
# ============================================================================
CODEPUSH_DEPLOYMENT_KEY_IOS=your_codepush_dev_ios_key
CODEPUSH_DEPLOYMENT_KEY_ANDROID=your_codepush_dev_android_key

# ============================================================================
# NOTES FOR DEVELOPERS:
# ============================================================================
# 1. Copy this file to .env for local development
# 2. Replace placeholder values with actual development keys
# 3. Never commit .env to version control
# 4. Use localhost or 10.0.2.2 (Android emulator) for local API
# 5. SSL pinning is disabled for local development
# 6. All debug features are enabled
# 7. Use test API keys for external services
