{
  "name": "@flamoral/mobile",
  "version": "1.0.0",
  "description": "Flamoral Mobile App - Where Passion Meets Connection (iOS & Android)",
  "main": "index.js",
  "scripts": {
    "android": "react-native run-android",
    "android:dev": "ENVFILE=.env react-native run-android",
    "android:staging": "ENVFILE=.env.staging react-native run-android --variant=release",
    "android:prod": "ENVFILE=.env.production react-native run-android --variant=release",
    "android:build": "cd android && ./gradlew assembleRelease",
    "android:build:dev": "cd android && ./gradlew assembleDebug",
    "android:bundle": "cd android && ./gradlew bundleRelease",
    "ios": "react-native run-ios",
    "ios:dev": "ENVFILE=.env react-native run-ios",
    "ios:staging": "ENVFILE=.env.staging react-native run-ios --configuration Release",
    "ios:prod": "ENVFILE=.env.production react-native run-ios --configuration Release",
    "ios:device": "react-native run-ios --device",
    "ios:build": "cd ios && xcodebuild -workspace FlavoralApp.xcworkspace -scheme FlavoralApp -configuration Release archive",
    "start": "react-native start",
    "start:reset": "react-native start --reset-cache",
    "build": "echo 'Mobile app builds via native tooling. Use android:build or ios:build'",
    "clean": "rimraf android/build ios/build",
    "clean:deep": "cd ios && xcodebuild clean && cd ../android && ./gradlew clean",
    "clean:all": "rimraf node_modules && rimraf android/build ios/build && rimraf ios/Pods",
    "pod-install": "cd ios && pod install",
    "pod-install:update": "cd ios && pod install --repo-update",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\"",
    "postinstall": "cd ios && pod install || true"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-native-community/geolocation": "^3.2.1",
    "@react-navigation/bottom-tabs": "^6.5.11",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "@reduxjs/toolkit": "^2.0.1",
    "axios": "^1.7.9",
    "buffer": "^6.0.3",
    "expo-crypto": "^13.0.2",
    "expo-secure-store": "^13.0.2",
    "react": "18.2.0",
    "react-native": "0.73.0",
    "react-native-agora": "^4.2.6",
    "react-native-background-timer": "^2.4.1",
    "react-native-callkeep": "^4.3.12",
    "react-native-fast-image": "^8.6.3",
    "react-native-gesture-handler": "^2.14.0",
    "react-native-image-picker": "^7.1.0",
    "react-native-libsodium": "^0.9.0",
    "react-native-permissions": "^4.0.3",
    "react-native-quick-crypto": "^0.7.0",
    "react-native-reanimated": "^3.6.0",
    "react-native-safe-area-context": "^4.8.0",
    "react-native-screens": "^3.29.0",
    "react-native-vector-icons": "^10.0.2",
    "react-native-voip-push-notification": "^3.3.2",
    "react-redux": "^9.0.4",
    "redux-persist": "^6.0.0",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@babel/core": "^7.23.5",
    "@babel/preset-env": "^7.23.5",
    "@babel/runtime": "^7.23.5",
    "@react-native/babel-preset": "^0.73.19",
    "@react-native/eslint-config": "^0.73.1",
    "@react-native/metro-config": "^0.73.3",
    "@react-native/typescript-config": "^0.73.1",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/react": "^18.2.42",
    "@types/react-test-renderer": "^18.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "babel-jest": "^29.7.0",
    "babel-plugin-module-resolver": "^5.0.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "jest": "^29.7.0",
    "metro-react-native-babel-preset": "^0.77.0",
    "prettier": "^3.1.1",
    "react-native-dotenv": "^3.4.9",
    "react-test-renderer": "18.2.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "jest": {
    "preset": "react-native",
    "passWithNoTests": true
  }
}
