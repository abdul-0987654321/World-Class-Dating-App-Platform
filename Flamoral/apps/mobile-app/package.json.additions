{
  "// REQUIRED DEPENDENCIES FOR PUSH NOTIFICATIONS": "Add these to your package.json dependencies",
  "dependencies": {
    "@react-native-firebase/app": "^18.7.0",
    "@react-native-firebase/messaging": "^18.7.0",
    "@notifee/react-native": "^7.8.0",
    "@react-native-async-storage/async-storage": "^1.21.0",
    "@react-navigation/native": "^6.1.9",
    "@react-navigation/stack": "^6.3.20",
    "react-native-permissions": "^3.10.1"
  },
  "devDependencies": {
    "@types/react-native": "^0.72.0"
  },
  "// SETUP INSTRUCTIONS": [
    "1. Install dependencies: npm install",
    "2. For iOS:",
    "   - cd ios && pod install",
    "   - Add GoogleService-Info.plist to ios/FlavoralApp/",
    "   - Enable Push Notifications capability in Xcode",
    "   - Add APNs key to Apple Developer Portal",
    "3. For Android:",
    "   - Add google-services.json to android/app/",
    "   - Update android/build.gradle with classpath 'com.google.gms:google-services:4.3.15'",
    "   - Add apply plugin: 'com.google.gms.google-services' to android/app/build.gradle",
    "4. Configure Firebase project with FCM and add Android/iOS apps",
    "5. Update notification service backend with Firebase service account"
  ]
}
