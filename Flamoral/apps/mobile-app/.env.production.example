# ============================================================================
# Flamoral Mobile App - Production Environment Configuration
# ============================================================================

# ============================================================================
# API & Backend Configuration
# ============================================================================

# Main API Gateway (all requests go through this)
API_BASE_URL=https://api.flamoral.com

# WebSocket URL for real-time features (messaging, notifications, presence)
WEBSOCKET_URL=wss://api.flamoral.com

# GraphQL endpoint (if using GraphQL)
GRAPHQL_URL=https://api.flamoral.com/graphql

# ============================================================================
# AI Services Configuration
# ============================================================================

# AI Fraud Detection Service
FRAUD_DETECTION_URL=https://ai.flamoral.com/fraud

# Natural Language Processing Service
NLP_SERVICE_URL=https://ai.flamoral.com/nlp

# Photo Analysis Service (AI-powered photo moderation)
PHOTO_ANALYSIS_URL=https://ai.flamoral.com/photos

# Recommendation Engine
RECOMMENDATION_URL=https://ai.flamoral.com/recommendations

# ============================================================================
# Messaging Service
# ============================================================================
EXPO_PUBLIC_MESSAGING_SERVICE_URL=https://messaging.flamoral.com

# ============================================================================
# Application Configuration
# ============================================================================
APP_NAME=Flamoral
APP_VERSION=1.0.0
APP_ENV=production

# Bundle identifiers
BUNDLE_ID=com.flamoral.app
IOS_BUNDLE_ID=com.flamoral.app
ANDROID_PACKAGE=com.flamoral.app

# Deep linking
DEEP_LINK_SCHEME=flamoral
UNIVERSAL_LINK_DOMAIN=flamoral.com

# ============================================================================
# External Services & API Keys
# ============================================================================

# Stripe Payment Processing (Production Keys)
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_MERCHANT_ID=merchant.com.flamoral.app

# Google Maps (for location features)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Agora (Video/Voice Calling)
AGORA_APP_ID=your_agora_app_id

# Tenor GIF API
TENOR_API_KEY=your_tenor_api_key

# Giphy API (alternative to Tenor)
GIPHY_API_KEY=your_giphy_api_key

# ============================================================================
# Push Notifications (Firebase)
# ============================================================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id

# iOS Push Certificates
FIREBASE_IOS_CLIENT_ID=your_firebase_ios_client_id
FIREBASE_IOS_REVERSED_CLIENT_ID=your_firebase_ios_reversed_client_id

# Android FCM
FIREBASE_ANDROID_CLIENT_ID=your_firebase_android_client_id

# ============================================================================
# Social Login Configuration
# ============================================================================

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_CLIENT_TOKEN=your_facebook_client_token
FACEBOOK_DISPLAY_NAME=Flamoral

# Apple Sign In
APPLE_SERVICE_ID=your_apple_service_id

# ============================================================================
# Analytics & Monitoring
# ============================================================================

# Google Analytics for Firebase
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel (Product Analytics)
MIXPANEL_TOKEN=your_mixpanel_token

# Sentry (Error Tracking)
SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# Amplitude (User Analytics)
AMPLITUDE_API_KEY=your_amplitude_api_key

# ============================================================================
# SSL Certificate Pinning
# ============================================================================

# SSL Certificates (Base64 encoded public keys for certificate pinning)
# Generate with: openssl s_client -servername api.flamoral.com -connect api.flamoral.com:443 | openssl x509 -pubkey -noout | openssl rsa -pubin -outform der | openssl dgst -sha256 -binary | openssl enc -base64
SSL_PINS_API_FLAMORAL=sha256/AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=,sha256/BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=

# Backup pins (in case primary cert rotates)
SSL_PINS_BACKUP=sha256/CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC=

# ============================================================================
# Feature Flags
# ============================================================================

# Core Features
ENABLE_VIDEO_CALLS=true
ENABLE_VOICE_CALLS=true
ENABLE_EVENTS=true
ENABLE_AI_FEATURES=true
ENABLE_STORIES=true
ENABLE_TRAVEL_MODE=true

# Premium Features
ENABLE_PREMIUM_SUBSCRIPTIONS=true
ENABLE_BOOSTS=true
ENABLE_SUPER_LIKES=true
ENABLE_VIRTUAL_GIFTS=true

# Safety Features
ENABLE_PHOTO_VERIFICATION=true
ENABLE_ID_VERIFICATION=true
ENABLE_BACKGROUND_CHECKS=true
ENABLE_ENCRYPTION=true

# Native Features
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true

# Experimental Features
ENABLE_GAMIFICATION=true
ENABLE_AI_COACH=true
ENABLE_AR_FEATURES=false
ENABLE_BLOCKCHAIN_VERIFICATION=false

# ============================================================================
# In-App Purchases (IAP)
# ============================================================================

# iOS Product IDs
IOS_PRODUCT_ID_PREMIUM_MONTHLY=com.flamoral.app.premium.monthly
IOS_PRODUCT_ID_PREMIUM_YEARLY=com.flamoral.app.premium.yearly
IOS_PRODUCT_ID_COINS_SMALL=com.flamoral.app.coins.small
IOS_PRODUCT_ID_COINS_MEDIUM=com.flamoral.app.coins.medium
IOS_PRODUCT_ID_COINS_LARGE=com.flamoral.app.coins.large

# Android Product IDs (same format typically)
ANDROID_PRODUCT_ID_PREMIUM_MONTHLY=com.flamoral.app.premium.monthly
ANDROID_PRODUCT_ID_PREMIUM_YEARLY=com.flamoral.app.premium.yearly

# ============================================================================
# Debug & Development Options (Should be FALSE in production)
# ============================================================================
DEBUG_MODE=false
LOG_LEVEL=error
ENABLE_DEBUG_MENU=false
ENABLE_FLIPPER=false

# ============================================================================
# Performance Configuration
# ============================================================================

# API timeouts (in milliseconds)
API_TIMEOUT=30000
UPLOAD_TIMEOUT=120000
AI_ANALYSIS_TIMEOUT=60000

# Retry configuration
MAX_RETRIES=3
RETRY_DELAY=1000
BACKOFF_MULTIPLIER=2

# Image optimization
IMAGE_QUALITY=80
IMAGE_MAX_SIZE=5242880
ENABLE_IMAGE_COMPRESSION=true

# ============================================================================
# Security Configuration
# ============================================================================

# Encryption keys (stored securely in Keychain/Keystore)
# DO NOT hardcode actual encryption keys here
ENCRYPTION_KEY_ALIAS=flamoral_encryption_key

# Secure storage
USE_KEYCHAIN=true
USE_KEYSTORE=true

# Certificate pinning
ENABLE_SSL_PINNING=true
SSL_PINNING_MODE=strict

# Root detection
ENABLE_ROOT_DETECTION=true
ENABLE_JAILBREAK_DETECTION=true

# ============================================================================
# Localization
# ============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh
DATE_FORMAT=MM/DD/YYYY
TIME_FORMAT=12h

# ============================================================================
# CDN Configuration
# ============================================================================
CDN_URL=https://cdn.flamoral.com
MEDIA_CDN_URL=https://media.flamoral.com

# ============================================================================
# API Rate Limiting (Client-side awareness)
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# ============================================================================
# Offline Mode
# ============================================================================
ENABLE_OFFLINE_MODE=true
OFFLINE_CACHE_SIZE=52428800
OFFLINE_CACHE_DURATION=86400000

# ============================================================================
# Legal & Compliance
# ============================================================================
TERMS_URL=https://flamoral.com/terms
PRIVACY_URL=https://flamoral.com/privacy
COOKIE_POLICY_URL=https://flamoral.com/cookies
COMMUNITY_GUIDELINES_URL=https://flamoral.com/guidelines

# ============================================================================
# Contact & Support
# ============================================================================
SUPPORT_EMAIL=support@flamoral.com
SUPPORT_URL=https://flamoral.com/support
HELP_CENTER_URL=https://help.flamoral.com

# ============================================================================
# Code Push (Over-the-air updates)
# ============================================================================
CODEPUSH_DEPLOYMENT_KEY_IOS=your_codepush_ios_key
CODEPUSH_DEPLOYMENT_KEY_ANDROID=your_codepush_android_key

# ============================================================================
# NOTES:
# ============================================================================
# 1. Never commit actual production keys to version control
# 2. Use secure storage mechanisms (iOS Keychain, Android Keystore)
# 3. Generate SSL pins using the script in scripts/generate-ssl-pins.sh
# 4. Test certificate pinning thoroughly before production release
# 5. Keep backup SSL pins in case of certificate rotation
# 6. Enable root/jailbreak detection in production builds
# 7. Use Code Push for hot fixes without app store approval
# 8. Test all payment flows thoroughly before production
# 9. Ensure proper error reporting is configured (Sentry)
# 10. Test offline mode and sync functionality
