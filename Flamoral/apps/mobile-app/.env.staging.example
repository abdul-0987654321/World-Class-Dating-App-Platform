# ============================================================================
# Flamoral Mobile App - Staging Environment Configuration
# ============================================================================

# ============================================================================
# API & Backend Configuration
# ============================================================================
API_BASE_URL=https://api-staging.flamoral.com
WEBSOCKET_URL=wss://api-staging.flamoral.com
GRAPHQL_URL=https://api-staging.flamoral.com/graphql

# ============================================================================
# AI Services Configuration
# ============================================================================
FRAUD_DETECTION_URL=https://ai-staging.flamoral.com/fraud
NLP_SERVICE_URL=https://ai-staging.flamoral.com/nlp
PHOTO_ANALYSIS_URL=https://ai-staging.flamoral.com/photos
RECOMMENDATION_URL=https://ai-staging.flamoral.com/recommendations

# ============================================================================
# Messaging Service
# ============================================================================
EXPO_PUBLIC_MESSAGING_SERVICE_URL=https://messaging-staging.flamoral.com

# ============================================================================
# Application Configuration
# ============================================================================
APP_NAME=Flamoral Staging
APP_VERSION=1.0.0-staging
APP_ENV=staging
BUNDLE_ID=com.flamoral.app.staging
IOS_BUNDLE_ID=com.flamoral.app.staging
ANDROID_PACKAGE=com.flamoral.app.staging
DEEP_LINK_SCHEME=flamoral-staging
UNIVERSAL_LINK_DOMAIN=staging.flamoral.com

# ============================================================================
# External Services & API Keys (Use TEST keys)
# ============================================================================
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key
STRIPE_MERCHANT_ID=merchant.com.flamoral.app.staging
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key
AGORA_APP_ID=your_agora_staging_app_id
TENOR_API_KEY=your_tenor_api_key
GIPHY_API_KEY=your_giphy_api_key

# ============================================================================
# Push Notifications (Firebase Staging)
# ============================================================================
FIREBASE_PROJECT_ID=your_firebase_staging_project_id
FIREBASE_API_KEY=your_firebase_staging_api_key
FIREBASE_AUTH_DOMAIN=your_firebase_staging_auth_domain.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your_firebase_staging_storage_bucket.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_firebase_staging_messaging_sender_id
FIREBASE_APP_ID=your_firebase_staging_app_id
FIREBASE_MEASUREMENT_ID=your_firebase_staging_measurement_id
FIREBASE_IOS_CLIENT_ID=your_firebase_staging_ios_client_id
FIREBASE_IOS_REVERSED_CLIENT_ID=your_firebase_staging_ios_reversed_client_id
FIREBASE_ANDROID_CLIENT_ID=your_firebase_staging_android_client_id

# ============================================================================
# Social Login (Staging Apps)
# ============================================================================
GOOGLE_CLIENT_ID=your_google_staging_client_id
GOOGLE_IOS_CLIENT_ID=your_google_staging_ios_client_id
GOOGLE_ANDROID_CLIENT_ID=your_google_staging_android_client_id
FACEBOOK_APP_ID=your_facebook_staging_app_id
FACEBOOK_CLIENT_TOKEN=your_facebook_staging_client_token
FACEBOOK_DISPLAY_NAME=Flamoral Staging
APPLE_SERVICE_ID=your_apple_staging_service_id

# ============================================================================
# Analytics & Monitoring
# ============================================================================
GA_MEASUREMENT_ID=G-STAGING_ID
MIXPANEL_TOKEN=your_mixpanel_staging_token
SENTRY_DSN=https://your_sentry_staging_dsn@sentry.io/project_id
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=1.0
AMPLITUDE_API_KEY=your_amplitude_staging_api_key

# ============================================================================
# SSL Certificate Pinning (Staging Certs)
# ============================================================================
SSL_PINS_API_FLAMORAL=sha256/STAGING_PIN_1=,sha256/STAGING_PIN_2=
SSL_PINS_BACKUP=sha256/STAGING_BACKUP_PIN=

# ============================================================================
# Feature Flags (Enable all for testing)
# ============================================================================
ENABLE_VIDEO_CALLS=true
ENABLE_VOICE_CALLS=true
ENABLE_EVENTS=true
ENABLE_AI_FEATURES=true
ENABLE_STORIES=true
ENABLE_TRAVEL_MODE=true
ENABLE_PREMIUM_SUBSCRIPTIONS=true
ENABLE_BOOSTS=true
ENABLE_SUPER_LIKES=true
ENABLE_VIRTUAL_GIFTS=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_ID_VERIFICATION=true
ENABLE_BACKGROUND_CHECKS=true
ENABLE_ENCRYPTION=true
ENABLE_BIOMETRIC_AUTH=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_LOCATION_SERVICES=true
ENABLE_GAMIFICATION=true
ENABLE_AI_COACH=true
ENABLE_AR_FEATURES=true
ENABLE_BLOCKCHAIN_VERIFICATION=true

# ============================================================================
# In-App Purchases (Staging Product IDs)
# ============================================================================
IOS_PRODUCT_ID_PREMIUM_MONTHLY=com.flamoral.app.staging.premium.monthly
IOS_PRODUCT_ID_PREMIUM_YEARLY=com.flamoral.app.staging.premium.yearly
IOS_PRODUCT_ID_COINS_SMALL=com.flamoral.app.staging.coins.small
IOS_PRODUCT_ID_COINS_MEDIUM=com.flamoral.app.staging.coins.medium
IOS_PRODUCT_ID_COINS_LARGE=com.flamoral.app.staging.coins.large
ANDROID_PRODUCT_ID_PREMIUM_MONTHLY=com.flamoral.app.staging.premium.monthly
ANDROID_PRODUCT_ID_PREMIUM_YEARLY=com.flamoral.app.staging.premium.yearly

# ============================================================================
# Debug & Development Options (More verbose)
# ============================================================================
DEBUG_MODE=true
LOG_LEVEL=debug
ENABLE_DEBUG_MENU=true
ENABLE_FLIPPER=true

# ============================================================================
# Performance Configuration
# ============================================================================
API_TIMEOUT=30000
UPLOAD_TIMEOUT=120000
AI_ANALYSIS_TIMEOUT=60000
MAX_RETRIES=3
RETRY_DELAY=1000
BACKOFF_MULTIPLIER=2
IMAGE_QUALITY=80
IMAGE_MAX_SIZE=5242880
ENABLE_IMAGE_COMPRESSION=true

# ============================================================================
# Security Configuration
# ============================================================================
ENCRYPTION_KEY_ALIAS=flamoral_staging_encryption_key
USE_KEYCHAIN=true
USE_KEYSTORE=true
ENABLE_SSL_PINNING=true
SSL_PINNING_MODE=strict
ENABLE_ROOT_DETECTION=false
ENABLE_JAILBREAK_DETECTION=false

# ============================================================================
# Localization
# ============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh
DATE_FORMAT=MM/DD/YYYY
TIME_FORMAT=12h

# ============================================================================
# CDN Configuration
# ============================================================================
CDN_URL=https://cdn-staging.flamoral.com
MEDIA_CDN_URL=https://media-staging.flamoral.com

# ============================================================================
# API Rate Limiting
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW=60000

# ============================================================================
# Offline Mode
# ============================================================================
ENABLE_OFFLINE_MODE=true
OFFLINE_CACHE_SIZE=52428800
OFFLINE_CACHE_DURATION=86400000

# ============================================================================
# Legal & Compliance
# ============================================================================
TERMS_URL=https://staging.flamoral.com/terms
PRIVACY_URL=https://staging.flamoral.com/privacy
COOKIE_POLICY_URL=https://staging.flamoral.com/cookies
COMMUNITY_GUIDELINES_URL=https://staging.flamoral.com/guidelines

# ============================================================================
# Contact & Support
# ============================================================================
SUPPORT_EMAIL=support-staging@flamoral.com
SUPPORT_URL=https://staging.flamoral.com/support
HELP_CENTER_URL=https://help-staging.flamoral.com

# ============================================================================
# Code Push (Staging Deployment)
# ============================================================================
CODEPUSH_DEPLOYMENT_KEY_IOS=your_codepush_staging_ios_key
CODEPUSH_DEPLOYMENT_KEY_ANDROID=your_codepush_staging_android_key
