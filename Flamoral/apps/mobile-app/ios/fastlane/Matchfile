# Fastlane Matchfile for Code Signing
# For more information about Match, see:
# https://docs.fastlane.tools/actions/match/

# Git URL for storing certificates and profiles
git_url("https://github.com/flamoral/certificates")

# Git branch to use (optional)
git_branch("main")

# Storage mode (git, google_cloud, or s3)
storage_mode("git")

# Type of provisioning profile
# Options: development, adhoc, appstore, enterprise
type("appstore")

# App Identifier
app_identifier(["com.flamoral"])

# Your Apple Developer Account username
username("developer@flamoral.com")

# Team ID (optional, will be detected automatically)
# team_id("TEAM_ID_HERE")

# If you want to use a specific team name
# team_name("Flamoral Inc")

# Keychain configuration
keychain_name("login.keychain")
keychain_password(ENV['MATCH_KEYCHAIN_PASSWORD'])

# Whether to force re-create certificates
# force(false)

# Whether to force re-create provisioning profiles
# force_for_new_devices(true)

# Whether to skip confirmation prompts
# skip_confirmation(false)

# Whether to skip checking for file existence
# skip_docs(false)

# Platform (ios, macos, tvos)
platform("ios")

# Verbose output
# verbose(false)

# Clone the git repo to a specific folder
# clone_branch_directly(false)

# Shallow clone (saves time and space)
# shallow_clone(true)

# Additional certificate types (optional)
# additional_cert_types(["mac_installer_distribution"])

# Template name for new provisioning profiles
# template_name("iOS Team Provisioning Profile: *")

# Disable output beautification
# skip_google_cloud_account_confirmation(false)

# Google Cloud bucket name (if using google_cloud storage)
# google_cloud_bucket_name("")

# S3 region (if using s3 storage)
# s3_region("")

# S3 bucket name (if using s3 storage)
# s3_bucket("")

# S3 access key (if using s3 storage)
# s3_access_key(ENV["S3_ACCESS_KEY"])

# S3 secret access key (if using s3 storage)
# s3_secret_access_key(ENV["S3_SECRET_ACCESS_KEY"])

# GitLab host (if using GitLab for storage)
# gitlab_host("https://gitlab.com")

# Whether to generate Apple Worldwide Developer Relations certificate
# skip_set_partition_list(false)

# Output path for readonly mode
# readonly(false)

# Generate profiles with specific capabilities
# include_all_certificates(false)

# Whether to include Mac in Catalyst apps
# include_mac_in_profiles(false)

# Force certificate renewal even if valid
# force(false)

# Skip fetching profiles and certs
# skip_fetch_profiles(false)

# Certificates renew duration before expiration (days)
# cert_notify_before_expiration(30)

# Profiles renew duration before expiration (days)
# profile_notify_before_expiration(30)
