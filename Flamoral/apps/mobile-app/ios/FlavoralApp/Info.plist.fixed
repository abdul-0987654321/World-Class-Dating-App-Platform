<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Identity -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>Flamoral</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>

	<!-- Device Requirements -->
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>armv7</string>
	</array>

	<!-- Supported Orientations -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
	</array>

	<!-- Status Bar -->
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleLightContent</string>

	<!-- Launch Screen -->
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>

	<!-- App Transport Security -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Allow arbitrary loads ONLY for development -->
		<!-- Set to false for production builds -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<!-- Exception domains for development -->
		<key>NSExceptionDomains</key>
		<dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>

	<!-- Privacy Permissions -->
	<key>NSCameraUsageDescription</key>
	<string>We need access to your camera to take profile photos, verify your identity, and enable video calls.</string>

	<key>NSPhotoLibraryUsageDescription</key>
	<string>We need access to your photo library to select and upload profile photos.</string>

	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>We need permission to save photos to your library.</string>

	<key>NSMicrophoneUsageDescription</key>
	<string>We need access to your microphone for video calls and voice messages.</string>

	<key>NSLocationWhenInUseUsageDescription</key>
	<string>We use your location to show you matches nearby and help you discover people in your area.</string>

	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>We use your location to show you matches nearby, even when the app is in the background.</string>

	<key>NSLocationAlwaysUsageDescription</key>
	<string>We use your location to show you matches nearby, even when the app is in the background.</string>

	<key>NSMotionUsageDescription</key>
	<string>We use motion data to enhance your experience and detect activity.</string>

	<key>NSContactsUsageDescription</key>
	<string>We need access to your contacts to help you find friends who are already on Flamoral.</string>

	<key>NSCalendarsUsageDescription</key>
	<string>We need access to your calendar to help you schedule dates and events.</string>

	<key>NSFaceIDUsageDescription</key>
	<string>Use Face ID to securely and quickly log in to your account.</string>

	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>We use Bluetooth to enhance your experience with nearby features.</string>

	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>We use Bluetooth to enhance your experience with nearby features.</string>

	<key>NSUserTrackingUsageDescription</key>
	<string>We use data to provide personalized content and improve your experience.</string>

	<!-- Push Notifications -->
	<key>UIBackgroundModes</key>
	<array>
		<string>remote-notification</string>
		<string>voip</string>
		<string>fetch</string>
		<string>location</string>
	</array>

	<!-- URL Schemes for Deep Linking -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.flamoral.app</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>flamoral</string>
			</array>
		</dict>
		<!-- Facebook URL Scheme -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>FacebookAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>fb$(FACEBOOK_APP_ID)</string>
			</array>
		</dict>
		<!-- Google URL Scheme -->
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>GoogleAuth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>$(GOOGLE_URL_SCHEME)</string>
			</array>
		</dict>
	</array>

	<!-- Universal Links -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:flamoral.com</string>
		<string>applinks:www.flamoral.com</string>
	</array>

	<!-- Firebase -->
	<key>FirebaseAppDelegateProxyEnabled</key>
	<false/>

	<!-- Facebook SDK -->
	<key>FacebookAppID</key>
	<string>$(FACEBOOK_APP_ID)</string>
	<key>FacebookClientToken</key>
	<string>$(FACEBOOK_CLIENT_TOKEN)</string>
	<key>FacebookDisplayName</key>
	<string>Flamoral</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>fbapi</string>
		<string>fb-messenger-share-api</string>
		<string>fbauth2</string>
		<string>fbshareextension</string>
		<string>instagram</string>
		<string>twitter</string>
		<string>whatsapp</string>
	</array>

	<!-- App Capabilities -->
	<key>UIRequiresFullScreen</key>
	<true/>

	<!-- Prevent screenshots in sensitive screens (optional) -->
	<!-- <key>UIAllowsScreenRecording</key>
	<false/> -->

	<!-- Encryption Export Compliance -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<!-- Scene Configuration (iOS 13+) -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict/>
	</dict>

	<!-- Appearance -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>

	<!-- Disable dark mode (optional) -->
	<!-- <key>UIUserInterfaceStyle</key>
	<string>Light</string> -->

</dict>
</plist>
