# ============================================================================
# Flamoral Web App - Production Environment Configuration
# ============================================================================

# ============================================================================
# API & Backend Configuration
# ============================================================================
# Main API Gateway (all requests go through this)
VITE_API_URL=https://api.flamoral.com

# WebSocket URL for real-time features (messaging, notifications, presence)
VITE_WS_URL=wss://api.flamoral.com

# Socket.IO endpoint for real-time messaging
VITE_SOCKET_URL=wss://api.flamoral.com

# GraphQL endpoint (if using GraphQL)
VITE_GRAPHQL_URL=https://api.flamoral.com/graphql

# ============================================================================
# Application Configuration
# ============================================================================
VITE_APP_NAME=Flamoral
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=production

# Application domain (used for sharing, redirects)
VITE_APP_DOMAIN=https://flamoral.com

# ============================================================================
# External Services & API Keys
# ============================================================================

# Stripe Payment Processing (Production Keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key

# Google Maps (for location features)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Agora (Video Calling)
VITE_AGORA_APP_ID=your_agora_app_id

# Tenor GIF API
VITE_TENOR_API_KEY=your_tenor_api_key

# Firebase Cloud Messaging (Push Notifications)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id
VITE_FIREBASE_VAPID_KEY=your_firebase_vapid_key

# ============================================================================
# Analytics & Monitoring
# ============================================================================

# Google Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Sentry (Error Tracking)
VITE_SENTRY_DSN=https://your_sentry_dsn@sentry.io/project_id
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Mixpanel (Product Analytics)
VITE_MIXPANEL_TOKEN=your_mixpanel_token

# LogRocket (Session Replay)
VITE_LOGROCKET_APP_ID=your_logrocket_app_id

# ============================================================================
# Social Login Configuration
# ============================================================================

# Google OAuth
VITE_GOOGLE_CLIENT_ID=your_google_client_id

# Facebook OAuth
VITE_FACEBOOK_APP_ID=your_facebook_app_id

# Apple Sign In
VITE_APPLE_CLIENT_ID=your_apple_client_id

# ============================================================================
# Feature Flags
# ============================================================================

# Core Features
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_VOICE_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_STORIES=true
VITE_ENABLE_TRAVEL_MODE=true

# Premium Features
VITE_ENABLE_PREMIUM_SUBSCRIPTIONS=true
VITE_ENABLE_BOOSTS=true
VITE_ENABLE_SUPER_LIKES=true
VITE_ENABLE_VIRTUAL_GIFTS=true

# Safety Features
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_ID_VERIFICATION=true
VITE_ENABLE_BACKGROUND_CHECKS=true

# Experimental Features
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_AI_COACH=true
VITE_ENABLE_BLOCKCHAIN_VERIFICATION=false

# ============================================================================
# Debug & Development Options (Should be FALSE in production)
# ============================================================================
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=false
VITE_ENABLE_REDUX_DEVTOOLS=false
VITE_LOG_LEVEL=error

# ============================================================================
# Performance Configuration
# ============================================================================

# API timeouts (in milliseconds)
VITE_API_TIMEOUT=30000
VITE_UPLOAD_TIMEOUT=120000

# Image optimization
VITE_IMAGE_QUALITY=80
VITE_IMAGE_MAX_SIZE=5242880

# Lazy loading
VITE_ENABLE_LAZY_LOADING=true

# ============================================================================
# Security Configuration
# ============================================================================

# Content Security Policy
VITE_CSP_ENABLED=true
VITE_CSP_REPORT_URI=https://flamoral.report-uri.com/r/d/csp/enforce

# CSRF Protection (handled by backend, but frontend needs to know)
VITE_CSRF_ENABLED=true

# Rate Limiting (client-side awareness)
VITE_RATE_LIMIT_ENABLED=true

# ============================================================================
# Localization
# ============================================================================
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh

# ============================================================================
# CDN Configuration
# ============================================================================
VITE_CDN_URL=https://cdn.flamoral.com
VITE_MEDIA_CDN_URL=https://media.flamoral.com

# ============================================================================
# Legal & Compliance
# ============================================================================
VITE_TERMS_URL=https://flamoral.com/terms
VITE_PRIVACY_URL=https://flamoral.com/privacy
VITE_COOKIE_POLICY_URL=https://flamoral.com/cookies
VITE_COMMUNITY_GUIDELINES_URL=https://flamoral.com/guidelines

# ============================================================================
# Contact & Support
# ============================================================================
VITE_SUPPORT_EMAIL=support@flamoral.com
VITE_CONTACT_URL=https://flamoral.com/contact

# ============================================================================
# NOTES:
# ============================================================================
# 1. Never commit actual production keys to version control
# 2. Use environment-specific key vaults (Azure Key Vault, AWS Secrets Manager)
# 3. All VITE_ prefixed variables are exposed to the client
# 4. Do not store sensitive backend secrets here
# 5. Update API URLs based on your deployment (e.g., api.flamoral.com)
# 6. Ensure all URLs use HTTPS in production
# 7. Test WebSocket connectivity thoroughly before going live
