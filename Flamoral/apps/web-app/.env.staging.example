# ============================================================================
# Flamoral Web App - Staging Environment Configuration
# ============================================================================

# ============================================================================
# API & Backend Configuration
# ============================================================================
# Staging API Gateway
VITE_API_URL=https://api-staging.flamoral.com

# WebSocket URL for real-time features
VITE_WS_URL=wss://api-staging.flamoral.com

# Socket.IO endpoint
VITE_SOCKET_URL=wss://api-staging.flamoral.com

# GraphQL endpoint
VITE_GRAPHQL_URL=https://api-staging.flamoral.com/graphql

# ============================================================================
# Application Configuration
# ============================================================================
VITE_APP_NAME=Flamoral (Staging)
VITE_APP_VERSION=1.0.0-staging
VITE_APP_ENV=staging

VITE_APP_DOMAIN=https://staging.flamoral.com

# ============================================================================
# External Services & API Keys (Use TEST keys in staging)
# ============================================================================

# Stripe TEST Keys
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_key

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Agora (Video Calling)
VITE_AGORA_APP_ID=your_agora_staging_app_id

# Tenor GIF API
VITE_TENOR_API_KEY=your_tenor_api_key

# Firebase (Staging Project)
VITE_FIREBASE_API_KEY=your_firebase_staging_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_firebase_staging_auth_domain
VITE_FIREBASE_PROJECT_ID=your_firebase_staging_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_firebase_staging_storage_bucket
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_staging_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_staging_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_staging_measurement_id
VITE_FIREBASE_VAPID_KEY=your_firebase_staging_vapid_key

# ============================================================================
# Analytics & Monitoring
# ============================================================================
VITE_GA_MEASUREMENT_ID=G-STAGING_ID
VITE_SENTRY_DSN=https://your_sentry_staging_dsn@sentry.io/project_id
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_MIXPANEL_TOKEN=your_mixpanel_staging_token
VITE_LOGROCKET_APP_ID=your_logrocket_staging_app_id

# ============================================================================
# Social Login (Staging Apps)
# ============================================================================
VITE_GOOGLE_CLIENT_ID=your_google_staging_client_id
VITE_FACEBOOK_APP_ID=your_facebook_staging_app_id
VITE_APPLE_CLIENT_ID=your_apple_staging_client_id

# ============================================================================
# Feature Flags (Enable all for testing)
# ============================================================================
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_VOICE_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_STORIES=true
VITE_ENABLE_TRAVEL_MODE=true
VITE_ENABLE_PREMIUM_SUBSCRIPTIONS=true
VITE_ENABLE_BOOSTS=true
VITE_ENABLE_SUPER_LIKES=true
VITE_ENABLE_VIRTUAL_GIFTS=true
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_ID_VERIFICATION=true
VITE_ENABLE_BACKGROUND_CHECKS=true
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_AI_COACH=true
VITE_ENABLE_BLOCKCHAIN_VERIFICATION=true

# ============================================================================
# Debug & Development Options (More verbose in staging)
# ============================================================================
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# ============================================================================
# Performance Configuration
# ============================================================================
VITE_API_TIMEOUT=30000
VITE_UPLOAD_TIMEOUT=120000
VITE_IMAGE_QUALITY=80
VITE_IMAGE_MAX_SIZE=5242880
VITE_ENABLE_LAZY_LOADING=true

# ============================================================================
# Security Configuration
# ============================================================================
VITE_CSP_ENABLED=true
VITE_CSP_REPORT_URI=https://flamoral-staging.report-uri.com/r/d/csp/enforce
VITE_CSRF_ENABLED=true
VITE_RATE_LIMIT_ENABLED=true

# ============================================================================
# Localization
# ============================================================================
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh

# ============================================================================
# CDN Configuration
# ============================================================================
VITE_CDN_URL=https://cdn-staging.flamoral.com
VITE_MEDIA_CDN_URL=https://media-staging.flamoral.com

# ============================================================================
# Legal & Compliance
# ============================================================================
VITE_TERMS_URL=https://staging.flamoral.com/terms
VITE_PRIVACY_URL=https://staging.flamoral.com/privacy
VITE_COOKIE_POLICY_URL=https://staging.flamoral.com/cookies
VITE_COMMUNITY_GUIDELINES_URL=https://staging.flamoral.com/guidelines

# ============================================================================
# Contact & Support
# ============================================================================
VITE_SUPPORT_EMAIL=support-staging@flamoral.com
VITE_CONTACT_URL=https://staging.flamoral.com/contact
