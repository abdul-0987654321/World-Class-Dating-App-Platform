# Flamoral Static Asset Caching Headers
# This file configures caching policies for static assets

# Default cache headers for all files
/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(self)

# HTML files - no cache (always fetch fresh)
/*.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Service Worker - no cache
/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# JavaScript files - cache for 1 year with immutable (webpack hashed filenames)
/assets/js/*.js
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/javascript; charset=utf-8

# CSS files - cache for 1 year with immutable (webpack hashed filenames)
/assets/css/*.css
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: text/css; charset=utf-8

# Images - cache for 1 year with immutable
/assets/images/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts - cache for 1 year with immutable
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

# Static images in root - cache for 1 week
/*.jpg
  Cache-Control: public, max-age=604800

/*.jpeg
  Cache-Control: public, max-age=604800

/*.png
  Cache-Control: public, max-age=604800

/*.gif
  Cache-Control: public, max-age=604800

/*.webp
  Cache-Control: public, max-age=604800

/*.svg
  Cache-Control: public, max-age=604800

# Favicon - cache for 1 week
/favicon.ico
  Cache-Control: public, max-age=604800

/flamoral-icon.svg
  Cache-Control: public, max-age=604800

# Manifest and config files - cache for 1 day
/manifest.json
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain

/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml

# Security files
/.well-known/*
  Cache-Control: public, max-age=86400

# OG Images for social sharing - cache for 1 week
/og-*.png
  Cache-Control: public, max-age=604800

/og-*.jpg
  Cache-Control: public, max-age=604800

# Media files (videos, audio)
/*.mp4
  Cache-Control: public, max-age=31536000

/*.webm
  Cache-Control: public, max-age=31536000

/*.mp3
  Cache-Control: public, max-age=31536000

/*.wav
  Cache-Control: public, max-age=31536000
