# Flamoral Web App - Development Environment

# API Configuration
# Points to the main backend server running locally (API Gateway on port 4000)
VITE_API_URL=http://localhost:4000/api/v1

# WebSocket Configuration (Socket.io uses http/https, same port as API Gateway)
VITE_SOCKET_URL=http://localhost:4000

# GraphQL Configuration
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# App Configuration
VITE_APP_NAME=Flamoral
VITE_APP_ENV=development

# Feature Flags
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true
