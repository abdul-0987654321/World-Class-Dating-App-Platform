# Flamoral Web App Environment Configuration

# API Configuration (API Gateway on port 4000 with /api/v1 prefix)
VITE_API_URL=http://localhost:4000/api/v1

# WebSocket Configuration (Socket.io uses http/https, same host as API Gateway)
VITE_SOCKET_URL=http://localhost:4000

# WebSocket URL for real-time features (messaging, notifications, presence)
VITE_WS_URL=ws://localhost:4000/ws

# App Configuration
VITE_APP_NAME=Flamoral
VITE_APP_VERSION=1.0.0

# External Services
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Agora Video Calling
VITE_AGORA_APP_ID=your_agora_app_id

# Analytics
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feature Flags
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true

# Development Options (Should be FALSE in production)
# VITE_USE_MOCKS=false
