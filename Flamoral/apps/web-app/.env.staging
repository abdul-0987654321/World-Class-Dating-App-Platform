# Flamoral Web App - Staging Environment Configuration

# API & Backend Configuration
VITE_API_URL=https://staging-api.flamoral.com/api/v1

# Socket.IO endpoint for API Gateway WebSocket
# IMPORTANT: This is the primary WebSocket connection URL for messaging and calls
VITE_SOCKET_URL=https://staging-api.flamoral.com

# Legacy/Alternative WebSocket URLs (kept for backward compatibility)
VITE_WS_URL=wss://staging-api.flamoral.com

VITE_GRAPHQL_URL=https://staging-api.flamoral.com/graphql

# Application Configuration
VITE_APP_NAME=Flamoral
VITE_APP_VERSION=1.0.0
VITE_APP_ENV=staging
VITE_APP_DOMAIN=https://staging.flamoral.com

# External Services (use test/staging keys)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_staging_key
VITE_GOOGLE_MAPS_API_KEY=staging_google_maps_key
VITE_AGORA_APP_ID=staging_agora_app_id
VITE_TENOR_API_KEY=staging_tenor_key

# Firebase (Staging project)
VITE_FIREBASE_API_KEY=staging_firebase_key
VITE_FIREBASE_AUTH_DOMAIN=flamoral-staging.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=flamoral-staging
VITE_FIREBASE_STORAGE_BUCKET=flamoral-staging.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=staging_sender_id
VITE_FIREBASE_APP_ID=staging_app_id
VITE_FIREBASE_MEASUREMENT_ID=staging_measurement_id
VITE_FIREBASE_VAPID_KEY=staging_vapid_key

# Analytics & Monitoring (separate from production)
VITE_GA_MEASUREMENT_ID=G-STAGING123
VITE_SENTRY_DSN=staging_sentry_dsn
VITE_SENTRY_ENVIRONMENT=staging
VITE_SENTRY_TRACES_SAMPLE_RATE=1.0
VITE_MIXPANEL_TOKEN=staging_mixpanel_token
VITE_LOGROCKET_APP_ID=staging_logrocket_id

# Social Login (use test credentials)
VITE_GOOGLE_CLIENT_ID=staging_google_client_id
VITE_FACEBOOK_APP_ID=staging_facebook_app_id
VITE_APPLE_CLIENT_ID=com.flamoral.app.staging
VITE_APPLE_REDIRECT_URI=https://staging-api.flamoral.com/auth/apple/callback

# Feature Flags (enable all for testing)
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_VOICE_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_STORIES=true
VITE_ENABLE_TRAVEL_MODE=true
VITE_ENABLE_PREMIUM_SUBSCRIPTIONS=true
VITE_ENABLE_BOOSTS=true
VITE_ENABLE_SUPER_LIKES=true
VITE_ENABLE_VIRTUAL_GIFTS=true
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_ID_VERIFICATION=true
VITE_ENABLE_BACKGROUND_CHECKS=true
VITE_ENABLE_GAMIFICATION=true
VITE_ENABLE_AI_COACH=true
VITE_ENABLE_BLOCKCHAIN_VERIFICATION=true

# Debug Options (more verbose in staging)
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true
VITE_ENABLE_REDUX_DEVTOOLS=true
VITE_LOG_LEVEL=debug

# Performance Configuration
VITE_API_TIMEOUT=30000
VITE_UPLOAD_TIMEOUT=120000
VITE_IMAGE_QUALITY=80
VITE_IMAGE_MAX_SIZE=5242880
VITE_ENABLE_LAZY_LOADING=true

# Security Configuration
VITE_CSP_ENABLED=true
VITE_CSRF_ENABLED=true
VITE_RATE_LIMIT_ENABLED=true

# Localization
VITE_DEFAULT_LANGUAGE=en
VITE_SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh

# CDN Configuration
VITE_CDN_URL=https://staging-cdn.flamoral.com
VITE_MEDIA_CDN_URL=https://staging-media.flamoral.com

# Legal & Compliance
VITE_TERMS_URL=https://staging.flamoral.com/terms
VITE_PRIVACY_URL=https://staging.flamoral.com/privacy
VITE_COOKIE_POLICY_URL=https://staging.flamoral.com/cookies
VITE_COMMUNITY_GUIDELINES_URL=https://staging.flamoral.com/guidelines

# Contact & Support
VITE_SUPPORT_EMAIL=staging-support@flamoral.com
VITE_CONTACT_URL=https://staging.flamoral.com/contact
