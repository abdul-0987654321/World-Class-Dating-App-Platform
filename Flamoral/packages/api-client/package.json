{
  "name": "@flamoral/react-api-client",
  "version": "1.0.0",
  "description": "React Query hooks for Flamoral API client",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "clean": "rimraf dist",
    "lint": "eslint src/ --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@flamoral/types": "workspace:*",
    "@flamoral/constants": "workspace:*",
    "@tanstack/react-query": "^5.17.0",
    "axios": "^1.7.9",
    "zustand": "^4.4.0"
  },
  "peerDependencies": {
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "eslint": "^8.54.0",
    "rimraf": "^5.0.5",
    "tsup": "^8.0.1",
    "typescript": "^5.3.2"
  },
  "keywords": [
    "api",
    "react-query",
    "flamoral",
    "hooks"
  ],
  "publishConfig": {
    "access": "restricted"
  }
}
