{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@flamoral/types": ["./types/src"],
      "@flamoral/constants": ["./constants/src"],
      "@flamoral/utils": ["./utils/src"],
      "@flamoral/validators": ["./validators/src"],
      "@flamoral/api-client": ["./api-client/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"],
  "references": [
    { "path": "./types" },
    { "path": "./constants" },
    { "path": "./utils" },
    { "path": "./validators" },
    { "path": "./api-client" }
  ]
}
