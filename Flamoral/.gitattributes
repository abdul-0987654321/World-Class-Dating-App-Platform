# .gitattributes for World-Class Dating App Platform
# Auto detect text files and normalize line endings to LF

# Default behavior
* text=auto eol=lf

# ===================
# Source Code
# ===================
*.js text eol=lf
*.jsx text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.sass text eol=lf
*.less text eol=lf
*.html text eol=lf
*.htm text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# ===================
# Documentation
# ===================
*.md text eol=lf diff=markdown
*.markdown text eol=lf
*.mdown text eol=lf
*.mkd text eol=lf
*.txt text eol=lf
*.adoc text eol=lf
*.textile text eol=lf
*.mustache text eol=lf
*.csv text eol=lf
*.tab text eol=lf
*.tsv text eol=lf

# ===================
# Scripts
# ===================
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
*.fish text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ===================
# Configuration Files
# ===================
*.conf text eol=lf
*.config text eol=lf
*.ini text eol=lf
*.properties text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
.eslintrc text eol=lf
.eslintrc.* text eol=lf
.prettierrc text eol=lf
.prettierrc.* text eol=lf
.babelrc text eol=lf
.browserslistrc text eol=lf
.stylelintrc text eol=lf
tsconfig*.json text eol=lf
jest.config.* text eol=lf
webpack.config.* text eol=lf
rollup.config.* text eol=lf
vite.config.* text eol=lf

# ===================
# Database
# ===================
*.sql text eol=lf
*.sql.gz binary

# ===================
# Protocol Buffers
# ===================
*.proto text eol=lf

# ===================
# Docker
# ===================
Dockerfile text eol=lf
*.dockerfile text eol=lf
docker-compose*.yml text eol=lf
.dockerignore text eol=lf

# ===================
# Kubernetes
# ===================
*.k8s.yml text eol=lf
*.k8s.yaml text eol=lf

# ===================
# Infrastructure as Code
# ===================
# Terraform
*.tf text eol=lf
*.tfvars text eol=lf
*.hcl text eol=lf

# Ansible
*.ansible.yml text eol=lf

# Helm
Chart.yaml text eol=lf
values*.yaml text eol=lf

# ===================
# Graphics
# ===================
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.tiff binary
*.tif binary
*.webp binary
*.svg text eol=lf
*.ai binary
*.psd binary
*.pdf binary
*.eps binary

# ===================
# Audio
# ===================
*.mp3 binary
*.ogg binary
*.wav binary
*.flac binary
*.m4a binary

# ===================
# Video
# ===================
*.mp4 binary
*.mov binary
*.avi binary
*.webm binary
*.mkv binary
*.flv binary

# ===================
# Fonts
# ===================
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.eot binary

# ===================
# Archives
# ===================
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.bz2 binary
*.7z binary
*.rar binary

# ===================
# Compiled & Binary
# ===================
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.class binary
*.jar binary
*.war binary
*.o binary
*.obj binary

# ===================
# Mobile Builds
# ===================
*.apk binary
*.aab binary
*.ipa binary
*.dSYM binary

# ===================
# Certificates & Keys
# ===================
*.jks binary
*.keystore binary
*.p12 binary
*.pfx binary
*.pem binary
*.crt binary
*.cer binary
*.der binary
*.key binary

# ===================
# Lock Files (Binary to prevent merge conflicts)
# ===================
package-lock.json binary
yarn.lock binary
pnpm-lock.yaml binary
Gemfile.lock binary
Pipfile.lock binary
composer.lock binary
poetry.lock binary

# ===================
# Minified Files
# ===================
*.min.js binary
*.min.css binary

# ===================
# Export Settings
# ===================
# Exclude development files from git archive/export
.github/ export-ignore
.github/** export-ignore
.gitattributes export-ignore
.gitignore export-ignore
.editorconfig export-ignore
.eslintrc.* export-ignore
.prettierrc export-ignore
.prettierignore export-ignore
tests/ export-ignore
test/ export-ignore
*.test.js export-ignore
*.spec.js export-ignore
*.test.ts export-ignore
*.spec.ts export-ignore
*.test.tsx export-ignore
*.spec.tsx export-ignore
__tests__/ export-ignore
__mocks__/ export-ignore
coverage/ export-ignore
.nyc_output/ export-ignore

# ===================
# Merge Strategies
# ===================
# Use union merge for package.json to reduce conflicts
package.json merge=union

# Use union merge for CHANGELOG
CHANGELOG.md merge=union

# ===================
# Linguist Overrides
# ===================
# For GitHub language statistics (Azure Repos doesn't use this, but keeping for compatibility)
*.sql linguist-detectable=true
*.md linguist-detectable=false
*.txt linguist-detectable=false
docs/** linguist-documentation
scripts/** linguist-vendored=false
tests/** linguist-generated=false
*.generated.* linguist-generated=true
vendor/** linguist-vendored
node_modules/** linguist-vendored
