# =============================================================================
# TRUFFLEHOG IGNORE PATTERNS - Flamoral Dating Platform
# =============================================================================
# Paths and patterns to exclude from TruffleHog secret scanning
# =============================================================================

# Example and template files
**/.env.example
**/.env.sample
**/.env.template
**/.env.dist

# Documentation
**/docs/**
**/README.md
**/CHANGELOG.md
**/LICENSE
**/CONTRIBUTING.md

# Test fixtures and mock data
**/tests/fixtures/**
**/test/fixtures/**
**/__tests__/fixtures/**
**/testdata/**
**/mocks/**
**/__mocks__/**

# Node modules and dependencies
**/node_modules/**
**/vendor/**

# Build artifacts
**/dist/**
**/build/**
**/out/**
**/coverage/**
**/.next/**

# Lock files
**/package-lock.json
**/yarn.lock
**/pnpm-lock.yaml
**/Gemfile.lock
**/Cargo.lock

# Configuration files (non-sensitive)
**/.prettierrc*
**/.eslintrc*
**/tsconfig.json
**/jest.config.*
**/.babelrc*
**/webpack.config.*

# Git files
**/.git/**
**/.gitignore
**/.gitattributes

# IDE and editor files
**/.vscode/**
**/.idea/**
**/*.swp
**/*.swo
**/*.bak

# Log files
**/*.log
**/logs/**

# Temporary files
**/tmp/**
**/temp/**
**/.tmp/**

# CI/CD configuration
**/.github/**/*.md
**/.gitlab-ci.yml

# Security tool configurations
**/.gitleaks.toml
**/.trufflehogignore
**/gitleaks-report.sarif
**/trivy-results.sarif

# Database migrations (may contain test data)
**/migrations/**/*.sql
**/seeds/**/*.sql

# Terraform state (should be in .gitignore anyway)
**/*.tfstate
**/*.tfstate.backup
**/.terraform/**

# Kubernetes manifests (may have example values)
**/k8s/examples/**
**/helm/values.example.yaml

# Image and binary files
**/*.png
**/*.jpg
**/*.jpeg
**/*.gif
**/*.svg
**/*.ico
**/*.pdf
**/*.zip
**/*.tar.gz
**/*.exe
**/*.dll
**/*.so
**/*.dylib
