{
  "name": "flamoral-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Flamoral - Where Passion Meets Connection (Web & Mobile Dating Platform)",
  "packageManager": "yarn@1.22.19",
  "workspaces": [
    "packages/shared",
    "packages/shared/types",
    "packages/shared/utils",
    "packages/shared/constants",
    "packages/shared/validators",
    "packages/shared/api-client",
    "packages/api-client",
    "packages/i18n",
    "packages/socket-client",
    "packages/video-sdk",
    "apps/web-app",
    "apps/mobile-app",
    "backend",
    "backend/services/*",
    "backend/shared",
    "backend/services/shared"
  ],
  "scripts": {
    "postinstall": "lerna bootstrap --hoist",
    "install:all": "yarn install --frozen-lockfile",
    "build": "yarn build:packages && yarn build:backend && yarn build:apps",
    "build:packages": "yarn workspace @flamoral/shared build && yarn workspace @flamoral/types build && yarn workspace @flamoral/constants build && yarn workspace @flamoral/utils build && yarn workspace @flamoral/validators build && yarn workspace @flamoral/shared-api-client build && yarn workspace @flamoral/api-client build && yarn workspace @flamoral/i18n build && yarn workspace @flamoral/socket-client build && yarn workspace @flamoral/video-sdk build",
    "build:backend": "yarn workspace @flamoral/backend build",
    "build:apps": "yarn workspace @flamoral/web build",
    "build:all": "yarn build",
    "test": "jest",
    "test:all": "yarn workspaces run test",
    "test:backend": "yarn workspace @flamoral/backend test",
    "test:backend:coverage": "yarn workspace @flamoral/backend test:coverage",
    "test:integration": "cd backend && jest --config tests/jest.config.integration.enhanced.js",
    "test:integration:docker": "yarn docker:test:up && yarn test:integration && yarn docker:test:down",
    "test:integration:coverage": "cd backend && jest --config tests/jest.config.integration.enhanced.js --coverage",
    "test:integration:watch": "cd backend && jest --config tests/jest.config.integration.enhanced.js --watch",
    "test:backend:e2e": "cd backend && jest --config tests/jest.config.e2e.js --runInBand",
    "test:backend:e2e:docker": "yarn docker:test:up && yarn test:backend:e2e && yarn docker:test:down",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:web": "yarn workspace @flamoral/web test:e2e",
    "test:load:auth": "k6 run tests/load/scenarios/auth-load.js",
    "test:load:matching": "k6 run tests/load/scenarios/matching-load.js",
    "test:load:websocket": "k6 run tests/load/scenarios/websocket-load.js",
    "test:load:all": "yarn test:load:auth && yarn test:load:matching && yarn test:load:websocket",
    "test:security": "jest tests/security/",
    "test:security:owasp": "jest tests/security/owasp-tests.spec.ts",
    "test:security:auth": "jest tests/security/authentication-security.spec.ts",
    "test:ci": "yarn test:backend && yarn test:integration:docker && yarn test:e2e",
    "test:ci:coverage": "yarn test:backend:coverage && yarn test:integration:coverage",
    "lint": "eslint . --ext .ts,.tsx,.js,.jsx --max-warnings=0",
    "lint:all": "yarn lint",
    "lint:fix": "eslint . --ext .ts,.tsx,.js,.jsx --fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "typecheck": "tsc --build --force",
    "typecheck:watch": "tsc --build --watch",
    "clean": "lerna clean -y && rimraf node_modules **/dist **/build **/.turbo",
    "clean:dist": "rimraf **/dist **/build",
    "dev:web": "yarn workspace @flamoral/web dev",
    "dev:mobile": "yarn workspace @flamoral/mobile start",
    "dev:backend": "yarn workspace @flamoral/backend dev",
    "build:web": "yarn workspace @flamoral/web build",
    "build:mobile:ios": "cd apps/mobile-app && npx react-native run-ios --configuration Release",
    "build:mobile:android": "cd apps/mobile-app && npx react-native run-android --variant=release",
    "seed": "ts-node scripts/seed-data.ts",
    "setup:dev": "yarn install && yarn build:packages && yarn seed",
    "docker:test:up": "docker-compose -f docker-compose.test.yml up -d --wait",
    "docker:test:down": "docker-compose -f docker-compose.test.yml down -v",
    "docker:test:logs": "docker-compose -f docker-compose.test.yml logs -f"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.1.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-import-resolver-typescript": "^3.6.1",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "js-yaml": "^4.1.1",
    "lerna": "^8.0.0",
    "prettier": "^3.1.1",
    "rimraf": "^5.0.5",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "resolutions": {
    "typescript": "^5.3.3",
    "axios": "^1.7.9",
    "socket.io-client": "^4.8.1",
    "@types/node": "^20.10.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flamoral/flamoral-dating-platform.git"
  },
  "author": "Flamoral Team",
  "license": "MIT"
}
