# =============================================================================
# Flamoral Dating Platform - Production Environment Configuration
# =============================================================================
# SECURITY CRITICAL: ALL sensitive values MUST be stored in Azure Key Vault
# This file is a template showing the structure only
# Never commit actual production secrets to version control
# =============================================================================

# =============================================================================
# Environment Settings
# =============================================================================
NODE_ENV=production
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=warn
LOG_FORMAT=json

# =============================================================================
# Service Configuration
# =============================================================================
PORT=3000
HOST=0.0.0.0

# =============================================================================
# API Gateway
# =============================================================================
API_GATEWAY_URL=https://api.flamoral.com
API_VERSION=v1

# =============================================================================
# Service URLs (Internal Communication - K8s Service Discovery)
# =============================================================================
USER_SERVICE_URL=http://user-service.flamoral-prod.svc.cluster.local:3002
AUTH_SERVICE_URL=http://auth-service.flamoral-prod.svc.cluster.local:3001
MATCHING_SERVICE_URL=http://matching-service.flamoral-prod.svc.cluster.local:3009
MESSAGING_SERVICE_URL=http://messaging-service.flamoral-prod.svc.cluster.local:3004
MODERATION_SERVICE_URL=http://moderation-service.flamoral-prod.svc.cluster.local:3008
PAYMENT_SERVICE_URL=http://payment-service.flamoral-prod.svc.cluster.local:3005
MEDIA_SERVICE_URL=http://media-service.flamoral-prod.svc.cluster.local:3006
NOTIFICATION_SERVICE_URL=http://notification-service.flamoral-prod.svc.cluster.local:3012
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-prod.svc.cluster.local:3007
AI_SERVICE_URL=http://ai-service.flamoral-prod.svc.cluster.local:8000
ADVERTISING_SERVICE_URL=http://advertising-service.flamoral-prod.svc.cluster.local:3011
REALTIME_SERVICE_URL=http://realtime-service.flamoral-prod.svc.cluster.local:8081
ADMIN_SERVICE_URL=http://admin-service.flamoral-prod.svc.cluster.local:3010
AUTOMATION_SERVICE_URL=http://automation-service.flamoral-prod.svc.cluster.local:3014
WORKFLOW_ENGINE_URL=http://workflow-engine.flamoral-prod.svc.cluster.local:3013

# =============================================================================
# Frontend URLs
# =============================================================================
WEB_URL=https://flamoral.com
ADMIN_URL=https://admin.flamoral.com
MOBILE_APP_SCHEME=flamoral://

# =============================================================================
# Database - PostgreSQL (Azure Database for PostgreSQL - Premium Tier)
# =============================================================================
DB_HOST=flamoral-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral
DB_USER=flamoral_admin
DB_PASSWORD=*** # MANDATORY: STORED IN AZURE KEY VAULT
DB_POOL_MIN=10
DB_POOL_MAX=50
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_TIMEOUT=30000
DB_QUERY_TIMEOUT=60000
DATABASE_URL=*** # MANDATORY: STORED IN AZURE KEY VAULT

# Read Replicas for Scaling
DB_READ_REPLICA_1_URL=*** # MANDATORY: STORED IN AZURE KEY VAULT
DB_READ_REPLICA_2_URL=*** # MANDATORY: STORED IN AZURE KEY VAULT

# =============================================================================
# Database - MongoDB (Azure Cosmos DB with MongoDB API - Production Tier)
# =============================================================================
MONGODB_URI=*** # MANDATORY: STORED IN AZURE KEY VAULT
MONGODB_DB=flamoral_prod
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10

# =============================================================================
# Cache - Redis (Azure Cache for Redis - Premium Tier with Clustering)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # MANDATORY: STORED IN AZURE KEY VAULT
REDIS_DB=0
REDIS_URL=*** # MANDATORY: STORED IN AZURE KEY VAULT
REDIS_TLS=true
REDIS_TLS_REJECT_UNAUTHORIZED=true
REDIS_CLUSTER_MODE=true
REDIS_TTL=3600
REDIS_MAX_RETRIES=3
REDIS_CONNECT_TIMEOUT=10000

# =============================================================================
# Message Queue - Azure Service Bus (Premium Tier)
# =============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=*** # MANDATORY: STORED IN AZURE KEY VAULT
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue
QUEUE_MEDIA_PROCESSING=media_processing_queue
QUEUE_EMAIL=email_queue
QUEUE_SMS=sms_queue

# =============================================================================
# Authentication - JWT
# =============================================================================
# CRITICAL: Use cryptographically secure 64+ character random strings
JWT_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT (64+ chars)
JWT_ACCESS_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT (64+ chars)
JWT_REFRESH_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT (64+ chars)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=flamoral-production

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT (64+ chars)
SERVICE_TOKEN=*** # MANDATORY: STORED IN AZURE KEY VAULT (64+ chars) - For realtime-service authentication
SERVICE_NAME=flamoral-service
SERVICE_TIMEOUT=30000

# =============================================================================
# OAuth Providers (Production)
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-production-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT
GOOGLE_CALLBACK_URL=https://api.flamoral.com/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-production-facebook-app-id
FACEBOOK_APP_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT
FACEBOOK_CALLBACK_URL=https://api.flamoral.com/auth/facebook/callback

# Apple OAuth
APPLE_CLIENT_ID=com.flamoral.app
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
APPLE_CALLBACK_URL=https://api.flamoral.com/auth/apple/callback

# =============================================================================
# =============================================================================
# Payment Gateway Configuration
# =============================================================================
# Enable/Disable Payment Providers
STRIPE_ENABLED=true
PAYSTACK_ENABLED=false
FLUTTERWAVE_ENABLED=false
APPLE_IAP_ENABLED=true
GOOGLE_PLAY_ENABLED=true

# =============================================================================
# Stripe (LIVE MODE - PRODUCTION) - Primary Payment Provider
# =============================================================================
# CRITICAL WARNING: These are LIVE keys that process real payments
# MANDATORY: ALL Stripe secrets MUST be stored in Azure Key Vault
STRIPE_SECRET_KEY=*** # STORED IN AZURE KEY VAULT: flamoral-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=*** # STORED IN AZURE KEY VAULT: flamoral-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=*** # STORED IN AZURE KEY VAULT: flamoral-stripe-webhook-secret
STRIPE_API_VERSION=2024-12-18.acacia

# =============================================================================
# Paystack (DISABLED - Stub Implementation Only)
# =============================================================================
# PAYSTACK_SECRET_KEY=*** # STORED IN AZURE KEY VAULT when enabled
# PAYSTACK_PUBLIC_KEY=pk_live_...

# =============================================================================
# Flutterwave (DISABLED - Stub Implementation Only)
# =============================================================================
# FLUTTERWAVE_SECRET_KEY=*** # STORED IN AZURE KEY VAULT when enabled
# FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_...
# =============================================================================
# Email Service - SendGrid (Production)
# =============================================================================
SENDGRID_API_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
SENDGRID_FROM_EMAIL=noreply@flamoral.com
SENDGRID_FROM_NAME=Flamoral

# =============================================================================
# SMS Service - Twilio (Production)
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=*** # MANDATORY: STORED IN AZURE KEY VAULT
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Azure Storage (Production - Premium Performance Tier)
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoralprodst
AZURE_STORAGE_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
AZURE_STORAGE_CONNECTION_STRING=*** # MANDATORY: STORED IN AZURE KEY VAULT
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents
AZURE_STORAGE_CDN_ENDPOINT=https://cdn.flamoral.com

# =============================================================================
# Azure Cognitive Services
# =============================================================================
AZURE_FACE_API_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com
AZURE_CONTENT_MODERATOR_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
AZURE_CONTENT_MODERATOR_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# =============================================================================
# Video/Voice Calling - Agora (Production)
# =============================================================================
AGORA_APP_ID=your_production_agora_app_id
AGORA_APP_CERTIFICATE=*** # MANDATORY: STORED IN AZURE KEY VAULT
AGORA_CUSTOMER_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
AGORA_CUSTOMER_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT

# =============================================================================
# Push Notifications - Firebase (Production)
# =============================================================================
FIREBASE_PROJECT_ID=flamoral-production
FIREBASE_PRIVATE_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@flamoral-production.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://flamoral-production.firebaseio.com

# =============================================================================
# Error Tracking - Sentry (Production)
# =============================================================================
SENTRY_DSN=*** # MANDATORY: STORED IN AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_RELEASE=flamoral@1.0.0

# =============================================================================
# CORS Configuration (Strict Production)
# =============================================================================
CORS_ORIGIN=https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# Rate Limiting (Strict Production)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# Session Configuration (Secure Production)
# =============================================================================
SESSION_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT (min 32 chars)
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# =============================================================================
# File Upload Configuration
# =============================================================================
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
UPLOAD_VIRUS_SCAN_ENABLED=true

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_PORT=5000
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000
WS_MAX_CONNECTIONS_PER_USER=3
WS_RECONNECT_ATTEMPTS=5

# =============================================================================
# Feature Flags (Production)
# =============================================================================
FEATURE_AI_MATCHING=true
FEATURE_VIDEO_CALLS=true
FEATURE_TRAVEL_MODE=true
FEATURE_DATING_COACH=true
FEATURE_GAMIFICATION=true
FEATURE_SOCIAL_FEED=true
FEATURE_STORIES=true
FEATURE_BETA_FEATURES=false

# =============================================================================
# AI/ML Configuration
# =============================================================================
AI_MODEL_ENDPOINT=https://ai.flamoral.com
AI_MODEL_API_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
OPENAI_API_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# =============================================================================
# Monitoring and Observability
# =============================================================================
ENABLE_METRICS=true
ENABLE_TRACING=true
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090
GRAFANA_ENABLED=true
JAEGER_ENABLED=true
JAEGER_AGENT_HOST=jaeger-agent.flamoral-prod.svc.cluster.local
JAEGER_AGENT_PORT=6831
APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # MANDATORY: STORED IN AZURE KEY VAULT

# =============================================================================
# Development Tools (DISABLED in Production)
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_API_DOCS=false
ENABLE_DEBUG_LOGGING=false
ENABLE_VERBOSE_ERRORS=false
ENABLE_HOT_RELOAD=false

# =============================================================================
# Security Configuration (Maximum Security)
# =============================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# =============================================================================
# Search Service (Elasticsearch/OpenSearch - Production Cluster)
# =============================================================================
ELASTICSEARCH_URL=https://flamoral-prod-search.eastus.cloudapp.azure.com:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=*** # MANDATORY: STORED IN AZURE KEY VAULT
ELASTICSEARCH_INDEX=flamoral_prod

# =============================================================================
# Analytics Configuration
# =============================================================================
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=*** # MANDATORY: STORED IN AZURE KEY VAULT

# =============================================================================
# Geolocation Service
# =============================================================================
GOOGLE_MAPS_API_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
MAPBOX_ACCESS_TOKEN=*** # MANDATORY: STORED IN AZURE KEY VAULT
DEFAULT_LOCATION_RADIUS_KM=50

# =============================================================================
# Content Delivery Network (CDN)
# =============================================================================
CDN_ENABLED=true
CDN_URL=https://cdn.flamoral.com
CDN_CACHE_CONTROL=public, max-age=31536000
STATIC_ASSETS_URL=https://cdn.flamoral.com/static

# =============================================================================
# Background Jobs Configuration
# =============================================================================
ENABLE_BACKGROUND_JOBS=true
JOB_CONCURRENCY=20
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5000

# =============================================================================
# Data Retention and Privacy (GDPR/CCPA Compliance)
# =============================================================================
GDPR_ENABLED=true
CCPA_ENABLED=true
DATA_RETENTION_DAYS=730
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365

# =============================================================================
# Localization
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh
DEFAULT_TIMEZONE=UTC

# =============================================================================
# Business Rules
# =============================================================================
MIN_AGE=18
MAX_AGE=100
FREE_LIKES_PER_DAY=10
FREE_SUPER_LIKES_PER_DAY=1
MATCH_EXPIRY_DAYS=30
MESSAGE_RETENTION_DAYS=365

# =============================================================================
# Azure Key Vault Integration (MANDATORY for Production)
# =============================================================================
KEY_VAULT_NAME=flamoral-prod-kv
KEY_VAULT_URI=https://flamoral-prod-kv.vault.azure.net/
KEY_VAULT_MANAGED_IDENTITY_ENABLED=true
KEY_VAULT_TENANT_ID=*** # MANDATORY: STORED IN AZURE KEY VAULT
KEY_VAULT_CLIENT_ID=*** # MANDATORY: STORED IN AZURE KEY VAULT
KEY_VAULT_CLIENT_SECRET=*** # MANDATORY: STORED IN AZURE KEY VAULT

# =============================================================================
# Kubernetes Configuration (Production)
# =============================================================================
AKS_CLUSTER_NAME=flamoral-prod-aks
AKS_RESOURCE_GROUP=flamoral-prod-rg
NAMESPACE=flamoral-prod
REPLICA_COUNT=5
AUTOSCALING_ENABLED=true
AUTOSCALING_MIN_REPLICAS=5
AUTOSCALING_MAX_REPLICAS=50
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=80

# =============================================================================
# Resource Limits (Production - High Performance)
# =============================================================================
RESOURCE_REQUEST_MEMORY=1Gi
RESOURCE_REQUEST_CPU=1000m
RESOURCE_LIMIT_MEMORY=2Gi
RESOURCE_LIMIT_CPU=2000m

# =============================================================================
# SSL/TLS Configuration
# =============================================================================
SSL_ENABLED=true
SSL_FORCE_HTTPS=true
TLS_MIN_VERSION=1.2

# =============================================================================
# DDoS Protection & WAF
# =============================================================================
WAF_ENABLED=true
DDOS_PROTECTION_ENABLED=true

# =============================================================================
# Database Backup Configuration
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_ACCOUNT=flamoralbkupprodst

# =============================================================================
# Blue-Green Deployment
# =============================================================================
DEPLOYMENT_SLOT=blue
ENABLE_CANARY_DEPLOYMENT=true
CANARY_TRAFFIC_PERCENTAGE=10

# =============================================================================
# Business Intelligence & Analytics
# =============================================================================
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
FACEBOOK_PIXEL_ID=your_facebook_pixel_id

# =============================================================================
# Support and Helpdesk Integration
# =============================================================================
ZENDESK_ENABLED=true
ZENDESK_SUBDOMAIN=flamoral
ZENDESK_API_TOKEN=*** # MANDATORY: STORED IN AZURE KEY VAULT

# =============================================================================
# Production Alert Contacts
# =============================================================================
ALERT_EMAIL_PRODUCTION=alerts@flamoral.com
ALERT_EMAIL_DEVOPS=devops@flamoral.com
ONCALL_PHONE_NUMBER=+1234567890
PAGERDUTY_INTEGRATION_KEY=*** # MANDATORY: STORED IN AZURE KEY VAULT
