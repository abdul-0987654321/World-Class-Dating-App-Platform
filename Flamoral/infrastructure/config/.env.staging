# =============================================================================
# Flamoral Dating Platform - Staging Environment Configuration
# =============================================================================
# This file contains staging environment configuration
# Staging should mirror production as closely as possible
# =============================================================================

# =============================================================================
# Environment Settings
# =============================================================================
NODE_ENV=staging
ENVIRONMENT=staging
DEBUG=false
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# Service Configuration
# =============================================================================
PORT=3000
HOST=0.0.0.0

# =============================================================================
# API Gateway
# =============================================================================
API_GATEWAY_URL=https://api-staging.flamoral.com
API_VERSION=v1

# =============================================================================
# Service URLs (Internal Communication - K8s Service Discovery)
# =============================================================================
USER_SERVICE_URL=http://user-service.flamoral-staging.svc.cluster.local:3001
AUTH_SERVICE_URL=http://auth-service.flamoral-staging.svc.cluster.local:3011
MATCHING_SERVICE_URL=http://matching-service.flamoral-staging.svc.cluster.local:3002
MESSAGING_SERVICE_URL=http://messaging-service.flamoral-staging.svc.cluster.local:3003
MODERATION_SERVICE_URL=http://moderation-service.flamoral-staging.svc.cluster.local:3004
PAYMENT_SERVICE_URL=http://payment-service.flamoral-staging.svc.cluster.local:3005
MEDIA_SERVICE_URL=http://media-service.flamoral-staging.svc.cluster.local:3006
NOTIFICATION_SERVICE_URL=http://notification-service.flamoral-staging.svc.cluster.local:3008
ANALYTICS_SERVICE_URL=http://analytics-service.flamoral-staging.svc.cluster.local:3007
AI_SERVICE_URL=http://ai-service.flamoral-staging.svc.cluster.local:3009
ADVERTISING_SERVICE_URL=http://advertising-service.flamoral-staging.svc.cluster.local:3010
REALTIME_SERVICE_URL=http://realtime-service.flamoral-staging.svc.cluster.local:3012
ADMIN_SERVICE_URL=http://admin-service.flamoral-staging.svc.cluster.local:3013
AUTOMATION_SERVICE_URL=http://automation-service.flamoral-staging.svc.cluster.local:3014
WORKFLOW_ENGINE_URL=http://workflow-engine.flamoral-staging.svc.cluster.local:3015

# =============================================================================
# Frontend URLs
# =============================================================================
WEB_URL=https://staging.flamoral.com
ADMIN_URL=https://admin-staging.flamoral.com
MOBILE_APP_SCHEME=flamoral://

# =============================================================================
# Database - PostgreSQL (Azure Database for PostgreSQL)
# =============================================================================
DB_HOST=flamoral-staging-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral_staging
DB_USER=flamoral_admin
DB_PASSWORD=*** # STORED IN AZURE KEY VAULT
DB_POOL_MIN=5
DB_POOL_MAX=30
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_CONNECTION_TIMEOUT=30000
DATABASE_URL=*** # STORED IN AZURE KEY VAULT

# =============================================================================
# Database - MongoDB (Azure Cosmos DB with MongoDB API)
# =============================================================================
MONGODB_URI=*** # STORED IN AZURE KEY VAULT
MONGODB_DB=flamoral_staging
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=5

# =============================================================================
# Cache - Redis (Azure Cache for Redis - Standard Tier)
# =============================================================================
REDIS_HOST=flamoral-staging-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # STORED IN AZURE KEY VAULT
REDIS_DB=0
REDIS_URL=*** # STORED IN AZURE KEY VAULT
REDIS_TLS=true
REDIS_TTL=3600
REDIS_MAX_RETRIES=3

# =============================================================================
# Message Queue - Azure Service Bus
# =============================================================================
AZURE_SERVICE_BUS_CONNECTION_STRING=*** # STORED IN AZURE KEY VAULT
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue
QUEUE_MEDIA_PROCESSING=media_processing_queue
QUEUE_EMAIL=email_queue
QUEUE_SMS=sms_queue

# =============================================================================
# Authentication - JWT
# =============================================================================
JWT_SECRET=*** # STORED IN AZURE KEY VAULT (64+ chars)
JWT_ACCESS_SECRET=*** # STORED IN AZURE KEY VAULT (64+ chars)
JWT_REFRESH_SECRET=*** # STORED IN AZURE KEY VAULT (64+ chars)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=flamoral-staging

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=*** # STORED IN AZURE KEY VAULT
SERVICE_NAME=flamoral-service
SERVICE_TIMEOUT=30000

# =============================================================================
# OAuth Providers (Staging)
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-staging-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=*** # STORED IN AZURE KEY VAULT
GOOGLE_CALLBACK_URL=https://api-staging.flamoral.com/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-staging-facebook-app-id
FACEBOOK_APP_SECRET=*** # STORED IN AZURE KEY VAULT
FACEBOOK_CALLBACK_URL=https://api-staging.flamoral.com/auth/facebook/callback

# Apple OAuth
APPLE_CLIENT_ID=com.flamoral.staging
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=*** # STORED IN AZURE KEY VAULT
APPLE_CALLBACK_URL=https://api-staging.flamoral.com/auth/apple/callback

# =============================================================================
# Payment Gateway - Stripe (TEST MODE for Staging)
# =============================================================================
# All Stripe secrets stored in Azure Key Vault
STRIPE_SECRET_KEY=*** # STORED IN AZURE KEY VAULT: flamoral-staging-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=*** # STORED IN AZURE KEY VAULT: flamoral-staging-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=*** # STORED IN AZURE KEY VAULT: flamoral-staging-stripe-webhook-secret
STRIPE_API_VERSION=2024-12-18.acacia

# =============================================================================
# Email Service - SendGrid
# =============================================================================
SENDGRID_API_KEY=*** # STORED IN AZURE KEY VAULT
SENDGRID_FROM_EMAIL=staging@flamoral.com
SENDGRID_FROM_NAME=Flamoral Staging

# =============================================================================
# SMS Service - Twilio
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=*** # STORED IN AZURE KEY VAULT
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Azure Storage (Staging)
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoralstagingst
AZURE_STORAGE_KEY=*** # STORED IN AZURE KEY VAULT
AZURE_STORAGE_CONNECTION_STRING=*** # STORED IN AZURE KEY VAULT
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents
AZURE_STORAGE_CDN_ENDPOINT=https://cdn-staging.flamoral.com

# =============================================================================
# Azure Cognitive Services
# =============================================================================
AZURE_FACE_API_KEY=*** # STORED IN AZURE KEY VAULT
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com
AZURE_CONTENT_MODERATOR_KEY=*** # STORED IN AZURE KEY VAULT
AZURE_CONTENT_MODERATOR_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# =============================================================================
# Video/Voice Calling - Agora
# =============================================================================
AGORA_APP_ID=your_staging_agora_app_id
AGORA_APP_CERTIFICATE=*** # STORED IN AZURE KEY VAULT
AGORA_CUSTOMER_KEY=*** # STORED IN AZURE KEY VAULT
AGORA_CUSTOMER_SECRET=*** # STORED IN AZURE KEY VAULT

# =============================================================================
# Push Notifications - Firebase
# =============================================================================
FIREBASE_PROJECT_ID=flamoral-staging
FIREBASE_PRIVATE_KEY=*** # STORED IN AZURE KEY VAULT
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@flamoral-staging.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://flamoral-staging.firebaseio.com

# =============================================================================
# Error Tracking - Sentry
# =============================================================================
SENTRY_DSN=*** # STORED IN AZURE KEY VAULT
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.5
SENTRY_PROFILES_SAMPLE_RATE=0.5
SENTRY_RELEASE=flamoral@1.0.0-staging

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGIN=https://staging.flamoral.com,https://admin-staging.flamoral.com
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=*** # STORED IN AZURE KEY VAULT (min 32 chars)
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# =============================================================================
# File Upload Configuration
# =============================================================================
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime
UPLOAD_VIRUS_SCAN_ENABLED=true

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_PORT=5000
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000
WS_MAX_CONNECTIONS_PER_USER=3
WS_RECONNECT_ATTEMPTS=5

# =============================================================================
# Feature Flags (Staging - Test Production Features)
# =============================================================================
FEATURE_AI_MATCHING=true
FEATURE_VIDEO_CALLS=true
FEATURE_TRAVEL_MODE=true
FEATURE_DATING_COACH=true
FEATURE_GAMIFICATION=true
FEATURE_SOCIAL_FEED=true
FEATURE_STORIES=true
FEATURE_BETA_FEATURES=true

# =============================================================================
# AI/ML Configuration
# =============================================================================
AI_MODEL_ENDPOINT=https://ai-staging.flamoral.com
AI_MODEL_API_KEY=*** # STORED IN AZURE KEY VAULT
OPENAI_API_KEY=*** # STORED IN AZURE KEY VAULT
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# =============================================================================
# Monitoring and Observability
# =============================================================================
ENABLE_METRICS=true
ENABLE_TRACING=true
PROMETHEUS_PORT=9090
JAEGER_AGENT_HOST=jaeger-agent.flamoral-staging.svc.cluster.local
JAEGER_AGENT_PORT=6831
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # STORED IN AZURE KEY VAULT

# =============================================================================
# Development Tools (Limited in Staging)
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_API_DOCS=true
ENABLE_DEBUG_LOGGING=false
ENABLE_VERBOSE_ERRORS=false
ENABLE_HOT_RELOAD=false

# =============================================================================
# Security Configuration
# =============================================================================
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true

# =============================================================================
# Search Service (Elasticsearch/OpenSearch)
# =============================================================================
ELASTICSEARCH_URL=https://flamoral-staging-search.eastus.cloudapp.azure.com:9200
ELASTICSEARCH_INDEX=flamoral_staging

# =============================================================================
# Analytics Configuration
# =============================================================================
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=*** # STORED IN AZURE KEY VAULT

# =============================================================================
# Geolocation Service
# =============================================================================
GOOGLE_MAPS_API_KEY=*** # STORED IN AZURE KEY VAULT
MAPBOX_ACCESS_TOKEN=*** # STORED IN AZURE KEY VAULT
DEFAULT_LOCATION_RADIUS_KM=50

# =============================================================================
# Content Delivery Network (CDN)
# =============================================================================
CDN_ENABLED=true
CDN_URL=https://cdn-staging.flamoral.com
STATIC_ASSETS_URL=https://cdn-staging.flamoral.com/static

# =============================================================================
# Background Jobs Configuration
# =============================================================================
ENABLE_BACKGROUND_JOBS=true
JOB_CONCURRENCY=10
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5000

# =============================================================================
# Data Retention and Privacy
# =============================================================================
GDPR_ENABLED=true
CCPA_ENABLED=true
DATA_RETENTION_DAYS=730
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# =============================================================================
# Localization
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh
DEFAULT_TIMEZONE=UTC

# =============================================================================
# Business Rules
# =============================================================================
MIN_AGE=18
MAX_AGE=100
FREE_LIKES_PER_DAY=10
FREE_SUPER_LIKES_PER_DAY=1
MATCH_EXPIRY_DAYS=30
MESSAGE_RETENTION_DAYS=365

# =============================================================================
# Azure Key Vault Integration
# =============================================================================
KEY_VAULT_NAME=flamoral-staging-kv
KEY_VAULT_URI=https://flamoral-staging-kv.vault.azure.net/
KEY_VAULT_MANAGED_IDENTITY_ENABLED=true

# =============================================================================
# Kubernetes Configuration
# =============================================================================
AKS_CLUSTER_NAME=flamoral-staging-aks
AKS_RESOURCE_GROUP=flamoral-staging-rg
NAMESPACE=flamoral-staging
REPLICA_COUNT=3
AUTOSCALING_ENABLED=true
AUTOSCALING_MIN_REPLICAS=3
AUTOSCALING_MAX_REPLICAS=20

# =============================================================================
# Resource Limits
# =============================================================================
RESOURCE_REQUEST_MEMORY=512Mi
RESOURCE_REQUEST_CPU=500m
RESOURCE_LIMIT_MEMORY=1Gi
RESOURCE_LIMIT_CPU=1000m
