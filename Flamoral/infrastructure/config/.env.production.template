KEY_VAULT_ENABLED=true
KEY_VAULT_NAME=flamoral-prod-kv
KEY_VAULT_URI=https://flamoral-prod-kv.vault.azure.net/
KEY_VAULT_MANAGED_IDENTITY_ENABLED=true
KEY_VAULT_TENANT_ID=*** # MANDATORY: Azure Tenant ID
KEY_VAULT_CLIENT_ID=*** # MANDATORY: Service Principal Client ID
KEY_VAULT_CLIENT_SECRET=*** # MANDATORY: Service Principal Secret

# Secret Refresh Configuration
KEY_VAULT_SECRET_REFRESH_INTERVAL=3600000  # 1 hour
KEY_VAULT_CACHE_ENABLED=true

# =============================================================================
# KUBERNETES CONFIGURATION (Production AKS)
# =============================================================================

AKS_CLUSTER_NAME=flamoral-prod-aks
AKS_RESOURCE_GROUP=flamoral-prod-rg
NAMESPACE=flamoral-prod
REPLICA_COUNT=5

# Autoscaling
AUTOSCALING_ENABLED=true
AUTOSCALING_MIN_REPLICAS=5
AUTOSCALING_MAX_REPLICAS=50
TARGET_CPU_UTILIZATION=70
TARGET_MEMORY_UTILIZATION=80

# Pod Disruption Budget
PDB_MIN_AVAILABLE=3

