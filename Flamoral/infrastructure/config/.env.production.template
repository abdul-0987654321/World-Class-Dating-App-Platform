# =============================================================================

DEFAULT_LANGUAGE=en
DEFAULT_LOCALE=en-US
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh,ar,hi,ru
SUPPORTED_LOCALES=en-US,es-ES,fr-FR,de-DE,it-IT,pt-BR,ja-JP,ko-KR,zh-CN
TRANSLATION_API_KEY=*** # Optional: For automatic translations

# Date/Time Formats
DATE_FORMAT=YYYY-MM-DD
TIME_FORMAT=HH:mm:ss
DATETIME_FORMAT=YYYY-MM-DD HH:mm:ss

# =============================================================================
# BUSINESS RULES & LIMITS
# =============================================================================

# Age Restrictions
MIN_AGE=18
MAX_AGE=100

# Free Tier Limits
FREE_LIKES_PER_DAY=10
FREE_SUPER_LIKES_PER_DAY=1
FREE_REWINDS_PER_DAY=0
FREE_BOOSTS_PER_MONTH=0

# Premium Tier Benefits
PREMIUM_UNLIMITED_LIKES=true
PREMIUM_SUPER_LIKES_PER_DAY=5
PREMIUM_REWINDS_UNLIMITED=true
PREMIUM_BOOSTS_PER_MONTH=1

# Match & Message Limits
MATCH_EXPIRY_DAYS=30
MESSAGE_RETENTION_DAYS=365
MAX_ACTIVE_MATCHES=500
MAX_MESSAGE_LENGTH=2000
MAX_MESSAGES_PER_CONVERSATION=10000

# Profile Limits
MAX_PHOTOS=10
MAX_VIDEOS=3
MAX_BIO_LENGTH=500
MAX_INTERESTS=20

