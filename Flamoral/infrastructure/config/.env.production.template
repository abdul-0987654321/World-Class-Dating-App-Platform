# =============================================================================
# AUTHENTICATION & SECURITY - JWT
# =============================================================================

# JWT Secrets (CRITICAL - Must be cryptographically secure 64+ chars)
JWT_SECRET=*** # MANDATORY: STORE IN AZURE KEY VAULT - Min 64 chars
JWT_ACCESS_SECRET=*** # MANDATORY: STORE IN AZURE KEY VAULT - Min 64 chars
JWT_REFRESH_SECRET=*** # MANDATORY: STORE IN AZURE KEY VAULT - Min 64 chars

# JWT Configuration
JWT_ACCESS_EXPIRES_IN=15m               # Access token expiry
JWT_REFRESH_EXPIRES_IN=7d               # Refresh token expiry
JWT_ALGORITHM=HS256                     # Signing algorithm
JWT_ISSUER=flamoral-production
JWT_AUDIENCE=flamoral-app

# Session Configuration
SESSION_SECRET=*** # MANDATORY: STORE IN AZURE KEY VAULT - Min 32 chars
SESSION_MAX_AGE=86400000                # 24 hours in milliseconds
SESSION_SECURE=true                     # Require HTTPS
SESSION_HTTP_ONLY=true                  # Prevent XSS attacks
SESSION_SAME_SITE=strict                # CSRF protection
SESSION_NAME=flamoral_session_id

# =============================================================================
# SERVICE-TO-SERVICE AUTHENTICATION
# =============================================================================

# Service API Key (CRITICAL - Must be identical across all services)
SERVICE_API_KEY=*** # MANDATORY: STORE IN AZURE KEY VAULT - Min 64 chars
SERVICE_NAME=flamoral-production
SERVICE_TIMEOUT=30000                   # Request timeout between services

# =============================================================================
# PASSWORD SECURITY
# =============================================================================

# Bcrypt Configuration
BCRYPT_ROUNDS=12                        # Higher = more secure, but slower

# Password Policy
PASSWORD_MIN_LENGTH=8
PASSWORD_MAX_LENGTH=128
PASSWORD_REQUIRE_UPPERCASE=true
PASSWORD_REQUIRE_LOWERCASE=true
PASSWORD_REQUIRE_NUMBER=true
PASSWORD_REQUIRE_SPECIAL=true
PASSWORD_HISTORY_COUNT=5                # Prevent reusing last N passwords

# Account Security
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION=1800000        # 30 minutes in milliseconds
MFA_ENABLED=true
MFA_ISSUER=Flamoral

