JOB_RETRY_DELAY=5000                    # Delay between retries (ms)
JOB_TIMEOUT=300000                      # Job timeout (5 minutes)

# Scheduled Jobs
CRON_MATCH_GENERATION=0 */6 * * *       # Every 6 hours
CRON_CLEANUP_EXPIRED_MATCHES=0 2 * * *  # Daily at 2 AM
CRON_ANALYTICS_AGGREGATION=0 1 * * *    # Daily at 1 AM
CRON_BACKUP_DATABASE=0 3 * * *          # Daily at 3 AM
CRON_SEND_DIGEST_EMAILS=0 9 * * *       # Daily at 9 AM

# =============================================================================
# DATA RETENTION & PRIVACY (GDPR/CCPA Compliance)
# =============================================================================

GDPR_ENABLED=true
CCPA_ENABLED=true
DATA_RETENTION_DAYS=730                 # 2 years
INACTIVE_USER_RETENTION_DAYS=365        # 1 year
MESSAGE_RETENTION_DAYS=365              # 1 year
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=365
ANONYMIZE_DELETED_USERS=true

# Data Export
DATA_EXPORT_ENABLED=true
DATA_EXPORT_FORMAT=json                 # Options: json, csv

# Right to Erasure
DATA_DELETION_GRACE_PERIOD=30           # Days before permanent deletion

# =============================================================================
