# =============================================================================
# Flamoral Dating Platform - Staging Environment Configuration
# SECURITY HARDENING ENABLED (Balanced for Testing)
# =============================================================================
# Copy this file to terraform.tfvars and update with your values
# DO NOT commit terraform.tfvars to version control
# =============================================================================

# =============================================================================
# Azure Authentication (Required)
# =============================================================================
tenant_id = "YOUR_TENANT_ID_HERE"

# =============================================================================
# SECURITY: AKS API Server Access Control
# =============================================================================
# Staging allows broader access for testing, but still restricted
authorized_ip_ranges = [
  "203.0.113.0/24",   # Office network
  "198.51.100.0/24"   # Developer VPN range
]

# =============================================================================
# SECURITY: Disk Encryption
# =============================================================================
# Enable encryption for staging to match production behavior
enable_disk_encryption = true

# =============================================================================
# SECURITY: Key Vault Protection
# =============================================================================
# Disable purge protection for staging (easier cleanup)
enable_purge_protection = false

# Shorter retention for staging
soft_delete_retention_days = 7

# =============================================================================
# SECURITY: WAF Configuration
# =============================================================================
# Detection mode for staging - logs without blocking
waf_mode = "Detection"

# Disable geo-filtering for staging (testing from anywhere)
enable_geo_filtering = false

# =============================================================================
# Environment Configuration
# =============================================================================
location            = "westus2"
resource_group_name = "flamoral-staging-rg"

# =============================================================================
# Network Configuration
# =============================================================================
vnet_address_space              = ["10.20.0.0/16"]
aks_subnet_prefix               = "10.20.1.0/24"
db_subnet_prefix                = "10.20.2.0/24"
redis_subnet_prefix             = "10.20.3.0/24"
private_endpoints_subnet_prefix = "10.20.4.0/24"

# =============================================================================
# AKS Staging Configuration (Smaller than production)
# =============================================================================
kubernetes_version = "1.28.3"

# System node pool
system_node_size      = "Standard_D2s_v3"  # 2 vCPU, 8 GB RAM
system_node_count     = 2
system_node_min_count = 2
system_node_max_count = 3
system_node_disk_size = 64

# User node pool
user_node_size      = "Standard_D4s_v3"  # 4 vCPU, 16 GB RAM
user_node_count     = 2
user_node_min_count = 2
user_node_max_count = 5
user_node_disk_size = 128

# =============================================================================
# PostgreSQL Staging Configuration
# =============================================================================
postgres_version                = "15"
postgres_sku_name               = "B_Standard_B2s"  # 2 vCores (Burstable)
postgres_storage_mb             = 32768             # 32 GB
postgres_backup_retention_days  = 7                 # 1 week
postgres_geo_redundant_backup   = false             # Single region

# =============================================================================
# Redis Staging Configuration
# =============================================================================
redis_sku_name  = "Standard"  # Standard tier (no VNet injection)
redis_family    = "C"
redis_capacity  = 1           # C1 = 1 GB cache

# =============================================================================
# Storage Configuration
# =============================================================================
storage_replication_type = "LRS"  # Locally redundant (cheaper for staging)

# =============================================================================
# Monitoring Configuration
# =============================================================================
log_analytics_retention_days = 30  # 1 month retention

# =============================================================================
# SignalR Staging Configuration
# =============================================================================
signalr_sku      = "Standard_S1"
signalr_capacity = 1

# =============================================================================
# Resource Tags
# =============================================================================
tags = {
  Project       = "Flamoral"
  Environment   = "staging"
  ManagedBy     = "Terraform"
  Owner         = "Engineering"
  Application   = "Dating Platform"
  CostCenter    = "Development"
  AccessLevel   = "Internal"
  SecurityLevel = "Medium"
  AutoShutdown  = "Enabled"
}

# =============================================================================
# NOTES
# =============================================================================
# 1. Staging uses smaller SKUs to reduce costs
# 2. WAF in Detection mode to avoid blocking legitimate test traffic
# 3. No purge protection - easier to destroy and recreate
# 4. No geo-redundancy to save costs
# 5. Shorter retention periods
# =============================================================================
