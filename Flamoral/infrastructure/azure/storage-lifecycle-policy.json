{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "description": "Azure Blob Storage Lifecycle Management Policy for Flamoral Dating Platform - Cost Optimization",
    "version": "1.0.0",
    "lastUpdated": "2025-12-13"
  },
  "lifecycleRules": [
    {
      "enabled": true,
      "name": "profilePhotosHotTier",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": [
            "avatars/",
            "photos/profile/"
          ]
        },
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 30
            },
            "tierToArchive": null,
            "delete": null
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 30
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "albumPhotosCoolTier",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": [
            "photos/albums/",
            "photos/gallery/"
          ]
        },
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 30
            },
            "tierToArchive": {
              "daysAfterModificationGreaterThan": 90
            },
            "delete": null
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 60
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "verificationPhotosArchive",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["verification/"]
        },
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 7
            },
            "tierToArchive": {
              "daysAfterModificationGreaterThan": 14
            },
            "delete": null
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 14
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "temporaryUploadsCleanup",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": [
            "temp/",
            "uploads/temp/",
            "processing/"
          ]
        },
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": 7
            }
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 1
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "softDeletedItemsCleanup",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"]
        },
        "actions": {
          "baseBlob": {
            "delete": {
              "daysAfterModificationGreaterThan": null
            }
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 14
            }
          },
          "version": {
            "delete": {
              "daysAfterCreationGreaterThan": 14
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "thumbnailsOptimization",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["thumbnails/"]
        },
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 60
            },
            "tierToArchive": {
              "daysAfterModificationGreaterThan": 180
            },
            "delete": null
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 30
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "videosOptimization",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["videos/"]
        },
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 45
            },
            "tierToArchive": {
              "daysAfterModificationGreaterThan": 120
            },
            "delete": null
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 45
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "inactiveUserPhotosArchive",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": ["photos/inactive/"]
        },
        "actions": {
          "baseBlob": {
            "tierToArchive": {
              "daysAfterModificationGreaterThan": 30
            },
            "delete": {
              "daysAfterModificationGreaterThan": 365
            }
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 30
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "originalPhotosArchive",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": [
            "photos/original/",
            "*/original/"
          ]
        },
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 60
            },
            "tierToArchive": {
              "daysAfterModificationGreaterThan": 180
            },
            "delete": null
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 90
            }
          }
        }
      }
    },
    {
      "enabled": true,
      "name": "standardHdPhotosOptimization",
      "type": "Lifecycle",
      "definition": {
        "filters": {
          "blobTypes": ["blockBlob"],
          "prefixMatch": [
            "*/standard/",
            "*/hd/"
          ]
        },
        "actions": {
          "baseBlob": {
            "tierToCool": {
              "daysAfterModificationGreaterThan": 45
            },
            "tierToArchive": {
              "daysAfterModificationGreaterThan": 120
            },
            "delete": null
          },
          "snapshot": {
            "delete": {
              "daysAfterCreationGreaterThan": 60
            }
          }
        }
      }
    }
  ],
  "deploymentInstructions": {
    "cli": "az storage account management-policy create --account-name <storage-account-name> --policy @storage-lifecycle-policy.json --resource-group <resource-group-name>",
    "powershell": "Set-AzStorageAccountManagementPolicy -ResourceGroupName <resource-group-name> -AccountName <storage-account-name> -Policy (Get-Content -Path storage-lifecycle-policy.json -Raw)",
    "terraform": "Use the azurerm_storage_management_policy resource in Terraform"
  },
  "estimatedSavings": {
    "description": "Expected cost savings from lifecycle policies",
    "profilePhotos": "15-20% reduction by moving to Cool tier after 30 days",
    "albumPhotos": "30-40% reduction by tiering to Cool (30d) and Archive (90d)",
    "verificationPhotos": "60-70% reduction by quick archival (14d) after approval",
    "temporaryFiles": "100% savings by deleting temp files after 7 days",
    "thumbnails": "25-35% reduction by archiving old thumbnails",
    "videos": "40-50% reduction by tiering based on access patterns",
    "overallEstimate": "35-45% total storage cost reduction"
  }
}
