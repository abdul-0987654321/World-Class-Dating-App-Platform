user nginx;
worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 4096;
    use epoll;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    # Logging - enhanced for debugging and monitoring
    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" "$http_x_forwarded_for" '
                    'rt=$request_time uct="$upstream_connect_time" '
                    'uht="$upstream_header_time" urt="$upstream_response_time"';

    log_format json_combined escape=json '{'
        '"time":"$time_iso8601",'
        '"remote_addr":"$remote_addr",'
        '"request_id":"$request_id",'
        '"request":"$request",'
        '"status":$status,'
        '"body_bytes_sent":$body_bytes_sent,'
        '"request_time":$request_time,'
        '"upstream_response_time":"$upstream_response_time",'
        '"upstream_connect_time":"$upstream_connect_time",'
        '"upstream_status":"$upstream_status",'
        '"http_referrer":"$http_referer",'
        '"http_user_agent":"$http_user_agent"'
    '}';

    access_log /var/log/nginx/access.log main;

    # WebSocket upgrade map - CRITICAL for WebSocket support
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Performance
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    server_tokens off;

    # Buffer sizes
    client_body_buffer_size 128k;
    client_max_body_size 50m;
    client_header_buffer_size 1k;
    large_client_header_buffers 4 16k;

    # Timeouts - CRITICAL: NGINX timeout > API Gateway timeout
    # API Gateway has max 45s timeout (media service), so NGINX should be 60s
    client_body_timeout 60;
    client_header_timeout 30;
    send_timeout 60;

    # Proxy timeouts - must be greater than backend service timeouts
    proxy_connect_timeout 10;     # Time to establish connection
    proxy_send_timeout 60;        # Time to send request to backend
    proxy_read_timeout 60;        # Time to read response from backend

    # ===================================================================
    # UPSTREAM DEFINITIONS - All backend microservices
    # ===================================================================

    # API Gateway - Main entry point for all API requests
    upstream api_gateway {
        least_conn;
        server api-gateway:4000 max_fails=3 fail_timeout=30s;
        keepalive 32;
        keepalive_requests 100;
        keepalive_timeout 60s;
    }

    # User Service - User management and profiles
    upstream user_service {
        least_conn;
        server user-service:4001 max_fails=3 fail_timeout=30s;
        keepalive 16;
        keepalive_requests 100;
        keepalive_timeout 60s;
    }

    # Matching Service - Recommendation engine and matching
    upstream matching_service {
        least_conn;
        server matching-service:4002 max_fails=3 fail_timeout=30s;
        keepalive 16;
        keepalive_requests 100;
        keepalive_timeout 60s;
    }

    # Media Service - Image/video uploads and processing
    upstream media_service {
        least_conn;
        server media-service:4003 max_fails=3 fail_timeout=30s;
        keepalive 16;
        keepalive_requests 100;
        keepalive_timeout 60s;
    }

    # Messaging Service - Real-time chat and messaging
    upstream messaging_service {
        least_conn;
        server messaging-service:4004 max_fails=3 fail_timeout=30s;
        keepalive 16;
        keepalive_requests 100;
        keepalive_timeout 60s;
    }

    # Notification Service - Push notifications and alerts
    upstream notification_service {
        least_conn;
        server notification-service:4005 max_fails=3 fail_timeout=30s;
        keepalive 16;
        keepalive_requests 100;
        keepalive_timeout 60s;
    }

    # Frontend - Web application
    upstream frontend {
        least_conn;
        server frontend:3000 max_fails=3 fail_timeout=30s;
        keepalive 16;
        keepalive_requests 100;
        keepalive_timeout 60s;
    }

    # ===================================================================
    # GZIP COMPRESSION
    # ===================================================================
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml text/javascript
               application/json application/javascript application/xml+rss
               application/rss+xml font/truetype font/opentype
               application/vnd.ms-fontobject image/svg+xml;
    gzip_disable "msie6";

    # ===================================================================
    # RATE LIMITING - Protection against abuse
    # ===================================================================
    limit_req_zone $binary_remote_addr zone=general:10m rate=20r/s;
    limit_req_zone $binary_remote_addr zone=auth:10m rate=5r/m;
    limit_req_zone $binary_remote_addr zone=api:10m rate=100r/s;
    limit_req_zone $binary_remote_addr zone=websocket:10m rate=10r/s;
    limit_req_status 429;

    # Connection limiting - increased for modern apps
    limit_conn_zone $binary_remote_addr zone=addr:10m;
    limit_conn addr 20;

    # ===================================================================
    # ERROR RESPONSE MAPPING
    # ===================================================================
    map $status $error_message {
        429 '{"error":"Too Many Requests","message":"Rate limit exceeded. Please retry later.","retryAfter":60}';
        502 '{"error":"Bad Gateway","message":"Service temporarily unavailable. Please retry."}';
        503 '{"error":"Service Unavailable","message":"Service temporarily unavailable. Please retry."}';
        504 '{"error":"Gateway Timeout","message":"Request timed out. Please retry."}';
        default '{"error":"Server Error","message":"An unexpected error occurred."}';
    }

    # Include server configurations
    include /etc/nginx/conf.d/*.conf;
}
