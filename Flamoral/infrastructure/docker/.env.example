# Flamoral Dating Platform - Docker Environment Configuration
# Copy this file to .env and update with your actual values

# ============================================================================
# Infrastructure Configuration
# ============================================================================

# PostgreSQL
POSTGRES_USER=flamoral
POSTGRES_PASSWORD=flamoral_dev_pass_change_in_production
POSTGRES_DB=flamoral

# Redis
REDIS_PASSWORD=flamoral_redis_pass_change_in_production

# MongoDB
MONGO_USER=flamoral
MONGO_PASSWORD=flamoral_mongo_pass_change_in_production

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123_change_in_production

# RabbitMQ
RABBITMQ_USER=flamoral
RABBITMQ_PASSWORD=flamoral_rabbit_pass_change_in_production

# ============================================================================
# Application Configuration
# ============================================================================

# JWT Configuration
JWT_SECRET=dev_jwt_secret_change_in_production_use_strong_random_string
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=10

# ============================================================================
# Third-Party Services
# ============================================================================

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@flamoral.com
SENDGRID_FROM_NAME=Flamoral

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Cloud Messaging
FCM_SERVER_KEY=your_firebase_server_key
FCM_PROJECT_ID=your_firebase_project_id

# Azure Storage (if using instead of MinIO)
AZURE_STORAGE_ACCOUNT=your_storage_account
AZURE_STORAGE_KEY=your_storage_key
AZURE_STORAGE_CONTAINER=flamoral-media

# Azure Computer Vision
AZURE_COMPUTER_VISION_KEY=your_computer_vision_key
AZURE_COMPUTER_VISION_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# Azure Content Moderator
AZURE_CONTENT_MODERATOR_KEY=your_content_moderator_key
AZURE_CONTENT_MODERATOR_ENDPOINT=https://your-region.api.cognitive.microsoft.com/

# OpenAI (for AI services)
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_ORGANIZATION=org-your_organization

# Agora (for video calls)
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# ============================================================================
# Azure Container Registry (for deployment)
# ============================================================================

ACR_NAME=flamoral
ACR_LOGIN_SERVER=flamoral.azurecr.io

# Azure Service Principal (for CI/CD)
AZURE_CLIENT_ID=your_service_principal_client_id
AZURE_CLIENT_SECRET=your_service_principal_client_secret
AZURE_TENANT_ID=your_azure_tenant_id
AZURE_SUBSCRIPTION_ID=your_azure_subscription_id

# ============================================================================
# Monitoring & Logging
# ============================================================================

# Application Insights
APPINSIGHTS_INSTRUMENTATION_KEY=your_app_insights_key

# Log Level
LOG_LEVEL=info

# ============================================================================
# Feature Flags
# ============================================================================

ENABLE_SWAGGER=true
ENABLE_DEBUG=false
ENABLE_RATE_LIMITING=true
ENABLE_CORS=true

# ============================================================================
# Service URLs (for production deployment)
# ============================================================================

# API Gateway
API_GATEWAY_URL=http://api-gateway:4000

# Backend Services
AUTH_SERVICE_URL=http://auth-service:4001
USER_SERVICE_URL=http://user-service:4002
MATCHING_SERVICE_URL=http://matching-service:4003
MESSAGING_SERVICE_URL=http://messaging-service:4004
MEDIA_SERVICE_URL=http://media-service:4005
PAYMENT_SERVICE_URL=http://payment-service:4006
NOTIFICATION_SERVICE_URL=http://notification-service:4007
ANALYTICS_SERVICE_URL=http://analytics-service:4008
MODERATION_SERVICE_URL=http://moderation-service:4009
ADMIN_SERVICE_URL=http://admin-service:4010
REALTIME_SERVICE_URL=http://realtime-service:4011

# AI Services
RECOMMENDATION_SERVICE_URL=http://recommendation-service:5000
NLP_SERVICE_URL=http://nlp-service:5001
PHOTO_ANALYSIS_URL=http://photo-analysis:5002
FRAUD_DETECTION_URL=http://fraud-detection:5003
DATING_COACH_URL=http://dating-coach-service:5004
CONTENT_GENERATOR_URL=http://content-generator:5005
