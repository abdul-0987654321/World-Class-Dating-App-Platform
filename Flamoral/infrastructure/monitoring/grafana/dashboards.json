{
  "dashboards": [
    {
      "name": "API Performance Dashboard",
      "uid": "api-performance",
      "panels": [
        {
          "title": "Request Rate",
          "targets": [
            {
              "expr": "sum(rate(http_requests_total[5m])) by (service)"
            }
          ]
        },
        {
          "title": "Error Rate",
          "targets": [
            {
              "expr": "sum(rate(http_requests_total{status=~\"5..\"}[5m])) by (service) / sum(rate(http_requests_total[5m])) by (service)"
            }
          ]
        },
        {
          "title": "Response Time (p95)",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (service, le))"
            }
          ]
        },
        {
          "title": "Response Time (p99)",
          "targets": [
            {
              "expr": "histogram_quantile(0.99, sum(rate(http_request_duration_seconds_bucket[5m])) by (service, le))"
            }
          ]
        }
      ]
    },
    {
      "name": "Database Metrics Dashboard",
      "uid": "database-metrics",
      "panels": [
        {
          "title": "Active Connections",
          "targets": [
            {
              "expr": "pg_stat_database_numbackends"
            }
          ]
        },
        {
          "title": "Transactions per Second",
          "targets": [
            {
              "expr": "rate(pg_stat_database_xact_commit[5m]) + rate(pg_stat_database_xact_rollback[5m])"
            }
          ]
        },
        {
          "title": "Query Duration",
          "targets": [
            {
              "expr": "rate(pg_stat_activity_max_tx_duration[5m])"
            }
          ]
        },
        {
          "title": "Cache Hit Ratio",
          "targets": [
            {
              "expr": "sum(pg_stat_database_blks_hit) / (sum(pg_stat_database_blks_hit) + sum(pg_stat_database_blks_read))"
            }
          ]
        },
        {
          "title": "Database Size",
          "targets": [
            {
              "expr": "pg_database_size_bytes"
            }
          ]
        },
        {
          "title": "Deadlocks",
          "targets": [
            {
              "expr": "rate(pg_stat_database_deadlocks[5m])"
            }
          ]
        }
      ]
    },
    {
      "name": "Redis Metrics Dashboard",
      "uid": "redis-metrics",
      "panels": [
        {
          "title": "Memory Usage",
          "targets": [
            {
              "expr": "redis_memory_used_bytes / redis_memory_max_bytes * 100"
            }
          ]
        },
        {
          "title": "Connected Clients",
          "targets": [
            {
              "expr": "redis_connected_clients"
            }
          ]
        },
        {
          "title": "Commands per Second",
          "targets": [
            {
              "expr": "rate(redis_commands_processed_total[5m])"
            }
          ]
        },
        {
          "title": "Cache Hit Rate",
          "targets": [
            {
              "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m]))"
            }
          ]
        },
        {
          "title": "Evicted Keys",
          "targets": [
            {
              "expr": "rate(redis_evicted_keys_total[5m])"
            }
          ]
        },
        {
          "title": "Network I/O",
          "targets": [
            {
              "expr": "rate(redis_net_input_bytes_total[5m])"
            },
            {
              "expr": "rate(redis_net_output_bytes_total[5m])"
            }
          ]
        }
      ]
    },
    {
      "name": "WebSocket Connections Dashboard",
      "uid": "websocket-metrics",
      "panels": [
        {
          "title": "Active WebSocket Connections",
          "targets": [
            {
              "expr": "websocket_connections_active"
            }
          ]
        },
        {
          "title": "Connection Rate",
          "targets": [
            {
              "expr": "rate(websocket_connections_total[5m])"
            }
          ]
        },
        {
          "title": "Disconnect Rate",
          "targets": [
            {
              "expr": "rate(websocket_disconnects_total[5m])"
            }
          ]
        },
        {
          "title": "Messages per Second",
          "targets": [
            {
              "expr": "rate(websocket_messages_sent_total[5m])"
            },
            {
              "expr": "rate(websocket_messages_received_total[5m])"
            }
          ]
        },
        {
          "title": "Connection Duration",
          "targets": [
            {
              "expr": "histogram_quantile(0.95, sum(rate(websocket_connection_duration_seconds_bucket[5m])) by (le))"
            }
          ]
        }
      ]
    },
    {
      "name": "Business Metrics Dashboard",
      "uid": "business-metrics",
      "panels": [
        {
          "title": "Active Users (DAU)",
          "targets": [
            {
              "expr": "count(count_over_time(user_activity[24h]))"
            }
          ]
        },
        {
          "title": "New Registrations",
          "targets": [
            {
              "expr": "sum(increase(user_registration_total[1h]))"
            }
          ]
        },
        {
          "title": "Matches Created",
          "targets": [
            {
              "expr": "sum(rate(matches_created_total[5m]))"
            }
          ]
        },
        {
          "title": "Messages Sent",
          "targets": [
            {
              "expr": "sum(rate(messages_sent_total[5m]))"
            }
          ]
        },
        {
          "title": "Match Success Rate",
          "targets": [
            {
              "expr": "sum(rate(matches_accepted_total[5m])) / sum(rate(matches_created_total[5m]))"
            }
          ]
        },
        {
          "title": "User Engagement Score",
          "targets": [
            {
              "expr": "avg(user_engagement_score)"
            }
          ]
        },
        {
          "title": "Premium Subscriptions",
          "targets": [
            {
              "expr": "sum(premium_subscriptions_active)"
            }
          ]
        },
        {
          "title": "Revenue (Daily)",
          "targets": [
            {
              "expr": "sum(increase(revenue_total[24h]))"
            }
          ]
        }
      ]
    },
    {
      "name": "Infrastructure Overview",
      "uid": "infrastructure-overview",
      "panels": [
        {
          "title": "CPU Usage by Node",
          "targets": [
            {
              "expr": "100 - (avg by (node) (irate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)"
            }
          ]
        },
        {
          "title": "Memory Usage by Node",
          "targets": [
            {
              "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100"
            }
          ]
        },
        {
          "title": "Network Traffic",
          "targets": [
            {
              "expr": "rate(node_network_receive_bytes_total[5m])"
            },
            {
              "expr": "rate(node_network_transmit_bytes_total[5m])"
            }
          ]
        },
        {
          "title": "Disk I/O",
          "targets": [
            {
              "expr": "rate(node_disk_read_bytes_total[5m])"
            },
            {
              "expr": "rate(node_disk_written_bytes_total[5m])"
            }
          ]
        },
        {
          "title": "Pod Count by Namespace",
          "targets": [
            {
              "expr": "count(kube_pod_info) by (namespace)"
            }
          ]
        },
        {
          "title": "Container Restarts",
          "targets": [
            {
              "expr": "sum(rate(kube_pod_container_status_restarts_total[15m])) by (namespace, pod)"
            }
          ]
        }
      ]
    }
  ]
}
