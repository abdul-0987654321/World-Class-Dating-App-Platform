{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Flamoral Platform Environment Schema",
  "description": "Schema for validating environment variables across dev/staging/prod",
  "type": "object",
  "definitions": {
    "common": {
      "type": "object",
      "properties": {
        "NODE_VERSION": {
          "type": "string",
          "default": "20",
          "description": "Node.js version"
        },
        "NODE_ENV": {
          "type": "string",
          "enum": ["development", "staging", "production", "test"],
          "description": "Node environment"
        }
      },
      "required": ["NODE_VERSION"]
    },
    "azure": {
      "type": "object",
      "properties": {
        "AZURE_CLIENT_ID": {
          "type": "string",
          "description": "Azure Service Principal Client ID"
        },
        "AZURE_CLIENT_SECRET": {
          "type": "string",
          "description": "Azure Service Principal Client Secret (secret)"
        },
        "AZURE_TENANT_ID": {
          "type": "string",
          "description": "Azure Tenant ID"
        },
        "AZURE_SUBSCRIPTION_ID": {
          "type": "string",
          "description": "Azure Subscription ID"
        },
        "AZURE_CREDENTIALS": {
          "type": "string",
          "description": "Azure credentials JSON (secret)"
        }
      },
      "required": ["AZURE_CLIENT_ID", "AZURE_TENANT_ID", "AZURE_SUBSCRIPTION_ID"]
    },
    "acr": {
      "type": "object",
      "properties": {
        "ACR_NAME": {
          "type": "string",
          "description": "Azure Container Registry name"
        },
        "ACR_LOGIN_SERVER": {
          "type": "string",
          "description": "ACR login server URL"
        }
      },
      "required": ["ACR_NAME"]
    },
    "notifications": {
      "type": "object",
      "properties": {
        "SLACK_WEBHOOK_URL": {
          "type": "string",
          "description": "Slack webhook for notifications (secret)"
        },
        "SLACK_SECURITY_WEBHOOK": {
          "type": "string",
          "description": "Slack webhook for security alerts (secret)"
        },
        "TEAMS_WEBHOOK_URL": {
          "type": "string",
          "description": "Microsoft Teams webhook URL (secret)"
        }
      }
    },
    "security": {
      "type": "object",
      "properties": {
        "SNYK_TOKEN": {
          "type": "string",
          "description": "Snyk API token (secret)"
        },
        "GITHUB_TOKEN": {
          "type": "string",
          "description": "GitHub token for API access (secret)"
        }
      }
    },
    "testing": {
      "type": "object",
      "properties": {
        "TEST_USER_EMAIL": {
          "type": "string",
          "description": "Test user email for E2E tests (secret)"
        },
        "TEST_USER_PASSWORD": {
          "type": "string",
          "description": "Test user password (secret)"
        }
      }
    }
  },
  "environments": {
    "dev": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        { "$ref": "#/definitions/azure" },
        { "$ref": "#/definitions/acr" }
      ],
      "properties": {
        "DEV_RESOURCE_GROUP": {
          "type": "string",
          "default": "flamoral-dev-rg",
          "description": "Azure resource group for dev"
        },
        "DEV_AKS_CLUSTER": {
          "type": "string",
          "default": "flamoral-dev-aks",
          "description": "AKS cluster name for dev"
        },
        "DEV_API_URL": {
          "type": "string",
          "description": "API URL for dev environment"
        },
        "DEV_URL": {
          "type": "string",
          "description": "Application URL for dev"
        }
      },
      "required": ["DEV_RESOURCE_GROUP", "DEV_AKS_CLUSTER"]
    },
    "staging": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        { "$ref": "#/definitions/azure" },
        { "$ref": "#/definitions/acr" },
        { "$ref": "#/definitions/testing" }
      ],
      "properties": {
        "STAGING_RESOURCE_GROUP": {
          "type": "string",
          "description": "Azure resource group for staging"
        },
        "STAGING_AKS_CLUSTER": {
          "type": "string",
          "description": "AKS cluster name for staging"
        },
        "STAGING_URL": {
          "type": "string",
          "description": "Application URL for staging"
        },
        "STAGING_API_URL": {
          "type": "string",
          "description": "API URL for staging"
        }
      },
      "required": ["STAGING_RESOURCE_GROUP", "STAGING_AKS_CLUSTER", "STAGING_URL"]
    },
    "prod": {
      "allOf": [
        { "$ref": "#/definitions/common" },
        { "$ref": "#/definitions/azure" },
        { "$ref": "#/definitions/acr" },
        { "$ref": "#/definitions/notifications" }
      ],
      "properties": {
        "PROD_RESOURCE_GROUP": {
          "type": "string",
          "description": "Azure resource group for production"
        },
        "PROD_AKS_CLUSTER": {
          "type": "string",
          "description": "AKS cluster name for production"
        }
      },
      "required": ["PROD_RESOURCE_GROUP", "PROD_AKS_CLUSTER"]
    }
  },
  "secrets": {
    "description": "List of secret names that should never be logged",
    "items": [
      "AZURE_CLIENT_SECRET",
      "AZURE_CREDENTIALS",
      "SNYK_TOKEN",
      "GITHUB_TOKEN",
      "SLACK_WEBHOOK_URL",
      "SLACK_SECURITY_WEBHOOK",
      "TEAMS_WEBHOOK_URL",
      "TEST_USER_PASSWORD",
      "DATABASE_URL",
      "REDIS_URL",
      "JWT_SECRET",
      "JWT_REFRESH_SECRET",
      "STRIPE_SECRET_KEY",
      "STRIPE_WEBHOOK_SECRET",
      "PAYSTACK_SECRET_KEY",
      "FLUTTERWAVE_SECRET_KEY",
      "SENDGRID_API_KEY",
      "TWILIO_AUTH_TOKEN"
    ]
  }
}
