{
  "queryName": "Bug Tracking Dashboard",
  "description": "Comprehensive bug tracking and analysis",
  "queryType": "hierarchical",

  "queries": [
    {
      "name": "Active Bugs",
      "wiql": "SELECT [System.Id], [System.Title], [System.AssignedTo], [Microsoft.VSTS.Common.Severity], [Microsoft.VSTS.Common.Priority], [System.CreatedDate], [System.State], [System.Tags] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [System.State] IN ('New', 'Active', 'Committed') ORDER BY [Microsoft.VSTS.Common.Severity] ASC, [Microsoft.VSTS.Common.Priority] ASC",
      "description": "All bugs currently in progress"
    },

    {
      "name": "Critical Bugs",
      "wiql": "SELECT [System.Id], [System.Title], [System.AssignedTo], [Microsoft.VSTS.Common.Severity], [Microsoft.VSTS.Common.Priority], [System.CreatedDate], [Custom.ImpactedUsers], [System.State] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [Microsoft.VSTS.Common.Severity] = '1 - Critical' AND [System.State] <> 'Closed' ORDER BY [System.CreatedDate] ASC",
      "description": "Critical severity bugs requiring immediate attention"
    },

    {
      "name": "Production Bugs",
      "wiql": "SELECT [System.Id], [System.Title], [System.AssignedTo], [Microsoft.VSTS.Common.Severity], [System.CreatedDate], [System.State], [Custom.BusinessImpact] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [System.Tags] CONTAINS 'production' AND [System.State] <> 'Closed' ORDER BY [Microsoft.VSTS.Common.Severity] ASC",
      "description": "Bugs found in production environment"
    },

    {
      "name": "Unassigned Bugs",
      "wiql": "SELECT [System.Id], [System.Title], [Microsoft.VSTS.Common.Severity], [Microsoft.VSTS.Common.Priority], [System.CreatedDate], [System.State] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [System.AssignedTo] = '' AND [System.State] IN ('New', 'Active') ORDER BY [Microsoft.VSTS.Common.Severity] ASC, [System.CreatedDate] ASC",
      "description": "Bugs without assigned owner"
    },

    {
      "name": "Bugs by Component",
      "wiql": "SELECT [System.Id], [System.Title], [Custom.Component], [Microsoft.VSTS.Common.Severity], [System.AssignedTo], [System.State] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [System.State] <> 'Closed' ORDER BY [Custom.Component] ASC, [Microsoft.VSTS.Common.Severity] ASC",
      "description": "Bugs grouped by component/service"
    },

    {
      "name": "Long-Standing Bugs",
      "wiql": "SELECT [System.Id], [System.Title], [System.AssignedTo], [System.CreatedDate], [Microsoft.VSTS.Common.Severity], [System.State] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [System.CreatedDate] < @Today - 30 AND [System.State] IN ('New', 'Active', 'Committed') ORDER BY [System.CreatedDate] ASC",
      "description": "Bugs open for more than 30 days"
    },

    {
      "name": "Resolved Bugs Pending Verification",
      "wiql": "SELECT [System.Id], [System.Title], [System.AssignedTo], [System.ResolvedDate], [Microsoft.VSTS.Common.Severity], [System.State] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [System.State] = 'Resolved' ORDER BY [System.ResolvedDate] ASC",
      "description": "Resolved bugs awaiting verification"
    },

    {
      "name": "Bugs Fixed This Sprint",
      "wiql": "SELECT [System.Id], [System.Title], [System.AssignedTo], [System.ResolvedDate], [Microsoft.VSTS.Common.Severity] FROM WorkItems WHERE [System.TeamProject] = 'DatingPlatform' AND [System.WorkItemType] = 'Bug' AND [System.State] IN ('Resolved', 'Closed') AND [System.ResolvedDate] >= @CurrentIteration ORDER BY [System.ResolvedDate] DESC",
      "description": "Bugs fixed in current sprint"
    }
  ],

  "charts": [
    {
      "name": "Bugs by Severity",
      "type": "pie",
      "groupBy": "Microsoft.VSTS.Common.Severity",
      "filter": "System.State <> 'Closed'"
    },

    {
      "name": "Bugs by State",
      "type": "bar",
      "groupBy": "System.State",
      "filter": "System.State <> 'Removed'"
    },

    {
      "name": "Bug Trend",
      "type": "line",
      "xAxis": "System.CreatedDate",
      "yAxis": "Count",
      "period": "Last 3 Months"
    },

    {
      "name": "Bugs by Component",
      "type": "column",
      "groupBy": "Custom.Component",
      "filter": "System.State <> 'Closed'"
    }
  ],

  "kpis": [
    {
      "name": "Critical Bugs Open",
      "formula": "COUNT WHERE Severity = '1 - Critical' AND State <> 'Closed'",
      "threshold": { "critical": 5, "warning": 2 }
    },
    {
      "name": "Average Bug Age",
      "formula": "AVG(Today - CreatedDate) WHERE State <> 'Closed'",
      "unit": "days",
      "threshold": { "critical": 30, "warning": 14 }
    },
    {
      "name": "Bug Resolution Rate",
      "formula": "COUNT(Resolved This Week) / COUNT(Created This Week)",
      "format": "percentage",
      "threshold": { "warning": 80, "good": 100 }
    }
  ]
}
