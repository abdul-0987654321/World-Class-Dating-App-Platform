{
  "stateTransitionRules": {
    "version": "1.0",
    "description": "Automated state transition rules based on pipeline and PR events",

    "rules": [
      {
        "name": "Move to Active on PR creation",
        "enabled": true,
        "trigger": {
          "type": "pull_request",
          "action": "opened"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "in",
            "value": ["New", "Approved", "Committed"]
          }
        ],
        "transitions": [
          {
            "fromState": "New",
            "toState": "Active"
          },
          {
            "fromState": "Approved",
            "toState": "Committed"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Pull Request #{{pr.number}} created: {{pr.url}}\nAutomatically moved to Active state."
          },
          {
            "type": "add_tags",
            "tags": ["in-development", "pr-{{pr.number}}"]
          },
          {
            "type": "link_pull_request",
            "url": "{{pr.url}}"
          }
        ]
      },

      {
        "name": "Move to In Review on PR ready for review",
        "enabled": true,
        "trigger": {
          "type": "pull_request",
          "action": "ready_for_review"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "equals",
            "value": "Active"
          }
        ],
        "transitions": [
          {
            "fromState": "Active",
            "toState": "In Review"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Pull Request #{{pr.number}} is ready for review.\nState changed to In Review."
          },
          {
            "type": "add_tags",
            "tags": ["pending-review"]
          },
          {
            "type": "notify",
            "recipients": ["code-reviewers"]
          }
        ]
      },

      {
        "name": "Move to Resolved on PR merged to develop",
        "enabled": true,
        "trigger": {
          "type": "pull_request",
          "action": "merged",
          "targetBranch": "develop"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "in",
            "value": ["Active", "In Review", "Committed"]
          }
        ],
        "transitions": [
          {
            "fromState": "Active",
            "toState": "Resolved"
          },
          {
            "fromState": "In Review",
            "toState": "Resolved"
          },
          {
            "fromState": "Committed",
            "toState": "Resolved"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Pull Request #{{pr.number}} merged to develop branch.\nCommit: {{commit.sha}}\nState changed to Resolved."
          },
          {
            "type": "remove_tags",
            "tags": ["in-development", "pending-review"]
          },
          {
            "type": "add_tags",
            "tags": ["merged-to-develop"]
          },
          {
            "type": "set_resolved_date",
            "date": "@Today"
          }
        ]
      },

      {
        "name": "Move to Resolved on PR merged to main",
        "enabled": true,
        "trigger": {
          "type": "pull_request",
          "action": "merged",
          "targetBranch": "main"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "in",
            "value": ["Active", "In Review", "Committed"]
          }
        ],
        "transitions": [
          {
            "fromState": "Active",
            "toState": "Resolved"
          },
          {
            "fromState": "In Review",
            "toState": "Resolved"
          },
          {
            "fromState": "Committed",
            "toState": "Resolved"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Pull Request #{{pr.number}} merged to main branch.\nCommit: {{commit.sha}}\nReady for deployment."
          },
          {
            "type": "add_tags",
            "tags": ["merged-to-main", "ready-for-deployment"]
          }
        ]
      },

      {
        "name": "Move back to Active on PR reopened",
        "enabled": true,
        "trigger": {
          "type": "pull_request",
          "action": "reopened"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "in",
            "value": ["Resolved", "Closed"]
          }
        ],
        "transitions": [
          {
            "fromState": "Resolved",
            "toState": "Active"
          },
          {
            "fromState": "Closed",
            "toState": "Active"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Pull Request #{{pr.number}} reopened. Work item reactivated."
          },
          {
            "type": "add_tags",
            "tags": ["reopened"]
          }
        ]
      },

      {
        "name": "Update on build completion (success)",
        "enabled": true,
        "trigger": {
          "type": "build",
          "action": "completed",
          "result": "succeeded"
        },
        "conditions": [],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Build {{build.number}} completed successfully.\nBuild URL: {{build.url}}\nDuration: {{build.duration}}"
          },
          {
            "type": "add_tags",
            "tags": ["build-passed"]
          }
        ]
      },

      {
        "name": "Update on build failure",
        "enabled": true,
        "trigger": {
          "type": "build",
          "action": "completed",
          "result": "failed"
        },
        "conditions": [],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Build {{build.number}} FAILED.\nBuild URL: {{build.url}}\nPlease review and fix the issues."
          },
          {
            "type": "add_tags",
            "tags": ["build-failed", "needs-attention"]
          },
          {
            "type": "notify",
            "recipients": ["{{assignedTo}}"],
            "template": "build-failure"
          }
        ]
      },

      {
        "name": "Move to Deployed-Staging on staging deployment",
        "enabled": true,
        "trigger": {
          "type": "deployment",
          "action": "completed",
          "environment": "staging",
          "status": "succeeded"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "equals",
            "value": "Resolved"
          }
        ],
        "transitions": [
          {
            "fromState": "Resolved",
            "toState": "Deployed-Staging"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Deployed to STAGING environment.\nDeployment: {{deployment.name}}\nBuild: {{build.number}}\nURL: {{staging.url}}"
          },
          {
            "type": "add_tags",
            "tags": ["deployed-staging", "ready-for-qa"]
          },
          {
            "type": "notify",
            "recipients": ["qa-team@datingplatform.com"],
            "template": "staging-deployment"
          }
        ]
      },

      {
        "name": "Move to Closed on production deployment",
        "enabled": true,
        "trigger": {
          "type": "deployment",
          "action": "completed",
          "environment": "production",
          "status": "succeeded"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "in",
            "value": ["Resolved", "Deployed-Staging"]
          }
        ],
        "transitions": [
          {
            "fromState": "Resolved",
            "toState": "Closed"
          },
          {
            "fromState": "Deployed-Staging",
            "toState": "Closed"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Deployed to PRODUCTION environment.\nRelease: {{release.name}}\nDeployment: {{deployment.name}}\nBuild: {{build.number}}\nDeployed at: {{deployment.timestamp}}"
          },
          {
            "type": "add_tags",
            "tags": ["deployed-production", "released"]
          },
          {
            "type": "set_closed_date",
            "date": "@Today"
          },
          {
            "type": "notify",
            "recipients": ["product-team@datingplatform.com"],
            "template": "production-deployment"
          }
        ]
      },

      {
        "name": "Reopen on deployment rollback",
        "enabled": true,
        "trigger": {
          "type": "deployment",
          "action": "rollback"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "equals",
            "value": "Closed"
          }
        ],
        "transitions": [
          {
            "fromState": "Closed",
            "toState": "Active"
          }
        ],
        "actions": [
          {
            "type": "add_comment",
            "comment": "DEPLOYMENT ROLLED BACK from {{deployment.environment}}.\nReason: {{rollback.reason}}\nWork item reopened for investigation."
          },
          {
            "type": "add_tags",
            "tags": ["rollback", "requires-investigation", "urgent"]
          },
          {
            "type": "set_priority",
            "value": 1
          },
          {
            "type": "notify",
            "recipients": [
              "{{assignedTo}}",
              "tech-lead@datingplatform.com",
              "devops-team@datingplatform.com"
            ],
            "template": "deployment-rollback"
          }
        ]
      },

      {
        "name": "Update on test completion",
        "enabled": true,
        "trigger": {
          "type": "test_run",
          "action": "completed"
        },
        "conditions": [],
        "actions": [
          {
            "type": "add_comment",
            "comment": "Test Run {{testRun.id}} completed.\nTotal: {{testRun.total}}\nPassed: {{testRun.passed}}\nFailed: {{testRun.failed}}\nSuccess Rate: {{testRun.successRate}}%\nTest Results: {{testRun.url}}"
          },
          {
            "type": "add_tags",
            "tags": ["tests-{{testRun.result}}"],
            "condition": "testRun.result in ['passed', 'failed']"
          }
        ]
      },

      {
        "name": "Create bug on test failure",
        "enabled": true,
        "trigger": {
          "type": "test_run",
          "action": "completed",
          "result": "failed"
        },
        "conditions": [
          {
            "testRun.failureCount": {
              "operator": "greater than",
              "value": 0
            }
          }
        ],
        "actions": [
          {
            "type": "create_work_item",
            "workItemType": "Bug",
            "title": "Test Failure: {{testRun.name}}",
            "description": "Tests failed in test run {{testRun.id}}.\n\nFailed Tests:\n{{testRun.failedTests}}\n\nTest Run URL: {{testRun.url}}",
            "fields": {
              "Microsoft.VSTS.Common.Severity": "2 - High",
              "Microsoft.VSTS.Common.Priority": 2,
              "System.Tags": "test-failure;automated"
            },
            "linkToParent": true
          }
        ]
      },

      {
        "name": "Auto-close duplicate work items",
        "enabled": false,
        "trigger": {
          "type": "duplicate_detected"
        },
        "conditions": [],
        "actions": [
          {
            "type": "close_as_duplicate",
            "duplicateOf": "{{original.id}}"
          },
          {
            "type": "add_comment",
            "comment": "Closed as duplicate of {{original.id}}."
          }
        ]
      }
    ],

    "customStates": {
      "Deployed-Staging": {
        "description": "Work item deployed to staging environment",
        "category": "InProgress"
      },
      "In Review": {
        "description": "Work item under code review",
        "category": "InProgress"
      }
    }
  }
}
