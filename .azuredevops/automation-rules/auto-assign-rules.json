{
  "automationRules": {
    "version": "1.0",
    "description": "Automated work item assignment rules for Dating Platform",

    "rules": [
      {
        "name": "Auto-assign bugs to component owner",
        "enabled": true,
        "trigger": {
          "type": "work_item_created",
          "workItemType": "Bug"
        },
        "conditions": [
          {
            "field": "Custom.Component",
            "operator": "is not empty"
          }
        ],
        "actions": [
          {
            "type": "assign",
            "assignTo": {
              "mapping": {
                "api-gateway": "apigateway-team@datingplatform.com",
                "user-service": "userservice-team@datingplatform.com",
                "matching-service": "matching-team@datingplatform.com",
                "messaging-service": "messaging-team@datingplatform.com",
                "media-service": "media-team@datingplatform.com",
                "notification-service": "notification-team@datingplatform.com",
                "payment-service": "payment-team@datingplatform.com",
                "moderation-service": "moderation-team@datingplatform.com",
                "analytics-service": "analytics-team@datingplatform.com",
                "frontend-web": "frontend-team@datingplatform.com",
                "mobile-ios": "ios-team@datingplatform.com",
                "mobile-android": "android-team@datingplatform.com"
              }
            }
          },
          {
            "type": "add_comment",
            "comment": "Automatically assigned to {{component}} team based on component selection."
          }
        ]
      },

      {
        "name": "Auto-assign critical bugs to lead",
        "enabled": true,
        "trigger": {
          "type": "work_item_created",
          "workItemType": "Bug"
        },
        "conditions": [
          {
            "field": "Microsoft.VSTS.Common.Severity",
            "operator": "equals",
            "value": "1 - Critical"
          }
        ],
        "actions": [
          {
            "type": "assign",
            "assignTo": "tech-lead@datingplatform.com"
          },
          {
            "type": "set_priority",
            "value": 1
          },
          {
            "type": "add_tags",
            "tags": ["critical", "urgent", "needs-immediate-attention"]
          },
          {
            "type": "send_notification",
            "recipients": [
              "tech-lead@datingplatform.com",
              "devops-team@datingplatform.com",
              "product-manager@datingplatform.com"
            ],
            "template": "critical-bug-alert"
          }
        ]
      },

      {
        "name": "Auto-assign production bugs",
        "enabled": true,
        "trigger": {
          "type": "work_item_created",
          "workItemType": "Bug"
        },
        "conditions": [
          {
            "field": "Microsoft.VSTS.TCM.SystemInfo",
            "operator": "contains",
            "value": "Production"
          }
        ],
        "actions": [
          {
            "type": "assign",
            "assignTo": "oncall-engineer@datingplatform.com"
          },
          {
            "type": "set_priority",
            "value": 1
          },
          {
            "type": "add_tags",
            "tags": ["production", "urgent"]
          },
          {
            "type": "add_comment",
            "comment": "Production bug detected. Assigned to on-call engineer. Please investigate immediately."
          },
          {
            "type": "create_incident",
            "severity": "high",
            "description": "Production bug requiring immediate attention"
          }
        ]
      },

      {
        "name": "Round-robin assignment for unassigned tasks",
        "enabled": true,
        "trigger": {
          "type": "scheduled",
          "schedule": "0 9 * * 1-5"
        },
        "conditions": [
          {
            "field": "System.WorkItemType",
            "operator": "in",
            "value": ["Task", "User Story"]
          },
          {
            "field": "System.AssignedTo",
            "operator": "is empty"
          },
          {
            "field": "System.State",
            "operator": "equals",
            "value": "New"
          }
        ],
        "actions": [
          {
            "type": "assign",
            "strategy": "round-robin",
            "team": "development-team"
          },
          {
            "type": "add_comment",
            "comment": "Automatically assigned via round-robin distribution."
          }
        ]
      },

      {
        "name": "Reassign stale items",
        "enabled": true,
        "trigger": {
          "type": "scheduled",
          "schedule": "0 10 * * 1"
        },
        "conditions": [
          {
            "field": "System.State",
            "operator": "equals",
            "value": "Active"
          },
          {
            "field": "System.ChangedDate",
            "operator": "older than",
            "value": "7 days"
          }
        ],
        "actions": [
          {
            "type": "send_notification",
            "recipients": ["{{assignedTo}}", "{{assignedTo.manager}}"],
            "template": "stale-work-item-reminder"
          },
          {
            "type": "add_comment",
            "comment": "This work item has been inactive for 7+ days. Please provide an update or reassign."
          },
          {
            "type": "add_tags",
            "tags": ["stale", "needs-update"]
          }
        ]
      },

      {
        "name": "Auto-assign code review tasks",
        "enabled": true,
        "trigger": {
          "type": "pull_request_created"
        },
        "conditions": [],
        "actions": [
          {
            "type": "create_work_item",
            "workItemType": "Task",
            "title": "Code Review: {{pr.title}}",
            "description": "Review pull request #{{pr.number}}: {{pr.url}}",
            "assignTo": {
              "strategy": "code-owners",
              "fallback": "tech-lead@datingplatform.com"
            },
            "fields": {
              "Microsoft.VSTS.Common.Activity": "Review",
              "System.Tags": "code-review;pr-{{pr.number}}"
            },
            "linkToPullRequest": true
          }
        ]
      },

      {
        "name": "Auto-assign testing tasks",
        "enabled": true,
        "trigger": {
          "type": "work_item_state_changed",
          "fromState": "Active",
          "toState": "Resolved"
        },
        "conditions": [
          {
            "field": "System.WorkItemType",
            "operator": "in",
            "value": ["User Story", "Bug"]
          }
        ],
        "actions": [
          {
            "type": "create_child_work_item",
            "workItemType": "Task",
            "title": "QA Testing: {{parent.title}}",
            "description": "Verify and test the resolution of {{parent.id}}",
            "assignTo": "qa-team@datingplatform.com",
            "fields": {
              "Microsoft.VSTS.Common.Activity": "Testing",
              "System.Tags": "qa;testing;verification"
            }
          },
          {
            "type": "add_comment",
            "comment": "QA testing task created and assigned to QA team."
          }
        ]
      },

      {
        "name": "Escalate overdue high-priority items",
        "enabled": true,
        "trigger": {
          "type": "scheduled",
          "schedule": "0 */4 * * *"
        },
        "conditions": [
          {
            "field": "Microsoft.VSTS.Common.Priority",
            "operator": "equals",
            "value": 1
          },
          {
            "field": "System.State",
            "operator": "not in",
            "value": ["Resolved", "Closed"]
          },
          {
            "field": "Microsoft.VSTS.Scheduling.TargetDate",
            "operator": "less than",
            "value": "@Today"
          }
        ],
        "actions": [
          {
            "type": "send_notification",
            "recipients": [
              "{{assignedTo}}",
              "{{assignedTo.manager}}",
              "tech-lead@datingplatform.com",
              "product-manager@datingplatform.com"
            ],
            "template": "overdue-high-priority-escalation"
          },
          {
            "type": "add_tags",
            "tags": ["overdue", "escalated"]
          },
          {
            "type": "add_comment",
            "comment": "ESCALATED: This high-priority item is overdue. Please provide status update immediately."
          }
        ]
      },

      {
        "name": "Auto-assign security review for sensitive changes",
        "enabled": true,
        "trigger": {
          "type": "work_item_created",
          "workItemType": "User Story"
        },
        "conditions": [
          {
            "field": "System.Tags",
            "operator": "contains any",
            "value": ["security", "authentication", "authorization", "payment", "pii", "gdpr"]
          }
        ],
        "actions": [
          {
            "type": "create_child_work_item",
            "workItemType": "Task",
            "title": "Security Review: {{parent.title}}",
            "description": "Conduct security review for {{parent.id}}",
            "assignTo": "security-team@datingplatform.com",
            "fields": {
              "Microsoft.VSTS.Common.Activity": "Review",
              "Microsoft.VSTS.Common.Priority": 1,
              "System.Tags": "security;security-review;compliance"
            }
          },
          {
            "type": "add_tags",
            "tags": ["security-review-required"]
          }
        ]
      },

      {
        "name": "Load balance between team members",
        "enabled": true,
        "trigger": {
          "type": "scheduled",
          "schedule": "0 9 * * 1"
        },
        "conditions": [],
        "actions": [
          {
            "type": "balance_workload",
            "team": "development-team",
            "criteria": "active-work-items",
            "threshold": 5,
            "action": "suggest-reassignment"
          }
        ]
      }
    ],

    "notificationTemplates": {
      "critical-bug-alert": {
        "subject": "CRITICAL BUG ALERT: {{workItem.id}} - {{workItem.title}}",
        "body": "A critical bug has been reported and requires immediate attention.\n\nBug ID: {{workItem.id}}\nTitle: {{workItem.title}}\nSeverity: {{workItem.severity}}\nComponent: {{workItem.component}}\nImpacted Users: {{workItem.impactedUsers}}\n\nPlease investigate immediately.\n\nView Bug: {{workItem.url}}"
      },

      "stale-work-item-reminder": {
        "subject": "Reminder: Work Item {{workItem.id}} Needs Update",
        "body": "The following work item has been inactive for 7+ days:\n\nID: {{workItem.id}}\nTitle: {{workItem.title}}\nAssigned To: {{workItem.assignedTo}}\nLast Updated: {{workItem.changedDate}}\n\nPlease provide an update or reassign if needed.\n\nView Work Item: {{workItem.url}}"
      },

      "overdue-high-priority-escalation": {
        "subject": "ESCALATED: High Priority Item Overdue - {{workItem.id}}",
        "body": "A high-priority work item is overdue and requires immediate attention:\n\nID: {{workItem.id}}\nTitle: {{workItem.title}}\nTarget Date: {{workItem.targetDate}}\nDays Overdue: {{workItem.daysOverdue}}\nAssigned To: {{workItem.assignedTo}}\n\nThis item has been escalated. Please provide status update immediately.\n\nView Work Item: {{workItem.url}}"
      }
    }
  }
}
