{
  "notificationRules": {
    "version": "1.0",
    "description": "Comprehensive notification rules for Dating Platform",

    "globalSettings": {
      "defaultChannels": ["email"],
      "quietHours": {
        "enabled": true,
        "start": "22:00",
        "end": "08:00",
        "timezone": "UTC",
        "exceptSeverity": ["critical"]
      },
      "rateLimiting": {
        "enabled": true,
        "maxNotificationsPerHour": 50,
        "exemptSeverity": ["critical"]
      }
    },

    "rules": [
      {
        "id": "critical-bug-created",
        "name": "Critical Bug Created",
        "enabled": true,
        "trigger": {
          "type": "work_item_created",
          "workItemType": "Bug"
        },
        "conditions": [
          {
            "field": "Microsoft.VSTS.Common.Severity",
            "operator": "equals",
            "value": "1 - Critical"
          }
        ],
        "recipients": [
          {
            "type": "team",
            "value": "DevOps-Team"
          },
          {
            "type": "team",
            "value": "Tech-Leads"
          },
          {
            "type": "email",
            "value": "product-manager@datingplatform.com"
          },
          {
            "type": "slack",
            "value": "#critical-alerts"
          },
          {
            "type": "teams",
            "value": "DevOps Channel"
          }
        ],
        "template": "critical-bug-alert",
        "priority": "high",
        "channels": ["email", "slack", "teams", "sms"]
      },

      {
        "id": "production-bug-created",
        "name": "Production Bug Created",
        "enabled": true,
        "trigger": {
          "type": "work_item_created",
          "workItemType": "Bug"
        },
        "conditions": [
          {
            "field": "System.Tags",
            "operator": "contains",
            "value": "production"
          }
        ],
        "recipients": [
          {
            "type": "email",
            "value": "oncall-engineer@datingplatform.com"
          },
          {
            "type": "slack",
            "value": "#production-incidents"
          },
          {
            "type": "pagerduty",
            "value": "production-oncall"
          }
        ],
        "template": "production-bug-alert",
        "priority": "critical",
        "channels": ["email", "slack", "pagerduty", "sms"]
      },

      {
        "id": "work-item-assigned-to-me",
        "name": "Work Item Assigned to Me",
        "enabled": true,
        "trigger": {
          "type": "work_item_field_changed",
          "field": "System.AssignedTo"
        },
        "conditions": [
          {
            "field": "System.AssignedTo",
            "operator": "equals",
            "value": "@Me"
          }
        ],
        "recipients": [
          {
            "type": "assignedTo"
          }
        ],
        "template": "work-item-assigned",
        "priority": "normal",
        "channels": ["email", "in-app"]
      },

      {
        "id": "pr-created-for-my-work-item",
        "name": "Pull Request Created for My Work Item",
        "enabled": true,
        "trigger": {
          "type": "pull_request_created"
        },
        "conditions": [
          {
            "linkedWorkItem.assignedTo": "@Me"
          }
        ],
        "recipients": [
          {
            "type": "assignedTo"
          }
        ],
        "template": "pr-created",
        "priority": "normal",
        "channels": ["email", "in-app"]
      },

      {
        "id": "pr-review-requested",
        "name": "Pull Request Review Requested",
        "enabled": true,
        "trigger": {
          "type": "pull_request_review_requested"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "reviewer"
          }
        ],
        "template": "pr-review-requested",
        "priority": "normal",
        "channels": ["email", "slack", "in-app"]
      },

      {
        "id": "pr-approved",
        "name": "Pull Request Approved",
        "enabled": true,
        "trigger": {
          "type": "pull_request_approved"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "author"
          },
          {
            "type": "linkedWorkItem.assignedTo"
          }
        ],
        "template": "pr-approved",
        "priority": "normal",
        "channels": ["email", "in-app"]
      },

      {
        "id": "pr-changes-requested",
        "name": "Pull Request Changes Requested",
        "enabled": true,
        "trigger": {
          "type": "pull_request_changes_requested"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "author"
          }
        ],
        "template": "pr-changes-requested",
        "priority": "normal",
        "channels": ["email", "slack", "in-app"]
      },

      {
        "id": "build-failed",
        "name": "Build Failed",
        "enabled": true,
        "trigger": {
          "type": "build_completed",
          "result": "failed"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "requestedBy"
          },
          {
            "type": "linkedWorkItem.assignedTo"
          },
          {
            "type": "slack",
            "value": "#build-failures"
          }
        ],
        "template": "build-failed",
        "priority": "high",
        "channels": ["email", "slack"]
      },

      {
        "id": "deployment-completed-staging",
        "name": "Deployment Completed to Staging",
        "enabled": true,
        "trigger": {
          "type": "deployment_completed",
          "environment": "staging",
          "status": "succeeded"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "team",
            "value": "QA-Team"
          },
          {
            "type": "team",
            "value": "Product-Team"
          },
          {
            "type": "slack",
            "value": "#staging-deployments"
          }
        ],
        "template": "deployment-staging-success",
        "priority": "normal",
        "channels": ["email", "slack"]
      },

      {
        "id": "deployment-completed-production",
        "name": "Deployment Completed to Production",
        "enabled": true,
        "trigger": {
          "type": "deployment_completed",
          "environment": "production",
          "status": "succeeded"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "team",
            "value": "All-Teams"
          },
          {
            "type": "slack",
            "value": "#production-deployments"
          },
          {
            "type": "teams",
            "value": "General"
          }
        ],
        "template": "deployment-production-success",
        "priority": "high",
        "channels": ["email", "slack", "teams"]
      },

      {
        "id": "deployment-failed",
        "name": "Deployment Failed",
        "enabled": true,
        "trigger": {
          "type": "deployment_completed",
          "status": "failed"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "team",
            "value": "DevOps-Team"
          },
          {
            "type": "requestedBy"
          },
          {
            "type": "slack",
            "value": "#deployment-failures"
          },
          {
            "type": "pagerduty",
            "value": "devops-oncall"
          }
        ],
        "template": "deployment-failed",
        "priority": "critical",
        "channels": ["email", "slack", "pagerduty", "sms"]
      },

      {
        "id": "work-item-commented",
        "name": "Work Item Commented",
        "enabled": true,
        "trigger": {
          "type": "work_item_commented"
        },
        "conditions": [
          {
            "comment": {
              "operator": "mentions",
              "value": "@Me"
            }
          }
        ],
        "recipients": [
          {
            "type": "mentioned"
          }
        ],
        "template": "work-item-comment",
        "priority": "normal",
        "channels": ["email", "in-app"]
      },

      {
        "id": "work-item-blocked",
        "name": "Work Item Blocked",
        "enabled": true,
        "trigger": {
          "type": "work_item_field_changed",
          "field": "System.Tags"
        },
        "conditions": [
          {
            "field": "System.Tags",
            "operator": "contains",
            "value": "blocked"
          }
        ],
        "recipients": [
          {
            "type": "assignedTo"
          },
          {
            "type": "team",
            "value": "Tech-Leads"
          },
          {
            "type": "slack",
            "value": "#blockers"
          }
        ],
        "template": "work-item-blocked",
        "priority": "high",
        "channels": ["email", "slack"]
      },

      {
        "id": "sprint-ending-soon",
        "name": "Sprint Ending Soon",
        "enabled": true,
        "trigger": {
          "type": "scheduled",
          "schedule": "0 9 * * *"
        },
        "conditions": [
          {
            "daysUntilSprintEnd": {
              "operator": "<=",
              "value": 2
            }
          }
        ],
        "recipients": [
          {
            "type": "team",
            "value": "DatingPlatform Team"
          }
        ],
        "template": "sprint-ending-reminder",
        "priority": "normal",
        "channels": ["email", "slack"]
      },

      {
        "id": "overdue-work-items",
        "name": "Overdue Work Items",
        "enabled": true,
        "trigger": {
          "type": "scheduled",
          "schedule": "0 9 * * *"
        },
        "conditions": [
          {
            "field": "Microsoft.VSTS.Scheduling.TargetDate",
            "operator": "<",
            "value": "@Today"
          },
          {
            "field": "System.State",
            "operator": "not in",
            "value": ["Closed", "Resolved"]
          }
        ],
        "recipients": [
          {
            "type": "assignedTo"
          },
          {
            "type": "createdBy"
          }
        ],
        "template": "overdue-work-item",
        "priority": "normal",
        "channels": ["email"]
      },

      {
        "id": "security-vulnerability-detected",
        "name": "Security Vulnerability Detected",
        "enabled": true,
        "trigger": {
          "type": "security_scan_completed"
        },
        "conditions": [
          {
            "vulnerabilities": {
              "operator": ">",
              "value": 0,
              "severity": ["critical", "high"]
            }
          }
        ],
        "recipients": [
          {
            "type": "team",
            "value": "Security-Team"
          },
          {
            "type": "team",
            "value": "DevOps-Team"
          },
          {
            "type": "slack",
            "value": "#security-alerts"
          }
        ],
        "template": "security-vulnerability",
        "priority": "critical",
        "channels": ["email", "slack", "pagerduty"]
      },

      {
        "id": "performance-degradation",
        "name": "Performance Degradation Detected",
        "enabled": true,
        "trigger": {
          "type": "performance_test_completed"
        },
        "conditions": [
          {
            "performance": {
              "metric": "response_time_p95",
              "operator": ">",
              "threshold": "baseline + 20%"
            }
          }
        ],
        "recipients": [
          {
            "type": "team",
            "value": "Performance-Team"
          },
          {
            "type": "slack",
            "value": "#performance-alerts"
          }
        ],
        "template": "performance-degradation",
        "priority": "high",
        "channels": ["email", "slack"]
      },

      {
        "id": "daily-standup-reminder",
        "name": "Daily Standup Reminder",
        "enabled": true,
        "trigger": {
          "type": "scheduled",
          "schedule": "0 9 * * 1-5"
        },
        "conditions": [],
        "recipients": [
          {
            "type": "team",
            "value": "DatingPlatform Team"
          }
        ],
        "template": "daily-standup",
        "priority": "low",
        "channels": ["slack"]
      }
    ],

    "templates": {
      "critical-bug-alert": {
        "subject": "🚨 CRITICAL BUG: {{workItem.id}} - {{workItem.title}}",
        "body": "A critical severity bug has been reported and requires immediate attention.\n\n**Bug Details:**\n- ID: {{workItem.id}}\n- Title: {{workItem.title}}\n- Severity: {{workItem.severity}}\n- Component: {{workItem.component}}\n- Impacted Users: {{workItem.impactedUsers}}\n- Environment: {{workItem.environment}}\n\n**Reported By:** {{workItem.createdBy}}\n**Created:** {{workItem.createdDate}}\n\n**Action Required:** Please investigate and provide initial assessment within 1 hour.\n\n[View Bug]({{workItem.url}})",
        "format": "markdown"
      },

      "production-bug-alert": {
        "subject": "🔴 PRODUCTION BUG: {{workItem.id}} - {{workItem.title}}",
        "body": "A bug has been detected in the production environment.\n\n**Bug Details:**\n- ID: {{workItem.id}}\n- Title: {{workItem.title}}\n- Severity: {{workItem.severity}}\n- Component: {{workItem.component}}\n- Business Impact: {{workItem.businessImpact}}\n\n**On-Call Engineer:** {{oncall.name}}\n\n[View Bug]({{workItem.url}}) | [Incident Response Playbook]({{playbook.url}})",
        "format": "markdown"
      },

      "deployment-production-success": {
        "subject": "✅ Production Deployment Successful - {{release.name}}",
        "body": "**Release {{release.name}} has been successfully deployed to production!**\n\n**Deployment Details:**\n- Environment: Production\n- Build: {{build.number}}\n- Deployed At: {{deployment.timestamp}}\n- Duration: {{deployment.duration}}\n- Strategy: {{deployment.strategy}}\n\n**Included Work Items:**\n{{#workItems}}\n- [{{type}}] {{id}}: {{title}}\n{{/workItems}}\n\n**Post-Deployment:**\n- Monitoring Dashboard: {{monitoring.url}}\n- Release Notes: {{releaseNotes.url}}\n\nThank you to everyone who contributed to this release! 🎉",
        "format": "markdown"
      }
    },

    "channels": {
      "slack": {
        "webhooks": {
          "#critical-alerts": "${SLACK_WEBHOOK_CRITICAL}",
          "#production-incidents": "${SLACK_WEBHOOK_PROD_INCIDENTS}",
          "#build-failures": "${SLACK_WEBHOOK_BUILD_FAILURES}",
          "#staging-deployments": "${SLACK_WEBHOOK_STAGING}",
          "#production-deployments": "${SLACK_WEBHOOK_PROD}",
          "#deployment-failures": "${SLACK_WEBHOOK_DEPLOY_FAILURES}",
          "#blockers": "${SLACK_WEBHOOK_BLOCKERS}",
          "#security-alerts": "${SLACK_WEBHOOK_SECURITY}",
          "#performance-alerts": "${SLACK_WEBHOOK_PERFORMANCE}"
        }
      },

      "teams": {
        "webhooks": {
          "DevOps Channel": "${TEAMS_WEBHOOK_DEVOPS}",
          "General": "${TEAMS_WEBHOOK_GENERAL}"
        }
      },

      "pagerduty": {
        "integrationKeys": {
          "production-oncall": "${PAGERDUTY_PROD_ONCALL}",
          "devops-oncall": "${PAGERDUTY_DEVOPS_ONCALL}"
        }
      }
    }
  }
}
