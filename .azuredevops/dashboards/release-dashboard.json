{
  "dashboard": {
    "name": "Release Status Dashboard",
    "description": "Real-time release tracking and deployment status",
    "refreshInterval": "2 minutes",
    "layout": "grid",
    "columns": 3,

    "widgets": [
      {
        "id": "release-progress",
        "type": "progress-widget",
        "position": { "row": 1, "column": 1, "width": 2, "height": 1 },
        "title": "Release Progress",
        "settings": {
          "query": "Release Readiness",
          "metric": "completion-percentage",
          "showMilestones": true,
          "milestones": [
            { "value": 25, "label": "25% Complete" },
            { "value": 50, "label": "50% Complete" },
            { "value": 75, "label": "75% Complete" },
            { "value": 100, "label": "Ready to Ship" }
          ]
        }
      },

      {
        "id": "release-countdown",
        "type": "countdown-widget",
        "position": { "row": 1, "column": 3, "width": 1, "height": 1 },
        "title": "Release Date",
        "settings": {
          "targetDate": "@TargetDate",
          "showDays": true,
          "showHours": true,
          "alertDays": 3
        }
      },

      {
        "id": "release-gates",
        "type": "checklist-widget",
        "position": { "row": 2, "column": 1, "width": 2, "height": 2 },
        "title": "Release Gates",
        "settings": {
          "items": [
            {
              "name": "All Critical Items Resolved",
              "query": "SELECT COUNT(*) FROM WorkItems WHERE [Microsoft.VSTS.Common.Priority] = 1 AND [System.State] NOT IN ('Resolved', 'Closed')",
              "condition": "count = 0"
            },
            {
              "name": "All Features Deployed to Staging",
              "query": "SELECT COUNT(*) FROM WorkItems WHERE [System.WorkItemType] = 'Feature' AND [System.State] <> 'Deployed-Staging'",
              "condition": "count = 0"
            },
            {
              "name": "Security Scan Passed",
              "source": "pipeline",
              "pipeline": "Security-Tests",
              "condition": "status = succeeded"
            },
            {
              "name": "Performance Tests Passed",
              "source": "pipeline",
              "pipeline": "Performance-Tests",
              "condition": "status = succeeded"
            },
            {
              "name": "Code Coverage > 80%",
              "source": "metric",
              "metric": "code-coverage",
              "condition": "value >= 80"
            },
            {
              "name": "No High Severity Bugs",
              "query": "SELECT COUNT(*) FROM WorkItems WHERE [System.WorkItemType] = 'Bug' AND [Microsoft.VSTS.Common.Severity] IN ('1 - Critical', '2 - High') AND [System.State] NOT IN ('Resolved', 'Closed')",
              "condition": "count = 0"
            },
            {
              "name": "Documentation Complete",
              "query": "SELECT COUNT(*) FROM WorkItems WHERE [System.Tags] CONTAINS 'needs-documentation' AND [System.State] <> 'Closed'",
              "condition": "count = 0"
            }
          ],
          "showProgress": true
        }
      },

      {
        "id": "deployment-status",
        "type": "deployment-status-widget",
        "position": { "row": 2, "column": 3, "width": 1, "height": 1 },
        "title": "Deployment Status",
        "settings": {
          "environments": [
            {
              "name": "Development",
              "icon": "dev",
              "color": "#0078D4"
            },
            {
              "name": "Staging",
              "icon": "staging",
              "color": "#FFA500"
            },
            {
              "name": "Production",
              "icon": "prod",
              "color": "#008000"
            }
          ],
          "showVersion": true,
          "showLastDeployment": true
        }
      },

      {
        "id": "release-blockers",
        "type": "query-results-widget",
        "position": { "row": 4, "column": 1, "width": 2, "height": 2 },
        "title": "Release Blockers",
        "settings": {
          "query": {
            "wiql": "SELECT [System.Id], [System.Title], [System.WorkItemType], [System.AssignedTo], [Microsoft.VSTS.Common.Priority] FROM WorkItems WHERE [System.Tags] CONTAINS 'release-blocker' AND [System.State] NOT IN ('Resolved', 'Closed') ORDER BY [Microsoft.VSTS.Common.Priority] ASC"
          },
          "columns": [
            "System.Id",
            "System.WorkItemType",
            "System.Title",
            "System.AssignedTo",
            "Microsoft.VSTS.Common.Priority"
          ],
          "alertIfNotEmpty": true
        }
      },

      {
        "id": "critical-bugs",
        "type": "counter-widget",
        "position": { "row": 3, "column": 3, "width": 1, "height": 1 },
        "title": "Critical Bugs",
        "settings": {
          "query": {
            "wiql": "SELECT [System.Id] FROM WorkItems WHERE [System.WorkItemType] = 'Bug' AND [Microsoft.VSTS.Common.Severity] = '1 - Critical' AND [System.State] NOT IN ('Closed', 'Resolved')"
          },
          "thresholds": {
            "critical": 1,
            "warning": 0
          },
          "showIcon": true,
          "icon": "bug-critical"
        }
      },

      {
        "id": "work-items-by-type",
        "type": "chart-widget",
        "position": { "row": 4, "column": 3, "width": 1, "height": 1 },
        "title": "Work Items by Type",
        "settings": {
          "chartType": "pie",
          "query": "Release Readiness",
          "groupBy": "System.WorkItemType",
          "colors": {
            "Feature": "#0078D4",
            "User Story": "#00B294",
            "Bug": "#D13438",
            "Task": "#8764B8"
          }
        }
      },

      {
        "id": "deployment-frequency",
        "type": "chart-widget",
        "position": { "row": 6, "column": 1, "width": 2, "height": 2 },
        "title": "Deployment Frequency",
        "settings": {
          "chartType": "column",
          "source": "deployments",
          "timeRange": "Last 30 Days",
          "groupBy": "environment",
          "showTrend": true
        }
      },

      {
        "id": "lead-time",
        "type": "metric-widget",
        "position": { "row": 5, "column": 3, "width": 1, "height": 1 },
        "title": "Lead Time",
        "settings": {
          "metric": "cycle-time",
          "calculation": "average",
          "timeRange": "Last Sprint",
          "unit": "days",
          "showTrend": true,
          "target": 5
        }
      },

      {
        "id": "release-notes-preview",
        "type": "markdown-widget",
        "position": { "row": 8, "column": 1, "width": 3, "height": 2 },
        "title": "Release Notes Preview",
        "settings": {
          "source": "generated",
          "template": "release-notes",
          "autoRefresh": true
        }
      },

      {
        "id": "test-results",
        "type": "test-results-widget",
        "position": { "row": 6, "column": 3, "width": 1, "height": 1 },
        "title": "Test Results",
        "settings": {
          "pipelines": [
            "CI-Backend",
            "CI-Frontend",
            "E2E-Tests",
            "Performance-Tests"
          ],
          "showPassRate": true,
          "showTrend": true
        }
      },

      {
        "id": "build-history",
        "type": "build-history-widget",
        "position": { "row": 10, "column": 1, "width": 2, "height": 1 },
        "title": "Recent Builds",
        "settings": {
          "pipelines": [
            "CI-Backend",
            "CI-Frontend",
            "CD-Staging",
            "CD-Production"
          ],
          "maxBuilds": 10,
          "showDuration": true,
          "showStatus": true
        }
      },

      {
        "id": "quality-metrics",
        "type": "metrics-widget",
        "position": { "row": 10, "column": 3, "width": 1, "height": 1 },
        "title": "Quality Metrics",
        "settings": {
          "metrics": [
            {
              "name": "Code Coverage",
              "source": "sonarqube",
              "threshold": 80
            },
            {
              "name": "Tech Debt",
              "source": "sonarqube",
              "unit": "days",
              "threshold": 5
            },
            {
              "name": "Security Issues",
              "source": "security-scan",
              "threshold": 0
            }
          ],
          "layout": "compact"
        }
      },

      {
        "id": "deployment-pipeline",
        "type": "release-pipeline-widget",
        "position": { "row": 11, "column": 1, "width": 3, "height": 2 },
        "title": "Deployment Pipeline",
        "settings": {
          "pipeline": "CD-Production",
          "showStages": true,
          "showApprovals": true,
          "showGates": true
        }
      }
    ],

    "alerts": [
      {
        "condition": "critical-bugs > 0",
        "message": "Critical bugs detected! Release may be at risk.",
        "severity": "critical"
      },
      {
        "condition": "release-blockers > 0",
        "message": "Release blockers present. Immediate action required.",
        "severity": "critical"
      },
      {
        "condition": "days-to-release <= 3 AND release-progress < 90",
        "message": "Release date approaching but progress below 90%.",
        "severity": "warning"
      }
    ],

    "permissions": {
      "view": ["Everyone"],
      "edit": ["Project Administrators", "Release Managers"]
    }
  }
}
