{
  "dashboard": {
    "name": "Sprint Overview Dashboard",
    "description": "Comprehensive sprint tracking and team performance metrics",
    "refreshInterval": "5 minutes",
    "layout": "grid",
    "columns": 3,

    "widgets": [
      {
        "id": "sprint-burndown",
        "type": "sprint-burndown-chart",
        "position": { "row": 1, "column": 1, "width": 2, "height": 2 },
        "title": "Sprint Burndown",
        "settings": {
          "iteration": "@CurrentIteration",
          "metric": "RemainingWork",
          "showIdealTrend": true,
          "showWeekends": false
        }
      },

      {
        "id": "sprint-capacity",
        "type": "sprint-capacity-widget",
        "position": { "row": 1, "column": 3, "width": 1, "height": 1 },
        "title": "Team Capacity",
        "settings": {
          "iteration": "@CurrentIteration",
          "showPerMember": true,
          "unit": "hours"
        }
      },

      {
        "id": "velocity-chart",
        "type": "velocity-chart",
        "position": { "row": 3, "column": 1, "width": 2, "height": 2 },
        "title": "Velocity Trend",
        "settings": {
          "iterations": 6,
          "metric": "StoryPoints",
          "showAverage": true,
          "showTrend": true
        }
      },

      {
        "id": "sprint-goals",
        "type": "text-widget",
        "position": { "row": 2, "column": 3, "width": 1, "height": 1 },
        "title": "Sprint Goals",
        "settings": {
          "content": "markdown",
          "source": "iteration-wiki"
        }
      },

      {
        "id": "work-items-by-state",
        "type": "chart-widget",
        "position": { "row": 3, "column": 3, "width": 1, "height": 1 },
        "title": "Work Items by State",
        "settings": {
          "chartType": "donut",
          "query": "Sprint Backlog",
          "groupBy": "System.State",
          "colors": {
            "New": "#0078D4",
            "Active": "#FFA500",
            "Resolved": "#90EE90",
            "Closed": "#008000"
          }
        }
      },

      {
        "id": "active-work-items",
        "type": "query-results-widget",
        "position": { "row": 5, "column": 1, "width": 2, "height": 2 },
        "title": "Active Work Items",
        "settings": {
          "query": "Sprint Backlog",
          "columns": [
            "System.Id",
            "System.WorkItemType",
            "System.Title",
            "System.AssignedTo",
            "Microsoft.VSTS.Scheduling.RemainingWork"
          ],
          "maxItems": 20
        }
      },

      {
        "id": "blocked-items",
        "type": "query-results-widget",
        "position": { "row": 4, "column": 3, "width": 1, "height": 1 },
        "title": "Blocked Items",
        "settings": {
          "query": {
            "wiql": "SELECT [System.Id], [System.Title], [System.AssignedTo] FROM WorkItems WHERE [System.IterationPath] = @CurrentIteration AND [System.Tags] CONTAINS 'blocked'"
          },
          "showCount": true,
          "alertThreshold": 1
        }
      },

      {
        "id": "team-members",
        "type": "team-members-widget",
        "position": { "row": 5, "column": 3, "width": 1, "height": 1 },
        "title": "Team Members",
        "settings": {
          "team": "DatingPlatform Team",
          "showCapacity": true,
          "showActivity": true
        }
      },

      {
        "id": "cumulative-flow",
        "type": "cumulative-flow-diagram",
        "position": { "row": 7, "column": 1, "width": 3, "height": 2 },
        "title": "Cumulative Flow Diagram",
        "settings": {
          "iterations": 3,
          "states": ["New", "Active", "In Review", "Resolved", "Closed"],
          "showLegend": true
        }
      },

      {
        "id": "bug-count",
        "type": "counter-widget",
        "position": { "row": 6, "column": 3, "width": 1, "height": 1 },
        "title": "Active Bugs",
        "settings": {
          "query": {
            "wiql": "SELECT [System.Id] FROM WorkItems WHERE [System.IterationPath] = @CurrentIteration AND [System.WorkItemType] = 'Bug' AND [System.State] NOT IN ('Closed', 'Resolved')"
          },
          "thresholds": {
            "critical": 10,
            "warning": 5
          },
          "showTrend": true
        }
      },

      {
        "id": "pr-status",
        "type": "pull-request-widget",
        "position": { "row": 9, "column": 1, "width": 2, "height": 1 },
        "title": "Pull Requests",
        "settings": {
          "repository": "World-Class-Dating-App-Platform",
          "states": ["active", "completed"],
          "showAge": true,
          "maxItems": 10
        }
      },

      {
        "id": "build-status",
        "type": "build-history-widget",
        "position": { "row": 9, "column": 3, "width": 1, "height": 1 },
        "title": "Build Status",
        "settings": {
          "pipelines": [
            "CI-Backend",
            "CI-Frontend",
            "E2E-Tests"
          ],
          "showDuration": true,
          "maxBuilds": 5
        }
      },

      {
        "id": "sprint-progress",
        "type": "progress-bar-widget",
        "position": { "row": 10, "column": 1, "width": 3, "height": 1 },
        "title": "Sprint Progress",
        "settings": {
          "metric": "story-points-completed",
          "showPercentage": true,
          "showRemaining": true
        }
      }
    ],

    "filters": {
      "iteration": "@CurrentIteration",
      "team": "DatingPlatform Team"
    },

    "permissions": {
      "view": ["Everyone"],
      "edit": ["Project Administrators", "Team Leads"]
    }
  }
}
