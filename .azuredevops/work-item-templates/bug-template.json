{
  "$schema": "https://dev.azure.com/schemas/workItemTemplates/1.0",
  "name": "Bug Template - Dating Platform",
  "description": "Standard bug template for the Dating Platform project",
  "workItemType": "Bug",
  "fields": {
    "System.Title": {
      "value": "[BUG] ",
      "required": true,
      "description": "Brief description of the bug"
    },
    "System.Description": {
      "value": "<div><h3>Bug Description</h3><p>Describe what happened and what was expected.</p></div>",
      "required": true
    },
    "Microsoft.VSTS.TCM.ReproSteps": {
      "value": "<div><h3>Steps to Reproduce</h3><ol><li>Step 1</li><li>Step 2</li><li>Step 3</li></ol></div>",
      "required": true
    },
    "Microsoft.VSTS.TCM.SystemInfo": {
      "value": "<div><h3>Environment</h3><ul><li><strong>Environment:</strong> Development/Staging/Production</li><li><strong>Browser/Device:</strong> </li><li><strong>OS:</strong> </li><li><strong>App Version:</strong> </li></ul></div>",
      "required": true
    },
    "System.AreaPath": {
      "value": "DatingPlatform",
      "required": true
    },
    "System.IterationPath": {
      "value": "DatingPlatform",
      "required": false
    },
    "Microsoft.VSTS.Common.Priority": {
      "value": 2,
      "required": true,
      "allowedValues": [1, 2, 3, 4]
    },
    "Microsoft.VSTS.Common.Severity": {
      "value": "3 - Medium",
      "required": true,
      "allowedValues": [
        "1 - Critical",
        "2 - High",
        "3 - Medium",
        "4 - Low"
      ]
    },
    "System.Tags": {
      "value": "bug",
      "required": false
    },
    "Microsoft.VSTS.Common.AcceptanceCriteria": {
      "value": "<div><h3>Acceptance Criteria</h3><ul><li>Bug is fixed and verified</li><li>Unit tests added/updated</li><li>No regression in related functionality</li><li>Documentation updated if necessary</li></ul></div>",
      "required": true
    },
    "Custom.Component": {
      "value": "",
      "required": false,
      "description": "Component affected (api-gateway, user-service, matching-service, etc.)"
    },
    "Custom.ImpactedUsers": {
      "value": "",
      "required": false,
      "description": "Number or percentage of users affected"
    },
    "Custom.BusinessImpact": {
      "value": "",
      "required": false,
      "description": "Impact on business operations"
    }
  },
  "rules": [
    {
      "name": "Critical bugs must have immediate priority",
      "conditions": [
        {
          "field": "Microsoft.VSTS.Common.Severity",
          "operator": "equals",
          "value": "1 - Critical"
        }
      ],
      "actions": [
        {
          "field": "Microsoft.VSTS.Common.Priority",
          "value": 1
        }
      ]
    },
    {
      "name": "Production bugs require immediate attention",
      "conditions": [
        {
          "field": "Microsoft.VSTS.TCM.SystemInfo",
          "operator": "contains",
          "value": "Production"
        }
      ],
      "actions": [
        {
          "field": "Microsoft.VSTS.Common.Priority",
          "value": 1
        },
        {
          "field": "System.Tags",
          "value": "bug;production;urgent"
        }
      ]
    }
  ]
}
