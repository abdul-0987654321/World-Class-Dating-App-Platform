{
  "$schema": "https://dev.azure.com/schemas/workItemTemplates/1.0",
  "name": "Task Template - Dating Platform",
  "description": "Standard task template for the Dating Platform project",
  "workItemType": "Task",
  "fields": {
    "System.Title": {
      "value": "[Component] Task description",
      "required": true,
      "description": "Clear and concise task title"
    },
    "System.Description": {
      "value": "<div><h3>Task Description</h3><p>Describe what needs to be done in detail.</p><h3>Technical Details</h3><ul><li>Files to modify</li><li>Dependencies</li><li>Configuration changes</li></ul></div>",
      "required": true
    },
    "System.AreaPath": {
      "value": "DatingPlatform",
      "required": true
    },
    "System.IterationPath": {
      "value": "DatingPlatform",
      "required": false
    },
    "Microsoft.VSTS.Common.Priority": {
      "value": 2,
      "required": true,
      "allowedValues": [1, 2, 3, 4]
    },
    "Microsoft.VSTS.Common.Activity": {
      "value": "Development",
      "required": true,
      "allowedValues": [
        "Deployment",
        "Design",
        "Development",
        "Documentation",
        "Requirements",
        "Testing"
      ]
    },
    "Microsoft.VSTS.Scheduling.RemainingWork": {
      "value": null,
      "required": false,
      "description": "Estimated hours remaining"
    },
    "Microsoft.VSTS.Scheduling.OriginalEstimate": {
      "value": null,
      "required": false,
      "description": "Original estimate in hours"
    },
    "System.Tags": {
      "value": "task",
      "required": false
    },
    "Custom.Component": {
      "value": "",
      "required": false,
      "description": "Component/Service affected"
    },
    "Custom.BlockedBy": {
      "value": "",
      "required": false,
      "description": "Dependencies or blockers"
    },
    "Custom.DefinitionOfDone": {
      "value": "<div><h3>Definition of Done</h3><ul><li>Code is complete and committed</li><li>Code review completed</li><li>Unit tests pass</li><li>Integration tests pass</li><li>Documentation updated</li><li>No critical bugs remain</li><li>Code merged to main branch</li></ul></div>",
      "required": true
    }
  },
  "rules": [
    {
      "name": "Testing tasks must link to user stories",
      "conditions": [
        {
          "field": "Microsoft.VSTS.Common.Activity",
          "operator": "equals",
          "value": "Testing"
        }
      ],
      "actions": [
        {
          "field": "System.Tags",
          "value": "task;testing;qa"
        }
      ]
    },
    {
      "name": "Deployment tasks require review",
      "conditions": [
        {
          "field": "Microsoft.VSTS.Common.Activity",
          "operator": "equals",
          "value": "Deployment"
        }
      ],
      "actions": [
        {
          "field": "System.Tags",
          "value": "task;deployment;requires-review"
        }
      ]
    }
  ]
}
