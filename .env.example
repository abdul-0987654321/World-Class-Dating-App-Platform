# Flamoral Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flamoral
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/flamoral

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/flamoral
MONGODB_DB=flamoral

# Database - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-very-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-very-secret-refresh-key-change-in-production-min-32-chars

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@flamoral.com

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string

# Cors
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# ============================================================================
# Azure AD B2C Configuration
# ============================================================================

# B2C Tenant Configuration
B2C_TENANT_NAME=your-tenant-name
B2C_TENANT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
B2C_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
B2C_POLICY_NAME=B2C_1_SignUpSignIn

# Group Sync Automation (Service Principal)
AUTOMATION_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
AUTOMATION_CLIENT_SECRET=your-client-secret

# ============================================================================
# Azure AD Group IDs (saas-* naming convention)
# Provision these groups using: scripts/provision-ad-groups.sh
# ============================================================================

# Subscription Tiers
GROUP_ID_SAAS_FREE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_ID_SAAS_STANDARD=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_ID_SAAS_PREMIUM=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Feature/Status Groups
GROUP_ID_SAAS_VERIFIED=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Role Groups (Internal Staff)
GROUP_ID_SAAS_MODERATOR=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_ID_SAAS_OPERATOR=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
GROUP_ID_SAAS_ADMIN=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Special Status
GROUP_ID_BANNED=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
