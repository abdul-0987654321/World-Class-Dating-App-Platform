# Flamoral Environment Configuration - AWS
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database - PostgreSQL (Aurora PostgreSQL on AWS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flamoral
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/flamoral

# Database - MongoDB (DocumentDB on AWS)
MONGODB_URI=mongodb://localhost:27017/flamoral
MONGODB_DB=flamoral

# Database - Redis (ElastiCache on AWS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-very-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-very-secret-refresh-key-change-in-production-min-32-chars

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# SendGrid Email (or use AWS SES)
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@flamoral.com

# Twilio SMS (or use AWS SNS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# AWS Storage (S3)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_PHOTOS=flamoral-photos
AWS_S3_BUCKET_VIDEOS=flamoral-videos
AWS_S3_BUCKET_MEDIA=flamoral-media

# Cors
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# =============================================================================
# AWS Cognito Configuration
# =============================================================================

# Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# =============================================================================
# AWS Cognito Group IDs (saas-* naming convention)
# =============================================================================

# Subscription Tiers
GROUP_ID_SAAS_FREE=saas-free
GROUP_ID_SAAS_STANDARD=saas-standard
GROUP_ID_SAAS_PREMIUM=saas-premium

# Feature/Status Groups
GROUP_ID_SAAS_VERIFIED=saas-verified

# Role Groups (Internal Staff)
GROUP_ID_SAAS_MODERATOR=saas-moderator
GROUP_ID_SAAS_OPERATOR=saas-operator
GROUP_ID_SAAS_ADMIN=saas-admin

# Special Status
GROUP_ID_BANNED=banned
