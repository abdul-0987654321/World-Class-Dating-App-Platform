# ConnectSphere Environment Configuration
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=3000
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000

# Database - PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=connectsphere
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/connectsphere

# Database - MongoDB
MONGODB_URI=mongodb://localhost:27017/connectsphere
MONGODB_DB=connectsphere

# Database - Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=your-very-secret-jwt-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-very-secret-refresh-key-change-in-production-min-32-chars

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# SendGrid Email
SENDGRID_API_KEY=SG.your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@connectsphere.com

# Twilio SMS
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Azure Storage
AZURE_STORAGE_CONNECTION_STRING=your_azure_connection_string

# Cors
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
