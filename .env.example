# ============================================
# ConnectSphere Dating Platform
# Environment Configuration Template
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control

# ============================================
# APPLICATION SETTINGS
# ============================================
NODE_ENV=production
ENVIRONMENT=production
VERSION=1.0.0
BUILD_DATE=
VCS_REF=

# ============================================
# FRONTEND CONFIGURATION
# ============================================
VITE_API_URL=http://localhost/api
VITE_WS_URL=ws://localhost/ws
VITE_GRAPHQL_URL=http://localhost/graphql
VITE_ENVIRONMENT=production

# ============================================
# BACKEND SERVER PORTS
# ============================================
PORT=3000
GRAPHQL_PORT=4000
WS_PORT=5000

# ============================================
# DATABASE - PostgreSQL
# ============================================
DB_HOST=postgres
DB_PORT=5432
DB_NAME=connectsphere
DB_USER=postgres
DB_PASSWORD=your_strong_postgres_password_here

# Connection pool settings
DB_POOL_MIN=2
DB_POOL_MAX=10

# ============================================
# DATABASE - MongoDB
# ============================================
MONGODB_URI=mongodb://mongodb:27017/connectsphere
MONGODB_DB=connectsphere
MONGODB_USER=admin
MONGODB_PASSWORD=your_strong_mongodb_password_here

# ============================================
# CACHE & SESSION - Redis
# ============================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here
REDIS_DB=0

# Session configuration
SESSION_SECRET=your_session_secret_min_32_chars
SESSION_MAX_AGE=86400000

# ============================================
# MESSAGE QUEUE - RabbitMQ
# ============================================
RABBITMQ_URL=amqp://rabbitmq:5672
RABBITMQ_USER=admin
RABBITMQ_PASSWORD=your_strong_rabbitmq_password_here
RABBITMQ_VHOST=/

# Queue names
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue

# ============================================
# SEARCH ENGINE - Elasticsearch
# ============================================
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_INDEX_PREFIX=connectsphere

# ============================================
# JWT AUTHENTICATION
# ============================================
# Generate strong secrets: openssl rand -base64 64
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars_random_string
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars_random_string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# AZURE CLOUD SERVICES
# ============================================
# Azure Storage (for media files)
AZURE_STORAGE_ACCOUNT=your_azure_storage_account
AZURE_STORAGE_KEY=your_azure_storage_access_key
AZURE_STORAGE_CONTAINER=connectsphere-media

# Azure Face API (for photo verification)
AZURE_FACE_API_KEY=your_azure_face_api_key
AZURE_FACE_API_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# Azure Content Moderator
AZURE_CONTENT_MODERATOR_KEY=your_content_moderator_key
AZURE_CONTENT_MODERATOR_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# ============================================
# PAYMENT PROCESSING - Stripe
# ============================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Stripe Product IDs
STRIPE_PREMIUM_MONTHLY_PRICE_ID=price_xxxxx
STRIPE_PREMIUM_YEARLY_PRICE_ID=price_xxxxx
STRIPE_BOOST_PRICE_ID=price_xxxxx
STRIPE_SUPERLIKE_PRICE_ID=price_xxxxx

# ============================================
# SMS & PHONE - Twilio
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# EMAIL - SendGrid
# ============================================
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@connectsphere.com
SENDGRID_FROM_NAME=ConnectSphere

# Email templates
SENDGRID_TEMPLATE_WELCOME=d-xxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_VERIFY_EMAIL=d-xxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_PASSWORD_RESET=d-xxxxxxxxxxxxxxxxxxxxx
SENDGRID_TEMPLATE_MATCH_NOTIFICATION=d-xxxxxxxxxxxxxxxxxxxxx

# ============================================
# VIDEO/VOICE CALLING - Agora
# ============================================
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate
AGORA_CUSTOMER_ID=your_agora_customer_id
AGORA_CUSTOMER_SECRET=your_agora_customer_secret

# ============================================
# ERROR TRACKING - Sentry
# ============================================
SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=

# ============================================
# ANALYTICS - Google Analytics
# ============================================
GA_TRACKING_ID=UA-XXXXXXXXX-X
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ============================================
# SOCIAL AUTH (Optional)
# ============================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost/api/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=http://localhost/api/auth/facebook/callback

# Apple OAuth
APPLE_CLIENT_ID=your_apple_client_id
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY_PATH=/path/to/apple/private/key.p8

# ============================================
# MONITORING - Grafana
# ============================================
GRAFANA_USER=admin
GRAFANA_PASSWORD=your_strong_grafana_password

# ============================================
# SECURITY SETTINGS
# ============================================
# CORS
CORS_ORIGIN=http://localhost,https://connectsphere.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_KEY=your_encryption_key_32_chars_min
ENCRYPTION_ALGORITHM=aes-256-gcm

# ============================================
# GEOLOCATION
# ============================================
# IP Geolocation Service (e.g., IPStack, MaxMind)
GEOLOCATION_API_KEY=your_geolocation_api_key
GEOLOCATION_API_URL=https://api.ipstack.com

# ============================================
# CDN & STATIC ASSETS
# ============================================
CDN_URL=https://cdn.connectsphere.com
STATIC_ASSETS_URL=https://static.connectsphere.com

# ============================================
# PUSH NOTIFICATIONS
# ============================================
# Firebase Cloud Messaging
FCM_SERVER_KEY=your_fcm_server_key
FCM_SENDER_ID=your_fcm_sender_id

# Apple Push Notification Service
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apns_team_id
APNS_BUNDLE_ID=com.connectsphere.app
APNS_PRODUCTION=false

# ============================================
# MATCHING ALGORITHM SETTINGS
# ============================================
MATCHING_RADIUS_KM=50
MATCHING_AGE_RANGE=5
MATCHING_BATCH_SIZE=50
MATCHING_UPDATE_INTERVAL=3600000

# ============================================
# PHOTO VERIFICATION
# ============================================
PHOTO_VERIFICATION_ENABLED=true
PHOTO_MIN_FACE_CONFIDENCE=0.8
PHOTO_MAX_FILE_SIZE_MB=10
PHOTO_ALLOWED_FORMATS=jpg,jpeg,png,heic

# ============================================
# MODERATION SETTINGS
# ============================================
AUTO_MODERATION_ENABLED=true
MODERATION_CONFIDENCE_THRESHOLD=0.7
FLAGGED_CONTENT_REVIEW_REQUIRED=true

# ============================================
# FEATURE FLAGS
# ============================================
FEATURE_VIDEO_CALLS=true
FEATURE_VOICE_CALLS=true
FEATURE_VIRTUAL_GIFTS=true
FEATURE_PREMIUM_SUBSCRIPTIONS=true
FEATURE_BOOST=true
FEATURE_SUPER_LIKES=true
FEATURE_READ_RECEIPTS=true
FEATURE_UNDO_SWIPE=true

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/connectsphere

# ============================================
# DOCKER & DEPLOYMENT
# ============================================
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=citadelcloud1
DOCKER_REPOSITORY=world-class-dating-platform
DOCKER_TAG=latest

# Health check
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# ============================================
# DEVELOPMENT ONLY
# ============================================
DEBUG=false
MOCK_EXTERNAL_SERVICES=false
SEED_DATABASE=false
