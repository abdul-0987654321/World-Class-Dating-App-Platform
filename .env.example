# Flamoral Environment Configuration - AWS
# Copy this file to .env and fill in your values
# NEVER commit .env files with real secrets to git!

# =============================================================================
# Application Settings
# =============================================================================
NODE_ENV=development
# In production, set NODE_ENV=production
WEB_URL=http://localhost:5173
API_URL=http://localhost:4000

# =============================================================================
# Service URLs (Per README.md Port Mapping)
# =============================================================================
API_GATEWAY_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3003
MESSAGING_SERVICE_URL=http://localhost:5000
PAYMENT_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
MEDIA_SERVICE_URL=http://localhost:3009
ADMIN_SERVICE_URL=http://localhost:3010
ADVERTISING_SERVICE_URL=http://localhost:3011
MODERATION_SERVICE_URL=http://localhost:3012
AUTOMATION_SERVICE_URL=http://localhost:3013
PARTNERSHIP_SERVICE_URL=http://localhost:3014
RECOMMENDATION_SERVICE_URL=http://localhost:3021
VERIFICATION_SERVICE_URL=http://localhost:3022

# SECURITY: Email verification settings
# IMPORTANT: Email verification is REQUIRED by default in production (even if not set)
# Only set to 'false' for local development/testing - NEVER in production!
# When NODE_ENV=production, defaults to true unless explicitly set to 'false'
REQUIRE_EMAIL_VERIFICATION=true

# Database - PostgreSQL (Aurora PostgreSQL on AWS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=flamoral
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/flamoral

# Database - MongoDB (DocumentDB on AWS)
MONGODB_URI=mongodb://localhost:27017/flamoral
MONGODB_DB=flamoral

# Database - Redis (ElastiCache on AWS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# =============================================================================
# Authentication & Security
# =============================================================================
# CRITICAL: Generate secure random secrets for production!
# Use: openssl rand -base64 64 | tr -d '\n/+=' | head -c 64
JWT_SECRET=CHANGE_ME_generate_secure_random_64_char_string_for_production
JWT_ACCESS_SECRET=CHANGE_ME_generate_secure_random_64_char_string_for_production
JWT_REFRESH_SECRET=CHANGE_ME_generate_secure_random_64_char_string_for_production

# Service-to-service authentication
SERVICE_TOKEN=CHANGE_ME_generate_secure_random_48_char_string
SERVICE_API_KEY=CHANGE_ME_generate_secure_random_48_char_string
INTERNAL_SERVICE_KEY=CHANGE_ME_generate_secure_random_48_char_string

# Encryption key for sensitive data (must be exactly 32 bytes for AES-256)
# Use: openssl rand -hex 16
ENCRYPTION_KEY=CHANGE_ME_generate_32_byte_hex_string

# TOTP encryption key for 2FA secrets
TOTP_ENCRYPTION_KEY=CHANGE_ME_generate_32_byte_hex_string

# Stripe Payment
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key

# AWS SES Email Configuration
AWS_SES_REGION=us-east-1
EMAIL_FROM=noreply@flamoral.com
EMAIL_FROM_NAME=Flamoral
AWS_SES_CONFIGURATION_SET=flamoral-emails

# AWS SNS SMS Configuration
AWS_SNS_REGION=us-east-1
AWS_SNS_SENDER_ID=Flamoral
AWS_SNS_MONTHLY_SPEND_LIMIT=100

# AWS SQS Queue Configuration
USE_AWS_SQS=true
AWS_SQS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
AWS_SQS_QUEUE_PREFIX=flamoral
# Optional: Override individual queue URLs
# AWS_SQS_NOTIFICATIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/flamoral-notifications
# AWS_SQS_EMAILS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/flamoral-emails
# AWS_SQS_SMS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/flamoral-sms
# AWS_SQS_PUSH_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/flamoral-push
# AWS_SQS_HIGH_PRIORITY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789/flamoral-high-priority
# AWS_SQS_DLQ_URL=https://sqs.us-east-1.amazonaws.com/123456789/flamoral-dlq

# =============================================================================
# AWS Storage (S3)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_PHOTOS=flamoral-photos
AWS_S3_BUCKET_VIDEOS=flamoral-videos
AWS_S3_BUCKET_MEDIA=flamoral-media

# =============================================================================
# CORS Configuration
# =============================================================================
# Development origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4000

# Production origins (update these for production deployment)
# CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com

# =============================================================================
# AWS Cognito Configuration
# =============================================================================

# Cognito User Pool
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# =============================================================================
# AWS Cognito Group IDs (saas-* naming convention)
# =============================================================================

# Subscription Tiers
GROUP_ID_SAAS_FREE=saas-free
GROUP_ID_SAAS_STANDARD=saas-standard
GROUP_ID_SAAS_PREMIUM=saas-premium

# Feature/Status Groups
GROUP_ID_SAAS_VERIFIED=saas-verified

# Role Groups (Internal Staff)
GROUP_ID_SAAS_MODERATOR=saas-moderator
GROUP_ID_SAAS_OPERATOR=saas-operator
GROUP_ID_SAAS_ADMIN=saas-admin

# Special Status
GROUP_ID_BANNED=banned

# =============================================================================
# AWS SNS Push Notifications (Mobile)
# Replaces Firebase Cloud Messaging - AWS-Only Compliant
# =============================================================================

# Platform Application ARNs (created via AWS Console or Terraform)
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:us-east-1:123456789:app/GCM/flamoral-android
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:us-east-1:123456789:app/APNS/flamoral-ios
AWS_SNS_PLATFORM_APPLICATION_ARN_WEB=arn:aws:sns:us-east-1:123456789:app/GCM/flamoral-web

# =============================================================================
# DEPRECATED - External Services (AWS-Only Migration)
# =============================================================================
# The following services have been replaced by AWS-native alternatives:
#
# TWILIO (SMS) → AWS SNS (configured above as AWS_SNS_*)
# SENDGRID (Email) → AWS SES (configured above as AWS_SES_*)
# FIREBASE (Push) → AWS SNS Platform Applications (configured above)
#
# These variables are kept for backward compatibility during migration.
# Remove after complete migration to AWS services.
# -----------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=your_twilio_account_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token
# TWILIO_PHONE_NUMBER=+1234567890
# SENDGRID_API_KEY=your_sendgrid_api_key
# FIREBASE_PROJECT_ID=your-firebase-project
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com

# =============================================================================
# Video/WebRTC Configuration
# =============================================================================
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_app_certificate

# =============================================================================
# Feature Flags
# =============================================================================
ENABLE_VIDEO_CALLS=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_AI_MATCHING=true
ENABLE_PUSH_NOTIFICATIONS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
# LOG_LEVEL=debug for development
