{
  "name": "flamoral-monorepo",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "description": "Flamoral - Where Passion Meets Connection (Web & Mobile Dating Platform)",
  "workspaces": [
    "packages/*",
    "packages/shared/types",
    "packages/shared/utils",
    "packages/shared/constants",
    "packages/shared/validators",
    "packages/shared/api-client",
    "apps/*",
    "backend",
    "backend/shared",
    "backend/services/*"
  ],
  "scripts": {
    "test": "echo 'Skipping pre-push tests - run npm run test:all for full test suite'",
    "install:all": "npm install",
    "build:shared": "tsc --build --force packages/shared/types packages/shared/constants && tsc --build --force packages/shared/utils packages/shared/validators packages/shared/api-client && tsc --build --force packages/shared",
    "build:backend-shared": "cd backend/shared && npm run build",
    "build:all": "npm run build:shared && npm run build:backend-shared && lerna run build --ignore @flamoral/shared --ignore @flamoral/types --ignore @flamoral/constants --ignore @flamoral/utils --ignore @flamoral/validators --ignore @flamoral/api-client --ignore @flamoral/backend-shared",
    "test:all": "lerna run test",
    "lint:all": "lerna run lint",
    "clean": "lerna clean -y && rm -rf node_modules",
    "dev:web": "npm run -w @flamoral/web dev",
    "dev:mobile": "npm run -w @flamoral/mobile start",
    "dev:backend": "npm run -w @flamoral/backend dev",
    "build:web": "npm run -w @flamoral/web build",
    "build:mobile:ios": "cd apps/mobile && npx react-native run-ios --configuration Release",
    "build:mobile:android": "cd apps/mobile && npx react-native run-android --variant=release",
    "build:backend": "npm run -w @flamoral/backend build",
    "setup:dev": "npm install && npm run docker:dev:up",
    "docker:test:up": "docker-compose -f infrastructure/local-dev/docker-compose.test.yml up -d --wait",
    "docker:test:down": "docker-compose -f infrastructure/local-dev/docker-compose.test.yml down -v",
    "docker:test:logs": "docker-compose -f infrastructure/local-dev/docker-compose.test.yml logs -f",
    "test:backend": "cd backend && npm test",
    "test:backend:coverage": "cd backend && npm test -- --coverage",
    "test:integration": "cd backend && jest --config tests/jest.config.integration.enhanced.js",
    "test:integration:docker": "npm run docker:test:up && npm run test:integration && npm run docker:test:down",
    "test:integration:coverage": "cd backend && jest --config tests/jest.config.integration.enhanced.js --coverage",
    "test:integration:watch": "cd backend && jest --config tests/jest.config.integration.enhanced.js --watch",
    "test:backend:e2e": "cd backend && jest --config tests/jest.config.e2e.js --runInBand",
    "test:backend:e2e:docker": "npm run docker:test:up && npm run test:backend:e2e && npm run docker:test:down",
    "test:e2e:api": "jest --config tests/e2e/api/jest.config.js --runInBand",
    "test:e2e:api:auth": "jest --config tests/e2e/api/jest.config.js --testPathPattern=auth.e2e.spec.ts --runInBand",
    "test:e2e:api:payment": "jest --config tests/e2e/api/jest.config.js --testPathPattern=payment.e2e.spec.ts --runInBand",
    "test:e2e:api:user": "jest --config tests/e2e/api/jest.config.js --testPathPattern=user-profile.e2e.spec.ts --runInBand",
    "test:e2e:api:matching": "jest --config tests/e2e/api/jest.config.js --testPathPattern=matching.e2e.spec.ts --runInBand",
    "test:e2e:api:docker": "npm run docker:test:up && npm run test:e2e:api && npm run docker:test:down",
    "test:e2e:api:staging": "cross-env API_GATEWAY_URL=$STAGING_URL AUTH_URL=$STAGING_AUTH_URL npm run test:e2e:api",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:firefox": "playwright test --project=firefox",
    "test:e2e:webkit": "playwright test --project=webkit",
    "test:e2e:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:e2e:smoke": "playwright test --project=smoke",
    "test:e2e:assets": "playwright test tests/e2e/asset-verification.spec.ts",
    "test:e2e:ux": "playwright test tests/e2e/ux-validation.spec.ts",
    "test:e2e:web": "cd apps/web-app && playwright test",
    "test:load:auth": "k6 run tests/load/scenarios/auth-load.js",
    "test:load:matching": "k6 run tests/load/scenarios/matching-load.js",
    "test:load:websocket": "k6 run tests/load/scenarios/websocket-load.js",
    "test:load:all": "npm run test:load:auth && npm run test:load:matching && npm run test:load:websocket",
    "test:security": "npm test -- tests/security/",
    "test:security:abuse": "jest tests/security/business-logic-abuse/",
    "test:security:owasp": "npm test -- tests/security/owasp-tests.spec.ts",
    "test:security:auth": "npm test -- tests/security/authentication-security.spec.ts",
    "security:scan": "ts-node tools/security-agent/scan.ts",
    "security:sast": "npx semgrep scan --config auto",
    "security:audit": "npm audit --audit-level=high",
    "security:pr": "npm run security:scan && npm run security:audit && npm run test:security:abuse",
    "test:ci": "npm run test:backend && npm run test:integration:docker && npm run test:e2e",
    "test:ci:coverage": "npm run test:backend:coverage && npm run test:integration:coverage",
    "test:smoke": "npm run test:smoke:api && npm run test:smoke:ui",
    "test:smoke:api": "jest --config tests/e2e/api/jest.config.js --testPathPattern=smoke --runInBand",
    "test:smoke:ui": "playwright test --project=smoke",
    "test:regression": "npm run test:regression:api && npm run test:regression:ui",
    "test:regression:api": "jest --config tests/e2e/api/jest.config.js --runInBand",
    "test:regression:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:regression:full": "npm run test:backend && npm run test:integration && npm run test:regression",
    "test:report": "allure open allure-report",
    "test:report:generate": "bash scripts/generate-allure-report.sh",
    "test:report:serve": "bash scripts/generate-allure-report.sh --serve",
    "test:report:open": "bash scripts/generate-allure-report.sh --open",
    "test:report:clean": "rm -rf allure-results allure-report allure-history",
    "docker:dev:up": "docker-compose -f infrastructure/local-dev/docker-compose.dev.yml up -d",
    "docker:dev:down": "docker-compose -f infrastructure/local-dev/docker-compose.dev.yml down",
    "docker:dev:rebuild": "docker-compose -f infrastructure/local-dev/docker-compose.dev.yml down && docker-compose -f infrastructure/local-dev/docker-compose.dev.yml build && docker-compose -f infrastructure/local-dev/docker-compose.dev.yml up -d"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.0",
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "allure-commandline": "^2.24.1",
    "allure-jest": "^2.12.0",
    "allure-playwright": "^2.15.1",
    "cross-env": "^7.0.3",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "globals": "^16.5.0",
    "husky": "^8.0.3",
    "jest": "^29.7.0",
    "jest-junit": "^16.0.0",
    "js-yaml": ">=4.1.0",
    "lerna": "^9.0.3",
    "prettier": "^3.1.0",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.50.1",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/flamoral/flamoral-dating-platform.git"
  },
  "author": "Flamoral Team",
  "license": "MIT",
  "resolutions": {
    "node-forge": "^1.3.2",
    "tar": ">=6.2.0",
    "diff": "^4.0.4",
    "sharp": "0.32.6",
    "js-yaml": ">=4.1.0",
    "react-server-dom-webpack": "19.0.2"
  },
  "overrides": {
    "node-forge": "^1.3.2",
    "tar": ">=6.2.0",
    "diff": "^4.0.4",
    "sharp": "0.32.6",
    "js-yaml": ">=4.1.0",
    "react-server-dom-webpack": "19.0.2"
  }
}
