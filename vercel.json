{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/stripe/webhook",
      "destination": "https://api.flamoral.com/api/v1/webhooks/stripe"
    },
    {
      "source": "/api/:path*",
      "destination": "https://api.flamoral.com/api/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "https://api.flamoral.com/ws/:path*"
    },
    {
      "source": "/socket.io/:path*",
      "destination": "https://api.flamoral.com/socket.io/:path*"
    },
    {
      "source": "/graphql",
      "destination": "https://api.flamoral.com/graphql"
    },
    {
      "source": "/health",
      "destination": "https://api.flamoral.com/health"
    },
    {
      "source": "/health/:path*",
      "destination": "https://api.flamoral.com/health/:path*"
    },
    {
      "source": "/((?!assets/|api/|ws/|socket\\.io/|graphql|\\.well-known/|stripe/|webhooks/|health).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), geolocation=(self), payment=(self)" },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://fonts.googleapis.com https://js.stripe.com https://cdn.clerk.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://api.flamoral.com https://*.flamoral.com https://api.stripe.com https://*.clerk.com wss://api.flamoral.com wss://*.flamoral.com; frame-src 'self' https://js.stripe.com https://*.clerk.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://www.flamoral.com"
        },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS" },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "X-Requested-With, Content-Type, Authorization, X-CSRF-Token, X-Request-ID"
        }
      ]
    }
  ]
}
