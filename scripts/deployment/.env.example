# Flamoral Dating Platform - Deployment Configuration Example
# Copy this file to .env and update with your values

# ============================================================================
# Azure Configuration
# ============================================================================

# Azure Subscription
AZURE_SUBSCRIPTION_ID="your-subscription-id-here"
AZURE_TENANT_ID="your-tenant-id-here"
AZURE_RESOURCE_GROUP="flamoral-prod-rg"
AZURE_LOCATION="eastus"

# Azure Container Registry
ACR_NAME="flamoralprodacr"
ACR_LOGIN_SERVER="flamoralprodacr.azurecr.io"

# Azure Key Vault
KEY_VAULT_NAME="flamoral-prod-kv"
KEY_VAULT_RESOURCE_GROUP="flamoral-prod-rg"

# Azure Storage (for backups)
BACKUP_STORAGE_ACCOUNT="flamoralprodsa"
BACKUP_CONTAINER="database-backups"

# ============================================================================
# Kubernetes Configuration
# ============================================================================

# Cluster Configuration
AKS_CLUSTER_NAME="flamoral-prod-aks"
AKS_RESOURCE_GROUP="flamoral-prod-rg"
NAMESPACE="flamoral-dating"
KUBECONFIG="/path/to/.kube/config"

# Default Deployment Settings
DEFAULT_ENVIRONMENT="production"
DEFAULT_REPLICAS="3"
DEFAULT_IMAGE_TAG="latest"

# ============================================================================
# Deployment Configuration
# ============================================================================

# Deployment Behavior
DRY_RUN="false"
AUTO_ROLLBACK="true"
BACKUP_BEFORE_DEPLOY="true"
WAIT_TIMEOUT="300"  # seconds
HEALTH_CHECK_TIMEOUT="300"  # seconds

# Traffic Management
TRAFFIC_SWITCH_DELAY="10"  # seconds
CANARY_START_PERCENTAGE="10"
CANARY_INCREMENT="10"
CANARY_MONITOR_DURATION="60"  # seconds

# ============================================================================
# Notification Configuration
# ============================================================================

# Email Notifications
NOTIFICATION_EMAIL="ops@flamoral.com,admin@flamoral.com"
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT="587"
SMTP_USER="apikey"
# SMTP_PASSWORD stored in Key Vault

# Slack Notifications
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
SLACK_CHANNEL="#deployments"

# Microsoft Teams (optional)
TEAMS_WEBHOOK_URL=""

# PagerDuty (optional)
PAGERDUTY_INTEGRATION_KEY=""

# ============================================================================
# Service Configuration
# ============================================================================

# Service List (in dependency order)
SERVICES=(
    "auth-service"
    "user-service"
    "media-service"
    "matching-service"
    "messaging-service"
    "notification-service"
    "payment-service"
    "analytics-service"
    "moderation-service"
    "admin-service"
    "realtime-service"
    "api-gateway"
    "advertising-service"
    "automation-service"
    "workflow-engine"
)

# Service Ports (for health checks)
USER_SERVICE_PORT="3001"
AUTH_SERVICE_PORT="3002"
MATCHING_SERVICE_PORT="3003"
MESSAGING_SERVICE_PORT="3004"
MEDIA_SERVICE_PORT="3005"
PAYMENT_SERVICE_PORT="3006"
NOTIFICATION_SERVICE_PORT="3007"
ANALYTICS_SERVICE_PORT="3008"
MODERATION_SERVICE_PORT="3009"
REALTIME_SERVICE_PORT="3010"
ADMIN_SERVICE_PORT="3011"
API_GATEWAY_PORT="3000"

# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL
POSTGRES_HOST="flamoral-postgres.postgres.database.azure.com"
POSTGRES_PORT="5432"
POSTGRES_ADMIN_USER="flamoral_admin"
# POSTGRES_ADMIN_PASSWORD stored in Key Vault

# Database names per service
DB_USER_SERVICE="flamoral_users"
DB_AUTH_SERVICE="flamoral_auth"
DB_MATCHING_SERVICE="flamoral_matching"
DB_MESSAGING_SERVICE="flamoral_messages"
DB_MEDIA_SERVICE="flamoral_media"
DB_PAYMENT_SERVICE="flamoral_payments"
DB_NOTIFICATION_SERVICE="flamoral_notifications"
DB_ANALYTICS_SERVICE="flamoral_analytics"
DB_MODERATION_SERVICE="flamoral_moderation"
DB_ADMIN_SERVICE="flamoral_admin"

# Migration Configuration
MIGRATION_BACKUP_ENABLED="true"
MIGRATION_TIMEOUT="600"  # seconds
MIGRATION_AUTO_ROLLBACK="true"

# ============================================================================
# Monitoring Configuration
# ============================================================================

# Prometheus
PROMETHEUS_URL="https://prometheus.flamoral.com"
PROMETHEUS_NAMESPACE="monitoring"

# Grafana
GRAFANA_URL="https://grafana.flamoral.com"
GRAFANA_API_KEY=""  # stored in Key Vault

# Application Insights
APPINSIGHTS_INSTRUMENTATION_KEY=""  # stored in Key Vault
APPINSIGHTS_CONNECTION_STRING=""

# Log Analytics
LOG_ANALYTICS_WORKSPACE_ID=""
LOG_ANALYTICS_WORKSPACE_KEY=""  # stored in Key Vault

# ============================================================================
# Security Configuration
# ============================================================================

# SSL/TLS Configuration
CERT_MANAGER_NAMESPACE="cert-manager"
CERT_ISSUER="letsencrypt-prod"
CERT_EMAIL="ssl@flamoral.com"

# Domains
PRIMARY_DOMAIN="flamoral.com"
API_DOMAIN="api.flamoral.com"
WILDCARD_DOMAIN="*.flamoral.com"

# Secret Rotation
SECRET_ROTATION_INTERVAL="30"  # days
SECRET_ROTATION_NOTIFY="true"

# ============================================================================
# Backup Configuration
# ============================================================================

# Backup Schedule
BACKUP_RETENTION_DAYS="30"
BACKUP_VERIFICATION_DAYS="7"
BACKUP_FREQUENCY="daily"  # daily, hourly

# Backup Types
BACKUP_DATABASE="true"
BACKUP_STORAGE="true"
BACKUP_CONFIGS="true"

# ============================================================================
# Disaster Recovery Configuration
# ============================================================================

# DR Settings
DR_ENABLED="true"
DR_REGION="westus2"
DR_REPLICATION_TYPE="geo-redundant"

# Recovery Objectives
RTO="4 hours"  # Recovery Time Objective
RPO="1 hour"   # Recovery Point Objective

# DR Testing
DR_TEST_FREQUENCY="monthly"
DR_TEST_NOTIFICATION="true"

# ============================================================================
# Scaling Configuration
# ============================================================================

# Scaling Profiles
SCALE_PROFILE_MAINTENANCE_MIN="1"
SCALE_PROFILE_LOW_MIN="2"
SCALE_PROFILE_NORMAL_MIN="3"
SCALE_PROFILE_HIGH_MIN="5"
SCALE_PROFILE_PEAK_MIN="10"

SCALE_PROFILE_MAINTENANCE_MAX="2"
SCALE_PROFILE_LOW_MAX="5"
SCALE_PROFILE_NORMAL_MAX="10"
SCALE_PROFILE_HIGH_MAX="20"
SCALE_PROFILE_PEAK_MAX="50"

# HPA Configuration
HPA_CPU_THRESHOLD="70"
HPA_MEMORY_THRESHOLD="80"
HPA_SCALE_DOWN_DELAY="300"  # seconds

# ============================================================================
# Logging Configuration
# ============================================================================

# Log Directories
LOG_DIR="/var/log/flamoral/deployment"
AUDIT_LOG_DIR="/var/log/flamoral/audit"
STATE_DIR="/var/lib/flamoral/state"

# Log Retention
LOG_RETENTION_DAYS="90"
AUDIT_LOG_RETENTION_DAYS="365"
STATE_RETENTION_DAYS="90"

# Log Levels
LOG_LEVEL="INFO"  # DEBUG, INFO, WARNING, ERROR
VERBOSE_LOGGING="false"

# ============================================================================
# Feature Flags
# ============================================================================

# Deployment Features
ENABLE_BLUE_GREEN="true"
ENABLE_CANARY="true"
ENABLE_ROLLBACK="true"
ENABLE_AUTO_SCALING="true"

# Safety Features
ENABLE_PRE_CHECKS="true"
ENABLE_POST_CHECKS="true"
ENABLE_SMOKE_TESTS="true"
ENABLE_LOAD_TESTS="false"

# Automation Features
ENABLE_AUTO_ROLLBACK="true"
ENABLE_AUTO_SCALING="true"
ENABLE_AUTO_HEALING="true"

# ============================================================================
# Performance Configuration
# ============================================================================

# Resource Limits
DEFAULT_CPU_REQUEST="250m"
DEFAULT_CPU_LIMIT="1000m"
DEFAULT_MEMORY_REQUEST="512Mi"
DEFAULT_MEMORY_LIMIT="2Gi"

# Network Configuration
SERVICE_MESH_ENABLED="true"
ISTIO_NAMESPACE="istio-system"
NETWORK_POLICY_ENABLED="true"

# ============================================================================
# Development/Testing Configuration
# ============================================================================

# Development Settings (for non-production environments)
DEV_SKIP_BACKUPS="false"
DEV_FAST_ROLLOUT="false"
DEV_MOCK_NOTIFICATIONS="false"

# Testing
RUN_INTEGRATION_TESTS="true"
RUN_E2E_TESTS="false"
TEST_TIMEOUT="900"  # seconds

# ============================================================================
# External Service Configuration
# ============================================================================

# Third-party Services
STRIPE_ENABLED="true"
APPLE_IAP_ENABLED="true"
GOOGLE_IAP_ENABLED="true"
TWILIO_ENABLED="true"
SENDGRID_ENABLED="true"

# API Endpoints
# All API keys stored in Key Vault
STRIPE_API_VERSION="2023-10-16"

# ============================================================================
# Compliance Configuration
# ============================================================================

# Compliance Settings
GDPR_ENABLED="true"
CCPA_ENABLED="true"
HIPAA_ENABLED="false"

# Audit Requirements
AUDIT_ALL_DEPLOYMENTS="true"
AUDIT_ALL_ROLLBACKS="true"
AUDIT_SECRET_ACCESS="true"

# Data Residency
DATA_RESIDENCY_REGION="US"
DATA_SOVEREIGNTY_ENABLED="true"

# ============================================================================
# Advanced Configuration
# ============================================================================

# Custom Hooks (optional)
PRE_DEPLOY_HOOK=""
POST_DEPLOY_HOOK=""
PRE_ROLLBACK_HOOK=""
POST_ROLLBACK_HOOK=""

# Custom Validation
CUSTOM_HEALTH_CHECK_SCRIPT=""
CUSTOM_SMOKE_TEST_SCRIPT=""

# Integration Points
JIRA_ENABLED="false"
JIRA_PROJECT_KEY=""
GITHUB_ENABLED="true"
GITHUB_REPO="flamoral/dating-platform"

# ============================================================================
# Notes
# ============================================================================

# IMPORTANT:
# 1. Never commit .env file with real credentials
# 2. Use Azure Key Vault for all secrets
# 3. Rotate credentials regularly (monthly recommended)
# 4. Test in staging before production
# 5. Keep this file updated with latest configuration options

# SECURITY BEST PRACTICES:
# - Store all passwords/keys in Azure Key Vault
# - Use managed identities where possible
# - Enable audit logging for all operations
# - Implement least privilege access
# - Regularly rotate secrets

# OPERATIONAL BEST PRACTICES:
# - Test all scripts in staging first
# - Always use dry-run for production changes
# - Monitor deployments actively
# - Have rollback plan ready
# - Document all changes
