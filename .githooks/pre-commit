#!/bin/sh
# Prevent committing .env files with secrets

# Check for .env files being staged (excluding .example files)
STAGED_ENV_FILES=$(git diff --cached --name-only | grep -E '\.env' | grep -v '\.example' || true)

if [ -n "$STAGED_ENV_FILES" ]; then
  echo "ERROR: Attempting to commit .env files:"
  echo "$STAGED_ENV_FILES"
  echo ""
  echo "These files may contain secrets. Remove them with:"
  echo "  git reset HEAD <file>"
  echo ""
  exit 1
fi

# Check for common secret patterns in staged files
SECRETS_FOUND=$(git diff --cached -U0 | grep -iE '(sk_live_|pk_live_|sk_test_|OIDC_TOKEN|SECRET_KEY|PRIVATE_KEY)' | head -5 || true)

if [ -n "$SECRETS_FOUND" ]; then
  echo "ERROR: Potential secrets detected in staged changes:"
  echo "$SECRETS_FOUND"
  echo ""
  echo "Please remove secrets before committing."
  exit 1
fi

exit 0
