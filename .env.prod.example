# =============================================================================
# Flamoral Dating Platform - Production Environment Configuration
# =============================================================================
# SECURITY WARNING: This file contains production configuration structure
# NEVER commit actual production secrets to version control
# Use Azure Key Vault for ALL production secrets
# =============================================================================

# =============================================================================
# Environment Configuration
# =============================================================================
NODE_ENV=production
ENVIRONMENT=production
PORT=3000
GRAPHQL_PORT=4000
WS_PORT=5000

# =============================================================================
# URLs and Hosts
# =============================================================================
WEB_URL=https://flamoral.app
API_URL=https://api.flamoral.app
INGRESS_HOST=flamoral.app
API_HOST=api.flamoral.app

# =============================================================================
# Database - PostgreSQL (Azure Database for PostgreSQL - Production Tier)
# =============================================================================
DB_HOST=flamoral-prod-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral
DB_USER=flamoral_admin
DB_PASSWORD=*** # STORE IN AZURE KEY VAULT
DB_POOL_MIN=10
DB_POOL_MAX=50
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true
DATABASE_URL=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Database - MongoDB (Azure Cosmos DB with MongoDB API)
# =============================================================================
MONGODB_URI=*** # STORE IN AZURE KEY VAULT
MONGODB_DB=flamoral-prod

# =============================================================================
# Cache - Redis (Azure Cache for Redis - Premium Tier)
# =============================================================================
REDIS_HOST=flamoral-prod-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=*** # STORE IN AZURE KEY VAULT
REDIS_DB=0
REDIS_URL=*** # STORE IN AZURE KEY VAULT
REDIS_TLS=true
REDIS_CLUSTER_MODE=true

# =============================================================================
# Message Queue - Azure Service Bus
# =============================================================================
RABBITMQ_URL=*** # STORE IN AZURE KEY VAULT
AZURE_SERVICE_BUS_CONNECTION_STRING=*** # STORE IN AZURE KEY VAULT
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue

# =============================================================================
# Authentication - JWT
# =============================================================================
# CRITICAL: Use cryptographically secure random strings (minimum 64 characters)
# MUST be stored in Azure Key Vault
JWT_ACCESS_SECRET=*** # STORE IN AZURE KEY VAULT (64+ chars)
JWT_REFRESH_SECRET=*** # STORE IN AZURE KEY VAULT (64+ chars)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Payment Gateway - Stripe (LIVE MODE - PRODUCTION KEYS)
# =============================================================================
# WARNING: These are LIVE keys that process real payments
STRIPE_SECRET_KEY=*** # STORE IN AZURE KEY VAULT (sk_live_...)
STRIPE_PUBLISHABLE_KEY=pk_live_... # Can be public but document here
STRIPE_WEBHOOK_SECRET=*** # STORE IN AZURE KEY VAULT (whsec_...)

# =============================================================================
# Email Service - SendGrid (Production)
# =============================================================================
SENDGRID_API_KEY=*** # STORE IN AZURE KEY VAULT
SENDGRID_FROM_EMAIL=noreply@flamoral.com
SENDGRID_FROM_NAME=Flamoral

# =============================================================================
# SMS Service - Twilio (Production)
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Document here
TWILIO_AUTH_TOKEN=*** # STORE IN AZURE KEY VAULT
TWILIO_PHONE_NUMBER=+1234567890 # Your verified production number
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Document here

# =============================================================================
# Azure Storage (Production - Premium Tier)
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoralprodst
AZURE_STORAGE_KEY=*** # STORE IN AZURE KEY VAULT
AZURE_STORAGE_CONNECTION_STRING=*** # STORE IN AZURE KEY VAULT
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos
AZURE_STORAGE_CDN_ENDPOINT=https://flamoral.azureedge.net

# =============================================================================
# Azure Cognitive Services - Face API (Production)
# =============================================================================
AZURE_FACE_API_KEY=*** # STORE IN AZURE KEY VAULT
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# =============================================================================
# Video/Voice Calling - Agora (Production)
# =============================================================================
AGORA_APP_ID=your_production_agora_app_id # Document here
AGORA_APP_CERTIFICATE=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Error Tracking - Sentry (Production)
# =============================================================================
SENTRY_DSN=*** # STORE IN AZURE KEY VAULT
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_RELEASE=flamoral@1.0.0

# =============================================================================
# CORS Configuration (Strict Production Settings)
# =============================================================================
CORS_ORIGIN=https://flamoral.app,https://www.flamoral.app
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting (Production - Stricter Limits)
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_ENABLED=true

# =============================================================================
# Logging (Production)
# =============================================================================
LOG_LEVEL=warn
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/flamoral
LOG_ROTATION_ENABLED=true
LOG_RETENTION_DAYS=30

# =============================================================================
# Azure Container Registry (ACR)
# =============================================================================
ACR_NAME=flamoralacr8eq5eg
ACR_LOGIN_SERVER=flamoralacr8eq5eg.azurecr.io
ACR_USERNAME=flamoralacr8eq5eg
ACR_PASSWORD=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Kubernetes / AKS (Production Cluster)
# =============================================================================
AKS_CLUSTER_NAME=flamoral-prod-aks
AKS_RESOURCE_GROUP=flamoral-prod-rg
NAMESPACE=flamoral-prod
REPLICA_COUNT=5
AUTOSCALING_ENABLED=true
AUTOSCALING_MIN_REPLICAS=5
AUTOSCALING_MAX_REPLICAS=50
TARGET_CPU_UTILIZATION=70

# =============================================================================
# Resource Limits (Production)
# =============================================================================
RESOURCE_REQUEST_MEMORY=1Gi
RESOURCE_REQUEST_CPU=1000m
RESOURCE_LIMIT_MEMORY=2Gi
RESOURCE_LIMIT_CPU=2000m

# =============================================================================
# Azure Key Vault (Production)
# =============================================================================
KEY_VAULT_NAME=flamoral-prod-kv
KEY_VAULT_URI=https://flamoral-prod-kv.vault.azure.net/
KEY_VAULT_MANAGED_IDENTITY_ENABLED=true

# =============================================================================
# Azure Resource Manager (for Terraform/Automation)
# =============================================================================
ARM_CLIENT_ID=*** # STORE IN AZURE KEY VAULT
ARM_CLIENT_SECRET=*** # STORE IN AZURE KEY VAULT
ARM_SUBSCRIPTION_ID=*** # STORE IN AZURE KEY VAULT
ARM_TENANT_ID=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Feature Flags (Production)
# =============================================================================
FEATURE_AI_MATCHING=true
FEATURE_VIDEO_CALLS=true
FEATURE_TRAVEL_MODE=true
FEATURE_DATING_COACH=true
FEATURE_GAMIFICATION=true
FEATURE_BETA_FEATURES=false

# =============================================================================
# Session Configuration (Production)
# =============================================================================
SESSION_SECRET=*** # STORE IN AZURE KEY VAULT (min 32 chars)
SESSION_MAX_AGE=86400000
SESSION_SECURE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=strict

# =============================================================================
# File Upload Limits (Production)
# =============================================================================
MAX_FILE_SIZE=10485760 # 10MB
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800 # 50MB
UPLOAD_VIRUS_SCAN_ENABLED=true

# =============================================================================
# WebSocket Configuration (Production)
# =============================================================================
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000
WS_MAX_CONNECTIONS_PER_USER=3

# =============================================================================
# Development Tools (DISABLED in Production)
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_API_DOCS=false
ENABLE_DEBUG_LOGGING=false
ENABLE_VERBOSE_ERRORS=false

# =============================================================================
# AI/ML Configuration (Production)
# =============================================================================
AI_MODEL_ENDPOINT=https://ai.flamoral.app
AI_MODEL_API_KEY=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Push Notifications - Firebase (Production)
# =============================================================================
FIREBASE_PROJECT_ID=flamoral-production
FIREBASE_PRIVATE_KEY=*** # STORE IN AZURE KEY VAULT
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@flamoral-production.iam.gserviceaccount.com

# =============================================================================
# Monitoring and Observability (Production)
# =============================================================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=true
APPLICATION_INSIGHTS_ENABLED=true
APPLICATION_INSIGHTS_CONNECTION_STRING=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Security Headers (Production)
# =============================================================================
HSTS_MAX_AGE=31536000
HSTS_INCLUDE_SUBDOMAINS=true
HSTS_PRELOAD=true
CSP_ENABLED=true
CSP_REPORT_URI=https://flamoral.report-uri.com/r/d/csp/enforce
X_FRAME_OPTIONS=DENY
X_CONTENT_TYPE_OPTIONS=nosniff

# =============================================================================
# CDN Configuration (Production)
# =============================================================================
CDN_ENABLED=true
CDN_DOMAIN=cdn.flamoral.app
CDN_CACHE_CONTROL=public, max-age=31536000

# =============================================================================
# SSL/TLS Configuration (Production)
# =============================================================================
SSL_ENABLED=true
SSL_FORCE_HTTPS=true
SSL_CERT_PATH=/etc/ssl/certs/flamoral.crt
SSL_KEY_PATH=/etc/ssl/private/flamoral.key

# =============================================================================
# Database Backup Configuration (Production)
# =============================================================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * * # Daily at 2 AM UTC
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_ACCOUNT=flamoralbkupprodst

# =============================================================================
# DDoS Protection & WAF (Production)
# =============================================================================
WAF_ENABLED=true
DDOS_PROTECTION_ENABLED=true

# =============================================================================
# Compliance and Privacy (Production)
# =============================================================================
GDPR_ENABLED=true
CCPA_ENABLED=true
DATA_RETENTION_DAYS=730
AUDIT_LOG_ENABLED=true

# =============================================================================
# Blue-Green Deployment (Production)
# =============================================================================
DEPLOYMENT_SLOT=blue # or green
ENABLE_CANARY_DEPLOYMENT=true
CANARY_TRAFFIC_PERCENTAGE=10

# =============================================================================
# Business Intelligence & Analytics (Production)
# =============================================================================
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Support and Helpdesk Integration (Production)
# =============================================================================
ZENDESK_ENABLED=true
ZENDESK_SUBDOMAIN=flamoral
ZENDESK_API_TOKEN=*** # STORE IN AZURE KEY VAULT

# =============================================================================
# Production Contacts (For Alerts and Notifications)
# =============================================================================
ALERT_EMAIL_PRODUCTION=alerts@flamoral.com
ALERT_EMAIL_DEVOPS=devops@flamoral.com
ONCALL_PHONE_NUMBER=+1234567890
