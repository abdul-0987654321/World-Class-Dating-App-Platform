        "ANTHROPIC_API_KEY": "${{shared.ANTHROPIC_API_KEY}}",
        "REDIS_URL": "${{redis.REDIS_URL}}"
      },
      "networking": {
        "ports": [8004]
      }
    },
    "ai-nlp-service": {
      "source": {
        "repo": ".",
        "branch": "main"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend/services/ai-services/nlp-service/Dockerfile",
        "watchPatterns": ["backend/services/ai-services/nlp-service/**"]
      },
      "deploy": {
        "healthcheckPath": "/health",
