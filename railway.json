      },
      "variables": {
        "PORT": "8085"
      },
      "networking": {
        "ports": [8085]
      }
    },
    "ai-content-generator": {
      "source": {
        "repo": ".",
        "branch": "main"
      },
      "build": {
        "builder": "DOCKERFILE",
        "dockerfilePath": "backend/services/ai-services/content-generator/Dockerfile",
        "watchPatterns": ["backend/services/ai-services/content-generator/**"]
      },
      "deploy": {
        "healthcheckPath": "/health",
        "healthcheckTimeout": 60,
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3
      },
      "variables": {
        "PORT": "8087",
        "OPENAI_API_KEY": "${{shared.OPENAI_API_KEY}}"
      },
      "networking": {
