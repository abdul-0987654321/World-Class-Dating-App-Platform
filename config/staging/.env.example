# Flamoral Staging Environment Configuration
# Copy this file to .env.staging and fill in the values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=flamoral
POSTGRES_PASSWORD=your_secure_password_here

# Service-specific database URLs
MEDIA_SERVICE_DATABASE_URL=postgres://flamoral:your_password@postgres-media:5432/flamoral_media_staging
USER_SERVICE_DATABASE_URL=postgres://flamoral:your_password@postgres-user:5432/flamoral_user_staging

# ============================================
# AWS Configuration
# ============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# ============================================
# Azure Configuration
# ============================================

# Azure Content Moderator
AZURE_CONTENT_MODERATOR_KEY=your_azure_content_moderator_key
AZURE_CONTENT_MODERATOR_ENDPOINT=https://your-region.api.cognitive.microsoft.com

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_account_key
AZURE_STORAGE_CONTAINER_NAME=media-staging

# ============================================
# Moderation Thresholds
# ============================================
AUTO_REJECT_THRESHOLD=0.90
AUTO_FLAG_THRESHOLD=0.70
SUSPENSION_VIOLATION_COUNT=3
BAN_VIOLATION_COUNT=5

# ============================================
# Authentication
# ============================================
JWT_SECRET=your_jwt_secret_here_minimum_32_characters

# ============================================
# Frontend Configuration
# ============================================
REACT_APP_API_URL=https://staging-api.flamoral.com
REACT_APP_MEDIA_SERVICE_URL=https://staging-media.flamoral.com
REACT_APP_MODERATION_SERVICE_URL=https://staging-moderation.flamoral.com

# ============================================
# Monitoring Configuration
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# ============================================
# Logging
# ============================================
LOG_LEVEL=info

# ============================================
# Email Configuration (for notifications)
# ============================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key
FROM_EMAIL=noreply@flamoral.com

# ============================================
# Feature Flags
# ============================================
# Core Features
ENABLE_VIDEO_CALLS=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_AI_MATCHING=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EVENTS=true

# Authentication Features
ENABLE_2FA=true
ENABLE_OAUTH=true
ENABLE_SMS_VERIFICATION=true

# Moderation Features
ENABLE_USER_APPEALS=true
ENABLE_AUTO_SANCTIONS=true
ENABLE_REAL_TIME_MODERATION=true

# Staging-specific (enable for testing)
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_API_DOCS=true
ENABLE_DEBUG_LOGGING=true
ENABLE_CIRCUIT_BREAKER=true
