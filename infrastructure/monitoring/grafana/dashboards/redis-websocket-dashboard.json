{
  "dashboard": {
    "title": "Dating App - Redis & WebSocket Dashboard",
    "tags": ["dating-app", "redis", "websocket", "cache"],
    "timezone": "browser",
    "schemaVersion": 16,
    "version": 1,
    "refresh": "30s",
    "rows": [
      {
        "title": "Redis Metrics",
        "panels": [
          {
            "id": 1,
            "title": "Redis Memory Usage",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
            "targets": [
              {
                "expr": "redis_memory_used_bytes / 1024 / 1024",
                "legendFormat": "Used Memory (MB)",
                "refId": "A"
              },
              {
                "expr": "redis_memory_max_bytes / 1024 / 1024",
                "legendFormat": "Max Memory (MB)",
                "refId": "B"
              }
            ],
            "yaxes": [
              {"format": "mbytes", "label": "Memory"},
              {"format": "short"}
            ]
          },
          {
            "id": 2,
            "title": "Redis Commands Rate",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
            "targets": [
              {
                "expr": "rate(redis_commands_processed_total[5m])",
                "legendFormat": "Commands/sec",
                "refId": "A"
              }
            ],
            "yaxes": [
              {"format": "ops", "label": "Commands/sec"},
              {"format": "short"}
            ]
          },
          {
            "id": 3,
            "title": "Cache Hit Rate",
            "type": "gauge",
            "gridPos": {"h": 8, "w": 6, "x": 0, "y": 8},
            "targets": [
              {
                "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m])) * 100",
                "refId": "A"
              }
            ],
            "options": {
              "orientation": "auto",
              "showThresholdLabels": false,
              "showThresholdMarkers": true
            },
            "fieldConfig": {
              "defaults": {
                "unit": "percent",
                "min": 0,
                "max": 100,
                "thresholds": {
                  "mode": "absolute",
                  "steps": [
                    {"value": 0, "color": "red"},
                    {"value": 70, "color": "yellow"},
                    {"value": 90, "color": "green"}
                  ]
                }
              }
            }
          },
          {
            "id": 4,
            "title": "Connected Clients",
            "type": "stat",
            "gridPos": {"h": 8, "w": 6, "x": 6, "y": 8},
            "targets": [
              {
                "expr": "redis_connected_clients",
                "refId": "A"
              }
            ],
            "options": {
              "colorMode": "value",
              "graphMode": "area",
              "orientation": "auto"
            }
          },
          {
            "id": 5,
            "title": "Key Evictions",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
            "targets": [
              {
                "expr": "rate(redis_evicted_keys_total[5m])",
                "legendFormat": "Evictions/sec",
                "refId": "A"
              }
            ],
            "yaxes": [
              {"format": "ops", "label": "Evictions/sec"},
              {"format": "short"}
            ]
          },
          {
            "id": 6,
            "title": "Operations by Command",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 16},
            "targets": [
              {
                "expr": "rate(redis_commands_duration_seconds_total[5m])",
                "legendFormat": "{{cmd}}",
                "refId": "A"
              }
            ],
            "yaxes": [
              {"format": "s", "label": "Duration"},
              {"format": "short"}
            ]
          },
          {
            "id": 7,
            "title": "Key Space",
            "type": "stat",
            "gridPos": {"h": 4, "w": 6, "x": 12, "y": 16},
            "targets": [
              {
                "expr": "redis_db_keys",
                "refId": "A"
              }
            ],
            "options": {
              "colorMode": "value",
              "graphMode": "area",
              "orientation": "auto"
            }
          },
          {
            "id": 8,
            "title": "Expired Keys",
            "type": "graph",
            "gridPos": {"h": 8, "w": 6, "x": 18, "y": 16},
            "targets": [
              {
                "expr": "rate(redis_expired_keys_total[5m])",
                "legendFormat": "Expirations/sec",
                "refId": "A"
              }
            ],
            "yaxes": [
              {"format": "ops", "label": "Expirations/sec"},
              {"format": "short"}
            ]
          }
        ]
      },
      {
        "title": "WebSocket Metrics",
        "panels": [
          {
            "id": 9,
            "title": "Active WebSocket Connections",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 24},
            "targets": [
              {
                "expr": "websocket_connections_active",
                "legendFormat": "{{pod}}",
                "refId": "A"
              }
            ],
            "yaxes": [
              {"format": "short", "label": "Connections"},
              {"format": "short"}
            ],
            "alert": {
              "conditions": [
                {
                  "evaluator": {"params": [8000], "type": "gt"},
                  "operator": {"type": "and"},
                  "query": {"params": ["A", "5m", "now"]},
                  "reducer": {"params": [], "type": "avg"},
                  "type": "query"
                }
              ],
              "executionErrorState": "alerting",
              "frequency": "1m",
              "handler": 1,
              "name": "High WebSocket Connections",
              "noDataState": "no_data"
            }
          },
          {
            "id": 10,
            "title": "WebSocket Message Rate",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 24},
            "targets": [
              {
                "expr": "rate(websocket_messages_sent_total[5m])",
                "legendFormat": "Sent",
                "refId": "A"
              },
              {
                "expr": "rate(websocket_messages_received_total[5m])",
                "legendFormat": "Received",
                "refId": "B"
              }
            ],
            "yaxes": [
              {"format": "ops", "label": "Messages/sec"},
              {"format": "short"}
            ]
          },
          {
            "id": 11,
            "title": "Connection Errors",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 0, "y": 32},
            "targets": [
              {
                "expr": "rate(websocket_connection_errors_total[5m])",
                "legendFormat": "{{error_type}}",
                "refId": "A"
              }
            ],
            "yaxes": [
              {"format": "ops", "label": "Errors/sec"},
              {"format": "short"}
            ]
          },
          {
            "id": 12,
            "title": "Message Queue Length",
            "type": "graph",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 32},
            "targets": [
              {
                "expr": "websocket_message_queue_length",
                "legendFormat": "{{pod}}",
                "refId": "A"
              }
            ],
            "yaxes": [
              {"format": "short", "label": "Queue Length"},
              {"format": "short"}
            ]
          },
          {
            "id": 13,
            "title": "Connection Duration (p95)",
            "type": "stat",
            "gridPos": {"h": 4, "w": 6, "x": 0, "y": 40},
            "targets": [
              {
                "expr": "histogram_quantile(0.95, rate(websocket_connection_duration_seconds_bucket[5m]))",
                "refId": "A"
              }
            ],
            "options": {
              "colorMode": "value",
              "graphMode": "area",
              "orientation": "auto"
            },
            "fieldConfig": {
              "defaults": {
                "unit": "s"
              }
            }
          },
          {
            "id": 14,
            "title": "Message Latency (p95)",
            "type": "stat",
            "gridPos": {"h": 4, "w": 6, "x": 6, "y": 40},
            "targets": [
              {
                "expr": "histogram_quantile(0.95, rate(websocket_message_latency_seconds_bucket[5m]))",
                "refId": "A"
              }
            ],
            "options": {
              "colorMode": "value",
              "graphMode": "area",
              "orientation": "auto"
            },
            "fieldConfig": {
              "defaults": {
                "unit": "s"
              }
            }
          },
          {
            "id": 15,
            "title": "Connections by Room",
            "type": "table",
            "gridPos": {"h": 8, "w": 12, "x": 12, "y": 40},
            "targets": [
              {
                "expr": "topk(10, websocket_connections_by_room)",
                "format": "table",
                "instant": true,
                "refId": "A"
              }
            ],
            "transformations": [
              {
                "id": "organize",
                "options": {
                  "excludeByName": {"Time": true},
                  "indexByName": {},
                  "renameByName": {
                    "room": "Room",
                    "Value": "Connections"
                  }
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
