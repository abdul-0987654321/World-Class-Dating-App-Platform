# =============================================================================
# Flamoral Dating Platform - Development Environment Configuration Template
# =============================================================================
# Purpose: Local development environment with minimal external dependencies
# Security: Use local services where possible, test credentials for external APIs
# This file is optimized for developer experience and fast iteration
#
# Usage:
#   1. Copy this file to .env.development
#   2. Replace placeholders with your local/test values
#   3. Start local infrastructure: docker-compose up -d
#   4. Validate with: ./scripts/validate-env.sh development
#
# Last Updated: 2025-12-11
# =============================================================================

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================

NODE_ENV=development
ENVIRONMENT=development
DEBUG=true

# Logging Configuration (Verbose for development)
LOG_LEVEL=debug                         # Full logging for development
LOG_FORMAT=pretty                       # Human-readable format
LOG_FILE_ENABLED=false                  # No file logging in dev
LOG_FILE_PATH=./logs

# Timezone
TZ=UTC
DEFAULT_TIMEZONE=UTC

# =============================================================================
# SERVICE CONFIGURATION
# =============================================================================

PORT=3000
HOST=0.0.0.0
GRAPHQL_PORT=4000
WS_PORT=5000

API_VERSION=v1
API_RATE_LIMIT_ENABLED=false            # Disabled for easier development
API_TIMEOUT=60000                       # Longer timeout for debugging

# =============================================================================
# FRONTEND URLs (Local Development)
# =============================================================================

WEB_URL=http://localhost:5173           # Vite dev server
API_URL=http://localhost:3000
ADMIN_URL=http://localhost:5174
INGRESS_HOST=localhost
API_HOST=localhost
MOBILE_APP_SCHEME=flamoral-dev://

# =============================================================================
# INTERNAL SERVICE URLs (Local Docker or Localhost)
# =============================================================================

# Core Services (Docker Compose)
USER_SERVICE_URL=http://localhost:4002
AUTH_SERVICE_URL=http://localhost:4001
MATCHING_SERVICE_URL=http://localhost:4003
MESSAGING_SERVICE_URL=http://localhost:4004
MODERATION_SERVICE_URL=http://localhost:4009
PAYMENT_SERVICE_URL=http://localhost:4006
MEDIA_SERVICE_URL=http://localhost:4005
