ANALYTICS_SERVICE_URL=http://localhost:4008
AI_SERVICE_URL=http://localhost:3009
ADVERTISING_SERVICE_URL=http://localhost:4010
REALTIME_SERVICE_URL=http://localhost:4011
ADMIN_SERVICE_URL=http://localhost:4012
AUTOMATION_SERVICE_URL=http://localhost:4013
