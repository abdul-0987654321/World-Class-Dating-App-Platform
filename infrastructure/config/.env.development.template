# =============================================================================
# DATABASE - PostgreSQL (Local Docker)
# =============================================================================

# Local PostgreSQL via Docker Compose
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_dev
DB_USER=flamoral
DB_PASSWORD=flamoral_dev_password
DATABASE_URL=postgresql://flamoral:flamoral_dev_password@localhost:5432/flamoral_dev

# Connection Pool Settings (Minimal for dev)
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=10000
DB_QUERY_TIMEOUT=30000
DB_STATEMENT_TIMEOUT=30000

# SSL/TLS Configuration (Disabled for local dev)
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=false

# Service-Specific Databases (All in same local PostgreSQL instance)
USER_SERVICE_DATABASE_URL=postgresql://flamoral:flamoral_dev_password@localhost:5432/flamoral_users_dev
AUTH_SERVICE_DATABASE_URL=postgresql://flamoral:flamoral_dev_password@localhost:5432/flamoral_auth_dev
MATCHING_SERVICE_DATABASE_URL=postgresql://flamoral:flamoral_dev_password@localhost:5432/flamoral_matching_dev
ANALYTICS_SERVICE_DATABASE_URL=postgresql://flamoral:flamoral_dev_password@localhost:5432/flamoral_analytics_dev
PAYMENT_SERVICE_DATABASE_URL=postgresql://flamoral:flamoral_dev_password@localhost:5432/flamoral_payments_dev
ADMIN_SERVICE_DATABASE_URL=postgresql://flamoral:flamoral_dev_password@localhost:5432/flamoral_admin_dev

# =============================================================================
# DATABASE - MongoDB (Local Docker)
# =============================================================================

MONGODB_URI=mongodb://flamoral:flamoral_mongo_pass@localhost:27017/flamoral_dev?authSource=admin
MONGODB_DB=flamoral_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2
MONGODB_SSL=false

# =============================================================================
# CACHE - Redis (Local Docker)
# =============================================================================

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=flamoral_redis_pass
REDIS_DB=0
REDIS_URL=redis://:flamoral_redis_pass@localhost:6379
REDIS_TLS=false
REDIS_CLUSTER_MODE=false
REDIS_MAX_RETRIES=3
REDIS_TTL=3600
REDIS_KEY_PREFIX=flamoral:dev:

# =============================================================================
# MESSAGE QUEUE - RabbitMQ (Local Docker)
# =============================================================================

# Using RabbitMQ for local development instead of Azure Service Bus
RABBITMQ_URL=amqp://flamoral:flamoral_rabbit_pass@localhost:5672
RABBITMQ_USER=flamoral
RABBITMQ_PASSWORD=flamoral_rabbit_pass
RABBITMQ_MANAGEMENT_URL=http://localhost:15672

# Queue Names (Same as production for consistency)
QUEUE_MATCHING=matching_queue_dev
QUEUE_NOTIFICATIONS=notification_queue_dev
QUEUE_ANALYTICS=analytics_queue_dev
QUEUE_MODERATION=moderation_queue_dev
QUEUE_MEDIA_PROCESSING=media_processing_queue_dev
QUEUE_EMAIL=email_queue_dev
QUEUE_SMS=sms_queue_dev
QUEUE_PUSH_NOTIFICATIONS=push_notification_queue_dev
QUEUE_WEBSOCKET_EVENTS=websocket_events_queue_dev
QUEUE_AUDIT_LOGS=audit_logs_queue_dev

# =============================================================================
# AUTHENTICATION & SECURITY - JWT
# =============================================================================

# Development JWT Secrets (NOT for production)
JWT_SECRET=dev_jwt_secret_change_this_in_production_min_64_chars_required_for_security
JWT_ACCESS_SECRET=dev_jwt_access_secret_change_this_in_production_min_64_chars_required
JWT_REFRESH_SECRET=dev_jwt_refresh_secret_change_this_in_production_min_64_chars_required
JWT_ACCESS_EXPIRES_IN=24h              # Longer expiry for dev convenience
JWT_REFRESH_EXPIRES_IN=30d
JWT_ALGORITHM=HS256
JWT_ISSUER=flamoral-development

# Session Configuration
SESSION_SECRET=dev_session_secret_min_32_chars_change_in_production
SESSION_MAX_AGE=86400000
SESSION_SECURE=false                    # HTTP allowed in dev
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax                   # More permissive for dev

# =============================================================================
# SERVICE-TO-SERVICE AUTHENTICATION
# =============================================================================

SERVICE_API_KEY=dev_service_api_key_change_this_in_production_min_64_chars_required
SERVICE_NAME=flamoral-development
SERVICE_TIMEOUT=60000                   # Longer for debugging

# =============================================================================
# PASSWORD SECURITY
# =============================================================================

BCRYPT_ROUNDS=4                         # Lower for faster development
PASSWORD_MIN_LENGTH=8
PASSWORD_REQUIRE_UPPERCASE=false        # More lenient for testing
PASSWORD_REQUIRE_LOWERCASE=false
PASSWORD_REQUIRE_NUMBER=false
PASSWORD_REQUIRE_SPECIAL=false
PASSWORD_HISTORY_COUNT=3
MAX_LOGIN_ATTEMPTS=10                   # Higher for dev
ACCOUNT_LOCKOUT_DURATION=300000         # 5 minutes
MFA_ENABLED=false                       # Disabled for easier dev

