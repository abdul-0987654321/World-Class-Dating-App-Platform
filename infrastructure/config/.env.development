# =============================================================================
# Flamoral Dating Platform - Development Environment Configuration
# =============================================================================
# This file contains development environment configuration
# Copy to .env in your service directory and customize as needed
# =============================================================================

# =============================================================================
# Environment Settings
# =============================================================================
NODE_ENV=development
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=debug
LOG_FORMAT=pretty

# =============================================================================
# Service Configuration
# =============================================================================
# These ports are defaults - each service should override with its specific port
PORT=3000
HOST=0.0.0.0

# =============================================================================
# API Gateway
# =============================================================================
API_GATEWAY_URL=http://localhost:3000
API_VERSION=v1

# =============================================================================
# Service URLs (Internal Communication)
# =============================================================================
USER_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:3011
MATCHING_SERVICE_URL=http://localhost:3002
MESSAGING_SERVICE_URL=http://localhost:3003
MODERATION_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3008
ANALYTICS_SERVICE_URL=http://localhost:3007
AI_SERVICE_URL=http://localhost:3009
ADVERTISING_SERVICE_URL=http://localhost:3010
REALTIME_SERVICE_URL=http://localhost:3012
ADMIN_SERVICE_URL=http://localhost:3013
AUTOMATION_SERVICE_URL=http://localhost:3014
WORKFLOW_ENGINE_URL=http://localhost:3015

# =============================================================================
# Frontend URLs
# =============================================================================
WEB_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
MOBILE_APP_SCHEME=flamoral://

# =============================================================================
# Database - PostgreSQL
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_dev
DB_USER=postgres
DB_PASSWORD=postgres
DB_POOL_MIN=2
DB_POOL_MAX=10
DB_SSL=false
DB_CONNECTION_TIMEOUT=30000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flamoral_dev

# =============================================================================
# Database - MongoDB (for messaging, analytics)
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/flamoral_dev
MONGODB_DB=flamoral_dev
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=2

# =============================================================================
# Cache - Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379
REDIS_TTL=3600
REDIS_MAX_RETRIES=3

# =============================================================================
# Message Queue - RabbitMQ
# =============================================================================
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue
QUEUE_MEDIA_PROCESSING=media_processing_queue
QUEUE_EMAIL=email_queue
QUEUE_SMS=sms_queue

# =============================================================================
# Authentication - JWT
# =============================================================================
JWT_SECRET=dev-jwt-secret-replace-with-secure-random-string-min-64-chars
JWT_ACCESS_SECRET=dev-jwt-access-secret-min-64-chars-REPLACE-WITH-SECURE-STRING
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-min-64-chars-REPLACE-WITH-SECURE-STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ALGORITHM=HS256
JWT_ISSUER=flamoral-dev

# =============================================================================
# Service-to-Service Authentication
# =============================================================================
SERVICE_API_KEY=dev-service-key-replace-with-secure-random-string
SERVICE_NAME=flamoral-service
SERVICE_TIMEOUT=30000

# =============================================================================
# OAuth Providers (Development)
# =============================================================================
# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Facebook OAuth
FACEBOOK_APP_ID=your-facebook-app-id
FACEBOOK_APP_SECRET=your-facebook-app-secret
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# Apple OAuth
APPLE_CLIENT_ID=com.flamoral.app
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY=your-apple-private-key
APPLE_CALLBACK_URL=http://localhost:3000/auth/apple/callback

# =============================================================================
# Payment Gateway - Stripe (TEST MODE)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
STRIPE_API_VERSION=2024-12-18.acacia

# =============================================================================
# Email Service - SendGrid
# =============================================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=dev@flamoral.com
SENDGRID_FROM_NAME=Flamoral Dev

# =============================================================================
# SMS Service - Twilio
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Azure Storage (Development)
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoraldevst
AZURE_STORAGE_KEY=your_azure_storage_account_key_here
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=flamoraldevst;AccountKey=your_key_here;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos
AZURE_STORAGE_CONTAINER_DOCUMENTS=documents

# =============================================================================
# Azure Cognitive Services
# =============================================================================
# Face API (for photo verification)
AZURE_FACE_API_KEY=your_azure_face_api_key_here
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# Content Moderator (for content moderation)
AZURE_CONTENT_MODERATOR_KEY=your_content_moderator_key
AZURE_CONTENT_MODERATOR_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# =============================================================================
# Video/Voice Calling - Agora
# =============================================================================
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_CUSTOMER_KEY=your_agora_customer_key
AGORA_CUSTOMER_SECRET=your_agora_customer_secret

# =============================================================================
# Push Notifications - Firebase
# =============================================================================
FIREBASE_PROJECT_ID=flamoral-dev
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@flamoral-dev.iam.gserviceaccount.com
FIREBASE_DATABASE_URL=https://flamoral-dev.firebaseio.com

# =============================================================================
# Error Tracking - Sentry
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILES_SAMPLE_RATE=1.0

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_CREDENTIALS=true
CORS_MAX_AGE=86400

# =============================================================================
# Rate Limiting (Relaxed for Development)
# =============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_SKIP_SUCCESSFUL_REQUESTS=false

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=dev-session-secret-min-32-chars-here
SESSION_MAX_AGE=86400000
SESSION_SECURE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# =============================================================================
# File Upload Configuration
# =============================================================================
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_VIDEO_TYPES=video/mp4,video/quicktime

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_PORT=5000
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000
WS_MAX_CONNECTIONS_PER_USER=5
WS_RECONNECT_ATTEMPTS=5

# =============================================================================
# Feature Flags (Development - All Features Enabled)
# =============================================================================
FEATURE_AI_MATCHING=true
FEATURE_VIDEO_CALLS=true
FEATURE_TRAVEL_MODE=true
FEATURE_DATING_COACH=true
FEATURE_GAMIFICATION=true
FEATURE_SOCIAL_FEED=true
FEATURE_STORIES=true
FEATURE_BETA_FEATURES=true

# =============================================================================
# AI/ML Configuration
# =============================================================================
AI_MODEL_ENDPOINT=http://localhost:8000
AI_MODEL_API_KEY=dev-ai-model-key
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000

# =============================================================================
# Monitoring and Observability
# =============================================================================
ENABLE_METRICS=true
ENABLE_TRACING=true
PROMETHEUS_PORT=9090
JAEGER_AGENT_HOST=localhost
JAEGER_AGENT_PORT=6831

# =============================================================================
# Development Tools
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_API_DOCS=true
ENABLE_DEBUG_LOGGING=true
ENABLE_VERBOSE_ERRORS=true
ENABLE_HOT_RELOAD=true

# =============================================================================
# Testing Configuration
# =============================================================================
TEST_DB_NAME=flamoral_test
TEST_USER_EMAIL=test@flamoral.com
TEST_USER_PASSWORD=Test123456!

# =============================================================================
# Security Configuration (Relaxed for Development)
# =============================================================================
BCRYPT_ROUNDS=10
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=10
ACCOUNT_LOCKOUT_DURATION=900000

# =============================================================================
# Search Service (Elasticsearch/OpenSearch)
# =============================================================================
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=flamoral_dev

# =============================================================================
# Analytics Configuration
# =============================================================================
ANALYTICS_ENABLED=true
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_dev_token

# =============================================================================
# Geolocation Service
# =============================================================================
GOOGLE_MAPS_API_KEY=your_google_maps_api_key
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token
DEFAULT_LOCATION_RADIUS_KM=50

# =============================================================================
# Content Delivery Network (CDN)
# =============================================================================
CDN_ENABLED=false
CDN_URL=http://localhost:3006
STATIC_ASSETS_URL=http://localhost:3000/static

# =============================================================================
# Background Jobs Configuration
# =============================================================================
ENABLE_BACKGROUND_JOBS=true
JOB_CONCURRENCY=5
JOB_RETRY_ATTEMPTS=3
JOB_RETRY_DELAY=5000

# =============================================================================
# Data Retention and Privacy
# =============================================================================
GDPR_ENABLED=true
DATA_RETENTION_DAYS=730
AUDIT_LOG_ENABLED=true
AUDIT_LOG_RETENTION_DAYS=90

# =============================================================================
# Localization
# =============================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,es,fr,de,it,pt,ja,ko,zh
DEFAULT_TIMEZONE=UTC

# =============================================================================
# Business Rules
# =============================================================================
MIN_AGE=18
MAX_AGE=100
FREE_LIKES_PER_DAY=10
FREE_SUPER_LIKES_PER_DAY=1
MATCH_EXPIRY_DAYS=30
MESSAGE_RETENTION_DAYS=365
