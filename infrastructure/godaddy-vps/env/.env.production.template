#===============================================================================
# Flamoral Production Environment Configuration
#
# IMPORTANT: This is a template file. Copy to .env.production and fill in values.
# NEVER commit the actual .env.production file to version control!
#
# Usage:
#   cp .env.production.template .env.production
#   # Edit .env.production with your actual values
#
# Author: Flamoral DevOps Team
# Version: 1.0.0
#===============================================================================

#-------------------------------------------------------------------------------
# Application Settings
#-------------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=Flamoral
APP_VERSION=1.0.0
APP_URL=https://flamoral.com
API_URL=https://api.flamoral.com
WS_URL=wss://ws.flamoral.com
ADMIN_URL=https://admin.flamoral.com

# Server Settings
HOST=0.0.0.0
PORT=4000
WORKERS=4

# Debug Settings (disable in production)
DEBUG=false
LOG_LEVEL=info

#-------------------------------------------------------------------------------
# Security & Authentication
#-------------------------------------------------------------------------------
# JWT Configuration
JWT_SECRET=<GENERATE_SECURE_256_BIT_SECRET>
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=7d
JWT_ISSUER=flamoral.com
JWT_AUDIENCE=flamoral-api

# Session Configuration
SESSION_SECRET=<GENERATE_SECURE_SESSION_SECRET>
SESSION_NAME=flamoral_session
SESSION_MAX_AGE=86400000

# Encryption Keys
ENCRYPTION_KEY=<GENERATE_32_BYTE_HEX_KEY>
ENCRYPTION_IV=<GENERATE_16_BYTE_HEX_IV>

# API Keys
API_KEY_SALT=<GENERATE_SECURE_SALT>

# CORS Settings
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://admin.flamoral.com
CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=5

#-------------------------------------------------------------------------------
# Database - PostgreSQL
#-------------------------------------------------------------------------------
# Primary Database
DATABASE_URL=postgresql://flamoral:<PASSWORD>@localhost:5432/flamoral_production
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=flamoral_production
DATABASE_USER=flamoral
DATABASE_PASSWORD=<SECURE_DATABASE_PASSWORD>
DATABASE_SSL=false
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT=10000
DATABASE_CONNECTION_TIMEOUT=5000

# Read Replica (if using)
# DATABASE_READ_REPLICA_URL=postgresql://flamoral:<PASSWORD>@read-replica:5432/flamoral_production

#-------------------------------------------------------------------------------
# Cache - Redis
#-------------------------------------------------------------------------------
REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=<SECURE_REDIS_PASSWORD>
REDIS_DB=0
REDIS_KEY_PREFIX=flamoral:
REDIS_TLS=false

# Redis Cluster (if using)
# REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379

#-------------------------------------------------------------------------------
# Cloud Storage - AWS S3
#-------------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_KEY>
AWS_REGION=us-east-1
AWS_S3_BUCKET=flamoral-media
AWS_S3_BUCKET_REGION=us-east-1

# CloudFront CDN
CLOUDFRONT_DISTRIBUTION_ID=<CLOUDFRONT_ID>
CLOUDFRONT_URL=https://cdn.flamoral.com

# Media Upload Settings
MAX_FILE_SIZE_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
IMAGE_COMPRESSION_QUALITY=85

#-------------------------------------------------------------------------------
# Email Service - SendGrid/AWS SES
#-------------------------------------------------------------------------------
# SendGrid
SENDGRID_API_KEY=<SENDGRID_API_KEY>
EMAIL_FROM=hello@flamoral.com
EMAIL_FROM_NAME=Flamoral

# AWS SES (alternative)
# AWS_SES_REGION=us-east-1
# AWS_SES_FROM_EMAIL=hello@flamoral.com

# Email Templates
EMAIL_TEMPLATE_WELCOME=welcome
EMAIL_TEMPLATE_VERIFICATION=email-verify
EMAIL_TEMPLATE_PASSWORD_RESET=password-reset
EMAIL_TEMPLATE_MATCH_NOTIFICATION=match-notification

#-------------------------------------------------------------------------------
# SMS Service - Twilio
#-------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=<TWILIO_ACCOUNT_SID>
TWILIO_AUTH_TOKEN=<TWILIO_AUTH_TOKEN>
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=<TWILIO_VERIFY_SID>

#-------------------------------------------------------------------------------
# Push Notifications - Firebase
#-------------------------------------------------------------------------------
FIREBASE_PROJECT_ID=flamoral-app
FIREBASE_CLIENT_EMAIL=<FIREBASE_SERVICE_ACCOUNT_EMAIL>
FIREBASE_PRIVATE_KEY=<FIREBASE_PRIVATE_KEY>

# APNs for iOS (if not using Firebase)
# APNS_KEY_ID=<KEY_ID>
# APNS_TEAM_ID=<TEAM_ID>
# APNS_BUNDLE_ID=com.flamoral.app

#-------------------------------------------------------------------------------
# Payment Processing - Stripe
#-------------------------------------------------------------------------------
STRIPE_SECRET_KEY=<STRIPE_SECRET_KEY>
STRIPE_PUBLISHABLE_KEY=<STRIPE_PUBLISHABLE_KEY>
STRIPE_WEBHOOK_SECRET=<STRIPE_WEBHOOK_SECRET>

# Subscription Plans (Price IDs)
STRIPE_PRICE_PREMIUM_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PREMIUM_YEARLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PLATINUM_MONTHLY=price_xxxxxxxxxxxx
STRIPE_PRICE_PLATINUM_YEARLY=price_xxxxxxxxxxxx

# In-App Purchases (for mobile)
APPLE_SHARED_SECRET=<APPLE_SHARED_SECRET>
GOOGLE_PLAY_SERVICE_ACCOUNT=<SERVICE_ACCOUNT_JSON>

#-------------------------------------------------------------------------------
# Video Calling - Agora/Twilio Video
#-------------------------------------------------------------------------------
# Agora
AGORA_APP_ID=<AGORA_APP_ID>
AGORA_APP_CERTIFICATE=<AGORA_APP_CERTIFICATE>

# Twilio Video (alternative)
# TWILIO_VIDEO_API_KEY=<API_KEY>
# TWILIO_VIDEO_API_SECRET=<API_SECRET>

#-------------------------------------------------------------------------------
# Identity Verification
#-------------------------------------------------------------------------------
# Onfido
ONFIDO_API_TOKEN=<ONFIDO_API_TOKEN>
ONFIDO_WEBHOOK_TOKEN=<ONFIDO_WEBHOOK_TOKEN>

# Alternative: Jumio
# JUMIO_API_TOKEN=<JUMIO_TOKEN>
# JUMIO_API_SECRET=<JUMIO_SECRET>

#-------------------------------------------------------------------------------
# AI/ML Services
#-------------------------------------------------------------------------------
# OpenAI for AI features
OPENAI_API_KEY=<OPENAI_API_KEY>
OPENAI_MODEL=gpt-4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Content Moderation - AWS Rekognition
AWS_REKOGNITION_REGION=us-east-1

# Alternative: Google Vision
# GOOGLE_VISION_API_KEY=<API_KEY>

#-------------------------------------------------------------------------------
# Analytics & Monitoring
#-------------------------------------------------------------------------------
# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX
GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel
MIXPANEL_TOKEN=<MIXPANEL_TOKEN>

# Amplitude
AMPLITUDE_API_KEY=<AMPLITUDE_KEY>

# Sentry (Error Tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# DataDog (APM)
DATADOG_API_KEY=<DATADOG_API_KEY>
DATADOG_APP_KEY=<DATADOG_APP_KEY>
DATADOG_SITE=datadoghq.com

#-------------------------------------------------------------------------------
# Social Authentication - OAuth
#-------------------------------------------------------------------------------
# Google OAuth
GOOGLE_CLIENT_ID=<GOOGLE_CLIENT_ID>
GOOGLE_CLIENT_SECRET=<GOOGLE_CLIENT_SECRET>
GOOGLE_CALLBACK_URL=https://api.flamoral.com/api/v1/auth/google/callback

# Apple Sign-In
APPLE_CLIENT_ID=<APPLE_CLIENT_ID>
APPLE_TEAM_ID=<APPLE_TEAM_ID>
APPLE_KEY_ID=<APPLE_KEY_ID>
APPLE_PRIVATE_KEY=<APPLE_PRIVATE_KEY>
APPLE_CALLBACK_URL=https://api.flamoral.com/api/v1/auth/apple/callback

# Facebook OAuth
FACEBOOK_APP_ID=<FACEBOOK_APP_ID>
FACEBOOK_APP_SECRET=<FACEBOOK_APP_SECRET>
FACEBOOK_CALLBACK_URL=https://api.flamoral.com/api/v1/auth/facebook/callback

# Instagram OAuth
INSTAGRAM_CLIENT_ID=<INSTAGRAM_CLIENT_ID>
INSTAGRAM_CLIENT_SECRET=<INSTAGRAM_CLIENT_SECRET>

#-------------------------------------------------------------------------------
# Geographic & Location Services
#-------------------------------------------------------------------------------
# Google Maps
GOOGLE_MAPS_API_KEY=<GOOGLE_MAPS_API_KEY>

# Mapbox (alternative)
# MAPBOX_ACCESS_TOKEN=<MAPBOX_TOKEN>

# IP Geolocation
IPINFO_TOKEN=<IPINFO_TOKEN>

#-------------------------------------------------------------------------------
# Queue & Job Processing
#-------------------------------------------------------------------------------
# Bull Queue Settings
BULL_REDIS_URL=redis://:${REDIS_PASSWORD}@localhost:6379/1
BULL_CONCURRENCY=5
BULL_MAX_JOBS_PER_WORKER=100

# Queue Names
QUEUE_EMAIL=email-queue
QUEUE_NOTIFICATION=notification-queue
QUEUE_MEDIA_PROCESSING=media-queue
QUEUE_MATCHING=matching-queue
QUEUE_ANALYTICS=analytics-queue

#-------------------------------------------------------------------------------
# Feature Flags
#-------------------------------------------------------------------------------
# LaunchDarkly
LAUNCHDARKLY_SDK_KEY=<SDK_KEY>

# Or use simple flags
FEATURE_VIDEO_CALLS=true
FEATURE_AI_MATCHING=true
FEATURE_VOICE_NOTES=true
FEATURE_STORIES=true
FEATURE_LIVE_STREAMING=false
FEATURE_DATING_EVENTS=true

#-------------------------------------------------------------------------------
# External Webhooks
#-------------------------------------------------------------------------------
WEBHOOK_SECRET=<WEBHOOK_VERIFICATION_SECRET>
SLACK_WEBHOOK_URL=<SLACK_WEBHOOK_FOR_ALERTS>
DISCORD_WEBHOOK_URL=<DISCORD_WEBHOOK_FOR_ALERTS>

#-------------------------------------------------------------------------------
# Backup Configuration
#-------------------------------------------------------------------------------
BACKUP_S3_BUCKET=flamoral-backups
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=<BACKUP_ENCRYPTION_KEY>

#-------------------------------------------------------------------------------
# Service-Specific Ports
#-------------------------------------------------------------------------------
# These should match your PM2 ecosystem.config.js
PORT_API_GATEWAY=4000
PORT_AUTH_SERVICE=4001
PORT_USER_SERVICE=4002
PORT_MATCHING_SERVICE=4003
PORT_MESSAGING_SERVICE=4004
PORT_VIDEO_SERVICE=4005
PORT_NOTIFICATION_SERVICE=4006
PORT_PAYMENT_SERVICE=4007
PORT_MEDIA_SERVICE=4008
PORT_SEARCH_SERVICE=4009
PORT_ANALYTICS_SERVICE=4010
PORT_WEBSOCKET=5000
PORT_FRONTEND=5173

#-------------------------------------------------------------------------------
# Health Check Configuration
#-------------------------------------------------------------------------------
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000
HEALTH_CHECK_RETRIES=3

#-------------------------------------------------------------------------------
# Miscellaneous
#-------------------------------------------------------------------------------
# Timezone
TZ=UTC

# Default Pagination
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Content Limits
MAX_BIO_LENGTH=500
MAX_PHOTOS=9
MAX_PROMPTS=3
MAX_MESSAGE_LENGTH=5000

# Matching Algorithm
MATCHING_DAILY_LIMIT=100
MATCHING_RADIUS_DEFAULT_KM=50
MATCHING_RADIUS_MAX_KM=500

# Premium Features
PREMIUM_BOOST_DURATION_HOURS=24
PREMIUM_SUPER_LIKES_PER_DAY=5
PREMIUM_REWIND_ENABLED=true

#===============================================================================
# END OF CONFIGURATION
#===============================================================================
#
# After filling in all values:
# 1. Save this file as .env.production
# 2. Set proper permissions: chmod 600 .env.production
# 3. Ensure it's in .gitignore
# 4. Load in your application or PM2 ecosystem config
#
# To generate secure secrets:
#   openssl rand -hex 32  # For 256-bit keys
#   openssl rand -hex 16  # For 128-bit keys
#   openssl rand -base64 32  # For base64 secrets
#===============================================================================
