# =============================================================================
# Flamoral Dating Platform - Development Environment Configuration (AWS)
# =============================================================================
# Copy this file to .env.dev and fill in your actual values
# DO NOT commit .env.dev to version control
# =============================================================================

# =============================================================================
# Environment Configuration
# =============================================================================
NODE_ENV=development
ENVIRONMENT=dev
PORT=3000
GRAPHQL_PORT=4000
WS_PORT=5000

# =============================================================================
# URLs and Hosts
# =============================================================================
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
INGRESS_HOST=dev.flamoral.app
API_HOST=api.dev.flamoral.app

# =============================================================================
# Database - PostgreSQL (Aurora PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_dev
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/flamoral_dev

# For AWS Aurora PostgreSQL:
# DB_HOST=flamoral-dev-aurora.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com
# DATABASE_URL=postgresql://postgres:password@flamoral-dev-aurora.cluster-xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/flamoral_dev

# =============================================================================
# Database - MongoDB (AWS DocumentDB)
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/flamoral-dev
MONGODB_DB=flamoral-dev

# For AWS DocumentDB:
# MONGODB_URI=mongodb://username:password@flamoral-dev-docdb.cluster-xxxxxxxxxxxx.us-east-1.docdb.amazonaws.com:27017/flamoral-dev?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false

# =============================================================================
# Cache - Redis (AWS ElastiCache)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# For AWS ElastiCache Redis:
# REDIS_HOST=flamoral-dev-redis.xxxxxxxxxxxx.use1.cache.amazonaws.com
# REDIS_PORT=6379
# REDIS_URL=redis://flamoral-dev-redis.xxxxxxxxxxxx.use1.cache.amazonaws.com:6379

# =============================================================================
# Message Queue - RabbitMQ (or AWS SQS/SNS)
# =============================================================================
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue

# For AWS SQS:
# AWS_SQS_MATCHING_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/xxxxxxxxxxxx/flamoral-dev-matching
# AWS_SQS_NOTIFICATIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/xxxxxxxxxxxx/flamoral-dev-notifications

# =============================================================================
# Authentication - JWT
# =============================================================================
# IMPORTANT: Use minimum 64 characters for production-like secrets
JWT_ACCESS_SECRET=dev-jwt-access-secret-min-64-chars-REPLACE-WITH-SECURE-RANDOM-STRING
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-min-64-chars-REPLACE-WITH-SECURE-RANDOM-STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Payment Gateway - Stripe (TEST MODE)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# =============================================================================
# Email Service - AWS SES (or SendGrid)
# =============================================================================
AWS_SES_REGION=us-east-1
AWS_SES_FROM_EMAIL=dev@flamoral.com
AWS_SES_FROM_NAME=Flamoral Dev

# SendGrid fallback (optional)
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=dev@flamoral.com
SENDGRID_FROM_NAME=Flamoral Dev

# =============================================================================
# SMS Service - AWS SNS (or Twilio)
# =============================================================================
AWS_SNS_REGION=us-east-1

# Twilio fallback (optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# AWS S3 Storage
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_PHOTOS=flamoral-dev-photos
AWS_S3_BUCKET_VIDEOS=flamoral-dev-videos
AWS_S3_BUCKET_MEDIA=flamoral-dev-media
AWS_S3_BUCKET_UPLOADS=flamoral-dev-uploads

# =============================================================================
# AWS Rekognition (Face API)
# =============================================================================
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=flamoral-dev-faces

# =============================================================================
# Video/Voice Calling - Agora
# =============================================================================
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# =============================================================================
# Error Tracking - Sentry
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/flamoral

# =============================================================================
# AWS ECR (Container Registry)
# =============================================================================
ECR_REGISTRY=xxxxxxxxxxxx.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY_PREFIX=flamoral
AWS_ACCOUNT_ID=xxxxxxxxxxxx

# =============================================================================
# AWS Secrets Manager
# =============================================================================
AWS_SECRETS_MANAGER_REGION=us-east-1
AWS_SECRETS_PREFIX=flamoral/dev

# =============================================================================
# AWS Cognito
# =============================================================================
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_MATCHING=true
FEATURE_VIDEO_CALLS=true
FEATURE_TRAVEL_MODE=true
FEATURE_DATING_COACH=true
FEATURE_GAMIFICATION=true

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=dev-session-secret-min-32-chars-here
SESSION_MAX_AGE=86400000

# =============================================================================
# File Upload Limits
# =============================================================================
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# =============================================================================
# Development Tools
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_API_DOCS=true
ENABLE_DEBUG_LOGGING=true

# =============================================================================
# AI/ML Configuration (AWS SageMaker)
# =============================================================================
AI_MODEL_ENDPOINT=http://localhost:8000
AI_MODEL_API_KEY=dev-ai-model-key
AWS_SAGEMAKER_ENDPOINT=flamoral-dev-matching-model

# =============================================================================
# Push Notifications - AWS SNS (Replaces Firebase)
# =============================================================================
# DEPRECATED: Firebase configuration removed. Using AWS SNS Platform Applications.
# AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:us-east-1:xxxx:app/APNS/flamoral-ios
# AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:us-east-1:xxxx:app/GCM/flamoral-android
