# =============================================================================
# Flamoral Dating Platform - Development Environment Configuration
# =============================================================================
# Copy this file to .env.dev and fill in your actual values
# DO NOT commit .env.dev to version control
# =============================================================================

# =============================================================================
# Environment Configuration
# =============================================================================
NODE_ENV=development
ENVIRONMENT=dev
PORT=3000
GRAPHQL_PORT=4000
WS_PORT=5000

# =============================================================================
# URLs and Hosts
# =============================================================================
WEB_URL=http://localhost:5173
API_URL=http://localhost:3000
INGRESS_HOST=dev.flamoral.app
API_HOST=api.dev.flamoral.app

# =============================================================================
# Database - PostgreSQL
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_dev
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DB_POOL_MIN=2
DB_POOL_MAX=10
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/flamoral_dev

# =============================================================================
# Database - MongoDB
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/flamoral-dev
MONGODB_DB=flamoral-dev

# =============================================================================
# Cache - Redis
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# For Azure Redis Cache (if using)
# REDIS_HOST=flamoral-dev-redis.redis.cache.windows.net
# REDIS_PORT=6380
# REDIS_PASSWORD=your_azure_redis_password_here
# REDIS_URL=rediss://:your_azure_redis_password_here@flamoral-dev-redis.redis.cache.windows.net:6380

# =============================================================================
# Message Queue - RabbitMQ
# =============================================================================
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue

# =============================================================================
# Authentication - JWT
# =============================================================================
# IMPORTANT: Use minimum 64 characters for production-like secrets
JWT_ACCESS_SECRET=dev-jwt-access-secret-min-64-chars-REPLACE-WITH-SECURE-RANDOM-STRING
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-min-64-chars-REPLACE-WITH-SECURE-RANDOM-STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Payment Gateway - Stripe (TEST MODE)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# =============================================================================
# Email Service - SendGrid
# =============================================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=dev@flamoral.com
SENDGRID_FROM_NAME=Flamoral Dev

# =============================================================================
# SMS Service - Twilio
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Azure Storage
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoraldevst
AZURE_STORAGE_KEY=your_azure_storage_account_key_here
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=flamoraldevst;AccountKey=your_key_here;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos

# =============================================================================
# Azure Cognitive Services - Face API
# =============================================================================
AZURE_FACE_API_KEY=your_azure_face_api_key_here
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# =============================================================================
# Video/Voice Calling - Agora
# =============================================================================
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# =============================================================================
# Error Tracking - Sentry
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/flamoral

# =============================================================================
# Azure Container Registry (ACR)
# =============================================================================
ACR_NAME=flamoralacr8eq5eg
ACR_LOGIN_SERVER=flamoralacr8eq5eg.azurecr.io
ACR_USERNAME=flamoralacr8eq5eg
ACR_PASSWORD=your_acr_password_here

# =============================================================================
# Kubernetes / AKS
# =============================================================================
AKS_CLUSTER_NAME=flamoral-dev-aks
AKS_RESOURCE_GROUP=flamoral-dev-rg
NAMESPACE=flamoral-dev

# =============================================================================
# Azure Key Vault
# =============================================================================
KEY_VAULT_NAME=flamoral-dev-kv
KEY_VAULT_URI=https://flamoral-dev-kv.vault.azure.net/

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_MATCHING=true
FEATURE_VIDEO_CALLS=true
FEATURE_TRAVEL_MODE=true
FEATURE_DATING_COACH=true
FEATURE_GAMIFICATION=true

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=dev-session-secret-min-32-chars-here
SESSION_MAX_AGE=86400000

# =============================================================================
# File Upload Limits
# =============================================================================
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# =============================================================================
# Development Tools
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=true
ENABLE_API_DOCS=true
ENABLE_DEBUG_LOGGING=true

# =============================================================================
# AI/ML Configuration
# =============================================================================
AI_MODEL_ENDPOINT=http://localhost:8000
AI_MODEL_API_KEY=dev-ai-model-key

# =============================================================================
# Push Notifications - Firebase (Optional)
# =============================================================================
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=your-firebase-client-email
