# Server
PORT=3033
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_progression
DB_USER=postgres
DB_PASSWORD=postgres

# JWT (RS256)
JWT_PUBLIC_KEY=
JWT_ISSUER=flamoral-auth
JWT_AUDIENCE=flamoral-api

# Alternative: Simple secret for development
JWT_SECRET=dev-secret-key

# Service-to-Service Authentication
SERVICE_KEY=dev-service-key

# External Services
USER_SERVICE_URL=http://localhost:3001
MATCHING_SERVICE_URL=http://localhost:3004

# CORS
CORS_ORIGIN=http://localhost:3000
