# =============================================================================
# SERVICE-TO-SERVICE AUTHENTICATION
# =============================================================================

# Service API Key - CRITICAL: Must be the same across ALL services
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=your-secret-service-key-here-change-this-in-production

# =============================================================================
# SERVICE URLS (Matching README.md Port Mapping)
# =============================================================================

# API Gateway
API_GATEWAY_URL=http://localhost:4000

# Auth Service
AUTH_SERVICE_URL=http://localhost:3001

# User Service
USER_SERVICE_URL=http://localhost:3002

# Matching Service
MATCHING_SERVICE_URL=http://localhost:3003

# Messaging Service (WebSocket)
MESSAGING_SERVICE_URL=http://localhost:5000

# Payment Service
PAYMENT_SERVICE_URL=http://localhost:3005

# Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:3007

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:3008

# Media Service
MEDIA_SERVICE_URL=http://localhost:3009

# Admin Service
ADMIN_SERVICE_URL=http://localhost:3010

# Advertising Service
ADVERTISING_SERVICE_URL=http://localhost:3011

# Moderation Service
MODERATION_SERVICE_URL=http://localhost:3012

# Automation Service
AUTOMATION_SERVICE_URL=http://localhost:3013

# Partnership Service
PARTNERSHIP_SERVICE_URL=http://localhost:3014

# =============================================================================
# COMMON SERVICE CONFIGURATION
# =============================================================================

# Node Environment
NODE_ENV=development

# Port (specific to each service - see README.md for port mapping)
PORT=3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL (Aurora PostgreSQL on AWS)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_dev
DB_USER=postgres
DB_PASSWORD=your-db-password
DATABASE_URL=postgresql://postgres:your-db-password@localhost:5432/flamoral_dev

# Redis (ElastiCache on AWS)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# MongoDB (DocumentDB on AWS) - for some services
MONGODB_URI=mongodb://localhost:27017/flamoral

# =============================================================================
# AWS SERVICES (AWS-Only Platform)
# =============================================================================

# AWS General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key

# AWS S3 Storage
AWS_S3_BUCKET=flamoral-media
AWS_S3_BUCKET_PHOTOS=flamoral-photos
AWS_S3_BUCKET_VIDEOS=flamoral-videos

# AWS SES Email (replaces SendGrid)
AWS_SES_REGION=us-east-1
EMAIL_FROM=noreply@flamoral.com
EMAIL_FROM_NAME=Flamoral
AWS_SES_CONFIGURATION_SET=flamoral-emails

# AWS SNS SMS (replaces Twilio)
AWS_SNS_REGION=us-east-1
AWS_SNS_SENDER_ID=Flamoral
AWS_SNS_MONTHLY_SPEND_LIMIT=100

# AWS SNS Push Notifications (replaces Firebase)
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:us-east-1:YOUR_ACCOUNT:app/GCM/flamoral-android
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:us-east-1:YOUR_ACCOUNT:app/APNS/flamoral-ios

# AWS Rekognition (Content Moderation)
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=flamoral-faces

# AWS SQS Queue Configuration
USE_AWS_SQS=true
AWS_SQS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
AWS_SQS_QUEUE_PREFIX=flamoral

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================

STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# SECURITY
# =============================================================================

# JWT Configuration - MUST BE CONSISTENT ACROSS ALL SERVICES
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ACCESS_SECRET=your-jwt-access-secret-change-this-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this-in-production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key (must be exactly 32 bytes for AES-256)
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# TOTP Encryption (for 2FA)
TOTP_ENCRYPTION_KEY=your-totp-encryption-key-32-chars

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log Level
LOG_LEVEL=debug

# Sentry (Error Tracking)
SENTRY_DSN=

# =============================================================================
# CORS
# =============================================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4000

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_CIRCUIT_BREAKER=false
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
