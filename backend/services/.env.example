# =============================================================================
# SERVICE-TO-SERVICE AUTHENTICATION
# =============================================================================

# Service API Key - CRITICAL: Must be the same across ALL services
# Generate with: openssl rand -hex 32
SERVICE_API_KEY=your-secret-service-key-here-change-this-in-production

# =============================================================================
# SERVICE URLS
# =============================================================================

# User Service
USER_SERVICE_URL=http://localhost:3001

# Matching Service
MATCHING_SERVICE_URL=http://localhost:3002

# Messaging Service
MESSAGING_SERVICE_URL=http://localhost:3003

# Moderation Service
MODERATION_SERVICE_URL=http://localhost:3004

# Payment Service
PAYMENT_SERVICE_URL=http://localhost:3005

# Media Service
MEDIA_SERVICE_URL=http://localhost:3006

# Notification Service
NOTIFICATION_SERVICE_URL=http://localhost:3008

# Analytics Service
ANALYTICS_SERVICE_URL=http://localhost:3007

# AI Services
AI_SERVICE_URL=http://localhost:3009

# Advertising Service
ADVERTISING_SERVICE_URL=http://localhost:3010

# Auth Service
AUTH_SERVICE_URL=http://localhost:3011

# Realtime Service
REALTIME_SERVICE_URL=http://localhost:3012

# =============================================================================
# COMMON SERVICE CONFIGURATION
# =============================================================================

# Node Environment
NODE_ENV=development

# Port (specific to each service)
PORT=3001

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_dev
DB_USER=postgres
DB_PASSWORD=your-db-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# MongoDB (for some services)
MONGODB_URI=mongodb://localhost:27017/flamoral

# Cosmos DB (for messaging service)
COSMOS_DB_ENDPOINT=
COSMOS_DB_KEY=
COSMOS_DB_DATABASE=flamoral-messaging

# =============================================================================
# EXTERNAL SERVICES
# =============================================================================

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_S3_BUCKET=flamoral-media

# Azure
AZURE_STORAGE_CONNECTION_STRING=
AZURE_CONTENT_MODERATOR_KEY=
AZURE_CONTENT_MODERATOR_ENDPOINT=

# Twilio (SMS/Phone Verification)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# SendGrid (Email)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@flamoral.com

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# =============================================================================
# SECURITY
# =============================================================================

# JWT
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_EXPIRES_IN=7d

# Encryption
ENCRYPTION_KEY=your-encryption-key-32-chars-long

# =============================================================================
# LOGGING & MONITORING
# =============================================================================

# Log Level
LOG_LEVEL=debug

# Sentry (Error Tracking)
SENTRY_DSN=

# =============================================================================
# CORS
# =============================================================================

CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_CIRCUIT_BREAKER=false
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
