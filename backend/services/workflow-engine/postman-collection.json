{
  "info": {
    "name": "Workflow Engine API",
    "description": "API collection for Flamoral Workflow Engine",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3011/api/v1",
      "type": "string"
    },
    {
      "key": "internalServiceKey",
      "value": "internal-service-key",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Workflows",
      "item": [
        {
          "name": "Create Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Welcome New Users\",\n  \"description\": \"Send welcome message and bonus coins to new users\",\n  \"trigger\": {\n    \"type\": \"first_login\"\n  },\n  \"conditions\": [],\n  \"actions\": [\n    {\n      \"type\": \"send_push\",\n      \"config\": {\n        \"title\": \"Welcome to Flamoral!\",\n        \"body\": \"Start your dating journey!\"\n      }\n    },\n    {\n      \"type\": \"add_coins\",\n      \"config\": {\n        \"amount\": 20,\n        \"reason\": \"welcome_bonus\"\n      },\n      \"delay\": 2000\n    }\n  ],\n  \"status\": \"active\",\n  \"priority\": 10,\n  \"tags\": [\"onboarding\", \"welcome\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/workflows",
              "host": ["{{baseUrl}}"],
              "path": ["workflows"]
            }
          }
        },
        {
          "name": "Get All Workflows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workflows",
              "host": ["{{baseUrl}}"],
              "path": ["workflows"]
            }
          }
        },
        {
          "name": "Get Workflow by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workflows/:id",
              "host": ["{{baseUrl}}"],
              "path": ["workflows", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "workflow-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "Enable Workflow",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workflows/:id/enable",
              "host": ["{{baseUrl}}"],
              "path": ["workflows", ":id", "enable"],
              "variable": [
                {
                  "key": "id",
                  "value": "workflow-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "Disable Workflow",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workflows/:id/disable",
              "host": ["{{baseUrl}}"],
              "path": ["workflows", ":id", "disable"],
              "variable": [
                {
                  "key": "id",
                  "value": "workflow-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "Get Workflow Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workflows/:id/statistics",
              "host": ["{{baseUrl}}"],
              "path": ["workflows", ":id", "statistics"],
              "variable": [
                {
                  "key": "id",
                  "value": "workflow-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "Delete Workflow",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/workflows/:id",
              "host": ["{{baseUrl}}"],
              "path": ["workflows", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "workflow-uuid-here"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Executions",
      "item": [
        {
          "name": "Trigger Workflow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"triggerType\": \"first_login\",\n  \"triggerData\": {\n    \"userId\": \"user-123\",\n    \"timestamp\": \"2025-12-09T10:00:00Z\"\n  },\n  \"userId\": \"user-123\",\n  \"metadata\": {\n    \"source\": \"manual_trigger\"\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/executions/trigger",
              "host": ["{{baseUrl}}"],
              "path": ["executions", "trigger"]
            }
          }
        },
        {
          "name": "Get All Executions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/executions?limit=50&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["executions"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            }
          }
        },
        {
          "name": "Get Execution by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/executions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["executions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "execution-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "Get Workflow Executions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/executions/workflow/:workflowId?limit=50",
              "host": ["{{baseUrl}}"],
              "path": ["executions", "workflow", ":workflowId"],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ],
              "variable": [
                {
                  "key": "workflowId",
                  "value": "workflow-uuid-here"
                }
              ]
            }
          }
        },
        {
          "name": "Get Execution Statistics",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/executions/statistics/summary",
              "host": ["{{baseUrl}}"],
              "path": ["executions", "statistics", "summary"]
            }
          }
        }
      ]
    },
    {
      "name": "Analytics",
      "item": [
        {
          "name": "Get Dashboard",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/dashboard",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "dashboard"]
            }
          }
        },
        {
          "name": "Get Workflow Performance",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/workflows/performance",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "workflows", "performance"]
            }
          }
        },
        {
          "name": "Get Trigger Popularity",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/triggers/popularity",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "triggers", "popularity"]
            }
          }
        },
        {
          "name": "Get Action Usage",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Service-Key",
                "value": "{{internalServiceKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/analytics/actions/usage",
              "host": ["{{baseUrl}}"],
              "path": ["analytics", "actions", "usage"]
            }
          }
        }
      ]
    },
    {
      "name": "Health Check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3011/health",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3011",
          "path": ["health"]
        }
      }
    }
  ]
}
