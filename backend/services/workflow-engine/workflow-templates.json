{
  "templates": [
    {
      "name": "Welcome New Users",
      "description": "Send welcome message and bonus coins to new users on first login",
      "trigger": {
        "type": "first_login"
      },
      "conditions": [],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "Welcome to Flamoral!",
            "body": "Start your dating journey and find your perfect match!"
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 20,
            "reason": "welcome_bonus"
          },
          "delay": 2000
        },
        {
          "type": "send_in_app_message",
          "config": {
            "title": "Getting Started",
            "message": "Complete your profile to get better matches!",
            "type": "info",
            "actionUrl": "/profile/edit"
          },
          "delay": 5000
        }
      ],
      "status": "draft",
      "priority": 10,
      "tags": ["onboarding", "welcome", "retention"]
    },
    {
      "name": "Reward Profile Completion",
      "description": "Reward users who complete their profile with boost and coins",
      "trigger": {
        "type": "profile_completed"
      },
      "conditions": [
        {
          "type": "profile_complete_percentage",
          "operator": "gte",
          "value": 90
        }
      ],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "Profile Complete!",
            "body": "Your profile looks amazing! Here's a boost to help you get discovered."
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 50,
            "reason": "profile_completion_reward"
          }
        },
        {
          "type": "activate_boost",
          "config": {
            "duration": 30,
            "type": "profile_boost"
          },
          "delay": 3000
        },
        {
          "type": "update_profile_score",
          "config": {
            "scoreAdjustment": 10,
            "reason": "profile_completed"
          }
        }
      ],
      "status": "draft",
      "priority": 8,
      "tags": ["engagement", "profile", "reward"]
    },
    {
      "name": "Re-engage Inactive Users",
      "description": "Send special offer to users inactive for 7 days",
      "trigger": {
        "type": "user_inactive_7d"
      },
      "conditions": [
        {
          "type": "match_count",
          "operator": "gte",
          "value": 1
        }
      ],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "We Miss You!",
            "body": "Come back and check your new matches. Special gift inside!"
          }
        },
        {
          "type": "send_email",
          "config": {
            "subject": "Your matches are waiting!",
            "template": "re_engagement",
            "templateData": {
              "offerType": "50% off premium"
            }
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 30,
            "reason": "reengagement_bonus"
          }
        },
        {
          "type": "promote_user",
          "config": {
            "duration": 60,
            "priority": "high"
          },
          "delay": 5000
        }
      ],
      "status": "draft",
      "priority": 9,
      "tags": ["retention", "reengagement", "inactive"]
    },
    {
      "name": "Premium Welcome Package",
      "description": "Send welcome package to new premium subscribers",
      "trigger": {
        "type": "subscription_purchase"
      },
      "conditions": [],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "Welcome to Premium!",
            "body": "Thank you for upgrading. Enjoy your exclusive perks!"
          }
        },
        {
          "type": "send_email",
          "config": {
            "subject": "Welcome to Flamoral Premium",
            "template": "premium_welcome",
            "templateData": {
              "benefits": ["unlimited likes", "see who liked you", "5 super likes per day"]
            }
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 100,
            "reason": "premium_welcome_bonus"
          },
          "delay": 2000
        },
        {
          "type": "activate_boost",
          "config": {
            "duration": 120,
            "type": "profile_boost"
          },
          "delay": 5000
        }
      ],
      "status": "draft",
      "priority": 10,
      "tags": ["monetization", "premium", "welcome"]
    },
    {
      "name": "First Match Celebration",
      "description": "Celebrate user's first match with encouragement",
      "trigger": {
        "type": "match_created"
      },
      "conditions": [
        {
          "type": "match_count",
          "operator": "eq",
          "value": 1
        }
      ],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "🎉 Your First Match!",
            "body": "Congratulations! Start chatting and make a connection."
          }
        },
        {
          "type": "send_in_app_message",
          "config": {
            "title": "First Match Tips",
            "message": "Break the ice with a fun question or compliment!",
            "type": "success"
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 10,
            "reason": "first_match_bonus"
          },
          "delay": 3000
        }
      ],
      "status": "draft",
      "priority": 7,
      "tags": ["engagement", "milestone", "match"]
    },
    {
      "name": "Super Like Notification",
      "description": "Notify users when they receive a super like",
      "trigger": {
        "type": "super_like"
      },
      "conditions": [],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "💫 You Got a Super Like!",
            "body": "Someone is really interested in you! Check them out now."
          }
        },
        {
          "type": "send_in_app_message",
          "config": {
            "title": "Super Like Received",
            "message": "This person really wants to connect with you!",
            "type": "info",
            "actionUrl": "/matches"
          }
        }
      ],
      "status": "draft",
      "priority": 9,
      "tags": ["engagement", "notification", "super_like"]
    },
    {
      "name": "Abandoned Onboarding Recovery",
      "description": "Encourage users to complete onboarding",
      "trigger": {
        "type": "abandoned_onboarding"
      },
      "conditions": [
        {
          "type": "profile_complete_percentage",
          "operator": "lt",
          "value": 50
        }
      ],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "Complete Your Profile",
            "body": "You're almost there! Complete your profile to start matching."
          }
        },
        {
          "type": "send_email",
          "config": {
            "subject": "Don't miss out on great matches!",
            "template": "onboarding_reminder",
            "templateData": {}
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 15,
            "reason": "onboarding_incentive"
          }
        }
      ],
      "status": "draft",
      "priority": 8,
      "tags": ["onboarding", "retention", "abandoned"]
    },
    {
      "name": "Message Milestone Reward",
      "description": "Reward active users who send many messages",
      "trigger": {
        "type": "message_sent"
      },
      "conditions": [
        {
          "type": "message_count",
          "operator": "gte",
          "value": 100
        }
      ],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "Active Chatter Badge!",
            "body": "You've sent 100+ messages! Here's a reward for being engaged."
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 25,
            "reason": "message_milestone_100"
          }
        },
        {
          "type": "update_profile_score",
          "config": {
            "scoreAdjustment": 5,
            "reason": "active_messenger"
          }
        }
      ],
      "status": "draft",
      "priority": 6,
      "tags": ["engagement", "reward", "milestone"]
    },
    {
      "name": "Promote Active Premium Users",
      "description": "Give extra visibility to premium users with complete profiles",
      "trigger": {
        "type": "like_received"
      },
      "conditions": [
        {
          "type": "user_premium",
          "operator": "eq",
          "value": true
        },
        {
          "type": "profile_complete_percentage",
          "operator": "gte",
          "value": 95,
          "logicalOperator": "AND"
        }
      ],
      "actions": [
        {
          "type": "promote_user",
          "config": {
            "duration": 30,
            "priority": "high"
          }
        },
        {
          "type": "update_profile_score",
          "config": {
            "scoreAdjustment": 2,
            "reason": "premium_engagement_boost"
          }
        }
      ],
      "status": "draft",
      "priority": 7,
      "tags": ["premium", "visibility", "engagement"]
    },
    {
      "name": "Coin Purchase Thank You",
      "description": "Thank users for purchasing coins and give bonus",
      "trigger": {
        "type": "coin_purchase"
      },
      "conditions": [],
      "actions": [
        {
          "type": "send_push",
          "config": {
            "title": "Thanks for Your Purchase!",
            "body": "Your coins are ready to use. Here's a bonus gift!"
          }
        },
        {
          "type": "add_coins",
          "config": {
            "amount": 5,
            "reason": "purchase_bonus"
          },
          "delay": 2000
        },
        {
          "type": "send_in_app_message",
          "config": {
            "title": "Coin Purchase Successful",
            "message": "Use your coins to unlock premium features and boost your profile!",
            "type": "success"
          }
        }
      ],
      "status": "draft",
      "priority": 8,
      "tags": ["monetization", "thank_you", "coins"]
    }
  ]
}
