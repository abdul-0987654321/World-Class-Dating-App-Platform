{
  "name": "Re-engage Inactive Users (7 Days)",
  "description": "Win back users who haven't been active for 7 days with personalized incentives",
  "trigger": {
    "type": "user_inactive_7d",
    "config": {
      "description": "Triggered for users inactive for 7 days",
      "scheduleCron": "0 10 * * *"
    }
  },
  "conditions": [
    {
      "type": "user_premium",
      "operator": "eq",
      "value": false,
      "logicalOperator": "AND"
    },
    {
      "type": "match_count",
      "operator": "gt",
      "value": 0,
      "logicalOperator": "AND"
    }
  ],
  "actions": [
    {
      "type": "send_push",
      "config": {
        "title": "Someone's thinking about you! 💭",
        "body": "You have {{pendingLikes}} new likes waiting. Come back and see who it is!",
        "data": {
          "action": "navigate_to_likes",
          "screen": "likes"
        }
      },
      "delay": 0,
      "retryOnFailure": true
    },
    {
      "type": "send_email",
      "config": {
        "subject": "Your matches miss you!",
        "template": "reengagement_7day",
        "templateData": {
          "userName": "{{user.firstName}}",
          "matchCount": "{{user.matchCount}}",
          "pendingLikes": "{{user.pendingLikes}}"
        }
      },
      "delay": 3600000,
      "retryOnFailure": true
    },
    {
      "type": "activate_boost",
      "config": {
        "duration": 30,
        "type": "profile_boost"
      },
      "delay": 7200000,
      "retryOnFailure": true
    }
  ],
  "status": "active",
  "priority": 70,
  "tags": ["retention", "reengagement", "churn-prevention"]
}
