{
  "name": "@flamoral/matching-service",
  "version": "1.0.0",
  "description": "AI-powered matching and recommendation service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src tests ",
    "lint:fix": "eslint src tests ",
    "migrate:latest": "knex migrate:latest --knexfile src/infrastructure/database/knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/infrastructure/database/knexfile.ts",
    "migrate:status": "knex migrate:status --knexfile src/infrastructure/database/knexfile.ts",
    "ml:train": "python src/ml/training/train.py",
    "ml:evaluate": "python src/ml/training/evaluate.py",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flamoral/backend-shared": "file:../../shared",
    "@nestjs/common": "^10.3.0",
    "axios": "^1.7.9",
    "bull": "^4.12.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "node-cron": "^3.0.3",
    "pg": "^8.11.3",
    "redis": "^4.6.11",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
