# Server Configuration
PORT=3001
NODE_ENV=development

# =============================================================================
# SECURITY: Email Verification
# =============================================================================
# IMPORTANT: Email verification is REQUIRED by default in production (even if not set)
# The config defaults to true when NODE_ENV=production, false when NODE_ENV=development
# Only set to 'false' for local development/testing - NEVER disable in production!
# This prevents fake account creation and improves user quality
REQUIRE_EMAIL_VERIFICATION=true

# JWT Configuration (REQUIRED - NEVER USE DEFAULTS IN PRODUCTION)
# Generate secure secrets using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: These MUST be set and be at least 32 characters long
JWT_ACCESS_SECRET=CHANGE_ME_TO_SECURE_64_CHARACTER_HEX_STRING_MINIMUM_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_TO_DIFFERENT_64_CHARACTER_HEX_STRING_MINIMUM_32_CHARS

# JWT Configuration (Optional - secure defaults shown)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=flamoral-auth-service
JWT_AUDIENCE=flamoral-platform

# Enable JWT secret validation in development (recommended)
VALIDATE_JWT_SECRETS=true

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSL=false

# Redis Configuration
# Option 1: Use REDIS_URL (takes precedence if set)
REDIS_URL=redis://localhost:6379
# Option 2: Use individual variables (used if REDIS_URL is not set)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Email Configuration (SendGrid)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@flamoral.com

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# AWS Secrets Manager (Production)
# Secrets are automatically retrieved from AWS Secrets Manager in production
AWS_SECRETS_MANAGER_SECRET_ID=flamoral-auth-secrets

# Internal Service Communication
# Generate secure key using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: MUST be set to a secure value (32+ chars) in production
INTERNAL_SERVICE_KEY=CHANGE_ME_TO_SECURE_64_CHARACTER_HEX_STRING

# Frontend URL
FRONTEND_URL=http://localhost:3000
