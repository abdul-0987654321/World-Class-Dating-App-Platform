# ============================================
# Flamoral Auth Service - Railway Environment Variables
# Copy these to your Railway service's Variables tab
# ============================================

# Core Settings
NODE_ENV=production
PORT=3001

# JWT Secrets (REQUIRED - Generate secure random strings, minimum 32 characters)
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=your-super-secure-access-secret-minimum-32-characters-long
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-minimum-32-characters-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=flamoral-auth-service
JWT_AUDIENCE=flamoral-platform

# Database (Railway provides these automatically when you add PostgreSQL)
# These are auto-injected by Railway - you don't need to set them manually
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# PGHOST=${{Postgres.PGHOST}}
# PGPORT=${{Postgres.PGPORT}}
# PGUSER=${{Postgres.PGUSER}}
# PGPASSWORD=${{Postgres.PGPASSWORD}}
# PGDATABASE=${{Postgres.PGDATABASE}}

# Redis (Railway provides these automatically when you add Redis)
# REDIS_URL=${{Redis.REDIS_URL}}

# Internal Service Key (for service-to-service communication)
# Generate with: openssl rand -base64 32
INTERNAL_SERVICE_KEY=your-internal-service-key-minimum-32-characters

# CORS - Your Vercel frontend URL
CORS_ORIGINS=https://world-class-dating-app-platform-web-app.vercel.app,https://flamoral.com,https://www.flamoral.com

# Frontend URL (for email links, redirects, etc.)
FRONTEND_URL=https://world-class-dating-app-platform-web-app.vercel.app

# Email Configuration (Optional - for email verification)
# AWS SES credentials if you want to send real verification emails
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# EMAIL_FROM=noreply@flamoral.com

# Feature Flags
REQUIRE_EMAIL_VERIFICATION=false

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
