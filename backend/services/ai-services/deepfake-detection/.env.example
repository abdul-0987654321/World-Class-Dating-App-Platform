# Deepfake Detection Service Configuration

# Server settings
DEEPFAKE_HOST=0.0.0.0
DEEPFAKE_PORT=8010
DEEPFAKE_DEBUG=false

# Model settings
DEEPFAKE_MODEL_PATH=./models/weights/efficientnet_deepfake.pth
DEEPFAKE_DETECTION_THRESHOLD=0.5

# File limits
DEEPFAKE_MAX_FILE_SIZE=52428800  # 50MB
DEEPFAKE_MAX_VIDEO_FRAMES=300

# Logging
LOG_LEVEL=INFO

# For GPU support (uncomment if using CUDA)
# CUDA_VISIBLE_DEVICES=0
