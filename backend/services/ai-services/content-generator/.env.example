# Service Configuration
SERVICE_NAME=content-generator
VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8087
WORKERS=2

# CORS
CORS_ORIGINS=*

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
GPT_MODEL=gpt-4-turbo-preview
GPT_MAX_TOKENS=1000
GPT_TEMPERATURE=0.8

# Content Generation Settings
MAX_ICEBREAKERS=10
MAX_DATE_IDEAS=10
MAX_GIFTS=10
MAX_COMPLIMENTS=10
MAX_TOPICS=10

# Rate Limiting
RATE_LIMIT_PER_USER=50

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_ALGORITHM=HS256

# Monitoring
SENTRY_DSN=
LOG_LEVEL=INFO
