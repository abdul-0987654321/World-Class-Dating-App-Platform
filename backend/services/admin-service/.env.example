# Server Configuration
PORT=3010
NODE_ENV=development

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_db
DB_USER=flamoral_user
DB_PASSWORD=your_password_here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your_jwt_secret_here
JWT_ADMIN_SECRET=your_admin_jwt_secret_here

# Service URLs
USER_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3005
MODERATION_SERVICE_URL=http://localhost:3012
ANALYTICS_SERVICE_URL=http://localhost:3007
MESSAGING_SERVICE_URL=http://localhost:5000

# CORS
CORS_ORIGIN=http://localhost:3000

# Admin Configuration
SUPER_ADMIN_EMAIL=admin@flamoral.com
ADMIN_SESSION_DURATION=12h
AUDIT_LOG_RETENTION_DAYS=90
