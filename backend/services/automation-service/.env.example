# ============================================================================
# AUTOMATION SERVICE - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=automation-service
NODE_ENV=development
PORT=3013

# JWT Configuration (REQUIRED)
JWT_ACCESS_SECRET=your-jwt-access-secret-key-min-32-chars

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_automation
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis (for caching and job queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=7

# RabbitMQ Configuration
RABBITMQ_URL=amqp://localhost:5672
RABBITMQ_EXCHANGE=flamoral_events
RABBITMQ_MATCH_QUEUE=match_events
RABBITMQ_MESSAGE_QUEUE=message_events
RABBITMQ_USER_QUEUE=user_events

# Service URLs (REQUIRED)
MESSAGING_SERVICE_URL=http://localhost:3003
NOTIFICATION_SERVICE_URL=http://localhost:3008
USER_SERVICE_URL=http://localhost:3001
MATCHING_SERVICE_URL=http://localhost:3002
AI_SERVICE_URL=http://localhost:3009

# Internal Service Authentication (REQUIRED)
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# OpenAI Configuration (for AI-powered features)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Automation Configuration
ENABLE_AUTO_DM_FLOWS=true
ENABLE_ICEBREAKER_SUGGESTIONS=true
ENABLE_GHOSTING_DETECTION=true
ENABLE_SCHEDULED_MESSAGES=true

# Workflow Engine Settings
MAX_CONCURRENT_WORKFLOWS=50
WORKFLOW_TIMEOUT_MS=30000
WORKFLOW_RETRY_ATTEMPTS=3

# Icebreaker Configuration
ICEBREAKER_CACHE_TTL_HOURS=24
ICEBREAKER_MIN_LENGTH=20
ICEBREAKER_MAX_LENGTH=150

# Ghosting Detection
GHOSTING_THRESHOLD_HOURS=48
RE_ENGAGEMENT_DELAY_HOURS=72
MAX_RE_ENGAGEMENT_ATTEMPTS=2

# Scheduled Messaging
DAILY_ENGAGEMENT_TIME=09:00
WEEKLY_DIGEST_DAY=monday
WEEKLY_DIGEST_TIME=10:00
MATCH_WARMUP_SEQUENCE_ENABLED=true
MATCH_WARMUP_INTERVALS=1h,6h,24h,72h

# Rate Limiting
AUTOMATION_RATE_LIMIT_PER_USER_DAILY=10
SCHEDULED_MESSAGE_RATE_LIMIT_PER_USER_DAILY=5
AI_REQUEST_RATE_LIMIT_PER_USER_HOURLY=20

# Job Queue Configuration (Bull)
BULL_JOB_ATTEMPTS=3
BULL_JOB_BACKOFF_DELAY_MS=5000
BULL_JOB_REMOVE_ON_COMPLETE=true
BULL_JOB_REMOVE_ON_FAIL=false

# Logging
LOG_LEVEL=info

# Health Check
HEALTH_CHECK_INTERVAL_MS=30000

# Feature Flags
ENABLE_AI_REPLY_ASSISTANT=true
ENABLE_CONTEXT_AWARE_SUGGESTIONS=true
ENABLE_SENTIMENT_ANALYSIS=true
ENABLE_ENGAGEMENT_SCORING=true

# Analytics Integration
TRACK_AUTOMATION_EVENTS=true
ANALYTICS_SERVICE_URL=http://localhost:3007
