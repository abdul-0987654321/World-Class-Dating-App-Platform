{
  "name": "@flamoral/notification-service",
  "version": "1.0.0",
  "description": "Multi-channel notification service (push, email, SMS)",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit",
    "lint": "eslint src tests --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "express": "^4.18.2",
    "dotenv": "^16.3.1",
    "@sendgrid/mail": "^8.1.0",
    "twilio": "^4.19.3",
    "firebase-admin": "^12.0.0",
    "@parse/node-apn": "^6.0.1",
    "winston": "^3.11.0",
    "bull": "^4.12.0",
    "redis": "^4.6.11",
    "ioredis": "^5.3.2",
    "knex": "^3.1.0",
    "pg": "^8.11.3",
    "cors": "^2.8.5",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/jest": "^29.5.11",
    "@types/bull": "^4.10.0",
    "@types/cors": "^2.8.17",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
