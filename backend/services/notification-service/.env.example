# Server Configuration
NODE_ENV=development
PORT=3008

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_notifications
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SendGrid Configuration (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@flamoral.com
EMAIL_FROM_NAME=Flamoral

# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Firebase Configuration (Push Notifications - Android/Web)
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# OR use environment variable with JSON string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Apple Push Notification Service (APNs - iOS)
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
# OR use base64 encoded key:
# APNS_KEY=base64-encoded-key-content
APNS_BUNDLE_ID=com.flamoral.app

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production

# Notification Settings
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=60000
NOTIFICATION_BATCH_SIZE=50
NOTIFICATION_CLEANUP_DAYS=90

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Queue Mode
EMAIL_QUEUE_MODE=true
SMS_QUEUE_MODE=true
