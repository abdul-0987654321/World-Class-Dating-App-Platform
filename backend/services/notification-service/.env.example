# ============================================================================
# NOTIFICATION SERVICE - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=notification-service
NODE_ENV=development
PORT=3006

# JWT Configuration (REQUIRED)
JWT_ACCESS_SECRET=your-jwt-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# Internal Service Authentication (REQUIRED)
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# Database (PostgreSQL) - for notification tracking and preferences
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_notifications
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis (REQUIRED for notification queue and Bull)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=4

# SendGrid Email Configuration (REQUIRED for email notifications)
# Get API key from: https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=noreply@flamoral.com
FROM_NAME=Flamoral
SUPPORT_EMAIL=support@flamoral.com

# Twilio SMS Configuration (REQUIRED for SMS notifications)
# Get credentials from: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Firebase Push Notifications (REQUIRED for mobile push notifications)
# Download service account JSON from: Firebase Console → Project Settings → Service Accounts
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour-private-key-here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# Or use service account file path:
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# Apple Push Notification Service (APNs) - for iOS
APNS_KEY_ID=your_apns_key_id
APNS_TEAM_ID=your_apple_team_id
APNS_BUNDLE_ID=com.flamoral.app
APNS_PRODUCTION=false

# Service URLs (REQUIRED)
USER_SERVICE_URL=http://localhost:3001

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Notification Settings
EMAIL_ENABLED=true
SMS_ENABLED=true
PUSH_ENABLED=true
BATCH_SIZE=100
NOTIFICATION_RETENTION_DAYS=90

# Email Templates
EMAIL_TEMPLATE_DIR=./src/templates/email
USE_SENDGRID_TEMPLATES=false

# Logging
LOG_LEVEL=info

# Queue Configuration
WORKER_CONCURRENCY=5
RETRY_ATTEMPTS=3
RETRY_DELAY_MS=5000
QUEUE_REMOVE_ON_COMPLETE=true
QUEUE_REMOVE_ON_FAIL=false

# Rate Limiting (per user)
MAX_EMAILS_PER_HOUR=10
MAX_SMS_PER_HOUR=5
MAX_PUSH_PER_HOUR=50
