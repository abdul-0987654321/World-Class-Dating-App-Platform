# Server Configuration
NODE_ENV=development
PORT=3008

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_notifications
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# SendGrid Configuration (Email)
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@flamoral.com
EMAIL_FROM_NAME=Flamoral

# Twilio Configuration (SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_FROM_NUMBER=+1234567890

# Firebase Configuration (Push Notifications - Android/Web)
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/firebase-service-account.json
# OR use environment variable with JSON string:
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# FCM Configuration
FCM_ENABLED=true
FCM_SERVER_KEY=your-fcm-server-key
FCM_SENDER_ID=your-sender-id

# Apple Push Notification Service (APNs - iOS)
APNS_ENABLED=true
APNS_PRODUCTION=false
APNS_KEY_ID=your-apns-key-id
APNS_TEAM_ID=your-apple-team-id
APNS_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
APNS_BUNDLE_ID=com.flamoral.app
# Certificate Authentication (Legacy)
# APNS_CERT_PATH=/path/to/apns-cert.pem
# APNS_CERT_KEY_PATH=/path/to/apns-key.pem

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-change-in-production

# Notification Settings
DEFAULT_NOTIFICATION_LANGUAGE=en
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_DELAY=60000
NOTIFICATION_BATCH_SIZE=500
NOTIFICATION_CLEANUP_DAYS=90

# Quiet Hours
DEFAULT_QUIET_HOURS_START=22:00
DEFAULT_QUIET_HOURS_END=08:00
DEFAULT_TIMEZONE=UTC

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# Queue Mode
EMAIL_QUEUE_MODE=true
SMS_QUEUE_MODE=true
