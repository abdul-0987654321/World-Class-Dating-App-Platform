# Test Environment Configuration
# Copy this file to .env.test and update the values as needed

# Environment
NODE_ENV=test

# Test Database Configuration
DATABASE_URL=postgresql://test:test@localhost:5432/connectsphere_test

DB_HOST=localhost
DB_PORT=5432
DB_NAME=connectsphere_test
DB_USER=test
DB_PASSWORD=test
DB_POOL_MIN=0
DB_POOL_MAX=5
DB_SSL=false

# JWT Secrets (use different secrets for testing)
JWT_ACCESS_SECRET=test-access-secret-key-change-this-in-production
JWT_REFRESH_SECRET=test-refresh-secret-key-change-this-in-production
JWT_ACCESS_EXPIRY=1h
JWT_REFRESH_EXPIRY=7d

# Redis Configuration (for testing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=1

# Email Configuration (use test credentials or mocks)
SENDGRID_API_KEY=test-sendgrid-key
SENDGRID_FROM_EMAIL=test@connectsphere.com
SENDGRID_FROM_NAME=ConnectSphere Test

# Azure Storage (use test storage or local emulator)
AZURE_STORAGE_CONNECTION_STRING=test-connection-string
AZURE_STORAGE_CONTAINER_NAME=test-container

# Stripe (use test mode keys)
STRIPE_SECRET_KEY=sk_test_your_test_key_here
STRIPE_WEBHOOK_SECRET=whsec_test_your_webhook_secret_here

# API Configuration
PORT=3001
API_VERSION=v1

# Rate Limiting (more lenient for tests)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=error
LOG_FORMAT=json

# Test Timeout
TEST_TIMEOUT=10000
