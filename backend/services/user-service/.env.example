# Service Configuration
SERVICE_NAME=user-service
NODE_ENV=development
PORT=3002

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_users
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# Azure Blob Storage (for profile photos)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_BLOB_CONTAINER_NAME=profile-photos

# SendGrid (for email verification)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@flamoral.com
FROM_NAME=Flamoral

# Internal Service Authentication (REQUIRED)
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# Service URLs (REQUIRED)
MODERATION_SERVICE_URL=http://localhost:3008

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Alternative Database URL (can use instead of individual DB_* vars)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_users

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5
