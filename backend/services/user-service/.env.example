# Service Configuration
SERVICE_NAME=user-service
NODE_ENV=development
PORT=3002

# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral_users
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here
JWT_ACCESS_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=30d

# Azure Blob Storage (for profile photos)
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_ACCOUNT_KEY=your_storage_key
AZURE_BLOB_CONTAINER_NAME=profile-photos

# SendGrid (for email verification)
SENDGRID_API_KEY=your_sendgrid_api_key
FROM_EMAIL=noreply@flamoral.com
FROM_NAME=Flamoral

# Internal Service Authentication (REQUIRED)
SERVICE_API_KEY=your-internal-service-api-key-min-32-chars

# Service URLs (REQUIRED)
MODERATION_SERVICE_URL=http://localhost:3012

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000

# Alternative Database URL (can use instead of individual DB_* vars)
# DATABASE_URL=postgresql://postgres:password@localhost:5432/flamoral_users

# Logging
LOG_LEVEL=info

# Security
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8

# TOTP/2FA Encryption (REQUIRED for production)
# Generate master key: openssl rand -base64 48
TOTP_ENCRYPTION_MASTER_KEY=your-totp-encryption-master-key-min-32-chars-use-openssl-rand-base64-48
# Generate salt: openssl rand -base64 48
TOTP_ENCRYPTION_KEY_SALT=your-totp-encryption-salt-min-32-chars-use-openssl-rand-base64-48
# Key version for rotation support
TOTP_ENCRYPTION_KEY_VERSION=1

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=5

# ===========================================
# ID Verification Provider Configuration
# ===========================================
# Provider selection: 'jumio' | 'onfido' | 'mock'
# Use 'mock' for development/testing without external API calls
VERIFICATION_PROVIDER=mock

# Service Base URL (used for webhook callbacks)
SERVICE_BASE_URL=http://localhost:3002

# Jumio Configuration (Primary Provider)
# Sign up at: https://www.jumio.com/
JUMIO_API_KEY=your_jumio_api_key
JUMIO_API_SECRET=your_jumio_api_secret
JUMIO_BASE_URL=https://api.jumio.com
JUMIO_WORKFLOW_ID=10011
JUMIO_CALLBACK_URL=http://localhost:3002/api/v1/verification/id/webhook/jumio

# Onfido Configuration (Fallback Provider)
# Sign up at: https://onfido.com/
ONFIDO_API_TOKEN=your_onfido_api_token
ONFIDO_BASE_URL=https://api.onfido.com
ONFIDO_WEBHOOK_TOKEN=your_onfido_webhook_token
ONFIDO_WORKFLOW_ID=flamoral_id_verification

# Mock Provider Configuration (Development/Testing)
MOCK_VERIFICATION_DELAY_MS=3000
MOCK_VERIFICATION_SIMULATE_ERRORS=false

# Verification Settings
VERIFICATION_EXPIRATION_HOURS=72
VERIFICATION_MAX_RETRIES=3
VERIFICATION_REQUIRE_BIOMETRIC_CONSENT=false

# ===========================================
# Date Planning / Venue Integration
# ===========================================
# Google Places API Configuration
# Sign up at: https://console.cloud.google.com/apis/credentials
# Enable: Places API, Maps JavaScript API
GOOGLE_PLACES_API_KEY=your_google_places_api_key
GOOGLE_PLACES_BASE_URL=https://maps.googleapis.com/maps/api/place

# Yelp Fusion API Configuration (Optional, used as fallback)
# Sign up at: https://www.yelp.com/developers
YELP_API_KEY=your_yelp_api_key
YELP_BASE_URL=https://api.yelp.com/v3

# Venue Search Defaults
VENUE_SEARCH_RADIUS=5000
VENUE_MAX_RESULTS=20
