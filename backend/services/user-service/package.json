{
  "name": "@flamoral/user-service",
  "version": "1.0.0",
  "description": "User authentication and profile management service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=__tests__/unit",
    "test:integration": "jest --testPathPattern=__tests__/integration",
    "test:e2e": "jest --testPathPattern=__tests__/e2e --runInBand",
    "test:coverage": "jest --coverage --collectCoverageFrom='src/**/*.ts'",
    "lint": "eslint src ",
    "lint:fix": "eslint src ",
    "migrate": "knex migrate:latest --knexfile src/infrastructure/database/knexfile.ts",
    "migrate:rollback": "knex migrate:rollback --knexfile src/infrastructure/database/knexfile.ts",
    "migrate:test": "NODE_ENV=test knex migrate:latest --knexfile src/infrastructure/database/knexfile.ts",
    "seed": "knex seed:run --knexfile src/infrastructure/database/knexfile.ts",
    "seed:test": "NODE_ENV=test knex seed:run --knexfile src/infrastructure/database/knexfile.ts",
    "rotate-key": "ts-node src/scripts/rotate-encryption-key.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@flamoral/backend-shared": "file:../../shared",
    "@nestjs/common": "^10.3.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "reflect-metadata": "^0.2.1",
    "@sendgrid/mail": "^8.1.0",
    "@types/socket.io": "^3.0.1",
    "agora-access-token": "^2.0.4",
    "archiver": "^7.0.1",
    "axios": "^1.7.9",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "crypto": "^1.0.1",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.1.5",
    "express-validator": "^7.0.1",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jose": "^6.1.3",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "knex": "^3.1.0",
    "multer": "^1.4.5-lts.2",
    "nodemailer": "^7.0.12",
    "pg": "^8.11.3",
    "redis": "^5.0.0",
    "sharp": "^0.33.5",
    "socket.io": "^4.8.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^5.0.0",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "@aws-sdk/client-rekognition": "^3.679.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "rxjs": "^7.8.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.5",
    "@types/nodemailer": "^6.4.14",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
