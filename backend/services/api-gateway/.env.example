# ============================================================================
# API GATEWAY - Environment Variables
# ============================================================================

# Service Configuration
SERVICE_NAME=api-gateway
NODE_ENV=development
PORT=4000

# CORS Configuration
# SECURITY: In production, only allow specific origins (no wildcards!)
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://staging.flamoral.com,https://clerk.flamoral.com
CORS_CREDENTIALS=true

# ============================================================================
# Microservices URLs (Railway private networking)
# These are auto-configured via railway.json — only override for local dev
# ============================================================================
# AUTH_SERVICE_URL — set by Railway: http://${{auth-service.RAILWAY_PRIVATE_DOMAIN}}:3001
# USER_SERVICE_URL — set by Railway: http://${{user-service.RAILWAY_PRIVATE_DOMAIN}}:3002
# MATCHING_SERVICE_URL — set by Railway: http://${{matching-service.RAILWAY_PRIVATE_DOMAIN}}:3004
# MESSAGING_SERVICE_URL — set by Railway: http://${{messaging-service.RAILWAY_PRIVATE_DOMAIN}}:3005
# MEDIA_SERVICE_URL — set by Railway: http://${{media-service.RAILWAY_PRIVATE_DOMAIN}}:3009
# PAYMENT_SERVICE_URL — set by Railway: http://${{payment-service.RAILWAY_PRIVATE_DOMAIN}}:3007
# NOTIFICATION_SERVICE_URL — set by Railway: http://${{notification-service.RAILWAY_PRIVATE_DOMAIN}}:3006
# MODERATION_SERVICE_URL — set by Railway: http://${{moderation-service.RAILWAY_PRIVATE_DOMAIN}}:3010
# ANALYTICS_SERVICE_URL — set by Railway: http://${{analytics-service.RAILWAY_PRIVATE_DOMAIN}}:3011

# Internal Service Authentication
INTERNAL_SERVICE_KEY=your-internal-service-key-change-in-production

# ============================================================================
# Redis Configuration (Rate Limiting & Caching)
# Railway injects REDIS_URL automatically from the Redis plugin
# ============================================================================
# REDIS_URL — set by Railway plugin

# ============================================================================
# Clerk Authentication (Primary)
# ============================================================================
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
CLERK_DOMAIN=https://clerk.flamoral.com
CLERK_JWKS_URL=https://clerk.flamoral.com/.well-known/jwks.json

# ============================================================================
# JWT Authentication
# ============================================================================
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ACCESS_SECRET=your-jwt-access-secret-change-in-production
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRY=24h
JWT_REFRESH_TOKEN_EXPIRY=30d

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Global throttle settings
THROTTLE_TTL=60000
THROTTLE_LIMIT=100

# Per-user rate limits
RATE_LIMIT_USER_POINTS=1000
RATE_LIMIT_USER_DURATION=900
RATE_LIMIT_USER_BLOCK=300

# Per-IP rate limits
RATE_LIMIT_IP_POINTS=500
RATE_LIMIT_IP_DURATION=900
RATE_LIMIT_IP_BLOCK=600

# Auth endpoint rate limits (stricter)
RATE_LIMIT_AUTH_POINTS=5
RATE_LIMIT_AUTH_DURATION=900
RATE_LIMIT_AUTH_BLOCK=3600

# ============================================================================
# Circuit Breaker Configuration
# ============================================================================
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_SUCCESS_THRESHOLD=2
CIRCUIT_TIMEOUT=60000
CIRCUIT_RESET_TIMEOUT=300000

# ============================================================================
# Service Timeouts (in milliseconds)
# ============================================================================
SERVICE_TIMEOUT_DEFAULT=30000
SERVICE_TIMEOUT_AUTH=10000
SERVICE_TIMEOUT_MEDIA=60000
SERVICE_TIMEOUT_PAYMENT=45000

# ============================================================================
# Distributed Tracing
# ============================================================================
TRACING_ENABLED=false
TRACING_SERVICE_NAME=api-gateway
JAEGER_ENDPOINT=http://localhost:14268/api/traces
TRACING_SAMPLING_RATE=0.1

# ============================================================================
# Metrics & Monitoring
# ============================================================================
METRICS_ENABLED=false
METRICS_PORT=9090

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_LEVEL=info
LOG_FORMAT=json

# ============================================================================
# GraphQL Configuration
# ============================================================================
GRAPHQL_PLAYGROUND=true
GRAPHQL_INTROSPECTION=true

# ============================================================================
# Security Headers
# ============================================================================
ENABLE_HELMET=true
ENABLE_CSRF_PROTECTION=false

# Content Security Policy
CSP_REPORT_URI=/api/v1/security/csp-report
API_DOMAIN=https://api.flamoral.com

# ============================================================================
# Performance
# ============================================================================
REQUEST_TIMEOUT_MS=30000
MAX_REQUEST_SIZE=10mb
COMPRESSION_ENABLED=true

# ============================================================================
# DDoS Protection
# ============================================================================
# Whitelisted IPs (comma-separated, bypass DDoS protection)
RATE_LIMIT_WHITELIST=127.0.0.1,::1

# Admin Override Secret (for bypassing rate limits in emergencies)
ADMIN_OVERRIDE_SECRET=your-admin-override-secret-change-in-production
