# ============================================
# Development Dockerfile for Backend
# Hot-reload with nodemon
# ============================================

FROM node:20-alpine

WORKDIR /app

# Install dependencies
COPY package*.json ./
RUN npm install

# Copy source code
COPY . .

# Expose ports
EXPOSE 3000 4000 5000

# Development command with hot-reload
CMD ["npm", "run", "dev"]
