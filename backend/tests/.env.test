# Test Database Configuration
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=flamoral_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# Test Redis Configuration
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6379
TEST_REDIS_DB=1

# JWT Secrets (Use different secrets for testing)
JWT_ACCESS_SECRET=test_access_secret_key_for_flamoral_testing
JWT_REFRESH_SECRET=test_refresh_secret_key_for_flamoral_testing

# Service URLs (for integration tests)
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3003
MESSAGING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3006

# Email (use test mode)
EMAIL_PROVIDER=test
SENDGRID_API_KEY=test_key

# SMS (use test mode)
TWILIO_ACCOUNT_SID=test_sid
TWILIO_AUTH_TOKEN=test_token
TWILIO_PHONE_NUMBER=+15555555555

# Stripe (use test keys)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_test_XXXXXXXXXXXX

# Storage (use local for tests)
STORAGE_PROVIDER=local
STORAGE_PATH=/tmp/flamoral-test-uploads

# Feature Flags
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PHONE_VERIFICATION=false
ENABLE_RATE_LIMITING=false
