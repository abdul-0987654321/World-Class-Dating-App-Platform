# Integration Test Environment Configuration
# Copy this file to .env.test and update values as needed

# ==================== Test Execution Mode ====================

# Use Docker Compose for test dependencies (default: true)
USE_DOCKER_COMPOSE=true

# Use Testcontainers for isolated test containers (default: false)
# Set to true if you want automatic container management per test suite
USE_TESTCONTAINERS=false

# ==================== Database Configuration ====================

# PostgreSQL Test Database
TEST_DB_HOST=localhost
TEST_DB_PORT=5433
TEST_DB_NAME=flamoral_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=test_password

# MongoDB Test Database
TEST_MONGO_HOST=localhost
TEST_MONGO_PORT=27018
TEST_MONGO_DB=flamoral_test

# ==================== Cache Configuration ====================

# Redis Test Cache
TEST_REDIS_HOST=localhost
TEST_REDIS_PORT=6380
TEST_REDIS_DB=1

# ==================== Message Queue Configuration ====================

# RabbitMQ Test Queue
TEST_RABBITMQ_HOST=localhost
TEST_RABBITMQ_PORT=5673
TEST_RABBITMQ_MANAGEMENT_PORT=15673
TEST_RABBITMQ_USER=test
TEST_RABBITMQ_PASSWORD=test

# ==================== Search Configuration ====================

# Elasticsearch Test Instance
TEST_ELASTICSEARCH_HOST=localhost
TEST_ELASTICSEARCH_PORT=9201

# ==================== Storage Configuration ====================

# MinIO Test Storage (S3-compatible)
TEST_MINIO_ENDPOINT=localhost
TEST_MINIO_PORT=9000
TEST_MINIO_ACCESS_KEY=minioadmin
TEST_MINIO_SECRET_KEY=minioadmin
TEST_MINIO_BUCKET=test-uploads

# ==================== Service URLs ====================

# Backend Services
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3003
MESSAGING_SERVICE_URL=http://localhost:3004
PAYMENT_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3006
NOTIFICATION_SERVICE_URL=http://localhost:3007
ANALYTICS_SERVICE_URL=http://localhost:3008
MODERATION_SERVICE_URL=http://localhost:3009

# API Gateway
API_GATEWAY_URL=http://localhost:4000

# ==================== Authentication ====================

# JWT Secrets (test values only)
JWT_SECRET=test_jwt_secret_key_for_flamoral_integration_tests_min_32_chars
JWT_ACCESS_SECRET=test_access_secret_key_for_flamoral_testing_min_32_chars
JWT_REFRESH_SECRET=test_refresh_secret_key_for_flamoral_testing_min_32_chars

# Token Expiration
JWT_ACCESS_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# ==================== External Services (Test Mode) ====================

# Email Service (Mailhog for testing)
EMAIL_PROVIDER=mailhog
MAILHOG_HOST=localhost
MAILHOG_SMTP_PORT=1025
MAILHOG_WEB_PORT=8025

# SendGrid (test mode)
SENDGRID_API_KEY=SG.test_key_for_testing
SENDGRID_FROM_EMAIL=test@flamoral.test

# SMS Service (Twilio test mode)
TWILIO_ACCOUNT_SID=test_account_sid
TWILIO_AUTH_TOKEN=test_auth_token
TWILIO_PHONE_NUMBER=+15555555555
TWILIO_TEST_MODE=true

# Payment Service (Stripe test mode)
STRIPE_SECRET_KEY=sk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXXXXXXXXXXXXXXXXXX
STRIPE_WEBHOOK_SECRET=whsec_test_XXXXXXXXXXXX
STRIPE_TEST_MODE=true

# ==================== Feature Flags ====================

# Enable/disable features for testing
ENABLE_EMAIL_VERIFICATION=false
ENABLE_PHONE_VERIFICATION=false
ENABLE_RATE_LIMITING=false
ENABLE_ENCRYPTION=false
ENABLE_ANALYTICS=false

# ==================== Test Configuration ====================

# Test Environment
NODE_ENV=test

# Logging
LOG_LEVEL=error
LOG_TO_FILE=false

# Test Data
SEED_TEST_DATA=false
CLEANUP_AFTER_TESTS=true

# Performance
MAX_CONCURRENT_REQUESTS=100
REQUEST_TIMEOUT=30000

# ==================== Optional Services ====================

# Video Calling (Agora - test mode)
AGORA_APP_ID=test_app_id
AGORA_APP_CERTIFICATE=test_certificate

# Push Notifications (test mode)
FCM_SERVER_KEY=test_fcm_key
APNS_KEY_ID=test_apns_key
APNS_TEAM_ID=test_team_id

# Content Moderation (Azure - test mode)
AZURE_CONTENT_MODERATOR_KEY=test_key
AZURE_CONTENT_MODERATOR_ENDPOINT=https://test.cognitiveservices.azure.com/

# ==================== CI/CD Configuration ====================

# CI Environment Detection
CI=false

# Test Execution
RUN_INTEGRATION_TESTS=true
RUN_E2E_TESTS=true
RUN_LOAD_TESTS=false

# Coverage Requirements
COVERAGE_THRESHOLD=70

# Test Retries
TEST_RETRY_COUNT=2
FLAKY_TEST_RETRIES=3
