# Backend Configuration (Railway + Vercel + Clerk + Stripe)
NODE_ENV=production

# =============================================================================
# Service URLs (Railway private networking)
# In Railway, use internal service DNS: http://<service>.railway.internal:<port>
# These env vars are auto-configured via railway.json service variables
# =============================================================================
# API_GATEWAY_URL — set automatically by Railway
# AUTH_SERVICE_URL — set automatically by Railway
# USER_SERVICE_URL — set automatically by Railway
# (All service URLs are injected via Railway private networking)

# =============================================================================
# PostgreSQL (Railway-managed)
# =============================================================================
# Railway injects DATABASE_URL automatically from the Postgres plugin
DATABASE_URL=${{Postgres.DATABASE_URL}}
DB_POOL_MIN=2
DB_POOL_MAX=10

# =============================================================================
# MongoDB (if needed — add Railway MongoDB plugin)
# =============================================================================
# MONGODB_URI — set via Railway plugin
MONGODB_DB=flamoral

# =============================================================================
# Redis (Railway-managed)
# =============================================================================
# Railway injects REDIS_URL automatically from the Redis plugin
REDIS_URL=${{redis.REDIS_URL}}

# =============================================================================
# AWS SQS Queue Configuration
# =============================================================================
USE_AWS_SQS=true
AWS_SQS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
AWS_SQS_QUEUE_PREFIX=flamoral

# =============================================================================
# Clerk Authentication (Primary)
# =============================================================================
# Get these from https://dashboard.clerk.com
CLERK_SECRET_KEY=your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key
CLERK_WEBHOOK_SECRET=your_clerk_webhook_secret
CLERK_DOMAIN=https://clerk.flamoral.com
CLERK_JWKS_URL=https://clerk.flamoral.com/.well-known/jwks.json

# =============================================================================
# JWT Configuration - MUST BE CONSISTENT ACROSS ALL SERVICES
# =============================================================================
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service-to-service authentication
SERVICE_API_KEY=your-service-api-key-min-32-chars
INTERNAL_SERVICE_KEY=your-internal-service-key-min-32-chars

# Encryption keys
ENCRYPTION_KEY=your-32-char-encryption-key-here
TOTP_ENCRYPTION_KEY=your-32-char-totp-key-here

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS S3 Storage
AWS_S3_BUCKET_MEDIA=flamoral-media
AWS_S3_BUCKET_PHOTOS=flamoral-photos
AWS_S3_BUCKET_VIDEOS=flamoral-videos

# AWS Rekognition (Face Detection & Content Moderation)
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=flamoral-faces

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# =============================================================================
# AWS SES Email (replaces SendGrid)
# =============================================================================
AWS_SES_REGION=us-east-1
EMAIL_FROM=noreply@flamoral.com
EMAIL_FROM_NAME=Flamoral
AWS_SES_CONFIGURATION_SET=flamoral-emails

# =============================================================================
# AWS SNS SMS & Push (replaces Twilio/Firebase)
# =============================================================================
AWS_SNS_REGION=us-east-1
AWS_SNS_SENDER_ID=Flamoral
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:us-east-1:YOUR_ACCOUNT:app/GCM/flamoral-android
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:us-east-1:YOUR_ACCOUNT:app/APNS/flamoral-ios

# =============================================================================
# Stripe Payments
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Video/WebRTC (Agora)
# =============================================================================
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_cert

# =============================================================================
# Monitoring & Logging
# =============================================================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=https://flamoral.com,https://www.flamoral.com,https://app.flamoral.com,https://staging.flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Feature Flags
# =============================================================================
# Core Features
ENABLE_VIDEO_CALLS=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_AI_MATCHING=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EVENTS=true

# Authentication Features
ENABLE_2FA=true
ENABLE_OAUTH=true
ENABLE_SMS_VERIFICATION=true

# Moderation Features
ENABLE_USER_APPEALS=true
ENABLE_AUTO_SANCTIONS=true
ENABLE_REAL_TIME_MODERATION=true

# Development Features (set to false in production)
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_API_DOCS=false
ENABLE_DEBUG_LOGGING=false

# Circuit Breaker (recommended for production)
ENABLE_CIRCUIT_BREAKER=true
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
