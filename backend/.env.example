# Backend Configuration (AWS)
NODE_ENV=production
PORT=3000
GRAPHQL_PORT=4000
WS_PORT=5000

# PostgreSQL (Aurora PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=flamoral
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# MongoDB (DocumentDB)
MONGODB_URI=mongodb://mongodb:27017/flamoral
MONGODB_DB=flamoral

# Redis (ElastiCache)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# RabbitMQ (or AWS SQS)
RABBITMQ_URL=amqp://rabbitmq:5672
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue

# JWT
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS S3 Storage
AWS_S3_BUCKET_MEDIA=flamoral-media
AWS_S3_BUCKET_PHOTOS=flamoral-photos
AWS_S3_BUCKET_VIDEOS=flamoral-videos

# AWS Rekognition (Face Detection)
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=flamoral-faces

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Stripe
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Twilio (or AWS SNS)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxx

# SendGrid (or AWS SES)
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@flamoral.com
SENDGRID_FROM_NAME=Flamoral

# Agora
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_cert

# Sentry
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=production

# CORS
CORS_ORIGIN=http://localhost,https://flamoral.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=false
LOG_FILE_PATH=/var/log/flamoral
