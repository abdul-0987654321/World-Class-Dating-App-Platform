# Backend Configuration (AWS-Only Platform)
NODE_ENV=development
# In production, set NODE_ENV=production

# =============================================================================
# Service URLs (Per README.md Port Mapping)
# =============================================================================
API_GATEWAY_URL=http://localhost:4000
AUTH_SERVICE_URL=http://localhost:3001
USER_SERVICE_URL=http://localhost:3002
MATCHING_SERVICE_URL=http://localhost:3003
MESSAGING_SERVICE_URL=http://localhost:5000
PAYMENT_SERVICE_URL=http://localhost:3005
ANALYTICS_SERVICE_URL=http://localhost:3007
NOTIFICATION_SERVICE_URL=http://localhost:3008
MEDIA_SERVICE_URL=http://localhost:3009
ADMIN_SERVICE_URL=http://localhost:3010
ADVERTISING_SERVICE_URL=http://localhost:3011
MODERATION_SERVICE_URL=http://localhost:3012
AUTOMATION_SERVICE_URL=http://localhost:3013
PARTNERSHIP_SERVICE_URL=http://localhost:3014

# =============================================================================
# PostgreSQL (Aurora PostgreSQL on AWS)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=flamoral
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_POOL_MIN=2
DB_POOL_MAX=10
DATABASE_URL=postgresql://postgres:your_postgres_password@localhost:5432/flamoral

# =============================================================================
# MongoDB (DocumentDB on AWS)
# =============================================================================
MONGODB_URI=mongodb://localhost:27017/flamoral
MONGODB_DB=flamoral

# =============================================================================
# Redis (ElastiCache on AWS)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379

# =============================================================================
# AWS SQS Queue Configuration (replaces RabbitMQ)
# =============================================================================
USE_AWS_SQS=true
AWS_SQS_REGION=us-east-1
AWS_ACCOUNT_ID=your_aws_account_id
AWS_SQS_QUEUE_PREFIX=flamoral
QUEUE_MATCHING=flamoral-matching
QUEUE_NOTIFICATIONS=flamoral-notifications
QUEUE_ANALYTICS=flamoral-analytics
QUEUE_MODERATION=flamoral-moderation

# =============================================================================
# Okta Authentication
# =============================================================================
OKTA_CLIENT_ID=your_okta_client_id
OKTA_CLIENT_SECRET=your_okta_client_secret
OKTA_DOMAIN=your-domain.okta.com
OKTA_ISSUER=https://your-domain.okta.com/oauth2/default
OKTA_AUDIENCE=api://default
OKTA_WEBHOOK_SECRET=your_okta_webhook_secret

# =============================================================================
# JWT Configuration - MUST BE CONSISTENT ACROSS ALL SERVICES
# =============================================================================
JWT_SECRET=your-jwt-secret-change-this-in-production
JWT_ACCESS_SECRET=your_jwt_access_secret_min_64_chars
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_64_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Service-to-service authentication
SERVICE_API_KEY=your-service-api-key-min-32-chars
INTERNAL_SERVICE_KEY=your-internal-service-key-min-32-chars

# Encryption keys
ENCRYPTION_KEY=your-32-char-encryption-key-here
TOTP_ENCRYPTION_KEY=your-32-char-totp-key-here

# =============================================================================
# AWS Configuration
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# AWS S3 Storage
AWS_S3_BUCKET_MEDIA=flamoral-media
AWS_S3_BUCKET_PHOTOS=flamoral-photos
AWS_S3_BUCKET_VIDEOS=flamoral-videos

# AWS Rekognition (Face Detection & Content Moderation)
AWS_REKOGNITION_REGION=us-east-1
AWS_REKOGNITION_COLLECTION_ID=flamoral-faces

# AWS Cognito
COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_REGION=us-east-1

# =============================================================================
# AWS SES Email (replaces SendGrid)
# =============================================================================
AWS_SES_REGION=us-east-1
EMAIL_FROM=noreply@flamoral.com
EMAIL_FROM_NAME=Flamoral
AWS_SES_CONFIGURATION_SET=flamoral-emails

# =============================================================================
# AWS SNS SMS & Push (replaces Twilio/Firebase)
# =============================================================================
AWS_SNS_REGION=us-east-1
AWS_SNS_SENDER_ID=Flamoral
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:us-east-1:YOUR_ACCOUNT:app/GCM/flamoral-android
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:us-east-1:YOUR_ACCOUNT:app/APNS/flamoral-ios

# =============================================================================
# Stripe Payments
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# Video/WebRTC (Agora)
# =============================================================================
AGORA_APP_ID=your_agora_app_id
AGORA_APP_CERTIFICATE=your_agora_cert

# =============================================================================
# Monitoring & Logging
# =============================================================================
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
SENTRY_ENVIRONMENT=development
LOG_LEVEL=info
LOG_FORMAT=json

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGINS=http://localhost:5173,http://localhost:4000,https://flamoral.com
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =============================================================================
# Feature Flags
# =============================================================================
# Core Features
ENABLE_VIDEO_CALLS=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_AI_MATCHING=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_EVENTS=true

# Authentication Features
ENABLE_2FA=true
ENABLE_OAUTH=true
ENABLE_SMS_VERIFICATION=true

# Moderation Features
ENABLE_USER_APPEALS=true
ENABLE_AUTO_SANCTIONS=true
ENABLE_REAL_TIME_MODERATION=true

# Development Features (set to false in production)
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_API_DOCS=false
ENABLE_DEBUG_LOGGING=false

# Circuit Breaker (recommended for production)
ENABLE_CIRCUIT_BREAKER=true
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
