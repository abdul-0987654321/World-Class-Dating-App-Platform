# =============================================================================
# Flamoral Web App - Development Environment
# =============================================================================

# API Configuration
# Points to the API Gateway (port 4000) per README.md port mapping
VITE_API_URL=http://localhost:4000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:4000

# Socket.IO for messaging service (port 5000)
VITE_SOCKET_URL=ws://localhost:5000

# GraphQL Configuration
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# App Configuration
VITE_APP_NAME=Flamoral
VITE_APP_ENV=development

# =============================================================================
# Feature Flags
# =============================================================================
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# =============================================================================
# Development-Only Flags
# =============================================================================
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true
