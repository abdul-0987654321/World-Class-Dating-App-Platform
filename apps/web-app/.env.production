# =============================================================================
# Flamoral Web App - Production Environment
# =============================================================================
# SECURITY WARNING: Do NOT commit real secrets to this file!
# All sensitive values should be injected via CI/CD from AWS Secrets Manager
# =============================================================================

# API Configuration
# Using relative URLs - Vercel rewrites proxy to Railway backend
# This avoids CORS issues and cookie sameSite problems
VITE_API_URL=
VITE_WS_URL=wss://api-gateway-production-1957.up.railway.app
VITE_SOCKET_URL=wss://api-gateway-production-1957.up.railway.app
VITE_GRAPHQL_URL=/graphql

# CDN & Media
VITE_CDN_URL=https://cdn.flamoral.com
VITE_MEDIA_URL=https://media.flamoral.com

# App Configuration
VITE_APP_NAME=Flamoral
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0
VITE_APP_DOMAIN=flamoral.com

# =============================================================================
# External Services - INJECTED VIA CI/CD
# =============================================================================

# Stripe (publishable key is safe to expose in frontend code)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_51OcU03KOiN1jQaBRyhHpZdwm0NFDLg736m6CpqaOITU0MrRGk8PQe1VicxPzzRBzuFIE3MJ24xx9zIj3GJBHIq6K00Er5SEKtl

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}

# =============================================================================
# Social Login (OAuth)
# =============================================================================
VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
VITE_FACEBOOK_APP_ID=${VITE_FACEBOOK_APP_ID}
VITE_APPLE_CLIENT_ID=${VITE_APPLE_CLIENT_ID}
VITE_APPLE_REDIRECT_URI=https://flamoral.com/auth/apple/callback

# =============================================================================
# Push Notifications - INJECTED VIA CI/CD
# =============================================================================
VITE_VAPID_PUBLIC_KEY=${VITE_VAPID_PUBLIC_KEY}

# =============================================================================
# Error Tracking & Monitoring
# =============================================================================
VITE_SENTRY_DSN=${VITE_SENTRY_DSN}
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_RELEASE=${VITE_APP_VERSION}

# =============================================================================
# Analytics - INJECTED VIA CI/CD
# =============================================================================
VITE_GA_MEASUREMENT_ID=${VITE_GA_MEASUREMENT_ID}
VITE_GTM_ID=${VITE_GTM_ID}
VITE_GOOGLE_ADS_ID=${VITE_GOOGLE_ADS_ID}

# =============================================================================
# Marketing Pixels - INJECTED VIA CI/CD
# =============================================================================
VITE_META_PIXEL_ID=${VITE_META_PIXEL_ID}
VITE_TIKTOK_PIXEL_ID=${VITE_TIKTOK_PIXEL_ID}
VITE_LINKEDIN_PARTNER_ID=${VITE_LINKEDIN_PARTNER_ID}
VITE_SNAPCHAT_PIXEL_ID=${VITE_SNAPCHAT_PIXEL_ID}
VITE_TWITTER_PIXEL_ID=${VITE_TWITTER_PIXEL_ID}
VITE_PINTEREST_TAG_ID=${VITE_PINTEREST_TAG_ID}
VITE_REDDIT_PIXEL_ID=${VITE_REDDIT_PIXEL_ID}
VITE_MICROSOFT_CLARITY_ID=${VITE_MICROSOFT_CLARITY_ID}

# =============================================================================
# Feature Flags
# =============================================================================
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# =============================================================================
# Production-Only Flags
# =============================================================================
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=false
