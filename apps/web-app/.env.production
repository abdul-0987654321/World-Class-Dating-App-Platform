# =============================================================================
# Flamoral Web App - Production Environment
# =============================================================================
# SECURITY WARNING: Do NOT commit real secrets to this file!
# All sensitive values should be injected via CI/CD from AWS Secrets Manager
# =============================================================================

# API Configuration
VITE_API_URL=https://world-class-dating-app-platform-production.up.railway.app
VITE_WS_URL=wss://world-class-dating-app-platform-production.up.railway.app
VITE_SOCKET_URL=wss://world-class-dating-app-platform-production.up.railway.app

# App Configuration
VITE_APP_NAME=Flamoral
VITE_APP_ENV=production
VITE_APP_VERSION=1.0.0

# =============================================================================
# External Services - INJECTED VIA CI/CD
# =============================================================================
# These values MUST be injected during deployment from AWS Secrets Manager
# DO NOT hardcode production keys here!

# Stripe (publishable key is safe to expose, but should still be managed)
VITE_STRIPE_PUBLISHABLE_KEY=${VITE_STRIPE_PUBLISHABLE_KEY}

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=${VITE_GOOGLE_MAPS_API_KEY}

# =============================================================================
# Social Login (OAuth) - INJECTED VIA CI/CD
# =============================================================================
VITE_GOOGLE_CLIENT_ID=${VITE_GOOGLE_CLIENT_ID}
VITE_FACEBOOK_APP_ID=${VITE_FACEBOOK_APP_ID}
VITE_APPLE_CLIENT_ID=${VITE_APPLE_CLIENT_ID}
VITE_APPLE_REDIRECT_URI=https://flamoral.com/auth/apple/callback

# =============================================================================
# Push Notifications - INJECTED VIA CI/CD
# =============================================================================
VITE_VAPID_PUBLIC_KEY=${VITE_VAPID_PUBLIC_KEY}

# =============================================================================
# Analytics - INJECTED VIA CI/CD
# =============================================================================
VITE_GA_MEASUREMENT_ID=${VITE_GA_MEASUREMENT_ID}

# =============================================================================
# Feature Flags
# =============================================================================
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true
