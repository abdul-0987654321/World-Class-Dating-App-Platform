# =============================================================================
# Flamoral Web App Environment Configuration
# =============================================================================
# Copy this file to .env.local for development
# NEVER commit real secrets to version control!
# =============================================================================

# =============================================================================
# API Configuration
# =============================================================================
# API Gateway URL - matches backend/services/api-gateway default port
VITE_API_URL=http://localhost:4000
# WebSocket URL for real-time features
VITE_WS_URL=ws://localhost:4000
# Socket.IO URL for messaging service
VITE_SOCKET_URL=ws://localhost:5000
# GraphQL endpoint
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# =============================================================================
# App Configuration
# =============================================================================
VITE_APP_NAME=Flamoral
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# =============================================================================
# External Services
# =============================================================================
# Stripe - Use pk_test_* keys for development
# SECURITY: Never commit production keys!
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =============================================================================
# Social Login (OAuth)
# =============================================================================
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_APPLE_CLIENT_ID=your_apple_client_id
VITE_APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback

# =============================================================================
# Push Notifications
# =============================================================================
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# =============================================================================
# Analytics
# =============================================================================
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# =============================================================================
# Feature Flags
# =============================================================================
# Must match feature flags in backend and mobile app
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# =============================================================================
# Development-Only Flags
# =============================================================================
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true
