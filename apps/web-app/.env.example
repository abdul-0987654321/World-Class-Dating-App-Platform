# =============================================================================
# Flamoral Web App Environment Configuration
# =============================================================================
# Copy this file to .env.local for development
# NEVER commit real secrets to version control!
# =============================================================================

# =============================================================================
# API Configuration
# =============================================================================
# API Gateway URL - matches backend/services/api-gateway default port
VITE_API_URL=http://localhost:4000
# WebSocket URL for real-time features
VITE_WS_URL=ws://localhost:4000
# Socket.IO URL for messaging service
VITE_SOCKET_URL=ws://localhost:5000
# GraphQL endpoint
VITE_GRAPHQL_URL=http://localhost:4000/graphql

# =============================================================================
# App Configuration
# =============================================================================
VITE_APP_NAME=Flamoral
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0

# =============================================================================
# External Services
# =============================================================================
# Stripe - Use pk_test_* keys for development
# SECURITY: Never commit production keys!
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Google Maps
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# =============================================================================
# Okta Authentication
# =============================================================================
# Okta client ID (safe to expose in frontend)
VITE_OKTA_CLIENT_ID=your_okta_client_id
# Okta domain (e.g., your-domain.okta.com)
VITE_OKTA_DOMAIN=your-domain.okta.com
# Redirect URI after authentication (must match Okta app configuration)
VITE_OKTA_REDIRECT_URI=http://localhost:5173/login/callback
# Post-logout redirect URI
VITE_OKTA_POST_LOGOUT_REDIRECT_URI=http://localhost:5173

# =============================================================================
# Social Login (OAuth) - Legacy (managed by Clerk now)
# =============================================================================
VITE_GOOGLE_CLIENT_ID=your_google_client_id
VITE_FACEBOOK_APP_ID=your_facebook_app_id
VITE_APPLE_CLIENT_ID=your_apple_client_id
VITE_APPLE_REDIRECT_URI=http://localhost:5173/auth/apple/callback

# =============================================================================
# Push Notifications
# =============================================================================
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key

# =============================================================================
# Analytics & Tracking
# =============================================================================
# Google Analytics 4
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager
VITE_GTM_ID=GTM-XXXXXXX

# Google Ads
VITE_GOOGLE_ADS_ID=AW-XXXXXXXXX
VITE_GOOGLE_ADS_CONVERSION_LABEL=XXXXXXXXXXXXXXXXXXXX

# =============================================================================
# Marketing Pixels
# =============================================================================
# Meta (Facebook) Pixel
VITE_META_PIXEL_ID=XXXXXXXXXXXXXXX
VITE_META_CONVERSION_API_TOKEN=your_meta_conversion_api_token

# TikTok Pixel
VITE_TIKTOK_PIXEL_ID=XXXXXXXXXXXXXXXXXX

# LinkedIn Insight Tag
VITE_LINKEDIN_PARTNER_ID=XXXXXXX

# Snapchat Pixel
VITE_SNAPCHAT_PIXEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Twitter/X Pixel
VITE_TWITTER_PIXEL_ID=XXXXX

# Pinterest Tag
VITE_PINTEREST_TAG_ID=XXXXXXXXXXXXX

# Reddit Pixel
VITE_REDDIT_PIXEL_ID=t2_XXXXXXXX

# Quora Pixel
VITE_QUORA_PIXEL_ID=xxxxxxxxxxxxxxxxxxxxxxxx

# Microsoft Clarity (Heatmaps & Session Recording)
VITE_MICROSOFT_CLARITY_ID=XXXXXXXXXX

# =============================================================================
# SEO & Performance
# =============================================================================
# Google Search Console Verification
VITE_GOOGLE_SITE_VERIFICATION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Bing Webmaster Verification
VITE_BING_SITE_VERIFICATION=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# PageSpeed Insights API Key (optional, for automated audits)
VITE_PAGESPEED_API_KEY=your_pagespeed_api_key

# =============================================================================
# Feature Flags
# =============================================================================
# Must match feature flags in backend and mobile app
VITE_ENABLE_VIDEO_CALLS=true
VITE_ENABLE_EVENTS=true
VITE_ENABLE_AI_FEATURES=true
VITE_ENABLE_PHOTO_VERIFICATION=true
VITE_ENABLE_PUSH_NOTIFICATIONS=true

# =============================================================================
# Development-Only Flags
# =============================================================================
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG=true
