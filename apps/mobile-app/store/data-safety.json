    "dataSharing": {
      "sharesData": true,
      "sharingDetails": {
        "profilePhotos": {
          "sharedWith": "Other app users",
          "purpose": "Core app functionality - matching and discovery",
          "userControlled": true
        },
        "profileVideos": {
          "sharedWith": "Other app users",
          "purpose": "Core app functionality - profile display",
          "userControlled": true
        },
        "messages": {
          "sharedWith": "Matched users only",
          "purpose": "Core app functionality - communication",
          "userControlled": true,
          "endToEndEncrypted": true
        },
        "displayName": {
          "sharedWith": "Other app users",
          "purpose": "Core app functionality - profile identification",
          "userControlled": true
        },
        "approximateLocation": {
          "sharedWith": "Other app users (distance only, not precise location)",
          "purpose": "Core app functionality - location-based matching",
          "userControlled": true
        }
      },
      "noDataSoldNote": "Flamoral does not sell user data to third parties."
    },
    "securityPractices": {
      "dataEncryption": {
        "inTransit": true,
        "atRest": true,
        "endToEndForMessages": true,
        "protocols": ["TLS 1.3", "AES-256"]
      },
      "dataRetention": {
        "policy": "Data retained while account is active",
        "deletionUponRequest": true,
        "deletionTimeframe": "30 days",
        "automatedDeletion": "Inactive accounts deleted after 2 years"
      },
      "accountDeletion": {
        "available": true,
        "method": "In-app settings or email request",
        "dataFullyDeleted": true,
        "timeframe": "Within 30 days of request"
      },
      "securityMeasures": [
        "Regular security audits",
        "Penetration testing",
        "Bug bounty program",
        "SOC 2 Type II compliance",
        "GDPR compliance",
        "CCPA compliance"
      ],
      "independentSecurityReview": {
        "reviewed": true,
        "reviewer": "Third-party security firm",
        "frequency": "Annual"
      }
    },
    "childrenData": {
      "directedToChildren": false,
      "collectsFromChildren": false,
      "ageGate": true,
      "minimumAge": 18,
