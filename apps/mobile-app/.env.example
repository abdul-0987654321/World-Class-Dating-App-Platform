# Flamoral Mobile App Environment Configuration
# Copy this file to .env and fill in the values
# Variables with EXPO_PUBLIC_ prefix are available in the app at runtime

# =============================================================================
# EXPO PUBLIC VARIABLES (Available in app via process.env)
# =============================================================================

# API Configuration
# Production (Railway): https://api-gateway-production-1957.up.railway.app
EXPO_PUBLIC_API_BASE_URL=https://api-gateway-production-1957.up.railway.app
EXPO_PUBLIC_WS_URL=wss://api-gateway-production-1957.up.railway.app

# Clerk Authentication
# Get these from https://dashboard.clerk.com
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Stripe Configuration
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Google Sign-In Configuration (Required for social login)
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# EAS Configuration (REQUIRED for builds to appear on Expo dashboard)
# Get your project ID from: https://expo.dev/accounts/flamoral/projects/flamoral
# It's a UUID like: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Or run: eas init
EXPO_PUBLIC_EAS_PROJECT_ID=

# Messaging Service — routed through API gateway in production
EXPO_PUBLIC_MESSAGING_SERVICE_URL=https://api-gateway-production-1957.up.railway.app

# =============================================================================
# AI SERVICES — routed through API gateway in production
# =============================================================================
EXPO_PUBLIC_FRAUD_DETECTION_URL=https://api-gateway-production-1957.up.railway.app/api/v1/ai/fraud
EXPO_PUBLIC_NLP_SERVICE_URL=https://api-gateway-production-1957.up.railway.app/api/v1/ai/nlp
EXPO_PUBLIC_PHOTO_ANALYSIS_URL=https://api-gateway-production-1957.up.railway.app/api/v1/ai/photos
EXPO_PUBLIC_RECOMMENDATION_URL=https://api-gateway-production-1957.up.railway.app/api/v1/ai/recommendations

# App Configuration
APP_NAME=Flamoral
APP_VERSION=1.0.0
BUNDLE_ID=com.flamoral.app

# App Variant (set by EAS build profiles)
# APP_VARIANT=development|preview|production

# External Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key

# Google AdMob App IDs (Required for react-native-google-mobile-ads)
# Get these from AdMob Console: https://admob.google.com/
# Test IDs (use for development):
#   Android: ca-app-pub-3940256099942544~3347511713
#   iOS: ca-app-pub-3940256099942544~1458002511
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=ca-app-pub-3940256099942544~3347511713
EXPO_PUBLIC_ADMOB_IOS_APP_ID=ca-app-pub-3940256099942544~1458002511

# Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# =============================================================================
# Feature Flags
# =============================================================================
# Core Features - must match web app and backend
ENABLE_VIDEO_CALLS=true
ENABLE_EVENTS=true
ENABLE_AI_FEATURES=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ENCRYPTION=true

# =============================================================================
# Error Tracking
# =============================================================================
SENTRY_DSN=

# =============================================================================
# Debug Settings
# =============================================================================
DEBUG_MODE=true
LOG_LEVEL=debug
