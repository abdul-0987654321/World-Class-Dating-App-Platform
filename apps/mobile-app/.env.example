# Flamoral Mobile App Environment Configuration
# Copy this file to .env and fill in the values
# Variables with EXPO_PUBLIC_ prefix are available in the app at runtime

# =============================================================================
# EXPO PUBLIC VARIABLES (Available in app via process.env)
# =============================================================================

# API Configuration
EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
EXPO_PUBLIC_WS_URL=ws://localhost:4000

# Authentication
EXPO_PUBLIC_AUTH_ISSUER=http://localhost:4000/auth

# Stripe Configuration
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_key

# Google Sign-In Configuration (Required for social login)
# Get these from Google Cloud Console: https://console.cloud.google.com/apis/credentials
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_google_ios_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_google_android_client_id.apps.googleusercontent.com

# EAS Configuration (REQUIRED for builds to appear on Expo dashboard)
# Get your project ID from: https://expo.dev/accounts/flamoral/projects/flamoral
# It's a UUID like: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Or run: eas init
EXPO_PUBLIC_EAS_PROJECT_ID=

# Messaging Service
EXPO_PUBLIC_MESSAGING_SERVICE_URL=http://localhost:3004

# =============================================================================
# BUILD-TIME VARIABLES (Not available in app runtime)
# =============================================================================

# AI Services (for development, point to local or staging)
FRAUD_DETECTION_URL=http://localhost:5001/fraud
NLP_SERVICE_URL=http://localhost:5001/nlp
PHOTO_ANALYSIS_URL=http://localhost:5001/photos
RECOMMENDATION_URL=http://localhost:5001/recommendations

# App Configuration
APP_NAME=Flamoral
APP_VERSION=1.0.0
BUNDLE_ID=com.flamoral.app

# App Variant (set by EAS build profiles)
# APP_VARIANT=development|preview|production

# External Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Push Notifications
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key

# Analytics
GA_MEASUREMENT_ID=G-XXXXXXXXXX
MIXPANEL_TOKEN=your_mixpanel_token

# =============================================================================
# Feature Flags
# =============================================================================
# Core Features - must match web app and backend
ENABLE_VIDEO_CALLS=true
ENABLE_EVENTS=true
ENABLE_AI_FEATURES=true
ENABLE_PHOTO_VERIFICATION=true
ENABLE_PUSH_NOTIFICATIONS=true
ENABLE_ENCRYPTION=true

# =============================================================================
# Error Tracking
# =============================================================================
SENTRY_DSN=

# =============================================================================
# Debug Settings
# =============================================================================
DEBUG_MODE=true
LOG_LEVEL=debug
