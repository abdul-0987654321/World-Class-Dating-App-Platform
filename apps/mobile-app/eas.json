{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "20.19.0",
      "env": {
        "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
        "CI": "1",
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1",
        "npm_config_platform": "linux",
        "npm_config_arch": "x64",
        "npm_config_libc": "glibc",
        "GRADLE_OPTS": "-Dorg.gradle.daemon=false -Dorg.gradle.jvmargs=-Xmx4g",
        "EAS_SKIP_AUTO_FINGERPRINT": "1"
      },
      "cache": {
        "key": "flamoral-mobile-v5",
        "paths": ["node_modules", ".expo"]
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      }
    },
    "development:simulator": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "APP_VARIANT": "development"
      },
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "development:device": {
      "extends": "development",
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "resourceClass": "m-medium",
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview"
      },
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "local"
      },
      "android": {
        "buildType": "apk",
        "withoutCredentials": true
      }
    },
    "preview:simulator": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "APP_VARIANT": "preview"
      },
      "ios": {
        "simulator": true,
        "resourceClass": "m-medium"
      }
    },
    "preview:testflight": {
      "extends": "preview",
      "distribution": "store",
      "ios": {
        "resourceClass": "m-medium",
        "credentialsSource": "remote"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "channel": "production",
      "env": {
        "APP_VARIANT": "production"
      },
      "ios": {
        "resourceClass": "large",
        "credentialsSource": "remote"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascApiKeyIssuerId": "7c9455fe-4cac-4630-81b5-3ce1d95f57ca",
        "ascApiKeyId": "LN6Y75PYK3",
        "ascApiKeyPath": "${ASC_API_KEY_PATH}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "production",
        "releaseStatus": "completed"
      }
    },
    "preview": {
      "ios": {
        "ascApiKeyIssuerId": "7c9455fe-4cac-4630-81b5-3ce1d95f57ca",
        "ascApiKeyId": "LN6Y75PYK3",
        "ascApiKeyPath": "${ASC_API_KEY_PATH}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-play-service-account.json",
        "track": "internal",
        "releaseStatus": "completed"
      }
    }
  }
}
