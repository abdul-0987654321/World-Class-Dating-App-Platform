# Fastlane Fastfile for Flamoral iOS App
# This file contains all the fastlane automation lanes

default_platform(:ios)

platform :ios do

  # ========================================
  # SETUP & CONFIGURATION
  # ========================================

  before_all do
    # Ensure we're in the right directory
    ensure_git_status_clean unless ENV['SKIP_GIT_CHECK']

    # Set timezone for consistent build timestamps
    ENV["TZ"] = "America/New_York"
  end

  # ========================================
  # DEVELOPMENT LANES
  # ========================================

  desc "Install dependencies"
  lane :install_deps do
    cocoapods(
      clean_install: true,
      podfile: "./Podfile"
    )
  end

  desc "Run unit tests"
  lane :test do
    run_tests(
      workspace: "FlavoralApp.xcworkspace",
      scheme: "FlavoralApp",
      device: "iPhone 15 Pro",
      clean: true,
      code_coverage: true
    )
  end

  desc "Run linter"
  lane :lint do
    sh("cd .. && npm run lint")
  end

  # ========================================
  # CODE SIGNING
  # ========================================

  desc "Sync code signing certificates and provisioning profiles"
  lane :sync_certificates do
    match(
      type: "appstore",
      readonly: true,
      app_identifier: "com.flamoral"
    )
  end

  desc "Create new code signing certificates"
  lane :create_certificates do
    match(
      type: "development",
      app_identifier: "com.flamoral",
      force_for_new_devices: true
    )

    match(
      type: "appstore",
      app_identifier: "com.flamoral"
    )
  end

  # ========================================
  # BUILD LANES
  # ========================================

  desc "Build the app for development"
  lane :build_dev do
    gym(
      workspace: "FlavoralApp.xcworkspace",
      scheme: "FlavoralApp",
      configuration: "Debug",
      export_method: "development",
      clean: true,
      output_directory: "./build",
      output_name: "Flamoral-Dev.ipa"
    )
  end

  desc "Build the app for App Store"
  lane :build_release do
    # Increment build number
    increment_build_number(
      xcodeproj: "FlavoralApp.xcodeproj"
    )

    # Build the app
    gym(
      workspace: "FlavoralApp.xcworkspace",
      scheme: "FlavoralApp",
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "./build",
      output_name: "Flamoral-Release.ipa",
      include_bitcode: false,
      include_symbols: true,
      export_options: {
        provisioningProfiles: {
          "com.flamoral" => "match AppStore com.flamoral"
        }
      }
    )

    # Commit build number increment
    commit_version_bump(
      message: "Bump build number [skip ci]",
      xcodeproj: "FlavoralApp.xcodeproj"
    )
  end

  # ========================================
  # SCREENSHOT LANES
  # ========================================

  desc "Capture screenshots for App Store"
  lane :screenshots do
    capture_screenshots(
      workspace: "FlavoralApp.xcworkspace",
      scheme: "FlavoralApp",
      output_directory: "./fastlane/screenshots",
      clear_previous_screenshots: true,
      override_status_bar: true,
      devices: [
        "iPhone 15 Pro Max",
        "iPhone 15 Pro",
        "iPhone 8 Plus"
      ],
      languages: [
        "en-US"
      ]
    )
  end

  desc "Add device frames to screenshots"
  lane :frame_screenshots do
    frameit(
      white: false,
      path: "./fastlane/screenshots"
    )
  end

  # ========================================
  # TESTFLIGHT LANES
  # ========================================

  desc "Upload to TestFlight"
  lane :beta do
    # Ensure code signing
    sync_certificates

    # Build the app
    build_release

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: true,
      changelog: "Bug fixes and performance improvements",
      distribute_external: false,
      groups: ["Internal Testers"]
    )

    # Notify team
    slack(
      message: "New Flamoral beta build uploaded to TestFlight! 🚀",
      success: true
    ) if ENV['SLACK_URL']
  end

  desc "Upload to TestFlight for external testing"
  lane :beta_external do
    # Ensure code signing
    sync_certificates

    # Build the app
    build_release

    # Upload to TestFlight
    upload_to_testflight(
      skip_waiting_for_build_processing: false,
      changelog: "Bug fixes and performance improvements",
      distribute_external: true,
      groups: ["External Testers"],
      submit_beta_review: true,
      beta_app_review_info: {
        contact_email: "support@flamoral.com",
        contact_first_name: "Flamoral",
        contact_last_name: "Support",
        contact_phone: "+1-555-0100",
        demo_account_required: true,
        demo_account_name: "reviewer@flamoral.com",
        demo_account_password: ENV['DEMO_PASSWORD'],
        notes: "This is a dating app. Use the provided demo account to test all features."
      }
    )

    # Notify team
    slack(
      message: "New Flamoral beta build uploaded for external testing! 🎉",
      success: true
    ) if ENV['SLACK_URL']
  end

  # ========================================
  # APP STORE SUBMISSION
  # ========================================

  desc "Prepare app for App Store submission"
  lane :prepare_submission do
    # Capture screenshots
    screenshots

    # Add frames to screenshots
    frame_screenshots

    # Build release version
    build_release

    UI.success("App is ready for submission! 🎉")
    UI.message("Next steps:")
    UI.message("1. Review screenshots in ./fastlane/screenshots")
    UI.message("2. Run 'fastlane submit' to upload to App Store Connect")
  end

  desc "Submit app to App Store"
  lane :submit do
    # Ensure code signing
    sync_certificates

    # Build the app
    build_release

    # Upload to App Store Connect
    deliver(
      submit_for_review: false,
      automatic_release: false,
      force: false,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      skip_binary_upload: false,
      skip_screenshots: false,
      skip_metadata: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      }
    )

    UI.success("App uploaded to App Store Connect! 🎊")
    UI.message("Log in to App Store Connect to submit for review")
  end

  desc "Submit app for review"
  lane :release do
    # Ensure code signing
    sync_certificates

    # Build the app
    build_release

    # Upload and submit for review
    deliver(
      submit_for_review: true,
      automatic_release: false,
      force: false,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false,
        export_compliance_is_exempt: true,
        content_rights_has_rights: true,
        content_rights_contains_third_party_content: false
      },
      app_review_information: {
        first_name: "Flamoral",
        last_name: "Support",
        phone_number: "+1-555-0100",
        email_address: "support@flamoral.com",
        demo_user: "reviewer@flamoral.com",
        demo_password: ENV['DEMO_PASSWORD'],
        notes: <<-NOTES
          Thank you for reviewing Flamoral!

          DEMO ACCOUNT:
          Email: reviewer@flamoral.com
          Password: (see above)

          TESTING INSTRUCTIONS:
          1. Log in with the demo account
          2. Browse profiles by swiping
          3. Like profiles to create matches
          4. Send messages to matches
          5. Test video call feature (optional)

          NOTES:
          - This is a dating app for users 18+
          - Photo verification is AI-powered
          - Video calls use Agora SDK
          - Payments via Apple In-App Purchase
          - All content is moderated for safety
        NOTES
      }
    )

    # Notify team
    slack(
      message: "🎉 Flamoral submitted to App Store for review!",
      success: true
    ) if ENV['SLACK_URL']

    UI.success("App submitted for review! 🚀")
  end

  # ========================================
  # VERSION MANAGEMENT
  # ========================================

  desc "Bump version and build number"
  lane :bump_version do |options|
    version_type = options[:type] || "patch" # major, minor, patch

    increment_version_number(
      bump_type: version_type,
      xcodeproj: "FlavoralApp.xcodeproj"
    )

    increment_build_number(
      xcodeproj: "FlavoralApp.xcodeproj"
    )

    version = get_version_number(xcodeproj: "FlavoralApp.xcodeproj")
    build = get_build_number(xcodeproj: "FlavoralApp.xcodeproj")

    commit_version_bump(
      message: "Bump version to #{version} (#{build}) [skip ci]",
      xcodeproj: "FlavoralApp.xcodeproj"
    )

    add_git_tag(tag: "v#{version}")
    push_to_git_remote

    UI.success("Version bumped to #{version} (#{build})")
  end

  # ========================================
  # UTILITY LANES
  # ========================================

  desc "Clean build artifacts"
  lane :clean do
    clear_derived_data
    sh("cd .. && rm -rf build/")
    UI.success("Build artifacts cleaned!")
  end

  desc "Register new device"
  lane :register_device do |options|
    device_name = options[:name]
    device_udid = options[:udid]

    register_devices(
      devices: {
        device_name => device_udid
      }
    )

    match(
      type: "development",
      force_for_new_devices: true
    )

    UI.success("Device registered and provisioning profile updated!")
  end

  desc "Display app information"
  lane :info do
    version = get_version_number(xcodeproj: "FlavoralApp.xcodeproj")
    build = get_build_number(xcodeproj: "FlavoralApp.xcodeproj")

    UI.header("Flamoral App Information")
    UI.message("Version: #{version}")
    UI.message("Build: #{build}")
    UI.message("Bundle ID: com.flamoral")
    UI.message("Scheme: FlavoralApp")
  end

  # ========================================
  # ERROR HANDLING
  # ========================================

  after_all do |lane|
    UI.success("Successfully executed lane: #{lane}")
  end

  error do |lane, exception|
    UI.error("Error in lane #{lane}: #{exception.message}")

    # Notify on Slack if configured
    slack(
      message: "❌ Fastlane failed in lane '#{lane}': #{exception.message}",
      success: false
    ) if ENV['SLACK_URL']
  end

end

# ========================================
# PLUGIN CONFIGURATION
# ========================================

# Uncomment these if you want to use plugins
# You can install plugins by running: bundle exec fastlane add_plugin [plugin_name]

# Example plugins:
# - fastlane-plugin-versioning
# - fastlane-plugin-firebase_app_distribution
# - fastlane-plugin-appcenter
