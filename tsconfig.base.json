{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@connectsphere/api-client": ["packages/shared/api-client/src"],
      "@connectsphere/types": ["packages/shared/types/src"],
      "@connectsphere/utils": ["packages/shared/utils/src"],
      "@connectsphere/constants": ["packages/shared/constants/src"],
      "@connectsphere/validators": ["packages/shared/validators/src"],
      "@connectsphere/ui-components": ["packages/ui-components/src"]
    }
  },
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "coverage"
  ]
}
