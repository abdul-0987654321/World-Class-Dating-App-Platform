{
  "name": "@flamoral/shared",
  "version": "1.0.0",
  "description": "Shared packages for Flamoral (types, utils, constants, validators)",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "workspaces": [
    "types",
    "utils",
    "constants",
    "validators",
    "api-client"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "lint": "echo 'Run lint from subpackages'",
    "test": "echo 'Run tests from subpackages'"
  },
  "dependencies": {
    "@flamoral/types": "workspace:*",
    "@flamoral/utils": "workspace:*",
    "@flamoral/constants": "workspace:*",
    "@flamoral/validators": "workspace:*",
    "@flamoral/api-client": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.3.2"
  }
}
