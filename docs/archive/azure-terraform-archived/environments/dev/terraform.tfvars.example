# =============================================================================
# Flamoral Dating Platform - Development Environment Configuration
# SECURITY HARDENING ENABLED (Developer-Friendly)
# =============================================================================
# Copy this file to terraform.tfvars and update with your values
# DO NOT commit terraform.tfvars to version control
# =============================================================================

# =============================================================================
# Azure Authentication (Required)
# =============================================================================
tenant_id = "YOUR_TENANT_ID_HERE"

# =============================================================================
# SECURITY: AKS API Server Access Control
# =============================================================================
# Development allows access from anywhere for developer convenience
# Remove this in higher environments
authorized_ip_ranges = []  # Empty = allow all (dev only!)

# =============================================================================
# SECURITY: Disk Encryption
# =============================================================================
# Optional for dev - can disable to speed up deployment
enable_disk_encryption = false

# =============================================================================
# SECURITY: Key Vault Protection
# =============================================================================
# No purge protection for dev
enable_purge_protection = false

# Minimal retention for dev
soft_delete_retention_days = 7

# =============================================================================
# SECURITY: WAF Configuration
# =============================================================================
# Detection mode only - never block in dev
waf_mode = "Detection"

# No geo-filtering for dev
enable_geo_filtering = false

# =============================================================================
# Environment Configuration
# =============================================================================
location            = "westus2"
resource_group_name = "flamoral-dev-rg"

# =============================================================================
# Network Configuration
# =============================================================================
vnet_address_space              = ["10.10.0.0/16"]
aks_subnet_prefix               = "10.10.1.0/24"
db_subnet_prefix                = "10.10.2.0/24"
redis_subnet_prefix             = "10.10.3.0/24"
private_endpoints_subnet_prefix = "10.10.4.0/24"

# =============================================================================
# AKS Development Configuration (Minimal)
# =============================================================================
kubernetes_version = "1.28.3"

# System node pool (minimal)
system_node_size      = "Standard_B2s"  # 2 vCPU, 4 GB RAM (Burstable)
system_node_count     = 1
system_node_min_count = 1
system_node_max_count = 2
system_node_disk_size = 32

# User node pool (minimal)
user_node_size      = "Standard_D2s_v3"  # 2 vCPU, 8 GB RAM
user_node_count     = 1
user_node_min_count = 1
user_node_max_count = 3
user_node_disk_size = 64

# =============================================================================
# PostgreSQL Development Configuration
# =============================================================================
postgres_version                = "15"
postgres_sku_name               = "B_Standard_B1ms"  # 1 vCore (Burstable)
postgres_storage_mb             = 32768              # 32 GB
postgres_backup_retention_days  = 7                  # 1 week
postgres_geo_redundant_backup   = false              # Single region

# =============================================================================
# Redis Development Configuration
# =============================================================================
redis_sku_name  = "Basic"  # Basic tier (cheapest)
redis_family    = "C"
redis_capacity  = 0        # C0 = 250 MB cache

# =============================================================================
# Storage Configuration
# =============================================================================
storage_replication_type = "LRS"  # Locally redundant

# =============================================================================
# Monitoring Configuration
# =============================================================================
log_analytics_retention_days = 30  # 1 month retention

# =============================================================================
# SignalR Development Configuration
# =============================================================================
signalr_sku      = "Free_F1"  # Free tier (limited features)
signalr_capacity = 1

# =============================================================================
# Resource Tags
# =============================================================================
tags = {
  Project       = "Flamoral"
  Environment   = "development"
  ManagedBy     = "Terraform"
  Owner         = "Engineering"
  Application   = "Dating Platform"
  CostCenter    = "Development"
  AccessLevel   = "Internal"
  SecurityLevel = "Low"
  AutoShutdown  = "Enabled"
  AutoStart     = "Disabled"
}

# =============================================================================
# NOTES
# =============================================================================
# 1. Development uses minimal SKUs to minimize costs
# 2. Open API access for developer convenience (NOT for prod!)
# 3. No encryption to speed up deployment
# 4. WAF in detection mode only
# 5. Free/Basic tiers where possible
# 6. Enable auto-shutdown policies to save costs
# 7. Consider using Azure Dev/Test pricing if eligible
# =============================================================================
