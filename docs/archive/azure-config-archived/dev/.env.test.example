# =============================================================================
# Flamoral Dating Platform - Test/Staging Environment Configuration
# =============================================================================
# Copy this file to .env.test and fill in your actual values
# DO NOT commit .env.test to version control
# =============================================================================

# =============================================================================
# Environment Configuration
# =============================================================================
NODE_ENV=production
ENVIRONMENT=test
PORT=3000
GRAPHQL_PORT=4000
WS_PORT=5000

# =============================================================================
# URLs and Hosts
# =============================================================================
WEB_URL=https://test.flamoral.app
API_URL=https://api.test.flamoral.app
INGRESS_HOST=test.flamoral.app
API_HOST=api.test.flamoral.app

# =============================================================================
# Database - PostgreSQL (Azure Database for PostgreSQL)
# =============================================================================
DB_HOST=flamoral-test-postgres.postgres.database.azure.com
DB_PORT=5432
DB_NAME=flamoral
DB_USER=flamoral_admin
DB_PASSWORD=your_azure_postgres_password_here
DB_POOL_MIN=5
DB_POOL_MAX=20
DB_SSL=true
DATABASE_URL=postgresql://flamoral_admin:your_password@flamoral-test-postgres.postgres.database.azure.com:5432/flamoral?ssl=true

# =============================================================================
# Database - MongoDB (Azure Cosmos DB or MongoDB Atlas)
# =============================================================================
MONGODB_URI=mongodb://your-cosmos-account:your-key@your-cosmos-account.mongo.cosmos.azure.com:10255/flamoral-test?ssl=true&replicaSet=globaldb
MONGODB_DB=flamoral-test

# =============================================================================
# Cache - Redis (Azure Cache for Redis)
# =============================================================================
REDIS_HOST=flamoral-test-redis.redis.cache.windows.net
REDIS_PORT=6380
REDIS_PASSWORD=your_azure_redis_primary_key_here
REDIS_DB=0
REDIS_URL=rediss://:your_azure_redis_primary_key_here@flamoral-test-redis.redis.cache.windows.net:6380
REDIS_TLS=true

# =============================================================================
# Message Queue - RabbitMQ (Azure Service Bus or CloudAMQP)
# =============================================================================
RABBITMQ_URL=amqps://user:password@your-rabbitmq-host.mq.cloudamqp.com/vhost
QUEUE_MATCHING=matching_queue
QUEUE_NOTIFICATIONS=notification_queue
QUEUE_ANALYTICS=analytics_queue
QUEUE_MODERATION=moderation_queue

# =============================================================================
# Authentication - JWT
# =============================================================================
# IMPORTANT: Use strong random strings (minimum 64 characters)
JWT_ACCESS_SECRET=test-jwt-access-secret-REPLACE-WITH-64-CHAR-SECURE-RANDOM-STRING
JWT_REFRESH_SECRET=test-jwt-refresh-secret-REPLACE-WITH-64-CHAR-SECURE-RANDOM-STRING
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# Payment Gateway - Stripe (TEST MODE)
# =============================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_test_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_test_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret

# =============================================================================
# Email Service - SendGrid
# =============================================================================
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM_EMAIL=test@flamoral.com
SENDGRID_FROM_NAME=Flamoral Test

# =============================================================================
# SMS Service - Twilio
# =============================================================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# Azure Storage
# =============================================================================
AZURE_STORAGE_ACCOUNT=flamoraltestst
AZURE_STORAGE_KEY=your_azure_storage_account_key_here
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=flamoraltestst;AccountKey=your_key_here;EndpointSuffix=core.windows.net
AZURE_STORAGE_CONTAINER_PHOTOS=photos
AZURE_STORAGE_CONTAINER_VIDEOS=videos

# =============================================================================
# Azure Cognitive Services - Face API
# =============================================================================
AZURE_FACE_API_KEY=your_azure_face_api_key_here
AZURE_FACE_API_ENDPOINT=https://eastus.api.cognitive.microsoft.com

# =============================================================================
# Video/Voice Calling - Agora
# =============================================================================
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here

# =============================================================================
# Error Tracking - Sentry
# =============================================================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/your-project-id
SENTRY_ENVIRONMENT=test
SENTRY_TRACES_SAMPLE_RATE=0.5

# =============================================================================
# CORS Configuration
# =============================================================================
CORS_ORIGIN=https://test.flamoral.app
CORS_CREDENTIALS=true

# =============================================================================
# Rate Limiting
# =============================================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_FILE_ENABLED=true
LOG_FILE_PATH=/var/log/flamoral

# =============================================================================
# Azure Container Registry (ACR)
# =============================================================================
ACR_NAME=flamoralacr8eq5eg
ACR_LOGIN_SERVER=flamoralacr8eq5eg.azurecr.io
ACR_USERNAME=flamoralacr8eq5eg
ACR_PASSWORD=your_acr_password_here

# =============================================================================
# Kubernetes / AKS
# =============================================================================
AKS_CLUSTER_NAME=flamoral-test-aks
AKS_RESOURCE_GROUP=flamoral-test-rg
NAMESPACE=flamoral-test
REPLICA_COUNT=2
AUTOSCALING_ENABLED=true
AUTOSCALING_MIN_REPLICAS=2
AUTOSCALING_MAX_REPLICAS=5

# =============================================================================
# Azure Key Vault
# =============================================================================
KEY_VAULT_NAME=flamoral-test-kv
KEY_VAULT_URI=https://flamoral-test-kv.vault.azure.net/

# =============================================================================
# Azure Resource Manager (for Terraform/Automation)
# =============================================================================
ARM_CLIENT_ID=your-service-principal-client-id
ARM_CLIENT_SECRET=your-service-principal-client-secret
ARM_SUBSCRIPTION_ID=your-azure-subscription-id
ARM_TENANT_ID=your-azure-tenant-id

# =============================================================================
# Feature Flags
# =============================================================================
FEATURE_AI_MATCHING=true
FEATURE_VIDEO_CALLS=true
FEATURE_TRAVEL_MODE=true
FEATURE_DATING_COACH=true
FEATURE_GAMIFICATION=true

# =============================================================================
# Session Configuration
# =============================================================================
SESSION_SECRET=test-session-secret-min-32-chars-here
SESSION_MAX_AGE=86400000

# =============================================================================
# File Upload Limits
# =============================================================================
MAX_FILE_SIZE=10485760
MAX_PHOTO_COUNT=10
MAX_VIDEO_SIZE=52428800

# =============================================================================
# WebSocket Configuration
# =============================================================================
WS_HEARTBEAT_INTERVAL=30000
WS_HEARTBEAT_TIMEOUT=60000

# =============================================================================
# Development Tools (Disabled in Test)
# =============================================================================
ENABLE_GRAPHQL_PLAYGROUND=false
ENABLE_API_DOCS=false
ENABLE_DEBUG_LOGGING=false

# =============================================================================
# AI/ML Configuration
# =============================================================================
AI_MODEL_ENDPOINT=https://ai.test.flamoral.app
AI_MODEL_API_KEY=test-ai-model-key

# =============================================================================
# Push Notifications - Firebase
# =============================================================================
FIREBASE_PROJECT_ID=flamoral-test
FIREBASE_PRIVATE_KEY=your-firebase-private-key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@flamoral-test.iam.gserviceaccount.com

# =============================================================================
# Monitoring and Observability
# =============================================================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
JAEGER_ENABLED=true

# =============================================================================
# Security Headers
# =============================================================================
HSTS_MAX_AGE=31536000
CSP_ENABLED=true
