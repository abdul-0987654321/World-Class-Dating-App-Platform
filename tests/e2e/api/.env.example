# E2E API Test Environment Configuration
# Copy this file to .env and configure for your environment

# ===========================================
# Service URLs - Local Development
# ===========================================
AUTH_URL=http://localhost:3001
USER_URL=http://localhost:3002
MATCHING_URL=http://localhost:3003
MESSAGING_URL=http://localhost:3004
NOTIFICATION_URL=http://localhost:3005
MEDIA_URL=http://localhost:3006
PAYMENT_URL=http://localhost:3007
API_GATEWAY_URL=http://localhost:3000

# ===========================================
# Service URLs - Production Railway (default when env vars not set)
# All services route through the API gateway in production
# ===========================================
# API_GATEWAY_URL=https://api-gateway-production-1957.up.railway.app
# AUTH_URL=https://api-gateway-production-1957.up.railway.app
# USER_URL=https://api-gateway-production-1957.up.railway.app
# MATCHING_URL=https://api-gateway-production-1957.up.railway.app
# MESSAGING_URL=https://api-gateway-production-1957.up.railway.app
# NOTIFICATION_URL=https://api-gateway-production-1957.up.railway.app
# MEDIA_URL=https://api-gateway-production-1957.up.railway.app
# PAYMENT_URL=https://api-gateway-production-1957.up.railway.app

# ===========================================
# Service URLs - Staging (uncomment for staging)
# ===========================================
# AUTH_URL=https://auth.staging.flamoral.com
# USER_URL=https://user.staging.flamoral.com
# MATCHING_URL=https://matching.staging.flamoral.com
# MESSAGING_URL=https://messaging.staging.flamoral.com
# NOTIFICATION_URL=https://notification.staging.flamoral.com
# MEDIA_URL=https://media.staging.flamoral.com
# PAYMENT_URL=https://payment.staging.flamoral.com
# API_GATEWAY_URL=https://api.staging.flamoral.com

# ===========================================
# Test User Credentials
# ===========================================
TEST_USER_EMAIL=e2e-test@example.com
TEST_USER_PASSWORD=E2ETestPassword123!

# ===========================================
# Stripe Test Keys (use test mode keys only!)
# ===========================================
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET

# ===========================================
# Internal Service Communication
# ===========================================
INTERNAL_SERVICE_KEY=your-internal-service-key

# ===========================================
# Test Timeouts (milliseconds)
# ===========================================
E2E_TIMEOUT=30000
E2E_LONG_TIMEOUT=60000

# ===========================================
# Database (for cleanup/setup if needed)
# ===========================================
TEST_DB_HOST=localhost
TEST_DB_PORT=5432
TEST_DB_NAME=flamoral_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
