# =============================================================================
# RAILWAY SHARED ENVIRONMENT VARIABLES TEMPLATE
# =============================================================================
# These variables should be configured as "Shared Variables" in Railway
# They will be referenced by individual services using ${{shared.VAR_NAME}}
# =============================================================================

# =============================================================================
# AUTHENTICATION & SECURITY
# =============================================================================

# JWT Configuration - Must be consistent across all services
JWT_SECRET=generate-with-openssl-rand-hex-64
JWT_ACCESS_SECRET=generate-with-openssl-rand-hex-64
JWT_REFRESH_SECRET=generate-with-openssl-rand-hex-64

# Service-to-Service Authentication
SERVICE_API_KEY=generate-with-openssl-rand-hex-32

# Encryption Keys (must be exactly 32 bytes for AES-256)
ENCRYPTION_KEY=generate-32-character-string-here
TOTP_ENCRYPTION_KEY=generate-32-character-string-here

# =============================================================================
# AWS SERVICES
# =============================================================================

# AWS General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# AWS S3 Storage
AWS_S3_BUCKET=flamoral-media
AWS_S3_BUCKET_PHOTOS=flamoral-photos
AWS_S3_BUCKET_VIDEOS=flamoral-videos

# AWS SES Email
AWS_SES_REGION=us-east-1
EMAIL_FROM=noreply@flamoral.com
EMAIL_FROM_NAME=Flamoral

# AWS SNS Push Notifications
AWS_SNS_PLATFORM_APPLICATION_ARN_ANDROID=arn:aws:sns:us-east-1:ACCOUNT:app/GCM/flamoral-android
AWS_SNS_PLATFORM_APPLICATION_ARN_IOS=arn:aws:sns:us-east-1:ACCOUNT:app/APNS/flamoral-ios

# AWS Rekognition
AWS_REKOGNITION_REGION=us-east-1

# AWS SQS
AWS_SQS_REGION=us-east-1

# =============================================================================
# STRIPE PAYMENTS
# =============================================================================

STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# =============================================================================
# AI SERVICES
# =============================================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn

# Log Level
LOG_LEVEL=info

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

CORS_ORIGINS=https://app.flamoral.com,https://admin.flamoral.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_CIRCUIT_BREAKER=true
ENABLE_REQUEST_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
